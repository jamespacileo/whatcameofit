{
 "$defs": {
  "Approach": {
   "description": "The kind of intervention a claim reports. Never part of status.",
   "enum": [
    "drug",
    "vaccine",
    "gene_therapy",
    "cell_therapy",
    "tissue_regeneration",
    "transplant",
    "device",
    "surgery_or_procedure",
    "diet_or_lifestyle",
    "biologic",
    "behavioural",
    "radiation"
   ],
   "title": "Approach",
   "type": "string"
  },
  "ApproachBasis": {
   "description": "What an approach was set on.",
   "enum": [
    "registry_intervention_type",
    "person"
   ],
   "title": "ApproachBasis",
   "type": "string"
  },
  "Condition": {
   "additionalProperties": false,
   "description": "One condition a claim or a trial pair stands for, with its own page.\n\nKeyed on its MeSH descriptor, so a condition's id is the descriptor's id. Its label and\ntree numbers are the descriptor's, read from `MeshDescriptor`, never copied here.",
   "properties": {
    "descriptor_id": {
     "title": "Descriptor Id",
     "type": "string"
    },
    "slug": {
     "title": "Slug",
     "type": "string"
    }
   },
   "required": [
    "descriptor_id",
    "slug"
   ],
   "title": "Condition",
   "type": "object"
  },
  "FilingBasis": {
   "description": "How a pair's vertical was set.",
   "enum": [
    "one_derived_topic",
    "narrowest_derived_topic",
    "special_group",
    "main_disease",
    "person"
   ],
   "title": "FilingBasis",
   "type": "string"
  },
  "Intervention": {
   "additionalProperties": false,
   "description": "One drug, device, method or complete regimen, shared by every claim about it.\n\n`id` is `<key_kind>:<key_value>`, made once by the step that creates the record. A\nregimen lists its agents in `components`; one agent has none.",
   "properties": {
    "components": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Components",
     "type": "array"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "key_kind": {
     "$ref": "#/$defs/InterventionKeyKind"
    },
    "key_value": {
     "title": "Key Value",
     "type": "string"
    },
    "preferred_name": {
     "title": "Preferred Name",
     "type": "string"
    },
    "slug": {
     "title": "Slug",
     "type": "string"
    }
   },
   "required": [
    "id",
    "key_kind",
    "key_value",
    "preferred_name",
    "slug"
   ],
   "title": "Intervention",
   "type": "object"
  },
  "InterventionApproach": {
   "additionalProperties": false,
   "description": "An intervention's approach, on what basis, and the registry type it was read from.\n\nThe approach is the intervention's own, not each pair's. It is None when the registry\ntypes of its trials disagree. A rule never replaces a person's.",
   "properties": {
    "approach": {
     "anyOf": [
      {
       "$ref": "#/$defs/Approach"
      },
      {
       "type": "null"
      }
     ]
    },
    "basis": {
     "$ref": "#/$defs/ApproachBasis"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "registry_type": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Registry Type"
    },
    "trials": {
     "title": "Trials",
     "type": "integer"
    }
   },
   "required": [
    "intervention_id",
    "approach",
    "basis",
    "registry_type",
    "trials"
   ],
   "title": "InterventionApproach",
   "type": "object"
  },
  "InterventionKeyKind": {
   "description": "Where an intervention's key comes from, best first.",
   "enum": [
    "substance",
    "mesh",
    "registry_name",
    "regimen"
   ],
   "title": "InterventionKeyKind",
   "type": "string"
  },
  "InterventionName": {
   "additionalProperties": false,
   "description": "One name of an intervention, with who gives it.\n\n`searchable` is true only when a substance registry, RxNorm or MeSH gives the name, or a\nregistry name equals one they give. Only searchable names find headlines and trials.",
   "properties": {
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "origin": {
     "$ref": "#/$defs/NameOrigin"
    },
    "role": {
     "$ref": "#/$defs/NameRole"
    },
    "searchable": {
     "title": "Searchable",
     "type": "boolean"
    }
   },
   "required": [
    "intervention_id",
    "name",
    "origin",
    "role",
    "searchable"
   ],
   "title": "InterventionName",
   "type": "object"
  },
  "Lead": {
   "additionalProperties": false,
   "description": "One article address, in the form the site compares addresses, kept once.\n\n`title` is the headline it was first seen with: a headline, never article text.",
   "properties": {
    "first_seen": {
     "format": "date-time",
     "title": "First Seen",
     "type": "string"
    },
    "outlet": {
     "title": "Outlet",
     "type": "string"
    },
    "published": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Published"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "url": {
     "title": "Url",
     "type": "string"
    },
    "url_key": {
     "title": "Url Key",
     "type": "string"
    }
   },
   "required": [
    "url_key",
    "url",
    "outlet",
    "title",
    "published",
    "first_seen"
   ],
   "title": "Lead",
   "type": "object"
  },
  "MeshDescriptor": {
   "additionalProperties": false,
   "description": "A MeSH descriptor as the lab keeps it: its label and its places in the tree.",
   "properties": {
    "descriptor_id": {
     "title": "Descriptor Id",
     "type": "string"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "tree_numbers": {
     "items": {
      "type": "string"
     },
     "title": "Tree Numbers",
     "type": "array"
    }
   },
   "required": [
    "descriptor_id",
    "label",
    "tree_numbers"
   ],
   "title": "MeshDescriptor",
   "type": "object"
  },
  "NameOrigin": {
   "description": "Who gives a name for an intervention.",
   "enum": [
    "substance_registry",
    "rxnorm",
    "mesh_label",
    "mesh_entry_term",
    "registry_intervention",
    "registry_other_name",
    "article",
    "person"
   ],
   "title": "NameOrigin",
   "type": "string"
  },
  "NameRole": {
   "description": "What kind of name it is. A development code or search phrase is never shown as a name.",
   "enum": [
    "preferred",
    "generic",
    "brand",
    "development_code",
    "search_phrase",
    "other"
   ],
   "title": "NameRole",
   "type": "string"
  },
  "Pair": {
   "additionalProperties": false,
   "description": "A tracked (intervention, condition), derived each run. Never written by a batch.\n\n`key` is `<intervention_id>|<condition_id>`, the row key. `address` is the public one,\n`<intervention slug>--<condition slug>`, kept apart so two pairs with one address are\nboth tracked. `checked_by_person` is true while a person's decision on one of its\ntrials still counts.",
   "properties": {
    "address": {
     "title": "Address",
     "type": "string"
    },
    "checked_by_person": {
     "title": "Checked By Person",
     "type": "boolean"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "key": {
     "title": "Key",
     "type": "string"
    },
    "nct_ids": {
     "items": {
      "type": "string"
     },
     "title": "Nct Ids",
     "type": "array"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "key",
    "address",
    "nct_ids",
    "checked_by_person"
   ],
   "title": "Pair",
   "type": "object"
  },
  "PairFiling": {
   "additionalProperties": false,
   "description": "The one vertical a pair is filed under, and how.",
   "properties": {
    "basis": {
     "$ref": "#/$defs/FilingBasis"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "vertical": {
     "title": "Vertical",
     "type": "string"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "vertical",
    "basis"
   ],
   "title": "PairFiling",
   "type": "object"
  },
  "PairOrigin": {
   "additionalProperties": false,
   "description": "One of thenwhat's published claims and the pair it stands for: the old address the\nsite redirects, read from the published export (`gold.u19_pairs`).",
   "properties": {
    "claim_slug": {
     "title": "Claim Slug",
     "type": "string"
    },
    "condition_fit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Condition Fit"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "indication": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Indication"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "claim_slug"
   ],
   "title": "PairOrigin",
   "type": "object"
  },
  "PairRow": {
   "additionalProperties": false,
   "description": "A pair as a list shows it, with the published claim it was, if any, for the open-data\nexport and the site's redirects.",
   "properties": {
    "claim_slugs": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Claim Slugs",
     "type": "array"
    },
    "condition": {
     "$ref": "#/$defs/Condition"
    },
    "descriptor": {
     "$ref": "#/$defs/MeshDescriptor"
    },
    "filing": {
     "anyOf": [
      {
       "$ref": "#/$defs/PairFiling"
      },
      {
       "type": "null"
      }
     ]
    },
    "first_report": {
     "anyOf": [
      {
       "$ref": "#/$defs/Lead"
      },
      {
       "type": "null"
      }
     ]
    },
    "intervention": {
     "$ref": "#/$defs/Intervention"
    },
    "origin": {
     "anyOf": [
      {
       "$ref": "#/$defs/PairOrigin"
      },
      {
       "type": "null"
      }
     ]
    },
    "pair": {
     "$ref": "#/$defs/Pair"
    },
    "status": {
     "$ref": "#/$defs/PairStatus"
    }
   },
   "required": [
    "pair",
    "intervention",
    "condition",
    "descriptor",
    "status",
    "filing",
    "origin",
    "first_report"
   ],
   "title": "PairRow",
   "type": "object"
  },
  "PairStatus": {
   "additionalProperties": false,
   "description": "A pair's status as of a day, with the events that explain it.",
   "properties": {
    "as_of": {
     "format": "date",
     "title": "As Of",
     "type": "string"
    },
    "code": {
     "$ref": "#/$defs/StatusCode"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "explained_by": {
     "items": {
      "type": "string"
     },
     "title": "Explained By",
     "type": "array"
    },
    "highest_phase": {
     "anyOf": [
      {
       "$ref": "#/$defs/TrialPhase"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "highest_phase_combined_with": {
     "anyOf": [
      {
       "$ref": "#/$defs/TrialPhase"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "highest_phase_trials": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Highest Phase Trials",
     "type": "array"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "overlay_years": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Overlay Years"
    },
    "trials_without_a_phase": {
     "default": 0,
     "title": "Trials Without A Phase",
     "type": "integer"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "code",
    "overlay_years",
    "explained_by",
    "as_of"
   ],
   "title": "PairStatus",
   "type": "object"
  },
  "StatusCode": {
   "description": "Where a pair stands. The site words each code; none is a verdict.",
   "enum": [
    "preclinical_only",
    "no_trial_found",
    "trial_registered",
    "phase_1",
    "phase_2",
    "phase_3",
    "approved",
    "failed",
    "terminated",
    "retracted"
   ],
   "title": "StatusCode",
   "type": "string"
  },
  "TrialPhase": {
   "description": "A phase as the registry codes it.",
   "enum": [
    "early_phase_1",
    "phase_1",
    "phase_2",
    "phase_3",
    "phase_4",
    "not_applicable"
   ],
   "title": "TrialPhase",
   "type": "string"
  }
 },
 "additionalProperties": false,
 "description": "An intervention's page on the pair path: its names and the pairs shown for it.",
 "properties": {
  "approach": {
   "anyOf": [
    {
     "$ref": "#/$defs/InterventionApproach"
    },
    {
     "type": "null"
    }
   ]
  },
  "intervention": {
   "$ref": "#/$defs/Intervention"
  },
  "names": {
   "items": {
    "$ref": "#/$defs/InterventionName"
   },
   "title": "Names",
   "type": "array"
  },
  "pairs": {
   "items": {
    "$ref": "#/$defs/PairRow"
   },
   "title": "Pairs",
   "type": "array"
  }
 },
 "required": [
  "intervention",
  "names",
  "approach",
  "pairs"
 ],
 "title": "PairInterventionPage",
 "type": "object"
}
