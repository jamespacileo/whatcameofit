{
 "$defs": {
  "Approach": {
   "description": "The kind of intervention a claim reports. Never part of status.",
   "enum": [
    "drug",
    "vaccine",
    "gene_therapy",
    "cell_therapy",
    "tissue_regeneration",
    "transplant",
    "device",
    "surgery_or_procedure",
    "diet_or_lifestyle"
   ],
   "title": "Approach",
   "type": "string"
  },
  "ApproachBasis": {
   "description": "What an approach was set on.",
   "enum": [
    "registry_intervention_type",
    "person"
   ],
   "title": "ApproachBasis",
   "type": "string"
  },
  "ArmRole": {
   "description": "An arm's role, as the registry codes it.",
   "enum": [
    "experimental",
    "active_comparator",
    "placebo_comparator",
    "sham_comparator",
    "no_intervention",
    "other"
   ],
   "title": "ArmRole",
   "type": "string"
  },
  "ClaimStatusCode": {
   "description": "Where a claim stands. The site words each code; none is a verdict.",
   "enum": [
    "preclinical_only",
    "no_trial_found",
    "trial_registered",
    "phase_1",
    "phase_2",
    "phase_3",
    "approved",
    "failed",
    "terminated",
    "retracted"
   ],
   "title": "ClaimStatusCode",
   "type": "string"
  },
  "ComparisonKind": {
   "description": "What a posted comparison compares, by its groups' arms.",
   "enum": [
    "treated_vs_comparator",
    "within_group",
    "other"
   ],
   "title": "ComparisonKind",
   "type": "string"
  },
  "Condition": {
   "additionalProperties": false,
   "description": "One condition a claim or a trial pair stands for, with its own page.\n\nKeyed on its MeSH descriptor, so a condition's id is the descriptor's id. Its label and\ntree numbers are the descriptor's, read from `MeshDescriptor`, never copied here.",
   "properties": {
    "descriptor_id": {
     "title": "Descriptor Id",
     "type": "string"
    },
    "slug": {
     "title": "Slug",
     "type": "string"
    }
   },
   "required": [
    "descriptor_id",
    "slug"
   ],
   "title": "Condition",
   "type": "object"
  },
  "DayBasis": {
   "description": "How an event's day is known.",
   "enum": [
    "registry_date",
    "registry_date_estimated",
    "seen_in_update"
   ],
   "title": "DayBasis",
   "type": "string"
  },
  "DraftedFrom": {
   "description": "What a claim was drafted from. Set once and never changed.",
   "enum": [
    "registry",
    "article",
    "post",
    "person",
    "seed"
   ],
   "title": "DraftedFrom",
   "type": "string"
  },
  "DueCode": {
   "description": "Which fact holds of a completed trial's results. A fact, never a breach: which trials\nthe law covers cannot be read from the record.",
   "enum": [
    "results_posted",
    "results_submitted_not_posted",
    "no_results_a_year_after_completion"
   ],
   "title": "DueCode",
   "type": "string"
  },
  "FilingBasis": {
   "description": "How a claim's vertical was set.",
   "enum": [
    "one_derived_topic",
    "narrowest_derived_topic",
    "person"
   ],
   "title": "FilingBasis",
   "type": "string"
  },
  "GroupArmBasis": {
   "description": "How a result group was joined to an arm.",
   "enum": [
    "title",
    "agent"
   ],
   "title": "GroupArmBasis",
   "type": "string"
  },
  "Intervention": {
   "additionalProperties": false,
   "description": "One drug, device, method or complete regimen, shared by every claim about it.\n\n`id` is `<key_kind>:<key_value>`, made once by the step that creates the record. A\nregimen lists its agents in `components`; one agent has none.",
   "properties": {
    "components": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Components",
     "type": "array"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "key_kind": {
     "$ref": "#/$defs/InterventionKeyKind"
    },
    "key_value": {
     "title": "Key Value",
     "type": "string"
    },
    "preferred_name": {
     "title": "Preferred Name",
     "type": "string"
    },
    "slug": {
     "title": "Slug",
     "type": "string"
    }
   },
   "required": [
    "id",
    "key_kind",
    "key_value",
    "preferred_name",
    "slug"
   ],
   "title": "Intervention",
   "type": "object"
  },
  "InterventionApproach": {
   "additionalProperties": false,
   "description": "An intervention's approach, on what basis, and the registry type it was read from.\n\nThe approach is the intervention's own, not each pair's. It is None when the registry\ntypes of its trials disagree. A rule never replaces a person's.",
   "properties": {
    "approach": {
     "anyOf": [
      {
       "$ref": "#/$defs/Approach"
      },
      {
       "type": "null"
      }
     ]
    },
    "basis": {
     "$ref": "#/$defs/ApproachBasis"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "registry_type": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Registry Type"
    },
    "trials": {
     "title": "Trials",
     "type": "integer"
    }
   },
   "required": [
    "intervention_id",
    "approach",
    "basis",
    "registry_type",
    "trials"
   ],
   "title": "InterventionApproach",
   "type": "object"
  },
  "InterventionKeyKind": {
   "description": "Where an intervention's key comes from, best first.",
   "enum": [
    "substance",
    "mesh",
    "registry_name",
    "regimen"
   ],
   "title": "InterventionKeyKind",
   "type": "string"
  },
  "InterventionName": {
   "additionalProperties": false,
   "description": "One name of an intervention, with who gives it.\n\n`searchable` is true only when a substance registry, RxNorm or MeSH gives the name, or a\nregistry name equals one they give. Only searchable names find headlines and trials.",
   "properties": {
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "origin": {
     "$ref": "#/$defs/NameOrigin"
    },
    "role": {
     "$ref": "#/$defs/NameRole"
    },
    "searchable": {
     "title": "Searchable",
     "type": "boolean"
    }
   },
   "required": [
    "intervention_id",
    "name",
    "origin",
    "role",
    "searchable"
   ],
   "title": "InterventionName",
   "type": "object"
  },
  "Lead": {
   "additionalProperties": false,
   "description": "One article address, in the form the site compares addresses, kept once.\n\n`title` is the headline it was first seen with: a headline, never article text.",
   "properties": {
    "first_seen": {
     "format": "date-time",
     "title": "First Seen",
     "type": "string"
    },
    "outlet": {
     "title": "Outlet",
     "type": "string"
    },
    "published": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Published"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "url": {
     "title": "Url",
     "type": "string"
    },
    "url_key": {
     "title": "Url Key",
     "type": "string"
    }
   },
   "required": [
    "url_key",
    "url",
    "outlet",
    "title",
    "published",
    "first_seen"
   ],
   "title": "Lead",
   "type": "object"
  },
  "MeshDescriptor": {
   "additionalProperties": false,
   "description": "A MeSH descriptor as the lab keeps it: its label and its places in the tree.",
   "properties": {
    "descriptor_id": {
     "title": "Descriptor Id",
     "type": "string"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "tree_numbers": {
     "items": {
      "type": "string"
     },
     "title": "Tree Numbers",
     "type": "array"
    }
   },
   "required": [
    "descriptor_id",
    "label",
    "tree_numbers"
   ],
   "title": "MeshDescriptor",
   "type": "object"
  },
  "NameOrigin": {
   "description": "Who gives a name for an intervention.",
   "enum": [
    "substance_registry",
    "rxnorm",
    "mesh_label",
    "mesh_entry_term",
    "registry_intervention",
    "registry_other_name",
    "article",
    "person"
   ],
   "title": "NameOrigin",
   "type": "string"
  },
  "NameRole": {
   "description": "What kind of name it is. A development code or search phrase is never shown as a name.",
   "enum": [
    "preferred",
    "generic",
    "brand",
    "development_code",
    "search_phrase",
    "other"
   ],
   "title": "NameRole",
   "type": "string"
  },
  "OutcomeKind": {
   "description": "Whether an outcome is the trial's primary one, as registered or posted.",
   "enum": [
    "primary",
    "secondary",
    "other",
    "post_hoc"
   ],
   "title": "OutcomeKind",
   "type": "string"
  },
  "OverallStatus": {
   "description": "A trial's recruitment status as ClinicalTrials.gov states it. Shown, never a status.",
   "enum": [
    "not_yet_recruiting",
    "recruiting",
    "enrolling_by_invitation",
    "active_not_recruiting",
    "suspended",
    "terminated",
    "completed",
    "withdrawn",
    "unknown",
    "available",
    "no_longer_available",
    "temporarily_not_available",
    "approved_for_marketing",
    "withheld"
   ],
   "title": "OverallStatus",
   "type": "string"
  },
  "Pair": {
   "additionalProperties": false,
   "description": "A tracked (intervention, condition), derived each run. Never written by a batch.\n\n`key` is `<intervention_id>|<condition_id>`, the row key. `address` is the public one,\n`<intervention slug>--<condition slug>`, kept apart so two pairs with one address are\nboth tracked. `checked_by_person` is true while a person's decision on one of its\ntrials still counts.",
   "properties": {
    "address": {
     "title": "Address",
     "type": "string"
    },
    "checked_by_person": {
     "title": "Checked By Person",
     "type": "boolean"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "key": {
     "title": "Key",
     "type": "string"
    },
    "nct_ids": {
     "items": {
      "type": "string"
     },
     "title": "Nct Ids",
     "type": "array"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "key",
    "address",
    "nct_ids",
    "checked_by_person"
   ],
   "title": "Pair",
   "type": "object"
  },
  "PairFiling": {
   "additionalProperties": false,
   "description": "The one vertical a pair is filed under, and how: `ClaimFiling` keyed on the pair.",
   "properties": {
    "basis": {
     "$ref": "#/$defs/FilingBasis"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "vertical": {
     "title": "Vertical",
     "type": "string"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "vertical",
    "basis"
   ],
   "title": "PairFiling",
   "type": "object"
  },
  "PairOrigin": {
   "additionalProperties": false,
   "description": "What a migrated claim was, for the open-data export. Written once, from the claims.",
   "properties": {
    "claim_slug": {
     "title": "Claim Slug",
     "type": "string"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "created_at": {
     "format": "date-time",
     "title": "Created At",
     "type": "string"
    },
    "drafted_by_run": {
     "title": "Drafted By Run",
     "type": "string"
    },
    "drafted_from": {
     "$ref": "#/$defs/DraftedFrom"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "claim_slug",
    "drafted_from",
    "drafted_by_run",
    "created_at"
   ],
   "title": "PairOrigin",
   "type": "object"
  },
  "PairPage": {
   "additionalProperties": false,
   "description": "The page of one tracked pair: `ClaimPage` keyed on the pair, by its address. Reports,\npromises, statements, cards, failure flags and regulators' decisions come with S10.",
   "properties": {
    "approach": {
     "anyOf": [
      {
       "$ref": "#/$defs/InterventionApproach"
      },
      {
       "type": "null"
      }
     ]
    },
    "checked": {
     "items": {
      "$ref": "#/$defs/RegistryCheck"
     },
     "title": "Checked",
     "type": "array"
    },
    "checked_by_person": {
     "title": "Checked By Person",
     "type": "boolean"
    },
    "history": {
     "items": {
      "$ref": "#/$defs/PairStatusChange"
     },
     "title": "History",
     "type": "array"
    },
    "names": {
     "items": {
      "$ref": "#/$defs/InterventionName"
     },
     "title": "Names",
     "type": "array"
    },
    "row": {
     "$ref": "#/$defs/PairRow"
    },
    "trials": {
     "items": {
      "$ref": "#/$defs/PairTrialRow"
     },
     "title": "Trials",
     "type": "array"
    }
   },
   "required": [
    "row",
    "names",
    "checked_by_person",
    "trials",
    "approach",
    "history",
    "checked"
   ],
   "title": "PairPage",
   "type": "object"
  },
  "PairRow": {
   "additionalProperties": false,
   "description": "A pair as a list shows it: `ClaimRow` keyed on the pair, with what a migrated claim\nwas, for the open-data export.",
   "properties": {
    "condition": {
     "$ref": "#/$defs/Condition"
    },
    "descriptor": {
     "$ref": "#/$defs/MeshDescriptor"
    },
    "filing": {
     "anyOf": [
      {
       "$ref": "#/$defs/PairFiling"
      },
      {
       "type": "null"
      }
     ]
    },
    "first_report": {
     "anyOf": [
      {
       "$ref": "#/$defs/Lead"
      },
      {
       "type": "null"
      }
     ]
    },
    "intervention": {
     "$ref": "#/$defs/Intervention"
    },
    "origin": {
     "anyOf": [
      {
       "$ref": "#/$defs/PairOrigin"
      },
      {
       "type": "null"
      }
     ]
    },
    "pair": {
     "$ref": "#/$defs/Pair"
    },
    "status": {
     "$ref": "#/$defs/PairStatus"
    }
   },
   "required": [
    "pair",
    "intervention",
    "condition",
    "descriptor",
    "status",
    "filing",
    "origin",
    "first_report"
   ],
   "title": "PairRow",
   "type": "object"
  },
  "PairStatus": {
   "additionalProperties": false,
   "description": "A pair's status as of a day, with the events that explain it: `ClaimStatus` keyed on\nthe pair, by the same rules.",
   "properties": {
    "as_of": {
     "format": "date",
     "title": "As Of",
     "type": "string"
    },
    "code": {
     "$ref": "#/$defs/ClaimStatusCode"
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "explained_by": {
     "items": {
      "type": "string"
     },
     "title": "Explained By",
     "type": "array"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "overlay_years": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Overlay Years"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "code",
    "overlay_years",
    "explained_by",
    "as_of"
   ],
   "title": "PairStatus",
   "type": "object"
  },
  "PairStatusChange": {
   "additionalProperties": false,
   "description": "A change of a pair's status between two runs: what a follower is told. The run that\nobserved it is a field of its own, so a change migrated from a claim's keeps its run.",
   "properties": {
    "after": {
     "$ref": "#/$defs/ClaimStatusCode"
    },
    "before": {
     "anyOf": [
      {
       "$ref": "#/$defs/ClaimStatusCode"
      },
      {
       "type": "null"
      }
     ]
    },
    "condition_id": {
     "title": "Condition Id",
     "type": "string"
    },
    "intervention_id": {
     "title": "Intervention Id",
     "type": "string"
    },
    "observed_in_run": {
     "title": "Observed In Run",
     "type": "string"
    },
    "on": {
     "format": "date",
     "title": "On",
     "type": "string"
    }
   },
   "required": [
    "intervention_id",
    "condition_id",
    "before",
    "after",
    "on",
    "observed_in_run"
   ],
   "title": "PairStatusChange",
   "type": "object"
  },
  "PairTrialRow": {
   "additionalProperties": false,
   "description": "One trial of a pair as its page shows it: the experimental arms that add the pair's\nintervention, the one arm when there is exactly one (`claim_arm` in the export), the\ntrial's facts, events, papers and findings.",
   "properties": {
    "arms": {
     "items": {
      "type": "string"
     },
     "title": "Arms",
     "type": "array"
    },
    "claim_arm": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Claim Arm"
    },
    "events": {
     "items": {
      "$ref": "#/$defs/TrialEvent"
     },
     "title": "Events",
     "type": "array"
    },
    "facts": {
     "$ref": "#/$defs/TrialFacts"
    },
    "findings": {
     "anyOf": [
      {
       "$ref": "#/$defs/TrialFindingsRow"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "nct_id": {
     "title": "Nct Id",
     "type": "string"
    },
    "paper_ids": {
     "items": {
      "type": "string"
     },
     "title": "Paper Ids",
     "type": "array"
    }
   },
   "required": [
    "nct_id",
    "arms",
    "claim_arm",
    "facts",
    "events",
    "paper_ids"
   ],
   "title": "PairTrialRow",
   "type": "object"
  },
  "Participants": {
   "additionalProperties": false,
   "description": "How many take part, and whether that is the count enrolled or the count planned.\n\n`actual` is empty when the registry gives the count and not which it is.",
   "properties": {
    "actual": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "title": "Actual"
    },
    "count": {
     "title": "Count",
     "type": "integer"
    }
   },
   "required": [
    "count",
    "actual"
   ],
   "title": "Participants",
   "type": "object"
  },
  "PlannedOutcome": {
   "additionalProperties": false,
   "description": "A primary outcome the record plans to measure.",
   "properties": {
    "measure": {
     "title": "Measure",
     "type": "string"
    },
    "time_frame": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Time Frame"
    }
   },
   "required": [
    "measure",
    "time_frame"
   ],
   "title": "PlannedOutcome",
   "type": "object"
  },
  "PostedComparison": {
   "additionalProperties": false,
   "description": "One comparison the sponsor posted for an outcome, carried as written.",
   "properties": {
    "design": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Design"
    },
    "estimate": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Estimate"
    },
    "estimate_kind": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Estimate Kind"
    },
    "group_ids": {
     "items": {
      "type": "string"
     },
     "title": "Group Ids",
     "type": "array"
    },
    "interval_pct": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Interval Pct"
    },
    "key": {
     "title": "Key",
     "type": "string"
    },
    "kind": {
     "$ref": "#/$defs/ComparisonKind"
    },
    "lower": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Lower"
    },
    "method": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Method"
    },
    "outcome_key": {
     "title": "Outcome Key",
     "type": "string"
    },
    "p_value": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "P Value"
    },
    "upper": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Upper"
    }
   },
   "required": [
    "key",
    "outcome_key",
    "kind",
    "group_ids",
    "design",
    "method",
    "p_value",
    "estimate_kind",
    "estimate",
    "interval_pct",
    "lower",
    "upper"
   ],
   "title": "PostedComparison",
   "type": "object"
  },
  "PostedEvent": {
   "additionalProperties": false,
   "description": "One adverse event in one group, as the record lists it.",
   "properties": {
    "affected": {
