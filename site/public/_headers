# Sent by Cloudflare with every page and file of the site. The embed is made to be
# framed by other sites, so no header here forbids framing.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Files Astro names by their content: a changed file has a new name, so a browser may
# keep these for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
