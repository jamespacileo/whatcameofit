---
// The home page's status and topic choices: two fields in the row of choices above the
// lists. A pick narrows the day-by-day list and the tabbed lists at once. The status
// field says how many claims are at each status, on the path a topic page draws.
import type { ExportedClaim, StatusCode } from "../lib/export";
import ReportFilter from "./ReportFilter.astro";
import { statusCountsByTopic } from "../lib/feed";
import { hasLinkedReport } from "../lib/reports";
import { STAGE_PATH, STATUS_LABELS } from "../lib/status";

interface Props {
  claims: ExportedClaim[];
  topics: { slug: string; title: string; count: number; reported: number }[];
  /** How many claims are at each status, for every topic and, under "", for all. */
  counts: Record<string, Record<string, number>>;
  /** Inside the day-by-day list's panel each field's name is drawn before it. */
  named?: boolean;
}

const { claims, topics, counts, named = false } = Astro.props;
const nameClass = named ? "pick-name" : "visually-hidden";
const all = counts[""] ?? {};
const reported = claims.filter(hasLinkedReport);
const reportCounts = statusCountsByTopic(reported);
const offPath = (Object.keys(all) as StatusCode[]).filter((code) => !STAGE_PATH.includes(code));
const statuses = [...STAGE_PATH, ...offPath];
---

<div class="scoreboard" data-scoreboard>
  {/* Shown by the script: without it there is nothing to pick. */}
  <label class="pick" data-await data-status-filter>
    <span class={nameClass}>Status now</span>
    <select
      id="feed-status"
      data-stage-filter
      data-scope="[data-feed]"
      data-param="status"
      data-counts={JSON.stringify(counts)}
      data-reported-counts={reported.length < claims.length ? JSON.stringify(reportCounts) : undefined}
    >
      <option value="">Any status</option>
      {
        statuses.map((code) => (
          <option value={code} data-label={STATUS_LABELS[code]} disabled={!all[code]}>
            {STATUS_LABELS[code]} ({all[code] ?? 0})
          </option>
        ))
      }
    </select>
  </label>
  {reported.length < claims.length && <ReportFilter id="feed-reported" named={named} />}
  {
    topics.length > 1 && (
      <label class="pick topic-filter" hidden data-topic-filter>
        <span class={nameClass}>Topic</span>
        <select id="feed-topic" data-counts={JSON.stringify(counts)}>
          <option value="">All topics</option>
          {topics.map((topic) => (
            <option value={topic.slug}>
              {topic.title} ({topic.count}, {topic.reported} reported)
            </option>
          ))}
        </select>
      </label>
    )
  }
</div>

<script>
  import { loadRest, onArrive } from "../lib/rest";

  // Picking a status shows only the rows of claims that stand there now. Rows left out
  // are marked "data-out", as a topic page's path marks them; each list then recounts.
  const field = document.querySelector<HTMLSelectElement>("#feed-status");
  if (field) {
    const scope = field.dataset.scope!;
    const report = document.querySelector<HTMLSelectElement>("#feed-reported");
    const claimsReport = document.querySelector<HTMLSelectElement>("#claims-reported");
    const topic = document.querySelector<HTMLSelectElement>("#feed-topic");
    const counts: Record<string, Record<string, number>> = JSON.parse(field.dataset.counts!);
    const reportCounts: Record<string, Record<string, number>> =
      field.dataset.reportedCounts ? JSON.parse(field.dataset.reportedCounts) : counts;
    const tables = [...document.querySelectorAll<HTMLTableElement>(`${scope} table`)];
    const dayList = document.querySelector<HTMLElement>(`${scope} [data-day-list]`);
    // Read at each pick: a list's rows past its first arrive when they are asked for.
    const rows = (): HTMLElement[] => [
      ...tables.flatMap((table) => [...table.querySelectorAll<HTMLElement>("tbody tr[data-status]")]),
      ...(dayList?.querySelectorAll<HTMLElement>("[data-day-row]") ?? []),
    ];
    const options = [...field.options].filter((option) => option.value !== "");

    const mark = (row: HTMLElement) => {
      row.toggleAttribute("data-out", field.value !== "" && row.dataset.status !== field.value);
      row.toggleAttribute("data-out-report", report?.value === "1" && row.hasAttribute("data-no-report"));
    };
    const updateCounts = () => {
      const bucket = (report?.value === "1" ? reportCounts : counts)[topic?.value ?? ""] ?? {};
      for (const option of options) {
        const count = bucket[option.value] ?? 0;
        option.textContent = `${option.dataset.label} (${count})`;
        option.disabled = count === 0 && field.value !== option.value;
      }
    };
    const apply = (remember = true) => {
      if (claimsReport && report) claimsReport.value = report.value;
      // One status of a list is found among all its rows, not its first ones.
      if (field.value !== "" || report?.value === "1") {
        for (const holder of document.querySelectorAll<HTMLElement>(`${scope} [data-rest][data-rest-for="narrowing"]`)) {
          void loadRest(holder);
        }
      }
      for (const row of rows()) mark(row);
      updateCounts();
      for (const table of tables) table.dispatchEvent(new Event("paged:refresh"));
      dayList?.dispatchEvent(new Event("paged:refresh"));
      if (!remember) return;
      const url = new URL(location.href);
      if (field.value) url.searchParams.set(field.dataset.param!, field.value);
      else url.searchParams.delete(field.dataset.param!);
      if (report?.value === "1") url.searchParams.set("reported", "1");
      else if (report) url.searchParams.delete("reported");
      history.replaceState(history.state, "", url);
      dispatchEvent(new Event("report:change"));
    };
    field.addEventListener("change", () => apply());
    report?.addEventListener("change", () => apply());
    claimsReport?.addEventListener("change", () => {
      if (report) report.value = claimsReport.value;
      apply();
    });
    field.addEventListener("stage:counts", updateCounts);
    // Rows that arrive later are narrowed as the rows in the page were.
    onArrive(({ rows: arriving }) => {
      for (const row of arriving.querySelectorAll<HTMLElement>("tr[data-status], [data-day-row]")) {
        mark(row);
      }
    });

    field.closest<HTMLElement>("[data-status-filter]")!.removeAttribute("data-await");
    report?.closest("[data-report-choice]")?.removeAttribute("data-await");
    claimsReport?.closest("[data-report-choice]")?.removeAttribute("data-await");
    const restore = (refresh: boolean) => {
      const query = new URL(location.href).searchParams;
      const asked = query.get(field.dataset.param!);
      field.value = options.some((option) => option.value === asked) ? asked! : "";
      if (report) report.value = query.get("reported") === "1" ? "1" : "";
      if (refresh || field.value || report?.value === "1") apply(false);
      else updateCounts();
    };
    restore(false);
    addEventListener("popstate", () => restore(true));
  }
</script>
