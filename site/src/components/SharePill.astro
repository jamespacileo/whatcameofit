---
// A quiet pill that passes the page on: the device's own share sheet where there is
// one, or the page's address copied where there is not. It appears only when one of
// the two can work, and never on paper.
import Share2 from "@lucide/astro/icons/share-2";
---

<button type="button" class="share" data-share hidden data-pagefind-ignore>
  <Share2 size={16} stroke-width={1.9} aria-hidden="true" />
  <span data-share-text aria-live="polite">Share</span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-share]")) {
    if (!navigator.share && !navigator.clipboard) continue;
    const text = button.querySelector<HTMLElement>("[data-share-text]")!;
    button.hidden = false;
    button.addEventListener("click", async () => {
      const url = location.origin + location.pathname;
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url });
        } else {
          await navigator.clipboard.writeText(url);
          // Confirmed as a copy is elsewhere: the label changes and the dot lands.
          text.textContent = "Link copied";
          button.classList.add("done");
          setTimeout(() => {
            text.textContent = "Share";
            button.classList.remove("done");
          }, 2000);
        }
      } catch {
        // The reader closed the share sheet, or copying was refused: nothing to do.
      }
    });
  }
</script>
