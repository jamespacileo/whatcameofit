---
// Where a status sits on the path from laboratory to approval: six places, one marked. The
// shared block (lib/blocks.ts, stageTrack), as the styleguide draws it.
import { stageTrack } from "../lib/blocks";
import type { StatusCode } from "../lib/status";

interface Props {
  code: StatusCode;
  ends?: boolean;
  /** Each place named under its dot, as in a panel that has room to say them. */
  named?: boolean;
  /** For a status off the path: draw a square, no path, beside the words. */
  off?: boolean;
}

const { code, ends = false, named = false, off = false } = Astro.props;
---

<Fragment set:html={stageTrack(code, { ends, named, off })} />
