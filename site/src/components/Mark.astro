---
// The reverse mark, drawn into the page so that its two parts can move: on the first
// page of a visit the glass is lowered onto the capsule, and when the name is hovered
// the capsule is seen closer. The drawing is public/mark-reverse.svg, which
// scripts/brand-icons.mjs makes from public/mark.svg; a site test holds the two together.
---

<svg class="mark" viewBox="8 8 48 48" width="32" height="32" aria-hidden="true">
  <path class="glass" fill="#ffffff" fill-rule="evenodd" d="M42.38 49.02A22 22 0 1 1 49.02 42.38A1.2 1.2 0 0 0 49.18 43.88L54.36 49.06A3.75 3.75 0 0 1 49.06 54.36L43.88 49.18A1.2 1.2 0 0 0 42.38 49.02ZM47 30.5A16.5 16.5 0 1 0 14 30.5A16.5 16.5 0 1 0 47 30.5Z"></path>
  <g class="capsule">
    <path d="M29.7 23.75h-6.2a6.75 6.75 0 0 0 0 13.5h6.2z" fill="#f28a62"></path>
    <path d="M31.3 23.75h6.2a6.75 6.75 0 0 1 0 13.5h-6.2z" fill="#1687da"></path>
  </g>
</svg>
