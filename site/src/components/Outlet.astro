---
// Names where a web article comes from: the outlet's own icon, its name and its
// short domain. The icon was fetched by the pipeline and is served by this site;
// an outlet without one gets a drawn letter tile. A page asks the network for
// nothing but the links a reader follows.
import { outletDomain, outletIconPath } from "../lib/outlets";

interface Props {
  url: string;
  outlet: string;
  link?: boolean;
}

const { url, outlet, link = true } = Astro.props;
const domain = outletDomain(url);
const icon = outletIconPath(domain);
// An article recorded without its outlet's name is still named: by its domain.
const name = outlet.trim() || domain || "Source";
const letter = (domain || name).charAt(0).toUpperCase();
---

<span class="outlet">
  <span class="outlet-name">
    <span class="outlet-icon" aria-hidden="true">
      <span class="tile">{letter}</span>
      {icon && (
      <img class="tile" src={icon} alt="" width="17" height="17" loading="lazy" decoding="async" />
      )}
    </span>
    {link ? <a href={url}>{name}</a> : <span>{name}</span>}
  </span>
  {domain && domain !== name && <span class="domain">{domain}</span>}
</span>

<script>
  // A failed image leaves the same-sized letter tile, never a broken-image glyph.
  for (const icon of document.querySelectorAll<HTMLImageElement>(".outlet-icon img")) {
    const fallback = () => icon.remove();
    icon.addEventListener("error", fallback, { once: true });
    if (icon.complete && !icon.naturalWidth) fallback();
  }
</script>
