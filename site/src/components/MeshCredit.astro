---
// The credit NLM's terms ask for wherever a MeSH category is shown, as the Worker writes it on
// a category page made on request (lib/blocks.ts, meshCredit). The bundle does not yet say which
// year's MeSH the lab read, so the credit names no year until it does.
import { meshCredit } from "../lib/blocks";
import { meshEdition } from "../lib/clinical";
import { pairBundle } from "../lib/pairs";

const years: string[] = pairBundle().manifest.snapshot?.mesh_years ?? [];
---

<Fragment set:html={meshCredit(meshEdition(years))} />
