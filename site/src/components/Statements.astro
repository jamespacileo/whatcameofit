---
// Reported statements: what each news report said about the treatment, in the site's
// own words, framed as the report's and grouped under the report. Openspec
// site-publishing: "Reported statements on the claim page". Between the summary and
// the records, and never compared with a record.
// Under its report a statement stands in a group: by who said it, or by what kind of
// statement it is, as the reader chooses (scripts/folds.ts; with no script, by who).
// A row is the statement with a mark for how firmly it was put. It opens to what the
// report gave as its basis; how sure the reading is stands a press further in, and in
// sight on the row only when the check is less than very sure. Chosen by the operator
// from .impeccable/mocks/sections-rebuild/ on 2026-11-17 (variant B, with A's order as
// a choice).
import Activity from "@lucide/astro/icons/activity";
import Building from "@lucide/astro/icons/building";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Cog from "@lucide/astro/icons/cog";
import ExternalLink from "@lucide/astro/icons/external-link";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import Microscope from "@lucide/astro/icons/microscope";
import Scale from "@lucide/astro/icons/scale";
import Shield from "@lucide/astro/icons/shield";
import Telescope from "@lucide/astro/icons/telescope";
import User from "@lucide/astro/icons/user";
import Users from "@lucide/astro/icons/users";
import Entry from "./Entry.astro";
import FoldHead from "./FoldHead.astro";
import Outlet from "./Outlet.astro";
import Score from "./Score.astro";
import type { ExportedClaim } from "../lib/export";
import {
  BASIS_WORDS,
  FIRMNESS_KEY,
  KIND_WORDS,
  SURE_READING,
  attributionText,
  confidenceMeaning,
  speakerText,
  statementConfidenceLabel,
  statementsHeading,
  statementsNote,
  type ExportedStatement,
} from "../lib/statements";
import { formatDate } from "../lib/timetable";

interface Props {
  statements: ExportedStatement[];
  articles: ExportedClaim["articles"];
}

const { statements, articles } = Astro.props;
// Report by report, in the order the claim lists its reports; a report with no
// approved statement is not listed.
const groups = articles
  .map((article) => ({
    article,
    statements: statements.filter((statement) => statement.article_url === article.url),
  }))
  .filter((group) => group.statements.length > 0);

// One drawing per kind of statement and per kind of speaker. A report's own statements
// carry its outlet's icon instead.
const KIND_ICONS: Record<string, typeof Activity> = {
  effect: Activity,
  safety: Shield,
  how_it_works: Cog,
  who_it_could_help: Users,
  comparison: Scale,
  what_it_could_lead_to: Telescope,
};
const SPEAKER_ICONS: Record<string, typeof Activity> = {
  researcher: Microscope,
  company: Building,
  patient: User,
  other_expert: GraduationCap,
};
const VIEWS = ["who", "kind"] as const;
type View = (typeof VIEWS)[number];
const nameOf = (view: View, statement: ExportedStatement) => (view === "who" ? statement.speaker : statement.kind);
// A statement's groups under one report: in the order their first statement stands.
const arranged = (view: View, list: ExportedStatement[]) =>
  [...new Set(list.map((statement) => nameOf(view, statement)))].map((name) => ({
    name,
    statements: list.filter((statement) => nameOf(view, statement) === name),
  }));
// The choice of order is offered only where it changes something.
const choice =
  statements.length > 2 &&
  new Set(statements.map((statement) => statement.speaker)).size > 1 &&
  new Set(statements.map((statement) => statement.kind)).size > 1;
// A figure in a statement is set in bold, so the eye finds it.
const figures = (text: string) => text.split(/(\d+(?:[.,]\d+)*%?)/);
let serial = 0;
---

<section class="matched statements" data-pagefind-ignore>
  <FoldHead id="reported-statements" phone="folded">{statementsHeading(groups.length)}</FoldHead>
  <p class="take-why">
    {statementsNote(groups.length)} <a href="/how-it-works#what-a-report-said">How statements are found</a>
  </p>
  <div class="said-tools">
    {/* What the mark before a statement says, once. */}
    <p class="said-key">
      <span><span class="firm-mark" aria-hidden="true" />{FIRMNESS_KEY.fact}</span>
      <span><span class="firm-mark maybe" aria-hidden="true" />{FIRMNESS_KEY.possibility}</span>
    </p>
    {
      choice && (
        // Shown by the script: with none, the statements stand by who said them.
        <div class="kind-tabs said-order" role="group" aria-label="Arrange the statements" hidden data-said-order>
          <button type="button" class="kind-tab" data-said-view="who" aria-pressed="true">By who said it</button>
          <button type="button" class="kind-tab" data-said-view="kind" aria-pressed="false">By kind</button>
        </div>
      )
    }
  </div>
  {
    groups.map((group) => (
      <>
        <h3 class="matched-group statement-report">
          <a class="statement-source" href={group.article.url} rel="noopener">
            “{group.article.title}”
            <ExternalLink class="out" size={14} stroke-width={1.9} aria-hidden="true" />
          </a>
          <span class="entry-note">
            <Outlet url={group.article.url} outlet={group.article.outlet} link={false} />{" "}
            <span class="unbroken">{formatDate(group.article.published_date)}</span>
          </span>
        </h3>
        {VIEWS.filter((view) => view === "who" || choice).map((view) => (
          <div class="said-view" data-said-body={view} hidden={view === "kind"}>
            {arranged(view, group.statements).map(({ name, statements: list }) => {
              const GroupIcon = view === "who" ? SPEAKER_ICONS[name] : KIND_ICONS[name];
              return (
                <div class="said-group">
                  <h4 class="said-by">
                    {view === "who" && name === "article" ? (
                      <Outlet url={group.article.url} outlet={group.article.outlet} link={false} />
                    ) : (
                      <span class="said-name">
                        {GroupIcon && <GroupIcon size={16} stroke-width={1.7} aria-hidden="true" />}
                        {view === "who" ? speakerText(name) : KIND_WORDS[name]}
                      </span>
                    )}
                    {view === "who" && name === "article" && <small>{speakerText(name)}</small>}
                  </h4>
                  <ul class="plain entry-rows statement-rows">
                    {list.map((statement) => {
                      const TagIcon = view === "who" ? KIND_ICONS[statement.kind] : SPEAKER_ICONS[statement.speaker];
                      const sure = statement.confidence >= SURE_READING;
                      return (
                        <Entry
                          id={`statement-${view}-${++serial}`}
                          name="this statement"
                          opens="What it rests on and how sure the reading is"
                        >
                          <span class="said-tag">
                            {TagIcon && <TagIcon size={15} stroke-width={1.8} aria-hidden="true" />}
                            {view === "who" ? KIND_WORDS[statement.kind] : speakerText(statement.speaker)}
                          </span>
                          <p class="statement">
                            <span class:list={["firm-mark", { maybe: statement.firmness !== "fact" }]} aria-hidden="true" />
                            <span class="statement-text">
                              <span class="visually-hidden statement-said">{attributionText(statement)}</span>{" "}
                              {figures(statement.text).map((part, index) => (index % 2 === 1 ? <b>{part}</b> : part))}
                            </span>
                          </p>
                          <Fragment slot="ties">
                            {!sure && (
                              <Score words={statementConfidenceLabel(statement.confidence)}>
                                <span>{confidenceMeaning(formatDate(statement.read_on))}</span>
                              </Score>
                            )}
                          </Fragment>
                          <div slot="more" class="said-more">
                            <p>{BASIS_WORDS[statement.basis]}</p>
                            <details class="match-why">
                              <summary class="match-why-head">
                                How sure this reading is
                                <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                              </summary>
                              <p class="match-score">
                                <Score words={statementConfidenceLabel(statement.confidence)}>
                                  <span>{confidenceMeaning(formatDate(statement.read_on))}</span>
                                </Score>
                              </p>
                              <p>{confidenceMeaning(formatDate(statement.read_on))}</p>
                            </details>
                          </div>
                        </Entry>
                      );
                    })}
                  </ul>
                </div>
              );
            })}
          </div>
        ))}
      </>
    ))
  }
</section>
