---
// One control that opens every field that narrows a list. The fields are the page's own
// (labels of class "pick", each holding a native field whose first choice narrows
// nothing), given in the slot. While a field narrows the list the control says so in that
// field's own words, so a narrowed list is never unexplained, and the panel offers to
// clear them all. The control is the script's: without it there is nothing to pick.
import ChevronDown from "@lucide/astro/icons/chevron-down";
import SlidersHorizontal from "@lucide/astro/icons/sliders-horizontal";

interface Props {
  id: string;
  /** What the group of choices is for, read aloud. */
  group: string;
  /** What the control says while nothing narrows the list. */
  label?: string;
}

const { id, group, label = "Filter" } = Astro.props;
---

<div class="filter-menu" role="group" aria-label={group} data-filter-menu data-label={label}>
  {/* Opened by a press only: a field's own list opens outside the panel, where a
      pointer leaving would otherwise close it. */}
  <button
    type="button"
    class="share filter-open"
    hidden
    data-filter-open
    data-press-only
    popovertarget={id}
    aria-expanded="false"
    style={`anchor-name: --${id}`}
  >
    <SlidersHorizontal size={16} aria-hidden="true" />
    <span data-filter-says>{label}</span>
    <ChevronDown class="opens" size={16} aria-hidden="true" />
  </button>
  <div popover id={id} class="pop filter-panel" style={`position-anchor: --${id}`} data-filter-panel>
    <slot />
    <button type="button" class="text-control filter-clear" hidden data-filter-clear>Clear filters</button>
  </div>
</div>

<script>
  for (const menu of document.querySelectorAll<HTMLElement>("[data-filter-menu]")) {
    const open = menu.querySelector<HTMLButtonElement>("[data-filter-open]")!;
    const says = open.querySelector<HTMLElement>("[data-filter-says]")!;
    const panel = menu.querySelector<HTMLElement>("[data-filter-panel]")!;
    const clear = panel.querySelector<HTMLButtonElement>("[data-filter-clear]")!;
    const fields = [...panel.querySelectorAll<HTMLSelectElement>("select")];

    const say = () => {
      const picks = fields
        .filter((field) => field.selectedIndex > 0)
        .map((field) => {
          const option = field.selectedOptions[0];
          // A choice is named without its count.
          return option.dataset.label ?? option.textContent!.replace(/\s*\(\d+\)\s*$/, "").trim();
        });
      const said = picks.join(" · ");
      says.textContent = said || menu.dataset.label!;
      if (said) open.setAttribute("aria-label", `${menu.dataset.label}: ${said}`);
      else open.removeAttribute("aria-label");
      open.toggleAttribute("data-narrowed", picks.length > 0);
      clear.hidden = picks.length === 0;
    };

    for (const field of fields) field.addEventListener("change", say);
    // A page that sets a field itself says so here.
    menu.addEventListener("filter:say", say);
    clear.addEventListener("click", () => {
      for (const field of fields) {
        if (field.selectedIndex === 0) continue;
        field.selectedIndex = 0;
        field.dispatchEvent(new Event("change"));
      }
      open.focus();
    });
    panel.addEventListener("toggle", () => {
      open.setAttribute("aria-expanded", String(panel.matches(":popover-open")));
    });
    open.hidden = false;
    say();
  }
</script>
