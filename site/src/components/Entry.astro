---
// One row of an entry list (`<ul class="plain entry-rows">`): the one grammar for a list
// of things on a record page, such as papers and organisations.
//
//   <Entry id="paper-1" name="The paper's title" opens="Ties and index record">
//     <a class="entry-name" href="…">The paper's title</a>
//     <span class="entry-note">Randomised trial · A journal · 2014</span>
//     <Fragment slot="ties"><span class="tie">…</span></Fragment>
//     <Fragment slot="more">…</Fragment>
//   </Entry>
//
// Slots:
//   default  what the thing is, at the left edge: its name (`.entry-name`) and at most
//            one grey line under it (`.entry-note`);
//   ties     how it is tied to this claim, from the sheet's second stop: one line of
//            marks and short words (`.tie`), and any score, which stays in sight;
//   more     what the row opens to: where it came from, when it was read, and the
//            sentences the marks stand for. `.entry-more-lead` lies under the name,
//            `.entry-more-ties` under the ties.
//
// A row with a filled "more" slot opens, by the same press as a fact row
// (components/Fact.astro): the round fold mark at the end of its line and the whole of
// its head, links and scores excepted. With no script, and on paper, it is simply open.
import ChevronDown from "@lucide/astro/icons/chevron-down";

interface Props {
  /** The row's address. Needed by a row that opens. */
  id?: string;
  /** The thing's name, read out with `opens`. */
  name: string;
  /** What the row opens to, in a few words that are read out, not drawn. */
  opens?: string;
  class?: string;
}

const { id, name, opens, class: className } = Astro.props;
const filled = async (slot: string) =>
  Astro.slots.has(slot) ? (await Astro.slots.render(slot)).trim() : "";
const ties = await filled("ties");
const more = opens ? await filled("more") : "";
if (more && !id) throw new Error(`The entry “${name}” opens, so it needs an id.`);
---

<li id={id} class={className}>
  <div class="entry-lead"><slot /></div>
  {ties && <div class="entry-ties"><Fragment set:html={ties} /></div>}
  {
    more && (
      <button type="button" class="fact-open" aria-expanded="true" aria-controls={`${id}-more`}>
        <span class="fact-open-words">{opens}</span>
        <span class="visually-hidden"> for {name}.</span>
        <span class="chev" aria-hidden="true">
          <ChevronDown size={16} stroke-width={2} />
        </span>
      </button>
    )
  }
  {
    more && (
      <div class="entry-more" id={`${id}-more`}>
        <Fragment set:html={more} />
      </div>
    )
  }
</li>
