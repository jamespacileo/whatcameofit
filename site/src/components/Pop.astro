---
// A trigger and the small panel it opens. Built on the browser's own popover, so a
// tap, a key press and Escape work with no script; a pointer also opens it on hover.
// On paper the panel is printed in place.
interface Props {
  id: string;
  label?: string;
  class?: string;
  /** A panel that may stand inside a paragraph: a span, holding spans. */
  inline?: boolean;
  /** A panel that holds links gets a control that closes it, for a reader who cannot
      press Escape or reach outside the panel. Only where a script-free press works. */
  close?: boolean;
}

const { id, label, class: className, inline = false, close = false } = Astro.props;
const Panel = inline ? "span" : "div";
---

<button
  type="button"
  class:list={["pop-trigger", className]}
  popovertarget={id}
  aria-label={label}
  style={`anchor-name: --${id}`}><slot name="trigger" /></button
>
<Panel popover id={id} class:list={["pop", { closes: close }]} role="note" style={`position-anchor: --${id}`}>
  <slot />
  {
    close && (
      <button type="button" class="pop-close" popovertarget={id} popovertargetaction="hide">
        Close
      </button>
    )
  }
</Panel>

<script>
  // Say whether a panel is open on the button that opens it, for a screen reader
  // whose browser does not report it for a popover on its own.
  document.addEventListener(
    "toggle",
    (event) => {
      const panel = event.target;
      if (!(panel instanceof HTMLElement) || !panel.matches(".pop")) return;
      const trigger = document.querySelector(`[popovertarget="${panel.id}"]`);
      trigger?.setAttribute("aria-expanded", String(panel.matches(":popover-open")));
    },
    true,
  );
</script>
