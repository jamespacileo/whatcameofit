---
// A registry record in the day-by-day list (openspec latest-rows, home-then-now): the
// row is the record. Over it, where a report row names its outlet: the mark of what
// happened, "Registry record" and the record at its source. Then what was recorded,
// in the text face, with the trial's phase; then the claim. The claim's newest report
// hangs under these, smaller, on a hairline at its left: what the record belongs to,
// not what the row is. The claim's status now is the panel on the right, named so,
// since a record and a status side by side are easily read as one.
import { recordKey, type RecordRow } from "../lib/day-list";
import { confidenceLabel } from "../lib/confidence";
import { followedReports } from "../lib/reports";
import { sourceName } from "../lib/status";
import { formatDate } from "../lib/timetable";
import { recordedText } from "../lib/trial-facts";
import EventMark from "./EventMark.astro";
import Outlet from "./Outlet.astro";
import Quoted from "./Quoted.astro";
import RowStanding from "./RowStanding.astro";

interface Props {
  row: RecordRow;
  topic: string;
  /** The record is already drawn in the row before: this row is another claim it
   * belongs to, drawn as one short line. The list's script decides this again when a
   * choice leaves rows out. */
  follows?: boolean;
  /** The first of the rows that follow: it carries the one label over them all. */
  first?: boolean;
}

const { row, topic, follows = false, first = false } = Astro.props;
const { claim, event, change } = row;
const [report] = followedReports(claim);
const confidence = event.confidence ?? 1;
// What was recorded, said of the record, never in a status's words: "Phase 3 trial
// registered", "Trial results posted", "Follow-up paper".
const label = recordedText(event);
// A trial's record is named by its identifier; any other by where it is kept.
const sourceText = event.trial_id ?? sourceName(event.source_name);
// Years between the claim's first report and this record, said only when it is one or more.
const firstYear = claim.first_reported_date?.slice(0, 4);
const years = firstYear ? Number(row.date.slice(0, 4)) - Number(firstYear) : 0;
const moreId = `more-${claim.slug}-${row.date}-${event.id}`;
---

<li
  class="day-row record-row"
  data-day-row
  data-kind="record"
  data-status={claim.status.code}
  data-topic={claim.vertical}
  data-on={row.date}
  data-record={recordKey(row)}
  data-follows={follows ? (first ? "first" : "") : undefined}
>
  <div class="row-main">
    <p class="row-source">
      <span class="row-kind"><EventMark event={event} />Registry record<span class="visually-hidden">. </span></span>
      <a class="row-record" href={event.source_url}>{sourceText}</a>
      <span class="when">{formatDate(row.date)}</span>
      {topic && <span class="row-topic">{topic}</span>}
      {!report && years > 0 && <span class="row-age">First reported {years} {years === 1 ? "year" : "years"} ago</span>}
    </p>
    {/* Over the rows that follow a record, once: what they are. A row that follows names
        its treatment; the record's own words are then for a screen reader only. */}
    <p class="row-also-label">The same record, for other claims</p>
    <h4 class="row-title">
      <a href={`/${claim.slug}`}>
        <span class="row-what">{label}</span><span class="visually-hidden">: </span><span class="row-whom">{claim.intervention.name}</span>
      </a>
    </h4>
    <p class="row-claim">
      <span class="row-intervention">{claim.intervention.name}</span><span class="row-claim-sep"> · </span>{claim.indication}
    </p>
    {/* A record with no trial behind it (a regulator's decision, a paper) is given in its own words. */}
    {!event.trial_id && <p class="row-detail">{event.summary}</p>}
    {confidence < 1 && <p class="row-detail">{confidenceLabel(confidence)}</p>}
    {
      report && (
        <div class="row-about">
          <p class="row-about-source">
            <span class="row-about-label">Newest report</span>
            <Outlet url={report.url} outlet={report.outlet} link={false} />
            <span class="when">{formatDate(report.published_date)}</span>
            {years > 0 && <span class="row-age">First reported {years} {years === 1 ? "year" : "years"} ago</span>}
          </p>
          <p class="row-about-title"><Quoted>{report.title}</Quoted></p>
        </div>
      )
    }
  </div>
  <RowStanding claim={claim} date={row.date} id={moreId} change={change} />
</li>
