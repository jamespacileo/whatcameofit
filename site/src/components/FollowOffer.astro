---
// Follow, with what it does said beside it. The pill at the top of a claim page is one
// word; here the reader is told, in sight, what following is and where the list is kept,
// and once they follow, where to find it. Shown by the claim page's script, where the
// browser lets the page keep a list.
import Bookmark from "@lucide/astro/icons/bookmark";
import type { ExportedClaim } from "../lib/export";
import { STATUS_LABELS } from "../lib/status";

interface Props {
  claim: ExportedClaim;
}

const { claim } = Astro.props;
---

<div class="follow-offer" hidden data-follow-offer data-pagefind-ignore>
  <button
    type="button"
    class="share"
    data-follow
    data-slug={claim.slug}
    data-headline={claim.headline}
    data-status={STATUS_LABELS[claim.status.code]}
    aria-pressed="false"
  >
    <Bookmark size={16} stroke-width={1.9} aria-hidden="true" />
    <span data-follow-text>Follow</span>
  </button>
  <p class="entry-note">
    <span data-follow-when="off">
      Lists this claim on the home page, with a note when its status changes. Kept in this
      browser only: no account, nothing sent.
    </span>
    <span data-follow-when="on" hidden>
      You follow this claim. It is listed on <a href="/#following">the home page</a>, with a
      note when its status changes. Kept in this browser only.
    </span>
  </p>
</div>
