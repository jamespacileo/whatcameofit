---
// The home page's day-by-day list (openspec home-day-by-day): everything dated for the
// published claims, newest first, under dated headings. The page is dated by the day
// the registries were last checked. Every row is in the page as built; the script only
// hides, counts and marks.
import type { DayList } from "../lib/day-list";
import { countKinds, countsText, dayName, earlierText, headingTitle, toComeText } from "../lib/day-list";
import { formatDate } from "../lib/timetable";
import Info from "@lucide/astro/icons/info";
import DayPromise from "./DayPromise.astro";
import DayRecord from "./DayRecord.astro";
import DayReport from "./DayReport.astro";
import FilterMenu from "./FilterMenu.astro";
import Pop from "./Pop.astro";

interface Props {
  list: DayList;
  /** Every listed topic, for a row's topic name and the side column's choice. */
  topics: { slug: string; title: string; count: number }[];
}

const { list, topics } = Astro.props;
const topicTitle = new Map(topics.map((topic) => [topic.slug, topic.title]));
const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const weekday = (day: string) => WEEKDAYS[new Date(`${day}T00:00:00Z`).getUTCDay()];
const rows = list.headings.flatMap((heading) => heading.rows);
const totals = countKinds(rows.concat(list.toCome));
const KINDS = [
  { kind: "report", name: "News reports" },
  { kind: "record", name: "Registry records" },
  { kind: "promise", name: "Promised dates" },
] as const;
// The spans a reader can keep to, each counted back from the day of the last check.
const SPANS = [
  { span: "week", name: "Past week" },
  { span: "month", name: "Past month" },
  { span: "year", name: "Past year" },
  { span: "all", name: "All time" },
] as const;
const earlier = list.headings.filter((heading) => heading.span !== "day");
// "Saturday 14 November", in its parts.
const [checkedWeekday, checkedNumber, checkedMonth] = dayName(list.checked).split(" ");
const checkedDay = { weekday: checkedWeekday, day: checkedNumber, month: checkedMonth };
---

<section class="days" aria-labelledby="days-title" data-days data-checked={list.checked}>
  <div class="days-body">
    {/* Beside the list on a wide screen, on the pale ground so the list keeps the page:
        where the reader left off, one topic to narrow to, and the other ways in. The
        note and the topics are the script's; the links are the page's own. */}
    <aside class="days-side" aria-label="Topics and other lists" data-days-side>
      <p class="visit-note" hidden data-visit-note></p>
      {
        topics.length > 1 && (
          <div class="side-group" hidden data-side-topics>
            <h3>Topics</h3>
            <ul>
              <li>
                <button type="button" class="side-pick" aria-pressed="true" data-topic-pick="">
                  All topics <span class="kind-count">{topics.reduce((sum, topic) => sum + topic.count, 0)}</span>
                </button>
              </li>
              {topics.map((topic) => (
                <li>
                  <button type="button" class="side-pick" aria-pressed="false" data-topic-pick={topic.slug}>
                    {topic.title} <span class="kind-count">{topic.count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {/* A search's matches counted by topic, each narrowing them: the lookup's. */}
      <div class="side-group" hidden data-search-topics>
        <h3>Results by topic</h3>
        <ul></ul>
      </div>
      <slot name="browse" />
    </aside>

    <div class="days-main">
      {/* Where a search typed in the box above answers, in place of the list while the
          answer stands. The lookup fills it; without scripting it is never shown. */}
      <div class="search-answer" hidden data-search-answer></div>
      {/* The head, on one line: what the list is, a mark that says what the column at
          each row's right is, the day the list is dated by, and the one control that
          narrows it. The kind and the span are the script's: without it there is nothing
          to pick. */}
      <div class="days-head">
        <h2 class="days-title" id="days-title">Latest</h2>
        <Pop id="days-key" label="About this list" class="info">
          <Info slot="trigger" size={17} stroke-width={1.9} aria-hidden="true" />
          <p class="list-key">With each report and record: where its claim stands on record now. Press it for why.</p>
        </Pop>
        <p class="checked-on">
          Registries last checked{" "}
          {/* The head has the short date. Read without its styles it is the long date, once. */}
          <span class="unbroken">
            <span class="on-wide">{checkedDay.weekday} </span>{checkedDay.day} {checkedDay.month.slice(0, 3)}<span class="on-wide">{checkedDay.month.slice(3)}</span> {list.checked.slice(0, 4)}
          </span>
        </p>
        <FilterMenu id="days-filter" group="Narrow this list">
          <label class="pick" hidden data-kinds>
            <span class="pick-name">Show</span>
            <select id="feed-kind">
              <option value="all">Everything</option>
              {
                KINDS.filter(({ kind }) => totals[kind] > 0).map(({ kind, name }) => (
                  <option value={kind}>{name}</option>
                ))
              }
            </select>
          </label>
          <label class="pick" hidden data-spans>
            <span class="pick-name">Dated in</span>
            <select id="feed-span">
              {SPANS.map(({ span, name }) => <option value={span}>{name}</option>)}
            </select>
          </label>
          <slot name="narrow" />
        </FilterMenu>
      </div>


      <div class="day-list" data-day-list>
        {
          list.toCome.length > 0 && (
            <details class="to-come" data-to-come>
              <summary>
                <strong>Ahead.</strong> <span data-to-come-count>{toComeText(list.toCome.length)}</span>{" "}
                Next: <span data-to-come-next>{formatDate(list.toCome[0].date)}</span>.{" "}
                <span class="text-control">Show them</span>
              </summary>
              <p class="entry-note">
                A promise is what a report said, not a record. Each is listed by the date it was promised for.
              </p>
              <ol>
                {list.toCome.map((row) => <DayPromise row={row} />)}
              </ol>
            </details>
          )
        }
        {
          list.headings.map((heading) => (
            <section
              class="day-group"
              id={heading.id}
              data-group
              data-span={heading.span}
              data-date={heading.date}
              data-earlier={heading.span === "day" ? undefined : ""}
            >
              <div class="day-head">
                <h3 data-group-title>{headingTitle(heading)}</h3>
                <span data-says>{countsText(countKinds(heading.rows))}</span>
                <span class="day-col">Status now</span>
              </div>
              <ol>
                {heading.rows.map((row) =>
                  row.kind === "report" ? (
                    <DayReport row={row} topic={topicTitle.get(row.claim.vertical) ?? ""} />
                  ) : row.kind === "record" ? (
                    <DayRecord row={row} topic={topicTitle.get(row.claim.vertical) ?? ""} />
                  ) : (
                    <DayPromise row={row} />
                  ),
                )}
              </ol>
            </section>
          ))
        }
        <p class="none" hidden data-days-none>Nothing in this list for that choice.</p>
        {/* Where a span ends: what it held, and the next span one press away. */}
        <p class="earlier" hidden data-span-end>
          <span class="entry-note" data-span-said></span>
          <button type="button" class="share" data-span-wider></button>
        </p>
        {
          earlier.length > 0 && (
            <p class="earlier" hidden data-earlier-control>
              <button type="button" class="share">Show earlier</button>
              <span class="entry-note" data-earlier-left>
                {earlierText(earlier.reduce((sum, heading) => sum + heading.rows.length, 0))}
              </span>
            </p>
          )
        }
        {/* One claim from an earlier year, under the list: the same for every reader
            that day. It is not dated by the list, so no span leaves it out. */}
        {
          list.older && (
            <section class="older" aria-labelledby="older-title" data-older>
              <div class="day-head">
                <h3 id="older-title">From an earlier year</h3>
                <span data-picked-note>One older claim, picked by the date.</span>
                <span class="day-col">Status now</span>
              </div>
              <ol>
                <DayReport row={list.older} topic={topicTitle.get(list.older.claim.vertical) ?? ""} picked />
              </ol>
            </section>
          )
        }
      </div>
    </div>
    <slot name="rail" />
  </div>
</section>

<script>
  import { countKinds, countsText, earlierText, toComeText, type RowKind } from "../lib/day-list";
  import { VISIT_ENTRY, lastVisitIndex, nextVisit, sinceOf } from "../lib/returning";
  import { formatDate } from "../lib/timetable";

  const root = document.querySelector<HTMLElement>("[data-days]");
  if (root) {
    const list = root.querySelector<HTMLElement>("[data-day-list]")!;
    const groups = [...list.querySelectorAll<HTMLElement>("[data-group]")];
    const toCome = list.querySelector<HTMLDetailsElement>("[data-to-come]");
    const control = list.querySelector<HTMLElement>("[data-earlier-control]");
    const none = list.querySelector<HTMLElement>("[data-days-none]")!;
    const sideTopics = root.querySelector<HTMLElement>("[data-side-topics]");
    const spanEnd = list.querySelector<HTMLElement>("[data-span-end]")!;
    const spanSaid = spanEnd.querySelector<HTMLElement>("[data-span-said]")!;
    const spanWider = spanEnd.querySelector<HTMLButtonElement>("[data-span-wider]")!;
    const visitNote = root.querySelector<HTMLElement>("[data-visit-note]");
    const allRows = [...list.querySelectorAll<HTMLElement>("[data-day-row]")];
    const rowsIn = (element: Element) => [...element.querySelectorAll<HTMLElement>("[data-day-row]")];
    // Each filter marks the rows it leaves out, as on the tables further down the page.
    const out = (row: Element) => row.getAttributeNames().some((name) => name.startsWith("data-out"));

    // The control over the list is its own (FilterMenu); it is told when a field is set here.
    const filterMenu = root.querySelector<HTMLElement>("[data-filter-menu]");
    const kindsOf = (rows: HTMLElement[]) => countKinds(rows.map((row) => ({ kind: row.dataset.kind as RowKind })));
    // The older claim under the list is not dated by it.
    const picked = list.querySelector<HTMLElement>("[data-picked]");
    const older = list.querySelector<HTMLElement>("[data-older]");
    const isPicked = (row: HTMLElement) => row === picked;

    const two = (value: number) => String(value).padStart(2, "0");
    const iso = (date: Date) => `${date.getFullYear()}-${two(date.getMonth() + 1)}-${two(date.getDate())}`;
    const now = new Date();
    const today = iso(now);
    const yesterday = iso(new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1));

    // "Today" and "Yesterday" are said only when they are so on the reader's own date.
    for (const group of groups) {
      if (group.dataset.span !== "day") continue;
      const word = group.dataset.date === today ? "Today" : group.dataset.date === yesterday ? "Yesterday" : null;
      const title = group.querySelector<HTMLElement>("[data-group-title]")!;
      if (word) title.textContent = `${word}, ${title.textContent}`;
    }

    // The reader's last visit, as the since line further down reads it. Kept in this
    // browser only; where storage is refused there is no line.
    const since = (() => {
      try {
        return sinceOf(nextVisit(localStorage.getItem(VISIT_ENTRY), today), today);
      } catch {
        return null;
      }
    })();
    const line = document.createElement("p");
    line.className = "last-visit";
    line.id = "last-visit";
    // Set further down, once the list can be opened as far as a heading.
    let toLastVisit = () => {};
    const drawLastVisit = () => {
      line.remove();
      if (visitNote) visitNote.hidden = true;
      if (!since) return;
      const dated = groups.flatMap((group) => rowsIn(group).filter((row) => !out(row)));
      const index = lastVisitIndex(dated.map((row) => row.dataset.on!), since, today);
      if (index === null) return;
      const day = formatDate(since.from);
      line.textContent = `Your last visit, ${day}. Everything above is dated from that day on.`;
      const row = dated[index];
      const group = row.closest<HTMLElement>("[data-group]")!;
      // Between two headings where the visit falls between them; else inside the one.
      if (rowsIn(group).filter((entry) => !out(entry))[0] === row) group.before(line);
      else {
        const item = document.createElement("li");
        item.className = "last-visit-item";
        item.append(line);
        row.before(item);
      }
      if (visitNote) {
        const link = document.createElement("a");
        link.href = "#last-visit";
        link.textContent = "Go to where you left off";
        // A second press changes no address, so the press itself leads there.
        link.addEventListener("click", (event) => {
          event.preventDefault();
          toLastVisit();
        });
        visitNote.replaceChildren(
          `Dated since your last visit on ${day}: ${countsText(kindsOf(dated.slice(0, index)))}. `,
          link,
        );
        visitNote.hidden = false;
      }
    };

    // The span the list keeps to, counted back from the day of the last check, and the
    // kind of row shown. Both are set by the fields above the list.
    const SPANS = [
      { span: "week", days: 7, name: "the past week" },
      { span: "month", days: 30, name: "the past month" },
      { span: "year", days: 365, name: "the past year" },
      { span: "all", days: null, name: "all time" },
    ];
    let span = "week";
    let kind = "all";
    let setSpan: (picked: string, keep?: boolean) => void = () => {};

    const refresh = () => {
      list.querySelectorAll(".last-visit-item").forEach((item) => item.remove());
      let shown = 0;
      let later = 0;
      for (const group of groups) {
        const rows = rowsIn(group);
        const left = rows.filter((row) => !out(row));
        for (const row of rows) row.hidden = out(row);
        const says = group.querySelector<HTMLElement>("[data-says]")!;
        says.textContent = countsText(kindsOf(left));
        // A heading with nothing under it is not shown.
        group.hidden = left.length === 0;
        shown += left.length;
        if (group.hasAttribute("data-earlier")) later += left.length;
      }
      if (toCome) {
        // Dates still to come are no part of what has happened: they are offered when
        // the reader asks for promised dates.
        const left = kind === "promise" ? rowsIn(toCome).filter((row) => !out(row)) : [];
        for (const row of rowsIn(toCome)) row.hidden = out(row);
        toCome.hidden = left.length === 0;
        if (left.length > 0) {
          toCome.querySelector("[data-to-come-count]")!.textContent = toComeText(left.length);
          toCome.querySelector("[data-to-come-next]")!.textContent = formatDate(left[0].dataset.on!);
        }
        shown += left.length;
      }
      if (older && picked) {
        picked.hidden = out(picked);
        older.hidden = out(picked);
      }
      const at = SPANS.findIndex((entry) => entry.span === span);
      const wider = SPANS[at + 1];
      none.hidden = shown > 0 || wider !== undefined;
      // A span that has been read to its end says so, and offers the next one.
      spanEnd.hidden = wider === undefined || later > 0;
      if (wider) {
        spanSaid.textContent =
          shown > 0 ? `That is everything dated in ${SPANS[at].name}.` : `Nothing is dated in ${SPANS[at].name} for that choice.`;
        spanWider.textContent = `Show ${wider.name}`;
      }
      if (control) {
        control.hidden = later === 0;
        control.querySelector("[data-earlier-left]")!.textContent = earlierText(later);
      }
      filterMenu?.dispatchEvent(new Event("filter:say"));
      drawLastVisit();
    };
    spanWider.addEventListener("click", () => {
      const wider = SPANS[SPANS.findIndex((entry) => entry.span === span) + 1];
      if (wider) setSpan(wider.span);
    });

    // Earlier headings are shown a batch at a time, or as far as one named in the address.
    const BATCH = 8;
    const hiddenGroups = () => groups.filter((group) => group.hasAttribute("data-earlier"));
    const reveal = (count: number) => {
      // A heading narrowed to nothing does not use up the batch.
      let opened = 0;
      for (const group of hiddenGroups()) {
        if (opened >= count) break;
        group.removeAttribute("data-earlier");
        if (!group.hidden) opened += 1;
      }
      refresh();
    };
    control?.querySelector("button")!.addEventListener("click", () => reveal(BATCH));
    const openTo = (target: HTMLElement) => {
      // A heading outside the span is reached by widening to all time.
      if (target.hidden && span !== "all") setSpan("all");
      if (!target.hasAttribute("data-earlier")) return;
      for (const group of groups) {
        group.removeAttribute("data-earlier");
        if (group === target) break;
      }
      refresh();
    };
    const revealTo = (id: string) => {
      const target = groups.find((group) => group.id === id);
      if (!target) return;
      openTo(target);
      target.scrollIntoView({ block: "start" });
    };
    // The line can stand under a heading that is not yet shown: the list is opened as
    // far as it first.
    toLastVisit = () => {
      if (!line.isConnected) return;
      const group = line.closest<HTMLElement>("[data-group]") ?? (line.nextElementSibling as HTMLElement | null);
      if (group) openTo(group);
      line.scrollIntoView({ block: "center" });
    };
    const fromAddress = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (id === "last-visit") toLastVisit();
      else if (/^[dwy]-/.test(id)) revealTo(id);
    };
    addEventListener("hashchange", fromAddress);
    // Paper gets the whole list.
    addEventListener("beforeprint", () => {
      for (const group of groups) group.removeAttribute("data-earlier");
      if (toCome) toCome.open = true;
      refresh();
    });

    const remember = (name: string, value: string, first: string) => {
      const url = new URL(location.href);
      if (value === first) url.searchParams.delete(name);
      else url.searchParams.set(name, value);
      history.replaceState(history.state, "", url);
    };

    // One kind at a time, or every kind. The pick is kept in the page's address.
    const kindField = root.querySelector<HTMLSelectElement>("#feed-kind")!;
    const pick = (picked: string) => {
      kind = picked;
      kindField.value = picked;
      for (const row of allRows) row.toggleAttribute("data-out-kind", picked !== "all" && row.dataset.kind !== picked);
      refresh();
    };
    kindField.addEventListener("change", () => {
      pick(kindField.value);
      remember("kind", kind, "all");
    });
    root.querySelector<HTMLElement>("[data-kinds]")!.hidden = false;

    // The span: rows dated before it are left out. A date still to come is in every span.
    const spanField = root.querySelector<HTMLSelectElement>("#feed-span")!;
    const checked = root.dataset.checked!;
    const fromOf = (days: number | null) => {
      if (days === null) return "";
      const day = new Date(`${checked}T00:00:00Z`);
      day.setUTCDate(day.getUTCDate() - (days - 1));
      return day.toISOString().slice(0, 10);
    };
    setSpan = (picked, keep = true) => {
      span = picked;
      spanField.value = picked;
      const from = fromOf(SPANS.find((entry) => entry.span === picked)!.days);
      for (const row of allRows) {
        row.toggleAttribute("data-out-span", !isPicked(row) && row.dataset.on! < from);
      }
      refresh();
      if (keep) remember("span", span, "week");
    };
    spanField.addEventListener("change", () => setSpan(spanField.value));
    root.querySelector<HTMLElement>("[data-spans]")!.hidden = false;

    // The status path and the topic choice narrow these rows too, and say so here.
    list.addEventListener("paged:refresh", refresh);

    // On a wide screen the topic is chosen from the side column; it drives the same
    // field a narrower screen shows, so there is one choice and one place it is kept.
    const choice = document.querySelector<HTMLSelectElement>("#feed-topic");
    const topicPicks = [...root.querySelectorAll<HTMLButtonElement>("[data-topic-pick]")];
    if (sideTopics && choice) {
      const sync = () => {
        for (const button of topicPicks) {
          button.setAttribute("aria-pressed", String(choice.value === button.dataset.topicPick));
        }
      };
      for (const button of topicPicks) {
        button.addEventListener("click", () => {
          choice.value = button.dataset.topicPick!;
          choice.dispatchEvent(new Event("change"));
        });
      }
      choice.addEventListener("change", sync);
      sync();
      sideTopics.hidden = false;
    }

    const asked = new URL(location.href).searchParams;
    const askedKind = asked.get("kind");
    const askedSpan = asked.get("span");
    kind = [...kindField.options].some((option) => option.value === askedKind) ? askedKind! : "all";
    for (const row of allRows) row.toggleAttribute("data-out-kind", kind !== "all" && row.dataset.kind !== kind);
    kindField.value = kind;
    setSpan(SPANS.some((entry) => entry.span === askedSpan) ? askedSpan! : "week", false);
    fromAddress();
  }
</script>

<style is:global>
  /* Global, as the home page's own styles are: rows are counted and marked by script. */
  .days {
    margin-top: clamp(1.5rem, 5vw, 2.25rem);
  }

  /* The head, one line: what the list is, the mark that says what a row's right column
     is, then at the right the day the list is dated by, in grey, and the control that
     narrows it. */
  .days-head {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
  }

  .days-title {
    font-size: clamp(1.5rem, 3.8vw, 1.75rem);
    line-height: 1.15;
    margin: 0;
  }

  .days-head .pop-trigger.info {
    margin-left: -0.45rem;
    color: var(--muted);
  }

  .days-head .pop-trigger.info:hover {
    color: var(--blue);
  }

  .checked-on {
    margin: 0;
    font-size: var(--text-s);
    color: var(--muted);
  }

  /* The short date, kept to its line: a long pick in the control is what gives way. */
  .days-head .checked-on {
    justify-self: end;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .days-head .on-wide {
    display: none;
  }

  /* A long pick is cut before the date beside it is. */
  .days-head .filter-menu {
    max-width: 14rem;
  }

  .days-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 2.4rem;
    align-items: start;
  }

  .days-main {
    min-width: 0;
  }

  /* While a search typed in the box stands, its answer takes the list's place, and its
     topics take the place of the list's topics. */
  [data-days][data-searching] .days-main > :not([data-search-answer]),
  [data-days][data-searching] [data-side-topics] {
    display: none;
  }

  /* Where the side column stands, it holds a search's topics; the row under the
     answer's heading is for narrower screens. */
  @media (min-width: 56rem) {
    [data-search-answer] .search-topic-row {
      display: none;
    }
  }

  @media (min-width: 56rem) {
    .days-body {
      grid-template-columns: var(--list) minmax(0, 1fr);
      gap: 0 var(--column-gap);
    }

    /* The list is the one white sheet on the pale ground. */
    .days-main {
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      padding: 1.4rem clamp(1.1rem, 2.4vw, 2rem) 1.8rem;
    }
  }

  /* The right column: three short parts in grey headings, parted by hairlines. */
  .days-rail {
    display: none;
  }

  @media (min-width: 72rem) {
    .days-body {
      grid-template-columns: var(--list) minmax(0, 1fr) var(--rail);
    }

    .days-rail {
      display: grid;
      gap: 1.4rem;
      position: sticky;
      top: 1rem;
      padding-top: 1.4rem;
      font-size: 0.88rem;
      line-height: 1.45;
    }

    .days-rail h3 {
      font-size: 0.78rem;
      font-weight: 600;
