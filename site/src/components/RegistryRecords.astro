---
// Registry records that are not trials on the page yet, grouped by how each was read.
// Each row: the study's title, then one line in the trials' own grammar ("Phase 3 ·
// NCT… at ClinicalTrials.gov · Under way"), then what it is for and what it names.
// A possible record leads that line with its match, so the uncertainty comes before its
// phase and state; a matched one gives its match on a line of its own. Openspec
// registry-record-rows; the score stays in the row's notes (openspec site-publishing,
// "A match score reads as a note").
import ChevronDown from "@lucide/astro/icons/chevron-down";
import type { ExportedMatch } from "../lib/export";
import { NOT_COUNTED, NOT_COUNTED_LINK, RECORDS_SHOWN, groupByReading } from "../lib/registry-records";
import Row from "./RegistryRecordRow.astro";

interface Props {
  matches: ExportedMatch[];
  /** The groups' heading level: 3 directly under the section, 4 under a subheading. */
  level?: 3 | 4;
  /** Candidates: not counted in the status, which the list says once, with the rule. */
  possible?: boolean;
}

const { matches, level = 3, possible = false } = Astro.props;
const Heading = `h${level}` as "h3" | "h4";
const groups = groupByReading(matches).map((group) => ({
  ...group,
  shown: group.matches.slice(0, RECORDS_SHOWN),
  rest: group.matches.slice(RECORDS_SHOWN),
}));
---

{
  possible && (
    <p class="record-not-counted">
      {NOT_COUNTED} <a href={NOT_COUNTED_LINK.href}>{NOT_COUNTED_LINK.text}</a>
    </p>
  )
}
{
  groups.map((group) => (
    <div class={possible ? "record-group record-group-possible" : "record-group"}>
      <Heading class="record-group-head">
        {group.heading}
        <span class="visually-hidden">, </span>
        <span class="record-group-count">
          {group.matches.length}
          <span class="visually-hidden">{group.matches.length === 1 ? " record" : " records"}</span>
        </span>
      </Heading>
      <ul class="plain record-list">
        {group.shown.map((match) => (
          <Row match={match} possible={possible} />
        ))}
      </ul>
      {group.rest.length > 0 && (
        <details class="papers-rest record-rest">
          <summary>
            The other {group.rest.length} of {group.matches.length} records
            <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
          </summary>
          <ul class="plain record-list">
            {group.rest.map((match) => (
              <Row match={match} possible={possible} />
            ))}
          </ul>
        </details>
      )}
    </div>
  ))
}
