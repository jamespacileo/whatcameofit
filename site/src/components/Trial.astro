---
// One trial, once, as a row of the trials table: how many people, what it was compared
// with, its design, its state and its results, in plain words. The row opens to what it
// measured where a reading says so, the registry's own terms, what it set out to measure
// and what it posted. With no script the row is simply open. Openspec site-publishing:
// "Trials read across as a table". Openspec trial-facts and site-publishing (change plain-trial-entries): the
// numbers are the registry's, and no word here says how the trial turned out, where it
// takes place or who may take part.
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ExternalLink from "@lucide/astro/icons/external-link";
import { confidenceLabel, matchWords, readingOf } from "../lib/confidence";
import type { ExportedMatch, ExportedTrial } from "../lib/export";
import { paperAnchor } from "../lib/paper-facts";
import { measureWords } from "../lib/readings";
import { sourceName } from "../lib/status";
import { formatDate } from "../lib/timetable";
import {
  RESULT_NOTES,
  STUDY_KIND_WORDS,
  comparisonText,
  designText,
  measureLead,
  measureText,
  phaseText,
  resultTable,
  sponsorText,
  studiedText,
  trialColumns,
  type TrialDates,
} from "../lib/trial-facts";
import TrialDetailsLink from "./TrialDetailsLink.astro";

interface Props {
  trial: ExportedTrial;
  /** The approved match that brought the trial to the claim, when there is one. */
  match?: ExportedMatch;
  /** The claim's kind of treatment: a device is compared with a sham device. */
  approach: string | null;
  /** When the trial finished and when it last posted results, from the claim's events. */
  dates: TrialDates;
}

const { trial, match, approach, dates } = Astro.props;
// The papers its registry record names, each with an entry under "Papers on record".
const papers = trial.papers ?? [];
const facts = trial.facts;
const registry = sourceName(trial.source_name);
const columns = trialColumns(trial, approach, dates);
// What its first main measure is, in the words "The record in brief" uses.
const measured = measureWords(trial, 0);
const measuredPhrase = measured
  ? `${measured.phrase.charAt(0).toLowerCase()}${measured.phrase.slice(1)}${measured.over}`
  : null;
const design = designText(facts);
const studied = studiedText(facts);
const sponsor = sponsorText(facts);
const phased = trial.phases.filter((code) => code !== "not_applicable");
// An interventional trial is the usual kind and is not named; the others are.
const kind =
  facts?.study_kind && facts.study_kind !== "interventional"
    ? STUDY_KIND_WORDS[facts.study_kind]
    : null;
const results = facts?.results ?? null;
const planned = facts?.primary_outcomes ?? [];
const morePlanned = (facts?.primary_outcomes_total ?? 0) - planned.length;
const morePosted = results ? results.outcomes_total - results.outcomes.length : 0;
---

<div class="trial-group" role="rowgroup" id={`trial-${trial.trial_id}`}>
  <div class="trial-row" role="row">
    <div class="trial-cell trial-lead" role="rowheader">
      <button
        type="button"
        class="trial-open"
        aria-expanded="true"
        aria-controls={`trial-detail-${trial.trial_id}`}
      >
        <span class="chev" aria-hidden="true"><ChevronDown size={14} stroke-width={2.2} /></span>
        <span class="trial-title">{columns.lead}</span>
      </button>
      <span class="trial-name">
        {columns.phase && <span class="trial-phase">{columns.phase} · </span>}
        <a href={trial.url} rel="noopener">
          {trial.trial_id}
          <ExternalLink class="out" size={13} stroke-width={1.9} aria-hidden="true" />
          <span class="visually-hidden">(at {registry})</span>
        </a>
        <TrialDetailsLink url={trial.url} />
      </span>
    </div>
    <div class="trial-cell" role="cell"><span class="lbl">Compared with</span>{columns.compared}</div>
    <div class="trial-cell" role="cell">
      <span class="lbl">Design</span>{columns.design.length > 0 ? columns.design.join(" · ") : "Not stated in the record"}
    </div>
    <div class="trial-cell" role="cell"><span class="lbl">State</span>{columns.state ?? "Not stated in the record"}</div>
    <div class="trial-cell" role="cell"><span class="lbl">Results</span>{columns.results}</div>
  </div>
  <div class="trial-detail" role="row" id={`trial-detail-${trial.trial_id}`}>
    <div role="cell" aria-colspan="5">
  {
    measuredPhrase && (
      <p class="trial-measured">
        {measureLead(trial)} {measuredPhrase}.
      </p>
    )
  }
  <p class="entry-note trial-meta">
    {match && <span class="unbroken">Match to this claim: {matchWords(match.score)}</span>}
    {
      papers.length > 0 && (
        <a class="unbroken" href={`#${paperAnchor(papers[0])}`}>
          {papers.length === 1 ? "1 paper named by its record" : `${papers.length} papers named by its record`}
        </a>
      )
    }
    {
      trial.facts_as_of && (
        <span>
          {registry} record read <span class="unbroken">{formatDate(trial.facts_as_of)}</span>
        </span>
      )
    }
    {measuredPhrase && <span>What it measured was read by a model and checked against the record</span>}
  </p>
    <dl class="trial-facts">
      {
        studied && (
          <div>
            <dt>Who took part</dt>
            <dd>{studied}</dd>
          </div>
        )
      }
      {
        sponsor && (
          <div>
            <dt>Run by</dt>
            <dd>{sponsor}</dd>
          </div>
        )
      }
      {
        kind && (
          <div>
            <dt>Kind of study</dt>
            <dd>{kind}</dd>
          </div>
        )
      }
      {
        trial.title && !columns.isTitle && (
          <div>
            <dt>The registry's title</dt>
            <dd>{trial.title}</dd>
          </div>
        )
      }
      {
        design && (
          <div>
            <dt>Design, in the registry's terms</dt>
            <dd>{design}</dd>
          </div>
        )
      }
      <div>
        <dt>Phase</dt>
        <dd>
          {phased.length > 0 ? phaseText(phased) : RESULT_NOTES.no_phase}{" "}
          <a href="/guide/trial-phases">What a phase is</a>
        </dd>
      </div>
      {
        planned.length > 0 && (
          <div>
            <dt>Main measures planned</dt>
            <dd>
              <ul class="trial-measures">
                {planned.map((outcome) => (
                  <li>
                    {outcome.measure}
                    {outcome.time_frame && <span class="entry-note">{outcome.time_frame}</span>}
                  </li>
                ))}
              </ul>
              {morePlanned > 0 && (
                <span class="entry-note">
                  {morePlanned} more in the {registry} record.
                </span>
              )}
            </dd>
          </div>
        )
      }
      {
        facts?.why_stopped && (
          <div>
            <dt>Reason the record gives for stopping</dt>
            <dd>“{facts.why_stopped}”</dd>
          </div>
        )
      }
      {
        results && (
          <div class="trial-results">
            <dt>Results posted for the main measures</dt>
            <dd>
              {results.outcomes.map((outcome) => {
                const table = resultTable(outcome);
                const about = [outcome.time_frame, measureText(outcome)].filter(Boolean).join(" · ");
                return (
                  <div class="result">
                    {table ? (
                      <table class="result-table">
                        <caption>
                          {outcome.title}
                          {about && <span class="entry-note">{about}</span>}
                        </caption>
                        <thead>
                          <tr>
                            <th scope="col">Group</th>
                            <th scope="col" class="figure">
                              {table.statistic}
                            </th>
                            {table.spread && (
                              <th scope="col" class="figure spread">
                                {table.spread}
                              </th>
                            )}
                            <th scope="col" class="figure">
                              People analysed
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          {table.rows.map((row) => (
                            <tr>
                              <th scope="row">{row.group}</th>
                              <td class="figure">
                                {row.value}
                                {row.spread && (
                                  <span class="spread-inline">
                                    {table.spread} {row.spread}
                                  </span>
                                )}
                              </td>
                              {table.spread && <td class="figure spread">{row.spread}</td>}
                              <td class="figure">{row.analysed}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    ) : (
                      <>
                        <p class="result-title">
                          {outcome.title}
                          {about && <span class="entry-note">{about}</span>}
                        </p>
                        <p class="entry-note">
                          Posted in {outcome.rows} rows of values, which are in the {registry} record.
                        </p>
                      </>
                    )}
                    {table?.fall && <p class="entry-note">{RESULT_NOTES.fall}</p>}
                    {outcome.comparisons.map((comparison) => (
                      <p class="result-comparison">
                        {comparisonText(comparison)}
                        {comparison.groups.length > 0 && (
                          <span class="entry-note">Posted for: {comparison.groups.join(", ")}</span>
                        )}
                      </p>
                    ))}
                  </div>
                );
              })}
              {morePosted > 0 && (
                <span class="entry-note">
                  {morePosted} more in the {registry} record.
                </span>
              )}
              <p class="entry-note result-scale">
                {RESULT_NOTES.scale}{" "}
                <a href={trial.url} rel="noopener">
                  See the {registry} record
                </a>
              </p>
            </dd>
          </div>
        )
      }
      {
        match && (
          <div>
            <dt>How sure the match is</dt>
            <dd>
              {confidenceLabel(match.score)}
              <span class="entry-note">{readingOf(match.reading)}</span>
            </dd>
          </div>
        )
      }
    </dl>
    </div>
  </div>
</div>
