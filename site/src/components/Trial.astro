---
// One trial, once, as a row of the trials table: how many people, what it was compared
// with, its design, its state and its results, in plain words. The row opens to what it
// measured where a reading says so, the registry's own terms, what it set out to measure
// and what it posted. With no script the row is simply open. Openspec site-publishing:
// "Trials read across as a table". Openspec trial-facts and site-publishing (change plain-trial-entries): the
// numbers are the registry's, and no word here says how the trial turned out, where it
// takes place or who may take part.
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ExternalLink from "@lucide/astro/icons/external-link";
import { MATCH_MEANING, matchWords, readingOf } from "../lib/confidence";
import Score from "./Score.astro";
import type { ExportedMatch, ExportedTrial } from "../lib/export";
import { paperAnchor } from "../lib/paper-facts";
import { measureWords } from "../lib/readings";
import { sourceName } from "../lib/status";
import { formatDate } from "../lib/timetable";
import {
  RESULT_NOTES,
  STUDY_KIND_WORDS,
  comparisonText,
  designText,
  measureLead,
  measureText,
  comparedNames,
  phaseText,
  RESULTS_POSTED,
  testedNames,
  resultTable,
  sponsorText,
  studiedText,
  trialColumns,
  type TrialDates,
} from "../lib/trial-facts";
import { trialDetailsPath } from "../lib/trial-links.mjs";

interface Props {
  trial: ExportedTrial;
  /** The approved match that brought the trial to the claim, when there is one. */
  match?: ExportedMatch;
  /** The claim's kind of treatment: a device is compared with a sham device. */
  approach: string | null;
  /** When the trial finished and when it last posted results, from the claim's events. */
  dates: TrialDates;
  /** Its main measure's abbreviations said plainly, those not already said above it. */
  glosses?: string[];
  /** The largest size any of the claim's trials states: this trial's is drawn against it. */
  largest?: number;
  /** The claim's treatment, by name, for a trial that has it only as a comparison. */
  treatment?: string;
}

const { largest = 0 } = Astro.props;
const { trial, match, approach, dates, glosses = [], treatment } = Astro.props;
// What it was compared with, by the names its record gives its comparator arms; else in
// the plain words for the kinds of comparator.
const arms = trial.facts?.arms ?? [];
const compared = comparedNames(arms);
// The claim's treatment is what this trial compares with, not what it tests.
const asComparison = trial.claim_arm === "comparator" ? testedNames(arms) : null;
// Its own page on this site, where the registry's record is shown in full; else the registry.
const local = trialDetailsPath(trial.url);
const NO_SIZE = "Size not stated";
// The papers its registry record names, each with an entry under "Papers on record".
const papers = trial.papers ?? [];
const facts = trial.facts;
const registry = sourceName(trial.source_name);
const columns = trialColumns(trial, approach, dates);
// What its first main measure is, in the words "The record in brief" uses.
const measured = measureWords(trial, 0);
const measuredPhrase = measured
  ? `${measured.phrase.charAt(0).toLowerCase()}${measured.phrase.slice(1)}${measured.over}`
  : null;
const design = designText(facts);
const studied = studiedText(facts);
const sponsor = sponsorText(facts);
const phased = trial.phases.filter((code) => code !== "not_applicable");
// An interventional trial is the usual kind and is not named; the others are.
const kind =
  facts?.study_kind && facts.study_kind !== "interventional"
    ? STUDY_KIND_WORDS[facts.study_kind]
    : null;
const results = facts?.results ?? null;
const planned = facts?.primary_outcomes ?? [];
const morePlanned = (facts?.primary_outcomes_total ?? 0) - planned.length;
const morePosted = results ? results.outcomes_total - results.outcomes.length : 0;
// The row's main measure, in the registry's own words: the plain reading groups
// measures (overall survival and progression-free survival read alike), so it stays
// in the fold's sentence and the row keeps what tells trials apart.
const mainMeasure = planned[0]?.measure ?? null;
---

<div class="trial-group" role="rowgroup" id={`trial-${trial.trial_id}`}>
  <div class="trial-row" role="row">
    <div class="trial-cell trial-lead" role="rowheader">
      <button
        type="button"
        class="trial-open"
        aria-expanded="true"
        aria-controls={`trial-detail-${trial.trial_id}`}
      >
        <span class="chev" aria-hidden="true"><ChevronDown size={14} stroke-width={2.2} /></span>
        <span class="trial-title">{columns.isTitle ? NO_SIZE : columns.lead}</span>
        <span class="visually-hidden">: more from its record</span>
      </button>
      {/* Its size against the claim's largest trial: a bar, since a column of numbers is slow to compare. */}
      {!columns.isTitle && largest > 0 && facts?.participants?.count !== undefined && (
        <span class="share-bar" aria-hidden="true" style={`--share: ${(facts.participants.count / largest).toFixed(3)}`} />
      )}
      {/* A trial that has the claim's treatment only as its comparison says so in sight. */}
      {asComparison && (
        <span class="trial-by">
          It tests {asComparison}; {treatment ?? "this treatment"} is what it is compared with.
        </span>
      )}
    </div>
    <div class="trial-cell" role="cell">
      <span class="lbl">Phase</span>
      {columns.phase ?? <span class="trial-none">Not given</span>}
    </div>
    <div class="trial-cell" role="cell">
      <span class="lbl">State</span>
      {/* A shape for the state, beside its words: a column of them is read at a glance.
          In the hue of its state and never alone: it says where a trial is, not how it turned out. */}
      <span class="trial-state">
        <span class:list={["state-mark", { posted: Boolean(results) }]} data-state={trial.state} aria-hidden="true" />
        {columns.state ?? "Not stated in the record"}
      </span>
    </div>
    <div class="trial-cell" role="cell">
      <span class="lbl">{RESULTS_POSTED}</span>
      {results ? (columns.results.replace(/^Posted\s*/, "") || "Yes") : <span class="trial-none">None</span>}
    </div>
    <div class="trial-cell trial-id" role="cell">
      <span class="lbl">Trial</span>
      <a href={local ?? trial.url} rel={local ? undefined : "noopener"}>
        {trial.trial_id}
        {!local && <ExternalLink class="out" size={13} stroke-width={1.9} aria-hidden="true" />}
        <span class="visually-hidden">{local ? "(its record, on this site)" : `(at ${registry})`}</span>
      </a>
    </div>
  </div>
  <div class="trial-detail" role="row" id={`trial-detail-${trial.trial_id}`}>
    <div role="cell" aria-colspan="5">
  {
    measuredPhrase && (
      <p class="trial-measured">
        {measureLead(trial)} {measuredPhrase}.
      </p>
    )
  }
  <p class="entry-note trial-meta">
    {
      match && (
        <span>
          <Score about="Match to this claim" words={matchWords(match.score)}>
            <span>{MATCH_MEANING}</span>
          </Score>{" "}
          {readingOf(match.reading)}
        </span>
      )
    }
    {
      papers.length > 0 && (
        <a class="unbroken" href={`#${paperAnchor(papers[0])}`}>
          {papers.length === 1 ? "1 paper named by its record" : `${papers.length} papers named by its record`}
        </a>
      )
    }
    {
      trial.facts_as_of && (
        <span>
          {registry} record read <span class="unbroken">{formatDate(trial.facts_as_of)}</span>
        </span>
      )
    }
    {measuredPhrase && <span>What it measured was read by a model and checked against the record</span>}
    {
      trial.url && (
        <a class="unbroken" href={trial.url} rel="noopener">
          {trial.trial_id} at {registry}
          <ExternalLink class="out" size={12} stroke-width={1.9} aria-hidden="true" />
        </a>
      )
    }
  </p>
    <dl class="trial-facts">
      {/* What tells a trial's design apart, said where the row opens: a row keeps to
          its size, phase, state and results. */}
      <div>
        <dt>Compared with</dt>
        <dd>
          {compared ?? columns.compared}
          {asComparison && (
            <span class="entry-note">
              It tests {asComparison}; {treatment ?? "this treatment"} is what it is compared with.
            </span>
          )}
        </dd>
      </div>
      <div>
        <dt>Main measure</dt>
        <dd>
          {mainMeasure ?? "Not stated in the record"}
          {glosses.length > 0 && <span class="entry-note">{glosses.join(" · ")}</span>}
        </dd>
      </div>
      {
        sponsor && (
          <div>
            <dt>Run by</dt>
            <dd>{sponsor}</dd>
          </div>
        )
      }
      {
        studied && (
          <div>
            <dt>Who took part</dt>
            <dd>{studied}</dd>
          </div>
        )
      }
      {
        kind && (
          <div>
            <dt>Kind of study</dt>
            <dd>{kind}</dd>
          </div>
        )
      }
      {
        trial.title && (
          <div>
            <dt>The registry's title</dt>
            <dd>{trial.title}</dd>
          </div>
        )
      }
      <div>
        <dt>Design</dt>
        <dd>
          {columns.design.length > 0 ? columns.design.join(" · ") : "Not stated in the record"}
          {design && <span class="entry-note">In the registry's terms: {design}</span>}
        </dd>
      </div>
      <div>
        <dt>Phase</dt>
        <dd>
          {phased.length > 0 ? phaseText(phased) : RESULT_NOTES.no_phase}{" "}
          <a href="/guide/trial-phases">What a phase is</a>
        </dd>
      </div>
      {
        planned.length > 0 && (
          <div>
            <dt>Main measures planned</dt>
            <dd>
              <ul class="trial-measures">
                {planned.map((outcome) => (
                  <li>
                    {outcome.measure}
                    {outcome.time_frame && <span class="entry-note">{outcome.time_frame}</span>}
                  </li>
                ))}
              </ul>
              {morePlanned > 0 && (
                <span class="entry-note">
                  {morePlanned} more in the {registry} record.
                </span>
              )}
            </dd>
          </div>
        )
      }
      {
        facts?.why_stopped && (
          <div>
            <dt>Reason the record gives for stopping</dt>
            <dd>“{facts.why_stopped}”</dd>
          </div>
        )
      }
      {
        results && (
          <div class="trial-results">
            <dt>Results posted for the main measures</dt>
            <dd>
              {results.outcomes.map((outcome) => {
                const table = resultTable(outcome);
                const about = [outcome.time_frame, measureText(outcome)].filter(Boolean).join(" · ");
                return (
                  <div class="result">
                    {table ? (
                      <table class="result-table">
                        <caption>
                          {outcome.title}
                          {about && <span class="entry-note">{about}</span>}
                        </caption>
                        <thead>
                          <tr>
                            <th scope="col">Group</th>
                            <th scope="col" class="figure">
                              {table.statistic}
                            </th>
                            {table.spread && (
                              <th scope="col" class="figure spread">
                                {table.spread}
                              </th>
                            )}
                            <th scope="col" class="figure">
                              People analysed
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          {table.rows.map((row) => (
                            <tr>
                              <th scope="row">{row.group}</th>
                              <td class="figure">
                                {row.value}
                                {row.spread && (
                                  <span class="spread-inline">
                                    {table.spread} {row.spread}
                                  </span>
                                )}
                              </td>
                              {table.spread && <td class="figure spread">{row.spread}</td>}
                              <td class="figure">{row.analysed}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    ) : (
                      <>
                        <p class="result-title">
                          {outcome.title}
                          {about && <span class="entry-note">{about}</span>}
                        </p>
                        <p class="entry-note">
                          Posted in {outcome.rows} rows of values, which are in the {registry} record.
                        </p>
                      </>
                    )}
                    {table?.fall && <p class="entry-note">{RESULT_NOTES.fall}</p>}
                    {outcome.comparisons.map((comparison) => (
                      <p class="result-comparison">
                        {comparisonText(comparison)}
                        {comparison.groups.length > 0 && (
                          <span class="entry-note">Posted for: {comparison.groups.join(", ")}</span>
                        )}
                      </p>
                    ))}
                  </div>
                );
              })}
              {morePosted > 0 && (
                <span class="entry-note">
                  {morePosted} more in the {registry} record.
                </span>
              )}
              <p class="entry-note result-scale">
                {RESULT_NOTES.scale}{" "}
                <a href={trial.url} rel="noopener">
                  See the {registry} record
                </a>
              </p>
            </dd>
          </div>
        )
      }
    </dl>
    </div>
  </div>
</div>
