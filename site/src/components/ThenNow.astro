---
// One published claim under the home page's box, as the site's idea in one look: what
// an outlet reported and when, how long ago that was, and where the claim stands on the
// records, in the well a claim page shows its status in. The claim is the site's example
// (lib/extension-page: chosen by rule, never by hand). The outlet's title is a quotation
// with the outlet named; the status is the site's label with its place on the path.
// Openspec home-then-now.
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Clock from "@lucide/astro/icons/clock";
import StageTrack from "./StageTrack.astro";
import type { ExportedClaim } from "../lib/export";
import { firstReport } from "../lib/extension-page";
import { STATUS_GLOSSES, STATUS_LABELS, overlayText } from "../lib/status";
import { yearsOn } from "../lib/then-now";
import { formatDate } from "../lib/timetable";

interface Props {
  claim: ExportedClaim;
  /** The day the registries were last checked. */
  checkedAt: string | null;
}

const { claim, checkedAt } = Astro.props;
const report = firstReport(claim);
const latest = claim.events.map((event) => event.event_date).sort().at(-1) ?? null;
const overlay = overlayText(claim.status.overlay_years);
const on = checkedAt ? yearsOn(report.published_date, checkedAt) : null;
---

<a class="then-now" href={`/${claim.slug}`} data-pagefind-ignore>
  <div class="then">
    <p class="then-when">
      Reported <span class="unbroken">{formatDate(report.published_date)}</span>
      {report.outlet && <> · {report.outlet}</>}
    </p>
    <p class="then-quote">“{report.title}”</p>
  </div>
  <p class="then-gap">
    {on && <span>{on}</span>}
    <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" />
  </p>
  <div class="now-well">
    <p class="now-tab">Where it stands</p>
    <p class="now-label">{STATUS_LABELS[claim.status.code]}</p>
    <p class="now-gloss">{STATUS_GLOSSES[claim.status.code]}</p>
    <StageTrack code={claim.status.code} ends />
    {
      overlay && (
        <p class="now-note">
          <Clock size={14} stroke-width={1.9} aria-hidden="true" />
          {overlay}
        </p>
      )
    }
    <p class="now-latest">{latest ? `Latest record ${formatDate(latest)}` : "No record yet"}</p>
  </div>
</a>
