---
// The sections of a page, by name, with the count each holds and the one in view
// marked. Beside the content on a wide screen; one row that stays at the top on a
// narrow one. Openspec site-publishing: "A claim page lists its sections".
interface Item {
  /** A section of this page, by its id; or leave out and give an address. */
  id?: string;
  /** Another page, for a list of pages such as the topics. */
  href?: string;
  name: string;
  count?: string | number | null;
  /** The page being read, in a list of pages. */
  current?: boolean;
}

interface Props {
  label: string;
  items: Item[];
}

const { label, items } = Astro.props;
---

<nav class="onpage" aria-label={label} data-pagefind-ignore>
  <p class="onpage-title" aria-hidden="true">{label}</p>
  <ul class="strip">
    {
      items.map((item) => (
        <li>
          <a href={item.href ?? `#${item.id}`} aria-current={item.current ? "page" : undefined}>
            <span>{item.name}</span>
            {item.count != null && item.count !== "" && <span class="n">{item.count}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>(".onpage");
  const strip = nav?.querySelector<HTMLElement>(".strip");
  if (nav && strip) {
    const links = [...strip.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links
      .map((link) => document.getElementById(link.getAttribute("href")!.slice(1)))
      .filter((target): target is HTMLElement => target !== null);
    const still = matchMedia("(prefers-reduced-motion: reduce)");

    // The row moves so that the marked name is in view. Only the row scrolls.
    const centre = (link: HTMLElement) => {
      // offsetLeft is from the row itself, which is the links' offset parent.
      if (strip.scrollWidth <= strip.clientWidth) return;
      strip.scrollTo({
        left: link.offsetLeft - (strip.clientWidth - link.offsetWidth) / 2,
        behavior: still.matches ? "auto" : "smooth",
      });
    };
    // Which end has more beyond it: the stylesheet fades that end.
    const ends = () => {
      const more = [];
      if (strip.scrollLeft > 4) more.push("start");
      if (strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 4) more.push("end");
      nav.dataset.more = more.join(" ");
    };

    let marked: HTMLElement | null = null;
    const mark = () => {
      let current = targets[0];
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= 140) current = target;
      }
      if (!current || current === marked) return;
      marked = current;
      for (const link of links) {
        if (link.getAttribute("href") === `#${current.id}`) {
          link.setAttribute("aria-current", "true");
          centre(link);
        } else link.removeAttribute("aria-current");
      }
    };

    if (targets.length > 0) {
      addEventListener("scroll", mark, { passive: true });
      mark();
    } else {
      // A list of pages: the one being read is in view from the start.
      const here = strip.querySelector<HTMLElement>("[aria-current]");
      if (here) strip.scrollLeft = here.offsetLeft - (strip.clientWidth - here.offsetWidth) / 2;
    }
    strip.addEventListener("scroll", ends, { passive: true });
    addEventListener("resize", ends);
    ends();
  }
</script>
