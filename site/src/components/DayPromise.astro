---
// A promised date in the day-by-day list: what the report promised, on pale amber, beside
// the claim's status now. Nothing here says whether the date has passed.
import type { PromiseRow } from "../lib/day-list";
import { formatDate } from "../lib/timetable";
import Outlet from "./Outlet.astro";
import PromiseText from "./PromiseText.astro";
import StatusCell from "./StatusCell.astro";

interface Props {
  row: PromiseRow;
}

const { row } = Astro.props;
const { claim, promise } = row;
// The report the promise was read from; a claim's reports are few.
const report = claim.articles.find((article) => article.url === promise.article_url) ?? null;
---

<li
  class="day-row promise-row"
  data-day-row
  data-kind="promise"
  data-status={claim.status.code}
  data-topic={claim.vertical}
  data-on={row.date}
>
  <p class="row-source">
    <span class="row-label">Promised date</span>
    {
      report && (
        <>
          <Outlet url={report.url} outlet={report.outlet} />
          <span class="when">{formatDate(report.published_date)}</span>
        </>
      )
    }
  </p>
  <h4 class="row-title">
    <a href={`/${claim.slug}`}>{report ? <>“{report.title}”</> : claim.headline}</a>
  </h4>
  <p class="row-promise">
    <PromiseText promise={promise} />
  </p>
  <p class="row-status promise-status">
    <StatusCell claim={claim} />
  </p>
</li>
