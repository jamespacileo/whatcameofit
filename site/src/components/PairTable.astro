---
// A list of pairs: each with its intervention, condition, status and how many trials. The same
// table the Worker writes for a listing made on request (lib/blocks.ts, pairTable); its styles
// are pair/pair.css's.
import { pairTable } from "../lib/blocks";
import type { PairRow } from "../lib/pairs";
import "../pair/pair.css";

interface Props {
  pairs: PairRow[];
  caption: string;
}

const { pairs, caption } = Astro.props;
---

<Fragment set:html={pairTable(caption, pairs)} />
