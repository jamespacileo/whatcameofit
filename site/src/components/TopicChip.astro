---
// A small mark for the topic a page belongs to. A topic takes the drawing of its
// group (dementia is drawn as brain and nerves), or its own when it has no group;
// one with no drawing gets a plain ring. A drawing says what part of the body or
// what kind of illness the topic is about, never how a claim in it is doing.
import { verticalTitle } from "../lib/export";
import TopicDrawing from "./TopicDrawing.astro";

interface Props {
  vertical: string;
  link?: boolean;
  /** How many claims the topic tracks, shown where topics are listed. */
  count?: number;
}

const { vertical, link = true, count } = Astro.props;
const Tag = link ? "a" : "span";
---

<Tag class="chip" href={link ? `/topic/${vertical}` : undefined}>
  <TopicDrawing vertical={vertical} />
  {verticalTitle(vertical)}
  {
    count !== undefined && (
      <span class="count">
        {count}
        <span class="visually-hidden">{count === 1 ? " claim tracked" : " claims tracked"}</span>
      </span>
    )
  }
</Tag>

<script>
  // On hover a chip's drawing is drawn again, line by line. Each line is counted as
  // one unit long, so a short line and a long one take the same time, and is given
  // its place in the order. One technique for every topic: none has a gesture of its own.
  for (const drawing of document.querySelectorAll<SVGElement>("a.chip > svg")) {
    [...drawing.children].forEach((line, index) => {
      line.setAttribute("pathLength", "1");
      (line as SVGElement).style.setProperty("--i", String(index));
    });
    drawing.classList.add("lines");
  }
</script>
