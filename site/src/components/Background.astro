---
import FoldHead from "./FoldHead.astro";
// Background cards: what an open vocabulary says of the claim's condition and
// treatment. The label and definition are the source's; the site adds the credit, the
// score and the reasons. Openspec site-publishing: "Background cards on the claim page".
import ChevronDown from "@lucide/astro/icons/chevron-down";
import {
  BACKGROUND_NOTE,
  DEFINITION_LABEL,
  NO_DEFINITION,
  NO_REASON,
  NO_TARGET_DEFINITION,
  TARGET_DEFINITION_LABEL,
  TARGET_NOTE,
  DRUG_NOTE,
  NO_MECHANISM,
  cardKindText,
  creditText,
  definitionCreditText,
  factsCreditText,
  isDrugsTarget,
  mechanismTexts,
  moleculeKindText,
  scoreLabel,
  reasonTexts,
  type ExportedCard,
  type ExportedCardSource,
} from "../lib/background";
import { confidenceLabel } from "../lib/confidence";

interface Props {
  cards: ExportedCard[];
  sources: ExportedCardSource[];
}

const { cards, sources } = Astro.props;
const sourceOf = (card: ExportedCard) => sources.find((source) => source.name === card.source)!;
// The source a definition's words are from, when it is not the card's own source.
const wordsBy = (card: ExportedCard) =>
  card.definition && card.definition_source
    ? sources.find((source) => source.name === card.definition_source)
    : undefined;
const isTarget = (card: ExportedCard) => card.kind === "target";
// The source a card's facts are drawn from, when it is not the card's own source.
const factsBy = (card: ExportedCard) =>
  card.facts_source ? sources.find((source) => source.name === card.facts_source) : undefined;
const day = (stamp: string) =>
  new Date(stamp).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---

<section class="matched background" data-pagefind-ignore>
  <FoldHead id="background" start="folded" note={`${cards.length} ${cards.length === 1 ? "term" : "terms"}, in their source’s words`}>
    Background
  </FoldHead>
  <p class="take-why">
    {BACKGROUND_NOTE}
    {cards.some((card) => isTarget(card) && !isDrugsTarget(card)) && ` ${TARGET_NOTE}`}
    {cards.some((card) => card.kind === "drug" || isDrugsTarget(card)) && ` ${DRUG_NOTE}`}
  </p>
  <ul class="plain match-list card-list">
    {
      cards.map((card) => (
        <li>
          <div class="match-record">
            <span class="card-kind">{cardKindText(card)}</span>
            <a class="card-label" href={card.url} rel="noopener">
              {card.label}
            </a>
            {card.name && <span class="entry-note">{card.name}</span>}
            <span class="entry-note">
              <a href={sourceOf(card).url} rel="noopener">
                {creditText(card, sourceOf(card))}
              </a>
              . Record read {day(card.read_at)}.
              {wordsBy(card) && (
                <>
                  {" "}
                  <a href={wordsBy(card)!.url} rel="noopener">
                    {definitionCreditText(wordsBy(card)!)}
                  </a>
                  .
                </>
              )}
            </span>
            {factsBy(card) && (
              <span class="entry-note">
                <a href={factsBy(card)!.url} rel="noopener">
                  {factsCreditText(card, factsBy(card)!)}
                </a>
                .
              </span>
            )}
            {card.kind === "drug" ? (
              <div class="card-facts">
                {moleculeKindText(card) && <p>{moleculeKindText(card)}</p>}
                {mechanismTexts(card).length > 0 ? (
                  <ul>
                    {mechanismTexts(card).map((mechanism) => (
                      <li>{mechanism}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="entry-note">{NO_MECHANISM}</p>
                )}
              </div>
            ) : card.definition ? (
              <details class="card-words">
                <summary>
                  {isTarget(card) ? TARGET_DEFINITION_LABEL : DEFINITION_LABEL}
                  <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                </summary>
                <blockquote cite={card.url}>{card.definition}</blockquote>
              </details>
            ) : (
              <span class="entry-note">{isTarget(card) ? NO_TARGET_DEFINITION : NO_DEFINITION}</span>
            )}
          </div>
          <details class="match-why">
            <summary>
              <strong>{scoreLabel(card, confidenceLabel)}</strong>
              <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
            </summary>
            {reasonTexts(card).map((reason) => (
              <p>{reason}</p>
            ))}
            {card.reasons.length === 0 && <p>{NO_REASON}</p>}
          </details>
        </li>
      ))
    }
  </ul>
</section>
