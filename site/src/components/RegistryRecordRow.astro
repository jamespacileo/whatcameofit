---
// One registry record in RegistryRecords: its title, one line in the trials' grammar
// ("Phase 3 · NCT… at ClinicalTrials.gov · Under way"), then what it is for and names.
// A possible record leads the line with its match; a matched one gives its match on a
// line of its own. Openspec registry-record-rows.
import ExternalLink from "@lucide/astro/icons/external-link";
import { matchNote, possibleMatchNote } from "../lib/confidence";
import type { ExportedMatch } from "../lib/export";
import { FOR_LABEL, NAMED_LABEL, NOT_READ_YET, phaseOf, stateOf } from "../lib/registry-records";
import { sourceName } from "../lib/status";
import { trialDetailsPath } from "../lib/trial-links.mjs";

interface Props {
  match: ExportedMatch;
  possible: boolean;
}

const { match, possible } = Astro.props;
const record = match.record ?? null;
const local = trialDetailsPath(match.url);
const title = record?.title ?? `Registry record ${match.external_id}`;
const at = `${match.external_id} at ${sourceName(match.source_name)}`;
---

<li class="record-row">
  <p class="record-title">{local ? <a href={local}>{title}</a> : title}</p>
  <p class="record-meta">
    {possible && <span class="record-possible">{possibleMatchNote(match.score)}</span>}
    {record && <span>{phaseOf(record)}</span>}
    <span>
      {
        match.url ? (
          <a class="record-source" href={match.url} rel="noopener">
            {at}
            <ExternalLink class="out" size={12} stroke-width={1.9} aria-hidden="true" />
          </a>
        ) : (
          at
        )
      }
    </span>
    <span>{record ? stateOf(record) : NOT_READ_YET}</span>
  </p>
  {!possible && <p class="record-match">{matchNote(match.score)}</p>}
  {
    record && (record.conditions.length > 0 || record.interventions.length > 0) && (
      <dl class="record-fields">
        {record.conditions.length > 0 && (
          <div>
            <dt>{FOR_LABEL}</dt>
            <dd>{record.conditions.join("; ")}</dd>
          </div>
        )}
        {record.interventions.length > 0 && (
          <div>
            <dt>{NAMED_LABEL}</dt>
            <dd>{record.interventions.join("; ")}</dd>
          </div>
        )}
      </dl>
    )
  }
</li>
