---
import type { ExportedClaim } from "../lib/export";
import { latestPromise } from "../lib/status";
import { formatDate } from "../lib/timetable";
import ClaimName from "./ClaimName.astro";
import Pager from "./Pager.astro";
import StageFilter from "./StageFilter.astro";
import PromiseText from "./PromiseText.astro";
import StatusCell from "./StatusCell.astro";

interface Props {
  claims: ExportedClaim[];
  caption: string;
  /** Show how the claims are spread across statuses, and let a reader pick one. */
  filter?: boolean;
  /** Names the list in the page's address; give one when a page has two lists. */
  name?: string;
}

const { claims, caption, filter = false, name = "claims" } = Astro.props;
// A longer list is read a page at a time.
const PAGE_SIZE = 25;
// A handful of claims is read at a glance; the filter earns its place on a longer list.
const FILTER_FROM = 6;
// Amber is kept for a promise that exists: with none in the list, there is no column.
const anyPromise = claims.some((claim) => latestPromise(claim) !== null);
---

{filter && claims.length >= FILTER_FROM && <StageFilter claims={claims} />}
<div class="table-frame">
<table role="table" class="index">
  <caption class="visually-hidden">{caption}</caption>
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Claim</th>
      <th role="columnheader" scope="col">First reported</th>
      {anyPromise && <th role="columnheader" scope="col" class="promise">Latest promise</th>}
      <th role="columnheader" scope="col">Status</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      claims.map((claim, index) => {
        const promise = latestPromise(claim);
        return (
          <tr data-status={claim.status.code} data-first={claim.first_reported_date ?? undefined} data-later={index >= PAGE_SIZE ? "" : undefined} role="row">
            <td role="cell" class="claim">
              <ClaimName claim={claim} />
            </td>
            <td role="cell" class="when" data-column="First reported">
              {claim.first_reported_date ? (
                formatDate(claim.first_reported_date)
              ) : (
                <span class="visually-hidden">Not recorded</span>
              )}
            </td>
            {anyPromise && (
            <td role="cell" class:list={["promise", { none: !promise }]} data-column="Latest promise">
              {promise ? (
                <>
                  <PromiseText promise={promise} />
                </>
              ) : (
                <span class="visually-hidden">None with a date</span>
              )}
            </td>
            )}
            <td role="cell" class="status" data-column="Status">
              <StatusCell claim={claim} />
            </td>
          </tr>
        );
      })
    }
  </tbody>
</table>
</div>
<Pager name={name} total={claims.length} size={PAGE_SIZE} one="claim" many="claims" />

<script>
  // A claim first reported since the reader last opened the home page says so in a
  // word, as the home page's own rows do. The day is read from this browser's storage
  // and is not changed here: only the home page counts as a visit.
  import { VISIT_ENTRY, isSince, nextVisit } from "../lib/returning";

  let raw: string | null = null;
  try {
    raw = localStorage.getItem(VISIT_ENTRY);
  } catch {}
  const now = new Date();
  const two = (value: number) => String(value).padStart(2, "0");
  const today = `${now.getFullYear()}-${two(now.getMonth() + 1)}-${two(now.getDate())}`;
  const since = nextVisit(raw, today).previous;
  if (since) {
    for (const row of document.querySelectorAll<HTMLTableRowElement>("table.index tr[data-first]")) {
      if (!isSince(row.dataset.first!, since, today)) continue;
      const tag = document.createElement("span");
      tag.className = "new-tag";
      tag.textContent = "New";
      row.querySelector(".claim a")?.after(" ", tag);
    }
  }
</script>
