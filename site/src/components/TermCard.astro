---
// One background card, inside its row's disclosure in "At a glance": what an open
// vocabulary or drug source says of a term, as the source wrote it, then the credit,
// the score and the reasons in the site's words. Openspec site-publishing: "Background
// cards on the claim page".
import {
  DEFINITION_LABEL,
  DRUG_NOTE,
  NO_DEFINITION,
  NO_REASON,
  NO_TARGET_DEFINITION,
  TARGET_DEFINITION_LABEL,
  TARGET_NOTE,
  NO_MECHANISM,
  cardKindText,
  creditText,
  definitionCreditText,
  factsCreditText,
  isDrugsTarget,
  mechanismTexts,
  moleculeKindText,
  scoreLabel,
  reasonTexts,
  type ExportedCard,
  type ExportedCardSource,
} from "../lib/background";
import { matchWords } from "../lib/confidence";

interface Props {
  card: ExportedCard;
  sources: ExportedCardSource[];
  /** The label to show when the claim's own wording of it is known (a drug matched by
   * its exact name); otherwise the source's. */
  label?: string;
  /** How the card's row shows its definition: whole, so the card does not repeat it, or
   * cut to three lines, so the card gives it whole to the eye only, as a screen reader
   * has already read it whole in the row. */
  wordsInRow?: "whole" | "cut";
  /** The drug's name as the claim writes it, for a reason that names the drug: the
   * source writes it in capitals. */
  drugAs?: string;
}

const { card, sources, label = card.label, wordsInRow, drugAs } = Astro.props;
// A reason that names the drug names it as the claim does, as the drug's own row does.
const reasons = reasonTexts({
  ...card,
  reasons: card.reasons.map((reason) =>
    drugAs && reason.code === "drug_record_names_target" && reason.name?.toLowerCase() === drugAs.toLowerCase()
      ? { ...reason, name: drugAs }
      : reason,
  ),
});
const source = sources.find((each) => each.name === card.source)!;
// The source a definition's words are from, when it is not the card's own source.
const wordsBy =
  card.definition && card.definition_source
    ? sources.find((each) => each.name === card.definition_source)
    : undefined;
// The source a card's facts are drawn from, when it is not the card's own source.
const factsBy = card.facts_source ? sources.find((each) => each.name === card.facts_source) : undefined;
const isTarget = card.kind === "target";
// What this card adds to the page's note: a gene the name names is not a mechanism; a
// drug's record is no reason to start or stop a medicine.
const note =
  card.kind === "drug" || isDrugsTarget(card) ? DRUG_NOTE : isTarget ? TARGET_NOTE : null;
const day = (stamp: string) =>
  new Date(stamp).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---

<div class="term-card">
  <p class="card-head">
    <span class="card-kind">{cardKindText(card)}</span>
    <a class="card-label" href={card.url} rel="noopener">
      {label}
    </a>
    {card.name && <span class="entry-note">{card.name}</span>}
  </p>
  {
    card.kind === "drug" ? (
      <div class="card-facts">
        {moleculeKindText(card) && <p>{moleculeKindText(card)}</p>}
        {mechanismTexts(card).length > 0 ? (
          <ul>
            {mechanismTexts(card).map((mechanism) => (
              <li>{mechanism}</li>
            ))}
          </ul>
        ) : (
          <p class="entry-note">{NO_MECHANISM}</p>
        )}
      </div>
    ) : card.definition && wordsInRow === "whole" ? null : card.definition ? (
      <div class="card-words" aria-hidden={wordsInRow === "cut" ? "true" : undefined}>
        <p class="card-words-label">{isTarget ? TARGET_DEFINITION_LABEL : DEFINITION_LABEL}</p>
        <blockquote cite={card.url}>{card.definition}</blockquote>
      </div>
    ) : (
      <p class="entry-note">{isTarget ? NO_TARGET_DEFINITION : NO_DEFINITION}</p>
    )
  }
  <p class="term-credit">
    <a href={source.url} rel="noopener">
      {creditText(card, source)}
    </a>
    . Record read {day(card.read_at)}.
    {
      wordsBy && (
        <>
          {" "}
          <a href={wordsBy.url} rel="noopener">
            {definitionCreditText(wordsBy)}
          </a>
          .
        </>
      )
    }
    {
      factsBy && (
        <>
          {" "}
          <a href={factsBy.url} rel="noopener">
            {factsCreditText(card, factsBy)}
          </a>
          .
        </>
      )
    }
  </p>
  <div class="match-why">
    <p class="match-why-head">{scoreLabel(card, matchWords)}</p>
    {reasons.map((reason) => <p>{reason}</p>)}
    {card.reasons.length === 0 && <p>{NO_REASON}</p>}
  </div>
  {note && <p class="term-note">{note}</p>}
</div>
