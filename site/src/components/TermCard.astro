---
// One background card: what an open vocabulary or drug source says of a term. The
// label and definition are the source's; the site adds the credit, the score and the
// reasons. Shown in a row of "At a glance". Openspec site-publishing: "Background
// cards on the claim page".
import ChevronDown from "@lucide/astro/icons/chevron-down";
import {
  DEFINITION_LABEL,
  NO_DEFINITION,
  NO_REASON,
  NO_TARGET_DEFINITION,
  TARGET_DEFINITION_LABEL,
  NO_MECHANISM,
  cardKindText,
  creditText,
  definitionCreditText,
  factsCreditText,
  mechanismTexts,
  moleculeKindText,
  scoreLabel,
  reasonTexts,
  type ExportedCard,
  type ExportedCardSource,
} from "../lib/background";
import { matchNote } from "../lib/confidence";

interface Props {
  card: ExportedCard;
  sources: ExportedCardSource[];
}

const { card, sources } = Astro.props;
const source = sources.find((each) => each.name === card.source)!;
// The source a definition's words are from, when it is not the card's own source.
const wordsBy =
  card.definition && card.definition_source
    ? sources.find((each) => each.name === card.definition_source)
    : undefined;
// The source a card's facts are drawn from, when it is not the card's own source.
const factsBy = card.facts_source ? sources.find((each) => each.name === card.facts_source) : undefined;
const isTarget = card.kind === "target";
const day = (stamp: string) =>
  new Date(stamp).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---

<div class="term-card">
  <div class="match-record">
    <span class="card-kind">{cardKindText(card)}</span>
    <a class="card-label" href={card.url} rel="noopener">
      {card.label}
    </a>
    {card.name && <span class="entry-note">{card.name}</span>}
    {
      card.kind === "drug" ? (
        <div class="card-facts">
          {moleculeKindText(card) && <p>{moleculeKindText(card)}</p>}
          {mechanismTexts(card).length > 0 ? (
            <ul>
              {mechanismTexts(card).map((mechanism) => (
                <li>{mechanism}</li>
              ))}
            </ul>
          ) : (
            <p class="entry-note">{NO_MECHANISM}</p>
          )}
        </div>
      ) : card.definition ? (
        <details class="card-words" open>
          <summary>
            {isTarget ? TARGET_DEFINITION_LABEL : DEFINITION_LABEL}
            <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
          </summary>
          <blockquote cite={card.url}>{card.definition}</blockquote>
        </details>
      ) : (
        <span class="entry-note">{isTarget ? NO_TARGET_DEFINITION : NO_DEFINITION}</span>
      )
    }
    <span class="entry-note">
      <a href={source.url} rel="noopener">
        {creditText(card, source)}
      </a>
      . Record read {day(card.read_at)}.
      {
        wordsBy && (
          <>
            {" "}
            <a href={wordsBy.url} rel="noopener">
              {definitionCreditText(wordsBy)}
            </a>
            .
          </>
        )
      }
    </span>
    {
      factsBy && (
        <span class="entry-note">
          <a href={factsBy.url} rel="noopener">
            {factsCreditText(card, factsBy)}
          </a>
          .
        </span>
      )
    }
  </div>
  <details class="match-why">
    <summary>
      <span>{scoreLabel(card, matchNote)}</span>
      <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
    </summary>
    {reasonTexts(card).map((reason) => <p>{reason}</p>)}
    {card.reasons.length === 0 && <p>{NO_REASON}</p>}
  </details>
</div>
