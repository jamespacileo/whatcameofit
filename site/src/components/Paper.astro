---
// One paper, once, as an entry row (components/Entry.astro): what it is called, what kind
// of publication its index record says it is and where it appeared, and in sight which
// trials it is tied to; how it came to be listed is said in words where the row opens. Openspec paper-facts: every
// fact is the index's, and no word here says what the paper concluded or how good it is.
import ExternalLink from "@lucide/astro/icons/external-link";
import Entry from "./Entry.astro";
import { MATCH_MEANING, matchWords } from "../lib/confidence";
import Score from "./Score.astro";
import type { ExportedPaper } from "../lib/export";
import {
  ALSO_WORDS,
  LISTED_WORDS,
  OPEN_ACCESS_WORDS,
  PAPER_INDEX,
  PAPER_REASON_WORDS,
  RETRACTED_WORDS,
  paperAnchor,
  paperName,
  paperStanding,
  studiedInText,
  trialRoles,
} from "../lib/paper-facts";
import { formatDate } from "../lib/timetable";

interface Props {
  paper: ExportedPaper;
  /** The trials that have an entry on this page, so that a trial is linked only then. */
  trialIds: Set<string>;
}

const { paper, trialIds } = Astro.props;
const facts = paper.facts;
const standing = paperStanding(paper);
const studied = studiedInText(paper);
const first = paper.roles[0]?.role;
const related = paper.roles.find((role) => role.role === "related");
const also = [...new Set(paper.roles.slice(1).map((role) => role.role))]
  .filter((role) => role !== first && role in ALSO_WORDS)
  .map((role) => ALSO_WORDS[role]);
const reasons = (related?.reasons ?? []).map((code) => PAPER_REASON_WORDS[code] ?? code);
---

<Entry class="paper" id={paperAnchor(paper.identifier)} name={paperName(paper)} opens="Ties and index record">
  <p class="entry-name paper-name">
    <a href={paper.url} rel="noopener">
      {paperName(paper)}
      <ExternalLink class="out" size={13} stroke-width={1.9} aria-hidden="true" />
    </a>
  </p>
  {standing && <p class="entry-note paper-standing">{standing}</p>}
  {facts?.retracted && <p class="paper-retracted">{RETRACTED_WORDS}.</p>}
  {/* In sight: which trials it is tied to, a mark saying how, and any score. */}
  <Fragment slot="ties">
    {
      trialRoles(paper).map((role) => (
        <span class="tie">
          <span class:list={["tie-mark", { listed: role.listed === "listed_by_sponsor" }]} aria-hidden="true" />
          <span class="visually-hidden">
            {LISTED_WORDS[role.listed ?? ""] ?? "Named by the registry record of"}{" "}
          </span>
          {trialIds.has(role.trial_id!) ? (
            <a href={`#trial-${role.trial_id}`}>{role.trial_id}</a>
          ) : (
            role.trial_id
          )}
        </span>
      ))
    }
    {
      related && typeof related.score === "number" && (
        <span class="tie">
          <Score about="Match to this claim" words={matchWords(related.score)}>
            <span>{MATCH_MEANING}</span>
          </Score>
        </span>
      )
    }
  </Fragment>
  {/* Where it opens: the index's record under the title, the ties in words beside it. */}
  <Fragment slot="more">
    <p class="entry-note entry-more-lead paper-meta">
      {also.map((words) => <span class="unbroken">{words}</span>)}
      {facts?.open_access && <span class="unbroken">{OPEN_ACCESS_WORDS}</span>}
      {
        paper.facts_as_of && (
          <span>
            {paper.record_url ? (
              <a href={paper.record_url} rel="noopener">
                {PAPER_INDEX} record
              </a>
            ) : (
              `${PAPER_INDEX} record`
            )}{" "}
            read <span class="unbroken">{formatDate(paper.facts_as_of)}</span>
          </span>
        )
      }
      {!facts && <span>No {PAPER_INDEX} details are available here</span>}
    </p>
    <div class="entry-more-ties">
      {
        trialRoles(paper).map((role) => (
          <p class="paper-role">
            {LISTED_WORDS[role.listed ?? ""] ?? "Named by the registry record of"}{" "}
            {trialIds.has(role.trial_id!) ? (
              <a href={`#trial-${role.trial_id}`}>{role.trial_id}</a>
            ) : (
              role.trial_id
            )}
          </p>
        ))
      }
      {studied && <p class="paper-role">{studied}.</p>}
      {!facts && related?.summary && <p class="entry-note">{related.summary}</p>}
      {reasons.length > 0 && <p class="entry-note">{reasons.join(" · ")}</p>}
    </div>
  </Fragment>
</Entry>
