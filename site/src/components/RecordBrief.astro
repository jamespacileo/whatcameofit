---
// "The record in brief": fixed questions about a claim's records (openspec
// site-publishing: "A claim page answers fixed questions from its records"). First one
// plain sentence that gives every answer, each figure a link to its row. Then the rows,
// a fact sheet (components/FactSheet.astro): the question, the answer, a bar where the
// answer is so many of the claim's trials. A row opens to what the answer means; where
// it was read from is a press further in. Chosen by the operator from
// .impeccable/mocks/sections-rebuild/ on 2026-11-17 (variants C and A together).
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Fact from "./Fact.astro";
import FactSheet from "./FactSheet.astro";
import FoldHead from "./FoldHead.astro";
import type { ExportedClaim } from "../lib/export";
import { BRIEF_TITLE, briefNote, recordBrief, sourceWords } from "../lib/record-brief";

interface Props {
  claim: ExportedClaim;
  lastChecked: string | null;
}

const { claim, lastChecked } = Astro.props;
const groups = recordBrief(claim, lastChecked);
const rows = groups.flatMap((group) => group.rows);
// A clause's figure stands between double square brackets: it is drawn in bold and
// leads to its row.
// The figures of an answer: a number with what follows it as one figure ("26 of 47",
// "4 Jun 2026", whose spaces do not break), and a number said in words where it opens
// the answer.
const FIGURE =
  /(\d[\d,.]*(?:\s+of\s+\d[\d,.]*)?(?:\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+\d{4})?|^(?:One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten|Eleven|Twelve|None|No)\b)/;
const figures = (answer: string) => answer.split(FIGURE);
const clause = (said: string) => {
  const [before, figure, after] = said.split(/\[\[|\]\]/);
  return { before, figure, after: after ?? "" };
};
---

{
  rows.length > 0 && (
    <section class="brief" data-pagefind-ignore>
      <FoldHead id="brief">
        {/* What the answers are and are not, from the mark beside the heading. */}
        <p slot="about">
          {briefNote(groups)} <a href="/how-it-works">How an answer is made</a>
        </p>
        {BRIEF_TITLE}
      </FoldHead>
      <p class="brief-said">
        {rows.map((row) => {
          const { before, figure, after } = clause(row.said);
          return (
            <>
              {before}
              <a class="brief-term" href={`#brief-${row.code}`}>{figure}</a>
              {after}.{" "}
            </>
          );
        })}
      </p>
      <FactSheet>
        {rows.map((row) => {
          const words = sourceWords(row.source);
          return (
            <Fact id={`brief-${row.code}`} label={row.question} value={row.answer} opens="What this means and where it is from">
              {/* Only the figures of an answer are bold, so a reader skims down them. */}
              {figures(row.answer).map((part, index) => (index % 2 === 1 ? <b>{part}</b> : part))}
              {row.share && row.share.of > 1 && (
                <span
                  slot="aside"
                  class="share-bar"
                  role="img"
                  aria-label={`${row.share.n} of ${row.share.of}`}
                  style={`--share: ${row.share.n / row.share.of}`}
                />
              )}
              {row.shown && (
                <span slot="under" class="aka brief-shown">
                  <a href={row.shown.href}>{row.shown.text}</a>
                </span>
              )}
              <div slot="more" class="brief-open">
                {row.opened.map((sentence) => (
                  <p>{sentence}</p>
                ))}
                {row.link && (
                  <p class="brief-link">
                    <a href={row.link.href}>{row.link.text}</a>
                  </p>
                )}
                {/* Where the answer was read from: a press further in. */}
                <details class="match-why">
                  <summary class="match-why-head">
                    Where this is read from
                    <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                  </summary>
                  <p class="brief-source">
                    {words.before}
                    {row.source.records.map((record, index) => (
                      <>
                        {index > 0 && ", "}
                        <a class="unbroken" href={record.url} rel="noopener">
                          {record.label}
                        </a>
                      </>
                    ))}
                    {words.after}
                  </p>
                </details>
              </div>
            </Fact>
          );
        })}
      </FactSheet>
    </section>
  )
}
