---
// A news report in the day-by-day list (openspec latest-rows): the outlet, date and
// topic, the outlet's title quoted, opening the claim, and the claim it is about lead
// on the left; where the claim stands is the column on the right, which opens the
// row's detail under it.
import type { ReportRow } from "../lib/day-list";
import { followedNameFor } from "../lib/reports";
import { formatDate } from "../lib/timetable";
import Outlet from "./Outlet.astro";
import RowStanding from "./RowStanding.astro";

interface Props {
  row: ReportRow;
  topic: string;
  /** The older claim shown after the day of the last check. It is not dated that day,
   * and its report has a row of its own further down, which carries the headline. */
  picked?: boolean;
}

const { row, topic, picked = false } = Astro.props;
const { claim } = row;
const [first] = row.reports;
// Named as on the claim page, so the headline pressed here is carried to its place there.
const name = picked ? null : followedNameFor(claim, first.url);
// One detail per row: a claim picked for the day of the last check also has a row of its own.
const moreId = `more-${claim.slug}-${row.date}${picked ? "-picked" : ""}`;
---

<li
  class="day-row report-row"
  data-day-row
  data-kind="report"
  data-status={claim.status.code}
  data-topic={claim.vertical}
  data-on={row.date}
  data-picked={picked ? "" : undefined}
>
  <div class="row-main">
    <p class="row-source">
      <span class="visually-hidden">News report. </span>
      {row.reports.map((report) => <Outlet url={report.url} outlet={report.outlet} />)}
      <span class="when">{formatDate(row.date)}</span>
      {topic && <span class="row-topic">{topic}</span>}
    </p>
    <h4 class="row-title">
      <a
        class="followed"
        href={`/${claim.slug}`}
        style={name ? `view-transition-name: ${name}` : undefined}
      >
        “{first.title}”
      </a>
    </h4>
    <p class="row-claim">
      <span class="row-intervention">{claim.intervention.name}</span> · {claim.indication}
    </p>
  </div>
  <RowStanding claim={claim} date={row.date} id={moreId} />
</li>
