---
// A news report in the day-by-day list: the outlet's title, quoted, beside the record.
// What was reported is on white; what is on record is on the panel blue.
import type { ReportRow } from "../lib/day-list";
import { followedNameFor } from "../lib/reports";
import { rowSentences } from "../lib/row-sentences";
import { EVIDENCE_STAGES, STATUS_GLOSSES, STATUS_LABELS, latestPromise, overlayText } from "../lib/status";
import { formatDate } from "../lib/timetable";
import Outlet from "./Outlet.astro";
import PromiseText from "./PromiseText.astro";
import StageTrack from "./StageTrack.astro";

interface Props {
  row: ReportRow;
  topic: string;
  /** The older claim shown after the day of the last check. It is not dated that day,
   * and its report has a row of its own further down, which carries the headline. */
  picked?: boolean;
}

const { row, topic, picked = false } = Astro.props;
const { claim } = row;
const [first] = row.reports;
// Named as on the claim page, so the headline pressed here is carried to its place there.
const name = picked ? null : followedNameFor(claim, first.url);
const sentences = rowSentences(claim, row.date);
const promise = latestPromise(claim);
const overlay = overlayText(claim.status.overlay_years);
const stage = claim.evidence_stage ? EVIDENCE_STAGES[claim.evidence_stage] : null;
---

<li
  class="day-row report-row"
  data-day-row
  data-kind="report"
  data-status={claim.status.code}
  data-topic={claim.vertical}
  data-on={row.date}
  data-picked={picked ? "" : undefined}
>
  <p class="row-source">
    <span class="visually-hidden">News report. </span>
    {row.reports.map((report) => <Outlet url={report.url} outlet={report.outlet} />)}
    <span class="when">{formatDate(row.date)}</span>
    <span class="row-topic">{topic}</span>
  </p>
  <h4 class="row-title">
    <a
      class="followed"
      href={`/${claim.slug}`}
      style={name ? `view-transition-name: ${name}` : undefined}
    >
      “{first.title}”
    </a>
  </h4>
  <div class="then-now">
    <div class="then">
      <span class="row-label">Evidence when first reported</span>
      <strong class="then-stage">{stage ?? "Not recorded"}</strong>
      {claim.first_reported_date && <span class="gloss">{formatDate(claim.first_reported_date)}</span>}
    </div>
    <div class="now">
      <span class="row-label">On record now</span>
      <strong class="status-name">{STATUS_LABELS[claim.status.code]}</strong>
      <span class="gloss">{STATUS_GLOSSES[claim.status.code]}{overlay && `. ${overlay}`}</span>
      <StageTrack code={claim.status.code} />
    </div>
  </div>
  {sentences.length > 0 && <p class="row-adds">{sentences.join(" ")}</p>}
  {
    promise && (
      <p class="row-promise">
        <span class="row-label">Promised</span> <PromiseText promise={promise} />
      </p>
    )
  }
  <p class="row-foot">
    <span class="row-claim">
      {claim.intervention.name} · {claim.indication}
    </span>
    <a href={`/${claim.slug}`}>
      See the records<span class="visually-hidden"> for {claim.intervention.name}</span>
    </a>
  </p>
</li>
