---
// What a list says about the rows that are not in the page as built (openspec
// landing-rows-on-demand). Two lines, both a child of the list's holder, the element
// that names where the rest are ("data-rest"):
// - the script's line: that the rest are being fetched, or that they did not arrive,
//   with a control to ask again;
// - the page's own line, given as this component's content: how many rows are shown of
//   how many, and where every claim is listed. It is read with scripting off, and on
//   paper while the rest are not in the page.
interface Props {
  /** Where the rest of the rows are. A list that is whole in the page says nothing. */
  when?: string | boolean;
  loading?: string;
  failed?: string;
}

// Left out, the lines are drawn; given as nothing, the list is whole and they are not.
const when = "when" in Astro.props ? Astro.props.when : true;
const {
  loading = "Loading the rest of this list.",
  failed = "The rest of this list did not load.",
} = Astro.props;
---

{
  when && (
    <p class="rest-said" data-rest-said data-loading={loading} data-failed={failed}>
      <span role="status" data-rest-line />
      <button type="button" class="text-control" hidden data-rest-again>Try again</button>
    </p>
  )
}
{when && Astro.slots.has("default") && <p class="rest-first"><slot /></p>}

<style is:global>
  /* Global, as the lists' own styles are: the lines stand among rows drawn by script. */
  .rest-said {
    margin: 0;
    font-size: var(--text-m);
    color: var(--muted);
  }

  .rest-said [data-rest-line]:not(:empty),
  .rest-said [data-rest-again]:not([hidden]) {
    display: inline-block;
    margin: 0.8rem 0.6rem 0 0;
  }

  /* 44 pixels to press on a phone. */
  @media (max-width: 40rem) {
    .rest-said [data-rest-again]:not([hidden]) {
      padding-block: 0.6rem;
      margin-block: 0.2rem -0.6rem;
    }
  }

  .rest-first {
    display: none;
    margin: 0.8rem 0 0;
    max-width: var(--measure);
    font-size: var(--text-m);
    color: var(--muted);
  }

  @media (scripting: none) {
    .rest-first {
      display: block;
    }
  }

  @media print {
    .rest-said {
      display: none;
    }

    [data-rest] > .rest-first {
      display: block;
    }
  }
</style>
