---
// The mark of something that happened on record: one small drawing for what the record
// did, on the tint, where a news report has its outlet's icon. A trial's life is drawn
// as a recording's controls are: added, started, paused, stopped, run to its end, taken
// back. Its colour says which way the record moved (docs/adr/0010): begun or approved,
// halted or refused, or neither. It never says whether a treatment works: a finished
// trial and posted results keep the blue. The row's words say what happened.
import Building from "@lucide/astro/icons/building";
import ChartNoAxesColumn from "@lucide/astro/icons/chart-no-axes-column";
import File from "@lucide/astro/icons/file";
import FileText from "@lucide/astro/icons/file-text";
import FileX from "@lucide/astro/icons/file-x";
import HandCoins from "@lucide/astro/icons/hand-coins";
import Pause from "@lucide/astro/icons/pause";
import Play from "@lucide/astro/icons/play";
import Plus from "@lucide/astro/icons/plus";
import RefreshCw from "@lucide/astro/icons/refresh-cw";
import SkipForward from "@lucide/astro/icons/skip-forward";
import Square from "@lucide/astro/icons/square";
import Stamp from "@lucide/astro/icons/stamp";
import Undo2 from "@lucide/astro/icons/undo-2";
import type { ExportedEvent } from "../lib/export";
import { eventDirection } from "../lib/status";

interface Props {
  event: ExportedEvent;
}

const { event } = Astro.props;

const TRIAL_STATES = {
  started: Play,
  suspended: Pause,
  terminated: Square,
  completed: SkipForward,
  withdrawn: Undo2,
};

const BY_TYPE = {
  trial_registered: Plus,
  trial_results_posted: ChartNoAxesColumn,
  followup_paper: FileText,
  regulatory_decision: Stamp,
  retraction: FileX,
  grant_awarded: HandCoins,
  company_event: Building,
};

const Icon =
  event.type === "trial_status_change"
    ? (TRIAL_STATES[event.trial_state as keyof typeof TRIAL_STATES] ?? RefreshCw)
    : (BY_TYPE[event.type as keyof typeof BY_TYPE] ?? File);
---

<span class="event-mark" data-event={event.type} data-direction={eventDirection(event)} aria-hidden="true"><Icon size={13} stroke-width={2.3} /></span>
