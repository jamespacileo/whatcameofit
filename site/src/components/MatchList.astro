---
// Matched records: the record on the left, how sure the match is on the right as a chip, how it
// was read in the chip's panel. Used for the papers of an export made before openspec
// paper-facts; registry records are laid out by RegistryRecords. Openspec auto-publish:
// "Confidence is shown with every match".
import { MATCH_MEANING, matchWords, readingOf } from "../lib/confidence";
import type { ExportedMatch } from "../lib/export";
import Score from "./Score.astro";
import TrialDetailsLink from "./TrialDetailsLink.astro";

interface Props {
  matches: ExportedMatch[];
}

const { matches } = Astro.props;
---

<ul class="plain match-list">
  {
    matches.map((match) => (
      <li>
        <span class="match-record">
          {match.url ? (
            <a href={match.url} rel="noopener">
              {match.external_id}
            </a>
          ) : (
            match.external_id
          )}
          <TrialDetailsLink url={match.url} />
          {match.summary && (
            <span class="entry-note">{match.summary.replace(`${match.external_id}: `, "")}</span>
          )}
        </span>
        <Score about="Match to this claim" words={matchWords(match.score)}>
          <span>{readingOf(match.reading)}</span>
          <span>{MATCH_MEANING}</span>
        </Score>
      </li>
    ))
  }
</ul>
