---
// "At a glance": the claim's treatment and condition, what kind of thing the treatment
// is and a gene, one line each, then the claim's own facts (passed in as rows). Each
// line taken from a background card has one disclosure, closed until asked for, with
// the card's score in sight on its summary and the source's words, credit and reasons
// inside. Before the record in brief, never inside the status panel: a card describes
// a term, not the evidence. Openspec site-publishing: "Background cards on the claim page".
import ChevronDown from "@lucide/astro/icons/chevron-down";
import FoldHead from "./FoldHead.astro";
import TermCard from "./TermCard.astro";
import { BACKGROUND_NOTE, scoreLabel, type ExportedCard, type ExportedCardSource } from "../lib/background";
import { confidenceLabel } from "../lib/confidence";
import {
  GLANCE_ID,
  GLANCE_TITLE,
  drugLine,
  drugName,
  glanceCards,
  rowId,
  rowLabel,
  sentenceCase,
  type GlanceRow,
} from "../lib/glance";

interface Props {
  intervention: { name: string; synonyms: string[] };
  indication: string;
  cards: ExportedCard[];
  sources: ExportedCardSource[];
}

const { intervention, indication, cards, sources } = Astro.props;
const found = glanceCards(cards);

interface Row {
  row: GlanceRow;
  value: string;
  /** A second, grey line: other names, a gene's full name, what a drug acts on. */
  detail: string | null;
  card: ExportedCard | undefined;
}

const drug = found.drug ? drugLine(found.drug) : null;
const rows: Row[] = [
  {
    row: "treatment",
    value: intervention.name,
    detail: null,
    card: found.treatment,
  },
  ...(found.kind
    ? [{ row: "kind" as const, value: sentenceCase(found.kind.label), detail: null, card: found.kind }]
    : []),
  ...(found.drug && drug ? [{ row: "drug" as const, value: drug.value, detail: drug.detail, card: found.drug }] : []),
  ...(found.target
    ? [{ row: "target" as const, value: found.target.label, detail: found.target.name, card: found.target }]
    : []),
  { row: "condition", value: indication, detail: null, card: found.condition },
];
---

<section class="glance" data-pagefind-ignore>
  <FoldHead id={GLANCE_ID}>{GLANCE_TITLE}</FoldHead>
  <dl class="glance-rows">
    {
      rows.map(({ row, value, detail, card }) => (
        <div id={rowId(row)}>
          <dt>{rowLabel(row, card)}</dt>
          <dd>
            <span class="glance-value">{value}</span>
            {detail && <span class="aka">{detail}</span>}
            {row === "treatment" && intervention.synonyms.length > 0 && (
              <span class="aka">
                also known as{" "}
                {
                  /* A name such as "TRG-035" must not break at its hyphen. */
                  intervention.synonyms.map((name, index) => (
                    <>
                      {index > 0 && ", "}
                      {name.includes("-") && name.length <= 16 ? <span class="unbroken">{name}</span> : name}
                    </>
                  ))
                }
              </span>
            )}
            {card && (
              <details class="glance-more">
                <summary>
                  <span>Source and definition</span>
                  <span class="glance-score">{scoreLabel(card, confidenceLabel)}</span>
                  <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                </summary>
                <TermCard
                  card={card}
                  sources={sources}
                  label={card.kind === "drug" ? drugName(card) : card.label}
                />
              </details>
            )}
          </dd>
        </div>
      ))
    }
    <slot />
  </dl>
  {
    cards.length > 0 && (
      <p class="glance-note">
        {BACKGROUND_NOTE} <a href="/how-it-works#background-on-a-claims-terms">How these terms are chosen</a>
      </p>
    )
  }
</section>
