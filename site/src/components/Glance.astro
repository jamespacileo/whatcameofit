---
// "At a glance": the claim's treatment and condition, what kind of thing the treatment
// is and a gene, one row each, then the claim's own facts (passed in as rows) as rows of
// the same list. A row taken from a background card is one line: its label, its value,
// its score and whose term it is. The line opens to the source's definition in quotation
// marks, whose words they are, the claim's words beside the source's term when they
// differ, and the card's credit and reasons (openspec glance-rows). Before the
// record in brief, never inside the status panel: a card describes a term, not the
// evidence. Openspec site-publishing: "Background cards on the claim page".
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import FoldHead from "./FoldHead.astro";
import Score from "./Score.astro";
import TermCard from "./TermCard.astro";
import { BACKGROUND_NOTE, GLANCE_LEAD, type ExportedCard, type ExportedCardSource } from "../lib/background";
import {
  GLANCE_ID,
  GLANCE_TITLE,
  SHORT_DEFINITION,
  drugLine,
  drugName,
  filedAs,
  glanceCards,
  rowId,
  rowLabel,
  sentenceCase,
  sourceName,
  rowScores,
  TERM_SCORE_MEANING,
  wordsLine,
  type GlanceRow,
} from "../lib/glance";

interface Props {
  intervention: { name: string; synonyms: string[] };
  indication: string;
  cards: ExportedCard[];
  sources: ExportedCardSource[];
}

const { intervention, indication, cards, sources } = Astro.props;
const found = glanceCards(cards);
const sourceOf = (name: string) => sources.find((each) => each.name === name);

interface Row {
  row: GlanceRow;
  value: string;
  /** A second, grey line: a gene's full name, what a drug acts on. */
  detail: string | null;
  /** The row's cards, the first giving the term match on the summary. */
  cards: ExportedCard[];
}

// A drug's own record says what kind of molecule it is, so the kind of treatment is not
// a row of its own beside it: its card goes inside the drug's row.
const drug = found.drug ? drugLine(found.drug) : null;
const rows: Row[] = [
  { row: "treatment", value: intervention.name, detail: null, cards: found.treatment ? [found.treatment] : [] },
  ...(found.kind && !found.drug
    ? [{ row: "kind" as const, value: sentenceCase(found.kind.label), detail: null, cards: [found.kind] }]
    : []),
  ...(found.drug && drug
    ? [
        {
          row: "drug" as const,
          value: drug.value,
          detail: drug.detail,
          cards: [found.drug, ...(found.kind ? [found.kind] : [])],
        },
      ]
    : []),
  ...(found.target
    ? [{ row: "target" as const, value: found.target.label, detail: found.target.name, cards: [found.target] }]
    : []),
  { row: "condition", value: indication, detail: null, cards: found.condition ? [found.condition] : [] },
];
---

<section class="glance" data-pagefind-ignore>
  <FoldHead id={GLANCE_ID}>{GLANCE_TITLE}</FoldHead>
  {cards.length > 0 && <p class="glance-lead" data-clamp="1">{GLANCE_LEAD}</p>}
  <dl class="glance-rows">
    {
      rows.map(({ row, value, detail, cards: rowCards }) => {
        const card = rowCards[0];
        // A definition is the source's words, shown in its row in quotation marks. A
        // drug's record has none: what it is and what it acts on are its row's value.
        const words = card && card.kind !== "drug" ? card.definition : null;
        const short = words !== null && words.length <= SHORT_DEFINITION;
        const wordsBy = card && sourceOf(card.definition_source ?? card.source);
        // The claim's words the term was matched on: a rule names them (a synonym, the
        // condition as written); otherwise the treatment's name or the condition.
        const claimWords =
          card?.reasons.find((reason) => reason.name)?.name ??
          (row === "condition" ? indication : intervention.name);
        const filed = card && filedAs(row, card, claimWords);
        return (
          // Reached from the band's links: the row takes focus and is marked.
          <div id={rowId(row)} tabindex="-1">
            <dt>{rowLabel(row, card)}</dt>
            <dd>
              <span class="glance-head">
                <span class="glance-value">{value}</span>
                {rowCards.length > 0 && (
                  <span class="glance-scores">
                    {rowScores(rowCards).map((score) => (
                      <Score about={score.about} words={score.words} shown={score.shown}>
                        <span>{TERM_SCORE_MEANING}</span>
                      </Score>
                    ))}
                  </span>
                )}
              </span>
              {detail && <span class="aka">{detail}</span>}
              {row === "treatment" && intervention.synonyms.length > 0 && (
                <span class="aka">
                  also known as{" "}
                  {
                    /* A name such as "TRG-035" must not break at its hyphen. */
                    intervention.synonyms.map((name, index) => (
                      <>
                        {index > 0 && ", "}
                        {name.includes("-") && name.length <= 16 ? <span class="unbroken">{name}</span> : name}
                      </>
                    ))
                  }
                </span>
              )}
              {card && (
                // The row's one press: whose term it is, in sight, and the chevron. The
                // words that say what it opens are read out, not drawn. With no script
                // the row is simply open (scripts/folds.ts).
                <button
                  type="button"
                  class="glance-open"
                  aria-expanded="true"
                  aria-controls={`${rowId(row)}-more`}
                >
                  <span class="glance-source">
                    {sourceName(words ? wordsBy! : sourceOf(card.facts_source ?? card.source)!)}
                  </span>
                  {/* A space is written out, so the name read out does not run two parts together. */}
                  {" "}
                  <span class="glance-more-words">{short || !words ? "Why this term" : "Full definition and why this term"}</span>
                  <span class="visually-hidden"> for {value}.</span>
                  <span class="chev" aria-hidden="true">
                    <ChevronDown size={16} stroke-width={2} />
                  </span>
                </button>
              )}
              {card && (
                <div class="glance-more" id={`${rowId(row)}-more`}>
                  {/* Whose words they are, the words, where the claim's term is filed, then
                      the card's credit and reasons. */}
                  <p class="glance-by">
                    {wordsLine(card, words ? wordsBy! : sourceOf(card.facts_source ?? card.source)!, words !== null)}
                  </p>
                  {words && (
                    <blockquote class:list={["glance-words", { "glance-words-long": !short }]} cite={card.url}>
                      {words}
                    </blockquote>
                  )}
                  {filed && (
                    <p class="glance-filed">
                      {/* The label is for the eye; the words between the two terms say the
                          same to a screen reader. */}
                      <span class="glance-filed-label" aria-hidden="true">Filed there as</span>
                      <span class="glance-filed-words">
                        {claimWords}
                        <ArrowRight size={13} stroke-width={2} aria-hidden="true" />
                        <span class="visually-hidden"> is filed there as </span>
                        {filed}
                      </span>
                    </p>
                  )}
                  {rowCards.map((each, index) => (
                    <TermCard
                      card={each}
                      sources={sources}
                      label={each.kind === "drug" ? drugName(each) : each.label}
                      wordsInRow={index === 0 && words !== null}
                      drugAs={found.drug ? drugName(found.drug) : undefined}
                    />
                  ))}
                </div>
              )}
            </dd>
          </div>
        );
      })
    }
  </dl>
  <dl class="glance-facts">
    <slot />
  </dl>
  {
    cards.length > 0 && (
      <p class="glance-note" data-clamp="1">
        {BACKGROUND_NOTE} <a href="/how-it-works#background-on-a-claims-terms">How these terms are chosen</a>
      </p>
    )
  }
</section>
