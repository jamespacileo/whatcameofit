---
// Marks a record the status rests on. Blue, like the status label it explains. The shared block
// (lib/blocks.ts, basisMark), as the styleguide draws it.
import { basisMark } from "../lib/blocks";

interface Props {
  label?: boolean;
}
const { label = true } = Astro.props;
---

<Fragment set:html={basisMark(label)} />
