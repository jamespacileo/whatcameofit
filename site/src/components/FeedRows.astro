---
// The rows of one of the home page's tabbed lists, from one place in the list to
// another (openspec landing-rows-on-demand). The page draws the first of them; the
// file the page fetches for the rest draws the others, with this same markup.
import ClaimName from "./ClaimName.astro";
import Outlet from "./Outlet.astro";
import PromiseText from "./PromiseText.astro";
import StageTrack from "./StageTrack.astro";
import StatusCell from "./StatusCell.astro";
import TestedCell from "./TestedCell.astro";
import {
  anyClaimPromise,
  anyPromise,
  days,
  everyClaim,
  moves,
  promised,
  quiet,
  reports,
  type FeedView,
} from "../lib/home-lists";
import { TESTED_WORDS } from "../lib/record-brief";
import { followedNameFor } from "../lib/reports";
import { STATUS_LABELS, latestPromise } from "../lib/status";
import { formatDate } from "../lib/timetable";

interface Props {
  view: FeedView;
  /** The first row drawn, counted from 0, and the row to stop before. */
  from?: number;
  to?: number;
}

const { view, from = 0, to } = Astro.props;
---

{
  view === "headlines" &&
    reports.slice(from, to).map((report) => (
      <tr role="row" data-status={report.claim.status.code} data-topic={report.claim.vertical} data-on={report.publishedDate}>
        <td role="cell" class="claim">
          {/* Named as on the claim page, so the headline pressed here is
              carried to its place there. With the day-by-day list above, the
              name is on that list's row: a name is on a page once. */}
          <a
            class="followed"
            href={`/${report.claim.slug}`}
            style={
              !days && followedNameFor(report.claim, report.url)
                ? `view-transition-name: ${followedNameFor(report.claim, report.url)}`
                : undefined
            }
          >
            “{report.title}”
          </a>
          <span class="entry-note">
            <Outlet url={report.url} outlet={report.outlet} />
          </span>
        </td>
        <td role="cell" class="when" data-column="Reported">
          {formatDate(report.publishedDate)}
        </td>
        {anyPromise && (
          <td
            role="cell"
            class:list={["promise", { none: !latestPromise(report.claim) }]}
            data-column="Promised"
          >
            {latestPromise(report.claim) ? (
              <>
                <PromiseText promise={latestPromise(report.claim)} />
              </>
            ) : (
              <span class="visually-hidden">None with a date</span>
            )}
          </td>
        )}
        <td role="cell" class="status" data-column="Status now">
          <StatusCell claim={report.claim} />
        </td>
      </tr>
    ))
}
{
  view === "claims" &&
    everyClaim.slice(from, to).map((claim) => {
      const promise = latestPromise(claim);
      return (
        <tr role="row" data-status={claim.status.code} data-topic={claim.vertical} data-on={claim.first_reported_date ?? undefined}>
          <td role="cell" class="claim">
            <ClaimName claim={claim} />
          </td>
          <td role="cell" class="when" data-column="First reported">
            {claim.first_reported_date ? (
              formatDate(claim.first_reported_date)
            ) : (
              <span class="visually-hidden">Not recorded</span>
            )}
          </td>
          <td role="cell" class="tested" data-column={TESTED_WORDS.column}>
            <TestedCell claim={claim} />
          </td>
          {anyClaimPromise && (
            <td role="cell" class:list={["promise", { none: !promise }]} data-column="Promised">
              {promise ? <PromiseText promise={promise} /> : <span class="visually-hidden">None with a date</span>}
            </td>
          )}
          <td role="cell" class="status" data-column="Status now">
            <StatusCell claim={claim} />
          </td>
        </tr>
      );
    })
}
{
  view === "moved" &&
    moves.slice(from, to).map((move) => (
      <tr role="row" data-status={move.claim.status.code} data-topic={move.claim.vertical} data-on={move.on}>
        <td role="cell" class="claim">
          <ClaimName claim={move.claim} />
        </td>
        <td role="cell" class="when" data-column="Changed">
          {formatDate(move.on)}
        </td>
        <td role="cell" class="status" data-column="Status from then">
          <span class="status-line">
            <StageTrack code={move.code} />
            <strong class="status-name">{STATUS_LABELS[move.code]}</strong>
          </span>
          <span class="gloss">Was: {STATUS_LABELS[move.before!]}</span>
        </td>
      </tr>
    ))
}
{
  view === "promised" &&
    promised.slice(from, to).map((claim) => (
      <tr role="row" data-status={claim.status.code} data-topic={claim.vertical} data-on={latestPromise(claim)?.parsed_date}>
        <td role="cell" class="claim">
          <ClaimName claim={claim} />
        </td>
        <td role="cell" class="promise" data-column="Promised">
          <PromiseText promise={latestPromise(claim)} />
        </td>
        <td role="cell" class="status" data-column="Status now">
          <StatusCell claim={claim} />
        </td>
      </tr>
    ))
}
{
  view === "quiet" &&
    quiet.slice(from, to).map((claim) => (
      <tr role="row" data-status={claim.status.code} data-topic={claim.vertical}>
        <td role="cell" class="claim">
          <ClaimName claim={claim} />
        </td>
        <td role="cell" class="when" data-column="First reported">
          {claim.first_reported_date ? (
            formatDate(claim.first_reported_date)
          ) : (
            <span class="visually-hidden">Not recorded</span>
          )}
        </td>
        <td role="cell" class="status" data-column="Status now">
          <StatusCell claim={claim} />
        </td>
      </tr>
    ))
}
