---
// Steps through the rows of the table just before it, a page at a time. Where every row
// is in the page (a topic's or a year's list), the whole list is shown without
// JavaScript, and search engines and print see all of it: the table marks rows after
// the first page with "data-later", which the stylesheet hides from the first paint
// where scripts run. Where the page holds a list's first rows only (the home page's
// lists, openspec landing-rows-on-demand), the rest are fetched on the first step
// forward: the pager stands as built, with the list's own total, until they are here.
import { pageLine, pageOf } from "../lib/paging";

interface Props {
  /** Names the list in the page's address ("?headlines=3"), so a page can be returned to. */
  name: string;
  total: number;
  size: number;
  /** What a row is: "headline", "headlines". */
  one: string;
  many: string;
  /** What the pager's rows are, when two lists on a page share the same noun. */
  label?: string;
}

const { name, total, size, one, many, label = many } = Astro.props;
const first = pageOf(total, size, 1);
---

<nav
  class="pager"
  aria-label={`Pages of ${label}`}
  data-pager={name}
  data-size={size}
  data-total={total}
  data-one={one}
  data-many={many}
  hidden
>
  <button type="button" data-step="-1" aria-disabled="true" tabindex="-1">Previous</button>
  <span class="pager-at" aria-live="polite" data-at>{pageLine(first, total, one, many)}</span>
  <button type="button" data-step="1">Next</button>
</nav>

<script>
  import { pageLine, pageOf } from "../lib/paging";
  import { loadRest, waiting } from "../lib/rest";

  for (const nav of document.querySelectorAll<HTMLElement>("[data-pager]")) {
    const frame = nav.previousElementSibling as HTMLElement | null;
    const table = frame?.querySelector("table");
    if (!frame || !table) continue;
    let rows = [...table.tBodies[0].rows];
    // The list's holder, where the page as built holds only its first rows.
    const holder = nav.closest<HTMLElement>("[data-rest]");
    const name = nav.dataset.pager!;
    const size = Number(nav.dataset.size);
    const line = nav.querySelector<HTMLElement>("[data-at]")!;
    const steps = [...nav.querySelectorAll<HTMLButtonElement>("button[data-step]")];

    let page = Number(new URL(location.href).searchParams.get(name) ?? 1);
    let printing = false;

    // Each filter marks the rows it leaves out ("data-out", "data-out-topic"); the pager
    // pages the rows no filter has marked.
    const out = (row: HTMLTableRowElement) =>
      row.getAttributeNames().some((name) => name.startsWith("data-out"));
    const listed = () => rows.filter((row) => !out(row));

    const draw = () => {
      const list = listed();
      // Until the rest of the rows are here the page holds the first page and no more:
      // the line and the steps stay as built, from the list's own total.
      if (waiting(holder)) {
        for (const row of rows) row.hidden = out(row);
        nav.hidden = Number(nav.dataset.total) <= size;
        return;
      }
      const at = pageOf(list.length, size, page);
      page = at.page;
      const shown = new Set(printing ? list : list.slice(at.from - 1, at.to));
      for (const row of rows) {
        row.hidden = !shown.has(row);
        row.removeAttribute("data-later");
      }
      nav.hidden = at.pages === 1;
      line.textContent = pageLine(at, list.length, nav.dataset.one!, nav.dataset.many!);
      for (const step of steps) {
        const to = page + Number(step.dataset.step);
        const off = to < 1 || to > at.pages;
        step.setAttribute("aria-disabled", String(off));
        // A step that leads nowhere is passed over by the Tab key. It keeps the focus
        // it already has, so pressing Next to the last page does not drop the reader.
        step.tabIndex = off ? -1 : 0;
      }
    };

    // The page is kept in the address, so "back" from a claim returns to the same rows.
    const remember = () => {
      const url = new URL(location.href);
      if (page > 1) url.searchParams.set(name, String(page));
      else url.searchParams.delete(name);
      history.replaceState(history.state, "", url);
    };

    for (const step of steps) {
      step.addEventListener("click", async () => {
        if (step.getAttribute("aria-disabled") === "true") return;
        // The next page is among the rows still to be fetched. If they do not arrive
        // the list says so, and the page shown stays the first.
        if (waiting(holder)) {
          page = 1;
          if (!(await loadRest(holder))) return;
        }
        page += Number(step.dataset.step);
        draw();
        remember();
        // A shorter last page must not leave the reader looking at the footer.
        if (frame.getBoundingClientRect().top < 0) frame.scrollIntoView({ block: "start" });
      });
    }

    table.addEventListener("paged:refresh", () => {
      page = 1;
      draw();
      remember();
    });

    // Paper gets the whole list.
    addEventListener("beforeprint", () => {
      printing = true;
      draw();
    });
    addEventListener("afterprint", () => {
      printing = false;
      draw();
    });

    // The rest of the rows have arrived: the same page, over all of them.
    holder?.addEventListener("rest:here", () => {
      rows = [...table.tBodies[0].rows];
      draw();
    });

    draw();
    // An address that names a later page asks for the rows that page is among. They are
    // drawn when they arrive, at that page unless a filter has since begun the list again.
    if (waiting(holder) && page > 1) void loadRest(holder);
  }
</script>
