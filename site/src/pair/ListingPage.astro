---
// The frame every pair listing shares: a title, a line on what the page is, then the list.
import Base from "../layouts/Base.astro";
import PairTable from "../components/PairTable.astro";
import type { PairRow } from "../lib/pairs";

interface Props {
  title: string;
  kind: string;
  description: string;
  pairs: PairRow[];
  crumbs?: { name: string; path: string }[];
}

const { title, kind, description, pairs, crumbs = [] } = Astro.props;
const count = pairs.length === 1 ? "1 treatment and condition" : `${pairs.length} treatments and conditions`;
---

<Base title={title} description={description} current="topics" breadcrumbs={crumbs.length ? crumbs : undefined}>
  {
    crumbs.length > 1 && (
      <nav class="crumbs" aria-label="Where this page sits">
        <a href={crumbs[0].path}>{crumbs[0].name}</a>
      </nav>
    )
  }
  <h1 class="title" data-listing={kind}>{title}</h1>
  <p class="lede" data-pagefind-ignore>
    {count} followed through the public trial records. Not medical advice.
    <a href="/how-it-works">How a status is set</a>
  </p>
  <slot />
  <h2 class="bar sheet-title" id="pairs">Treatments and conditions</h2>
  <PairTable pairs={pairs} caption={title} />
</Base>
