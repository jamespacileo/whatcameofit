---
// A condition's page on the pair path: every pair for it or for a condition beneath it in MeSH.
// The build makes it, in the band and sheet the Worker gives every listing it makes
// (lib/listing-render.ts), so a condition's page and a treatment's look alike.
import Base from "../layouts/Base.astro";
import { conditionCardOf, conditionListings } from "../lib/pairs";
import { conditionListing } from "../lib/listing-view";
import { renderListingBand, renderListingSheet } from "../lib/listing-render";
import "./pair.css";

export function getStaticPaths() {
  return conditionListings().map((listing) => ({ params: { condition: listing.slug }, props: { listing } }));
}

const { listing } = Astro.props;
const view = conditionListing(listing, conditionCardOf({ descriptor_id: listing.descriptorId, label: listing.label, tree_numbers: listing.treeNumbers }));
---

<Base title={view.title} description={view.description} current="topics" framed>
  <Fragment slot="band" set:html={renderListingBand(view)} />
  {/* A condition's page credits no MeSH category, so no edition is named. */}
  <Fragment set:html={renderListingSheet(view, "")} />
</Base>

<script>
  // Narrows a listing's table by status or by a word (lib/blocks.ts, stageFilter).
  import "../scripts/pair-filter";
</script>
