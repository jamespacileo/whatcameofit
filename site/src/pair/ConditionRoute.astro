---
// A condition's page on the pair path: every pair for it or for a condition beneath it in MeSH.
import ListingPage from "./ListingPage.astro";
import { conditionCardOf, conditionListings } from "../lib/pairs";
import { renderCard } from "../lib/card-render";

export function getStaticPaths() {
  return conditionListings().map((listing) => ({ params: { condition: listing.slug }, props: { listing } }));
}

const { listing } = Astro.props;
const card = renderCard(conditionCardOf({ descriptor_id: listing.descriptorId, label: listing.label, tree_numbers: listing.treeNumbers }));
---

<ListingPage
  title={listing.label}
  kind="condition"
  description={`Treatments tested for ${listing.label.toLowerCase()}, and where the public trial records show each stands.`}
  pairs={listing.pairs}
>
  <Fragment set:html={card} />
  <p class="what-this-is">Lists this condition and the narrower ones beneath it. A condition is not a diagnosis.</p>
</ListingPage>
