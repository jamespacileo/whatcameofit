---
// The home page on the pair path: the lookup box with what the site holds under it, where
// every pair stands along the path, the latest dated records of their trials by day, the
// topics, and every treatment followed, folded. The claims home's parts (its counts line, its
// "Try" chips, its day-by-day list with a status beside each entry), recovered for pairs. The
// first version shows no reports (design decision 6).
import Base from "../layouts/Base.astro";
import Lookup from "../components/Lookup.astro";
import { SITE } from "../../site.config.mjs";
import { stageCounts, stageTrack, statusCell } from "../lib/blocks";
import { siteData } from "../lib/structured";
import { interventionListings, latestRecords, pairTotals, thenAndNow, topicsIndex, type LatestRecord } from "../lib/pairs";
import { formatDate } from "../lib/timetable";
import "./pair.css";

const LATEST = 12;
// The topics a reader is offered to try: the three with the most pairs.
const TRY = 3;
const latest = latestRecords(LATEST);
const days = new Map<string, LatestRecord[]>();
for (const record of latest) days.set(record.day, [...(days.get(record.day) ?? []), record]);
const topics = topicsIndex();
const tried = [...topics].sort((a, b) => b.count - a.count || a.title.localeCompare(b.title)).slice(0, TRY);
const interventions = interventionListings().filter((listing) => listing.pairs.length > 0);
const totals = pairTotals();
const example = thenAndNow();
const n = (count: number) => count.toLocaleString("en-GB");
---

<Base current="home" structured={siteData()}>
  <section class="band home" slot="band" aria-labelledby="lookup-title">
    <div class="wrap">
      <h1 class="title" id="lookup-title">What happened to that breakthrough?</h1>
      <p class="lede">{SITE.description}</p>
      <Lookup>
        <div class="under-box">
          {
            tried.length > 0 && (
              <p class="try" data-home="try">
                <span>Try</span>
                {tried.map((topic) => <a class="chip" href={`/topic/${topic.slug}`}>{topic.title.toLowerCase()}</a>)}
              </p>
            )
          }
          {
            totals.pairs > 0 && (
              <p class="holds" data-home="holds">
                {n(totals.pairs)} {totals.pairs === 1 ? "treatment and condition" : "treatments and conditions"} followed in{" "}
                <a href="/topics">{topics.length} {topics.length === 1 ? "topic" : "topics"}</a>, through {n(totals.trials)}{" "}
                {totals.trials === 1 ? "registered trial" : "registered trials"}.
              </p>
            )
          }
        </div>
      </Lookup>

      {/* The site's idea in one look (the claims home's "then and now" card, on pairs): one
          pair's first registry record, how long ago that was, and where it stands now, in
          the well a pair page shows its status in. The pair is chosen by rule (lib/pairs,
          thenAndNow). Not drawn on a phone, where the first screen keeps to the box. */}
      {
        example && (
          <a class="then-now" href={`/${example.address}`} data-home="then-now" data-pair={example.address} data-event={example.first.key} data-pagefind-ignore>
            <div class="then">
              <p class="then-when">
                First registry record <span class="unbroken">{formatDate(example.first.day)}</span> · {example.first.label}, {example.first.nctId}
              </p>
              <p class="then-title">{example.title}</p>
            </div>
            <p class="then-gap">
              {example.on && <span data-years-on>{example.on}</span>}
              <svg class="then-arrow" viewBox="0 0 44 16" width="44" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 8h41" />
                <path d="m36 2 6 6-6 6" />
              </svg>
            </p>
            <div class="now-well">
              <p class="now-tab">Where it stands</p>
              <p class="now-label" data-status={example.statusCode}>{example.status}</p>
              <p class="now-gloss">{example.gloss}</p>
              <Fragment set:html={stageTrack(example.statusCode, { ends: true, off: true })} />
              <p class="now-latest">
                Latest record {formatDate(example.latestDay)} · {example.trials} {example.trials === 1 ? "registered trial" : "registered trials"}
              </p>
            </div>
          </a>
        )
      }
    </div>
  </section>

  {
    totals.pairs > 0 && (
      <section class="home-part" aria-labelledby="home-standing" data-home="standing">
        <h2 class="bar sheet-title" id="home-standing">Where they stand</h2>
        <p class="note">
          Each treatment and condition is counted once, at the furthest place its trials have reached. A place is a
          position in the records, not a result. <a href="/how-it-works">How a status is set</a>
        </p>
        <Fragment set:html={stageCounts(totals.rows, "Treatments and conditions followed, by status")} />
      </section>
    )
  }

  <section class="home-part" aria-labelledby="latest" data-home="latest">
    <h2 class="bar sheet-title" id="latest">Latest records</h2>
    {
      latest.length === 0 ? (
        <p>No dated record yet.</p>
      ) : (
        <>
          <p class="note">The newest dated events in the registry records of the trials followed, and where each treatment stands now.</p>
          <div class="days">
            {[...days].map(([day, records]) => (
              <section class="day" aria-label={formatDate(day)}>
                <h3 class="day-head">{formatDate(day)}</h3>
                <ul class="day-rows">
                  {records.map((record) => (
                    <li class="day-row" data-pair={record.address} data-event={record.key}>
                      <div class="what">
                        <p class="row-note">Registry record · {record.nctId}</p>
                        <p class="said">
                          {record.label}: <a href={`/${record.address}`}>{record.title}</a>
                        </p>
                        {record.others > 0 && (
                          <p class="row-note">
                            The same trial is followed for {record.others} other{" "}
                            {record.others === 1 ? "treatment and condition" : "treatments and conditions"}.
                          </p>
                        )}
                      </div>
                      <div class="now">
                        <p class="row-note">Status now</p>
                        <Fragment set:html={statusCell(record.statusCode, record.status)} />
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </>
      )
    }
    <p class="more"><a href="/changes.xml">Status changes feed</a></p>
  </section>

  <section class="home-part" aria-labelledby="home-topics" data-home="topics">
    <h2 class="bar sheet-title" id="home-topics">Topics</h2>
    <ul class="topic-chips">
      {
        topics.map((topic) => (
          <li data-topic={topic.slug}>
            <a class="chip" href={`/topic/${topic.slug}`}>
              {topic.title} <span class="count">{n(topic.count)}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/topics">Every topic</a> · <a href="/clinical">Clinical categories</a> · <a href="/explore">Pick several at once</a></p>
  </section>

  <section class="home-part" aria-labelledby="home-treatments" data-home="treatments">
    <h2 class="bar sheet-title" id="home-treatments">Treatments followed</h2>
    {/* Every treatment's page stays one link from the home page, folded: on the rehearsal
        bundle the list is some 3,000 names, and it stood open as most of the page. */}
    <details class="all-treatments">
      <summary>All {n(interventions.length)} {interventions.length === 1 ? "treatment" : "treatments"}, A to Z</summary>
      <ul>
        {
          interventions.map((listing) => (
            <li data-intervention={listing.slug}>
              <a href={`/intervention/${listing.slug}`}>{listing.name}</a> <span class="count">{listing.pairs.length}</span>
            </li>
          ))
        }
      </ul>
    </details>
  </section>
</Base>

<style>
  .home-part {
    max-width: 60rem;
    margin: 0 auto var(--section-space, 2.5rem);
  }
  .home-part:first-of-type {
    margin-top: var(--section-space, 2.5rem);
  }
  .home-part .note,
  .row-note {
    margin: 0;
    font-size: var(--note-size);
    color: var(--muted);
  }
  .home-part > .note {
    max-width: var(--measure);
    margin-bottom: 0.9rem;
  }
  .more {
    margin: 1rem 0 0;
  }

  /* Under the box: topics to try, and what the site holds. */
  .under-box {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
    justify-items: center;
  }
  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-s);
  }
  .try .chip {
    padding-inline: 0.8rem;
  }
  .holds {
    margin: 0;
    font-size: var(--text-s);
    color: var(--muted);
  }

  /* The example under the box, in the claims home's drawing: a white card that is one link,
     "then" at its left, the gap between, and "now" as the record band's dark well with its
     heading a tab on its top edge. Nothing in it is coloured by status. */
  .then-now {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 19rem);
    align-items: center;
    column-gap: 1.75rem;
    max-width: 54rem;
    margin: 2.1rem auto 0;
    padding: 1.25rem 1.25rem 1.25rem 1.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    text-align: left;
    text-decoration: none;
    transition: border-color 160ms var(--ease-out);
  }
  .then-now:hover {
    border-color: var(--ring);
  }
  .then-now:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius);
  }
  .then-now p {
    margin: 0;
  }
  .then-when {
    font-size: var(--text-s);
    color: var(--muted);
  }
  .then-now .then-title {
    margin-top: 0.35rem;
    font-family: var(--display);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.012em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .then-now:hover .then-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
  .then-arrow {
    display: block;
  }
  .then-gap {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    color: var(--muted);
    font-size: var(--text-s);
    white-space: nowrap;
  }
  .now-well {
    /* The band's light blue is the masthead's own: named here so the marked step is filled. */
    --on-navy: #8ec1f5;
    --ink: var(--on-navy-ink);
    --blue: var(--on-navy);
    --muted: var(--navy-soft);
    --ring: #9db4d2;
    --paper: var(--band-card);
    position: relative;
    margin-top: 1.9rem;
    padding: 0.85rem 1.1rem 0.95rem;
    border: 1px solid var(--band-card-rule);
    border-radius: 0 var(--radius-s) var(--radius-s) var(--radius-s);
    background: var(--band-card);
    color: var(--on-navy-ink);
  }
  .now-tab {
    position: absolute;
    bottom: 100%;
    left: -1px;
    display: flex;
    align-items: center;
    height: 1.9rem;
    padding: 0 0.95rem;
    border: 1px solid var(--band-card-rule);
    border-bottom: 0;
    border-radius: var(--radius-s) var(--radius-s) 0 0;
    background: var(--band-card);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .now-label {
    font-size: var(--text-status);
    font-weight: 700;
    line-height: 1.15;
    color: var(--on-navy);
  }
  .then-now .now-gloss,
  .then-now .now-latest {
    margin-top: 0.25rem;
    font-size: var(--text-s);
    color: var(--navy-soft);
  }
  .now-well :global(.track) {
    margin-top: 0.6rem;
  }
  @media (max-width: 52rem) {
    .then-now {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.9rem;
      padding: 1.1rem;
    }
    /* Stacked, the arrow is short and points down, from the first record to where it stands. */
    .then-gap {
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
      gap: 0.5rem;
      min-height: 1.75rem;
    }
    .then-arrow {
      width: 1.65rem;
      height: auto;
      transform: rotate(90deg);
    }
  }
  @media (max-width: 40rem) {
    .then-now {
      display: none;
    }
  }
  @media print {
    .then-now {
      border: 0;
      padding: 0;
    }
  }

  /* The latest records: a white sheet a day, each record a row with its status beside it. */
  .days {
    display: grid;
    gap: 1.1rem;
  }
  .day {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .day-head {
    margin: 0;
    padding: 0.5rem 1.1rem;
    font-family: inherit;
    font-size: var(--label-size);
    font-weight: 600;
    color: var(--muted);
    background: var(--table-head);
  }
  .day-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .day-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 0.6rem 1.5rem;
    padding: 0.95rem 1.1rem;
    border-top: 1px solid var(--row-rule);
  }
  .said {
    margin: 0.2rem 0;
    font-size: var(--text-l);
    font-weight: 600;
    line-height: 1.3;
  }
  .now {
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-s);
    background: var(--panel);
    align-self: start;
  }
  .now .row-note {
    margin-bottom: 0.25rem;
  }
  @media (max-width: 40rem) {
    .day-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .topic-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .topic-chips .chip {
    padding: 0.35rem 0.8rem;
    font-size: var(--text-m);
  }
  .topic-chips .count {
    margin-right: -0.4rem;
  }

  .all-treatments summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--blue);
  }
  .all-treatments ul {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    columns: 18rem;
    column-gap: 2rem;
  }
  .all-treatments li {
    break-inside: avoid;
    padding-block: 0.15rem;
  }
  .all-treatments .count {
    color: var(--muted);
    font-size: var(--text-s);
  }
</style>
