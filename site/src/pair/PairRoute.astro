---
// The pair page at /{address} (openspec pairs-site, pair-pages), for the pairs built ahead
// (decision 2). Its content is lib/pair-render.ts's, which the Worker also uses for the page
// it makes on request from the shell (PairShell.astro), so the two are the same.
import Base from "../layouts/Base.astro";
import { cardAlt } from "../lib/card";
import { pairCardFor } from "../lib/card-image";
import { pairDescription, renderPairBand, renderPairSheet } from "../lib/pair-render";
import { builtAheadPages, pairBundle, pairPages, pairView } from "../lib/pairs";
import { narrowerPairs } from "../lib/pair-view";
import "./pair.css";

export function getStaticPaths() {
  return Object.entries(builtAheadPages()).map(([address, page]) => ({ params: { address }, props: { page } }));
}

const { page } = Astro.props;
const view = pairView(page);
// The intervention's page file, which the Worker reads too for a page it makes on request.
const narrower = narrowerPairs(page, pairBundle()?.pages.PairInterventionPage?.[page.row.intervention.slug] ?? null, new Set(Object.keys(pairPages())));
---

<Base
  title={view.title}
  description={pairDescription(view)}
  image={`/og/${view.address}.png`}
  imageAlt={cardAlt(pairCardFor(page))}
  oembed={`/oembed/${view.address}.json`}
  framed
>
  <Fragment slot="band" set:html={renderPairBand(view)} />
  <Fragment set:html={renderPairSheet(view, narrower)} />
</Base>
