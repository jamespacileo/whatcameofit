---
// A clinical category's page on the pair path: the categories above and beneath it, and
// every pair whose condition sits at or beneath it in MeSH.
import ListingPage from "./ListingPage.astro";
import MeshCredit from "../components/MeshCredit.astro";
import { categoryPath } from "../lib/clinical";
import { categoryListings } from "../lib/pairs";

export function getStaticPaths() {
  return categoryListings().map((listing) => ({ params: { category: listing.descriptorId }, props: { listing } }));
}

const { listing } = Astro.props;
---

<ListingPage
  title={listing.label}
  kind="category"
  description={`Treatments tested for conditions in the MeSH category ${listing.label}, and where each stands.`}
  pairs={listing.pairs}
  crumbs={[
    { name: "Clinical categories", path: "/clinical" },
    { name: listing.label, path: categoryPath(listing.descriptorId) },
  ]}
>
  <p class="what-this-is">
    MeSH category {listing.descriptorId}{listing.treeNumbers.length > 0 && `, tree ${listing.treeNumbers.join(", ")}`}.
    Lists the pairs whose condition is this category or one beneath it. A category is not a diagnosis and not advice.
  </p>
  {
    listing.broader.length > 0 && (
      <p data-broader>
        Broader:{" "}
        {listing.broader.map((one, index) => (
          <>
            {index > 0 && ", "}
            <a href={categoryPath(one.descriptorId)}>{one.label}</a>
          </>
        ))}
      </p>
    )
  }
  {
    listing.narrower.length > 0 && (
      <ul data-narrower>
        {listing.narrower.map((one) => (
          <li>
            <a href={categoryPath(one.descriptorId)}>{one.label}</a> ({one.count})
          </li>
        ))}
      </ul>
    )
  }
  <MeshCredit />
</ListingPage>
