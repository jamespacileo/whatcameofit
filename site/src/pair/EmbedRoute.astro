---
// A pair's status, made to sit inside another site's frame (openspec pairs-site). It asks no
// other host for anything, stores nothing, and its links open in the whole window.
import "../styles/global.css";
import { SITE } from "../../site.config.mjs";
import { CARD_NOTICE, clip, monthAndYear } from "../lib/card";
import { NOTICES } from "../lib/notices";
import { builtAheadPages, pairView } from "../lib/pairs";

export function getStaticPaths() {
  return Object.entries(builtAheadPages()).map(([address, page]) => ({ params: { address }, props: { page } }));
}

const view = pairView(Astro.props.page);
const title = `${view.intervention} for ${view.condition.toLowerCase()}`;
const page = `${SITE.url}/${view.address}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The pair page is the one to find; this is only its window elsewhere. */}
    <meta name="robots" content="noindex" />
    <title>{title} | {SITE.name}</title>
  </head>
  <body class="embed">
    <article>
      <p class="embed-name">
        <a href={page} target="_top">{SITE.name}</a>
        <span>{CARD_NOTICE}</span>
      </p>
      <h1>{clip(title, 160)}</h1>
      <div class="embed-status" data-pair-status={view.statusCode}>
        <strong>{view.status}</strong>. {view.gloss}.
      </div>
      <p class="embed-more">
        <span>Checked {monthAndYear(view.asOf)}.</span>
        <a href={page} target="_top">Records and sources</a>
      </p>
      <footer>
        {NOTICES.map((notice) => <p>{notice}</p>)}
        <p>Data sources: ClinicalTrials.gov, Medical Subject Headings (MeSH).</p>
      </footer>
    </article>
  </body>
</html>
