---
// The frame of a pair page the Worker makes on request (worker/pairs.mjs): the site's layout
// with marked places for the page's title, description, address and content, which the Worker
// fills from lib/pair-render.ts. It records the bundle version this build read, the only
// version the Worker reads pages of. The Worker never serves the frame itself.
import Base from "../layouts/Base.astro";
import { pairBundle, pairBundleVersion } from "../lib/pairs";
import { meshEdition } from "../lib/clinical";
import { rendererDigest } from "../lib/renderer-digest";
import "./pair.css";

const version = pairBundleVersion();
// The MeSH vocabulary's year, for the credit a category page made on request carries: the year
// the bundle's manifest states. The bundle does not state it yet, so the credit names no year
// until it does.
const edition = meshEdition(pairBundle()?.manifest?.snapshot?.mesh_years ?? []);
---

<Base title="__PAIR_TITLE__" description="__PAIR_DESCRIPTION__" canonicalPath="/__PAIR_ADDRESS__" oembed="/oembed/__PAIR_ADDRESS__.json" framed>
  <Fragment slot="band" set:html="<!--pair-band-->" />
  <Fragment set:html="<!--pair-sheet-->" />
  <template data-pair-version={version} data-mesh-edition={edition} data-renderer={rendererDigest()}></template>
</Base>

<script>
  // Narrows a listing's table by status or by a word (lib/blocks.ts, stageFilter).
  import "../scripts/pair-filter";
</script>
