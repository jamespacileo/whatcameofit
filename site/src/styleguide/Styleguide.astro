---
// The styleguide (openspec pairs-site, shared components): every building block of
// lib/blocks.ts, and the whole pieces the renderers make of them, drawn with the bundle this
// build reads, so each is seen as a page shows it. Built only when STYLEGUIDE=1, which staging
// and pull request previews set and production never does (astro.config.mjs; scripts/deploy.mjs
// stops a production build that holds it). Never indexed.
import Base from "../layouts/Base.astro";
import { band, bandTitle, basisMark, crumbs, sectionList, embedFooter, stageTrack, escape, eventList, followedLine, meshCredit, pairTable, sheet, sheetHeading, statusWords } from "../lib/blocks";
import { pairBundle } from "../lib/pairs";
import { meshEdition } from "../lib/clinical";
import { NOTICES } from "../lib/notices";
import { PAIR_SOURCES } from "../lib/pair-record";
import { narrowerPairs, pairView } from "../lib/pair-view";
import { eventWhen, renderPairBand, renderPairSheet } from "../lib/pair-render";
import { categoryListing, interventionListing, topicListing } from "../lib/listing-view";
import { renderListingBand, renderListingSheet } from "../lib/listing-render";
import { renderEmbedArticle, renderEmbedRegistries } from "../lib/embed-render";
import { renderCard } from "../lib/card-render";
import { trialsTable } from "../lib/trials-table";
import { recordStrip, stripKey, stripKinds, stripOf } from "../lib/record-strip";
import { SITE } from "../../site.config.mjs";
import "../pair/pair.css";

const bundle = pairBundle();
const pages = bundle.pages;
const pairs = Object.values(pages.PairPage ?? {}) as any[];
const published = new Set(Object.keys(pages.PairPage ?? {}));
const categories = new Set(Object.keys(pages.PairClinicalCategoryPage ?? {}));
const edition = meshEdition(bundle.manifest?.snapshot?.mesh_years ?? []);

// The pair with the most trials, and one with posted results when the bundle has one: the
// pieces at their fullest. A bundle with no pair page draws no pair's piece, and says so.
const byTrials = [...pairs].sort((a, b) => b.trials.length - a.trials.length || a.row.pair.address.localeCompare(b.row.pair.address));
const fullest = byTrials[0] ?? null;
const view = fullest ? pairView(fullest) : null;
const narrower = fullest ? narrowerPairs(fullest, pages.PairInterventionPage?.[fullest.row.intervention.slug] ?? null, published) : [];
const withResults = pairs.find((page) => page !== fullest && page.trials.some((trial: any) => trial.findings?.outcomes?.length)) ?? null;

// For each kind of listing, the file whose page lists the most published pairs, and a card
// that draws something: a sample shows the piece, not its empty state, where the bundle can.
type Listing = ReturnType<typeof interventionListing>;
const fullestOf = (listings: Listing[]) => [...listings].sort((a, b) => b.rows.length - a.rows.length || a.path.localeCompare(b.path))[0] ?? null;
const listings = [
  ["An intervention's listing", fullestOf(Object.values(pages.PairInterventionPage ?? {}).map((file) => interventionListing(file, published)))],
  ["A clinical category's listing", fullestOf(Object.values(pages.PairClinicalCategoryPage ?? {}).map((file) => categoryListing(file, published, categories)))],
  ["A topic's listing", fullestOf(Object.values(pages.PairTopicPage ?? {}).map((file) => topicListing(file, published)))],
].filter(([, listing]) => listing) as [string, Listing][];
// A listing can contain most of the release. The styleguide illustrates its layout with the
// first rows, and the full listings keep the rest.
const LISTING_SAMPLE_ROWS = 16;
const rows = fullestOf(listings.map(([, listing]) => listing))?.rows.slice(0, LISTING_SAMPLE_ROWS) ?? [];
const card = listings.map(([, listing]) => (listing.card ? renderCard(listing.card) : "")).find(Boolean) ?? "";

const NO_PAIR = `<p>This bundle has no pair page to draw it with.</p>`;

// The record strip's sample: the pair whose strip has the most events, results among them where
// any has results; only a pair whose registries have a day of last check has a strip.
const strips = pairs.map((page) => pairView(page)).map((one) => ({ view: one, strip: stripOf(one) })).filter((one) => one.strip);
const stripped = strips.sort((a, b) => Number(b.strip!.counts.results > 0) - Number(a.strip!.counts.results > 0) || b.strip!.marks.length - a.strip!.marks.length || a.view.address.localeCompare(b.view.address))[0] ?? null;

/** Each block: its name in lib/blocks.ts, what it is for, and what it draws here. */
const blocks: { name: string; about: string; html: string; framed?: boolean; railed?: boolean }[] = [
  {
    name: "band",
    about: "The navy record band at the head of a record page.",
    framed: true,
    html: view ? band(` aria-label="${escape(view.title)}"`, [bandTitle(view.title), followedLine("A treatment and a condition,", "what-this-is")]) : NO_PAIR,
  },
  {
    name: "crumbs",
    about: "Where a page sits, its links joined by a middle dot.",
    framed: true,
    html: view ? band("", [crumbs("The treatment and the condition", [{ href: `/intervention/${view.interventionSlug}`, label: view.intervention }, { href: `/condition/${view.conditionSlug}`, label: view.condition }])]) : NO_PAIR,
  },
  { name: "bandTitle", about: "A record page's title, in the band's heading face.", framed: true, html: view ? band("", [bandTitle(view.title)]) : NO_PAIR },
  { name: "followedLine", about: "What a record page is, in one line, with the way to how a status is set.", framed: true, html: band("", [followedLine("A treatment and a condition,", "what-this-is")]) },
  { name: "statusWords", about: "A status and its gloss as a sentence: the status in bold, never coloured.", html: view ? `<p>${statusWords(view.status, view.gloss)}</p>` : NO_PAIR },
  { name: "sheet", about: "The white sheet under a band, in the site's frame.", html: sheet([`<p>The sheet holds the page's content.</p>`]) },
  { name: "sheetHeading", about: "A heading of the sheet, with its place's address.", html: sheet([sheetHeading("The trials", "trials")]) },
  {
    name: "eventList",
    about: "A dated list of what happened; a date the registry expects is marked so.",
    html: view
      ? sheet([eventList("", view.explainedBy.map((event) => `<li>${eventWhen(event.day, event.estimated)}: ${escape(event.label)}, ${escape(event.nctId)}</li>`))])
      : NO_PAIR,
  },
  { name: "pairTable", about: "A list of pairs: each pair's page, where it stands and its trials.", html: sheet([pairTable("Pairs in the styleguide", rows)]) },
  { name: "meshCredit", about: "The credit NLM's terms ask for wherever a MeSH category is shown.", html: sheet([meshCredit(edition)]) },
  {
    name: "trialsTable",
    about: "A pair's trials as a table (lib/trials-table.ts): results posted first, then by furthest phase; each row opens to its record. A pair page shows it from three trials up (TRIALS_TABLE_FROM in lib/pair-render.ts); fewer stay as entries.",
    html: view ? sheet([trialsTable(view.trials)]) : NO_PAIR,
  },
  {
    name: "stageTrack",
    about: "Where a status sits on the path, beside the status in words: a position, not progress; with the place named, and each place named.",
    html: view
      ? `<p>${statusWords(view.status, view.gloss)}</p>${stageTrack(view.statusCode, { ends: true })}<p>${stageTrack(view.statusCode, { named: true })}</p><p>Off the path: ${stageTrack("not_a_place", { off: true })}</p>`
      : NO_PAIR,
  },
  {
    name: "recordStrip",
    about: "A pair's dated trial records on one time axis to the last check (lib/record-strip.ts), with its key. Not on a pair page yet.",
    html: stripped
      ? `<p>${escape(stripped.view.title)}</p>${recordStrip(stripped.view)}${stripKey(stripKinds(stripped.strip!))}`
      : `<p>No pair in this bundle has a day its registries were last checked, so none has a strip.</p>`,
  },
  {
    name: "sectionList",
    about: "The sections of a page beside its sheet, the one in view marked; one row of chips on a narrow screen. Not on a pair page yet.",
    framed: true,
    railed: true,
    html: view
      ? renderPairSheet(view, narrower).replace(
          `<div class="frame no-rail"><div class="sheet">`,
          `<div class="frame">${sectionList("On this page", [
            { id: "why", name: "Why this status" },
            { id: "trials", name: "The trials", count: view.trials.length },
            { id: "history", name: "How the status changed" },
            ...(view.otherNames.length > 0 || view.approach ? [{ id: "about", name: "About the treatment" }] : []),
          ])}<div class="sheet">`,
        )
      : NO_PAIR,
  },
  { name: "basisMark", about: "Marks a record the status rests on: the blue diamond, named once in a key.", html: `<p>${basisMark(false)} Basis of status</p>` },
  {
    name: "embedFooter",
    about: "The footer of an embed: the notices every page carries and the data sources by name.",
    html: view ? `<div class="embed"><article>${embedFooter(NOTICES, PAIR_SOURCES, renderEmbedRegistries(view))}</article></div>` : NO_PAIR,
  },
];

/** Whole pieces, as the pages carry them. */
const pieces: { name: string; html: string; framed?: boolean }[] = [
  ...(view ? [{ name: `A pair's page: ${view.title}`, framed: true, html: renderPairBand(view) + renderPairSheet(view, narrower) }] : []),
  ...(withResults ? [{ name: `Posted results: ${pairView(withResults).title}`, framed: true, html: renderPairBand(pairView(withResults)) + renderPairSheet(pairView(withResults)) }] : []),
  ...listings.map(([name, listing]) => {
    const sample = { ...listing, rows: listing.rows.slice(0, LISTING_SAMPLE_ROWS) };
    return { name: `${name}: ${listing.title}`, framed: true, html: renderListingBand(sample) + renderListingSheet(sample, edition) };
  }),
  ...(card ? [{ name: "A knowledge card", html: card }] : []),
  ...(view
    ? [{ name: "An embed", html: `<div class="embed"><article>${renderEmbedArticle(view, SITE.name, SITE.url)}${embedFooter(NOTICES, PAIR_SOURCES, renderEmbedRegistries(view))}</article></div>` }]
    : []),
];

/** A sample's own ids, so two samples never share one and a link reaches the one it names: its
 * links within itself follow. */
const namespaced = (html: string, prefix: string) =>
  html.replace(/ id="([^"]+)"/g, (_, id) => ` id="${prefix}-${id}"`).replace(/ href="#([^"]+)"/g, (_, id) => ` href="#${prefix}-${id}"`);
---

<Base title="Styleguide" description="The building blocks of the site's pages, drawn with the bundle this build reads." noindex>
  <h1 class="title">Styleguide</h1>
  <p class="lede styleguide-text">
    The building blocks of the site's pages (<code>site/src/lib/blocks.ts</code>) and the pieces the pages make of them, drawn with
    bundle {bundle.version}, {pairs.length} pairs. Listing examples show up to {LISTING_SAMPLE_ROWS} rows.
  </p>
  <nav aria-label="Styleguide contents">
    <ul>
      {blocks.map((block) => <li><a href={`#block-${block.name}`}>{block.name}</a></li>)}
      {pieces.map((piece, index) => <li><a href={`#piece-${index}`}>{piece.name}</a></li>)}
    </ul>
  </nav>
  <h2>Blocks</h2>
  {
    blocks.map((block) => (
      <section class="styleguide-entry" id={`block-${block.name}`} data-block={block.name}>
        <h3><code>{block.name}</code></h3>
        <p class="styleguide-text">{block.about}</p>
        <div class:list={["styleguide-sample", { framed: block.framed, railed: block.railed }]}>
          <Fragment set:html={namespaced(block.html, `block-${block.name}`)} />
        </div>
      </section>
    ))
  }
  <h2>Pieces</h2>
  {
    pieces.length === 0 ? (
      <p>This bundle has no page to draw a piece with.</p>
    ) : (
      pieces.map((piece, index) => (
        <section class="styleguide-entry" id={`piece-${index}`} data-piece>
          <h3>{piece.name}</h3>
          <div class:list={["styleguide-sample", { framed: piece.framed }]}>
            <Fragment set:html={namespaced(piece.html, `piece-${index}`)} />
          </div>
        </section>
      ))
    )
  }
</Base>

<script>
  import "../scripts/section-list";
</script>

<style>
  .styleguide-text {
    max-width: var(--measure);
  }
  .styleguide-entry {
    margin-block: 2.5rem;
  }
  .styleguide-sample {
    border: 1px dashed var(--rule);
    border-radius: 0.85rem;
    padding: 1rem;
    overflow-x: auto;
  }
  /* A record page's pieces at the width the page gives them: the band and the frame set their
     own measure. */
  /* A sample with a section list scrolls with the page, so the list stays sticky to it. */
  .styleguide-sample.railed {
    overflow: visible;
  }
  .styleguide-sample.framed {
    background: var(--ground);
    padding: 0;
    margin-inline: calc(50% - 50vw);
    border-radius: 0;
    border-inline: 0;
  }
</style>
