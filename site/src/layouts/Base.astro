---
import "../styles/global.css";
// Preloaded so the first paint is already in the site's face and headings do not reflow.
import faceUrl from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import { SITE } from "../../site.config.mjs";
import { CARD_NOTICE } from "../lib/card";
import { data, listedTopics } from "../lib/export";
import { NOTICES, PREVIEW_NOTE } from "../lib/notices";
// Stops a public build whose configured address is a local one.
import "../lib/public-build";
import { canonicalAddress } from "../lib/structured";
import { formatDate } from "../lib/timetable";

interface Props {
  title?: string;
  /** A shorter title for the browser tab and search results; the full one is still shared. */
  tabTitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  current?: "home" | "topics" | "approved";
  /** Structured data for search engines, written into the page as JSON-LD. */
  structured?: Record<string, unknown>;
}

const {
  title,
  tabTitle,
  description = SITE.description,
  image,
  imageAlt,
  current,
  structured,
} = Astro.props;
const canonical = canonicalAddress(Astro.url.pathname);
// "<" is escaped so that no text in the data can close the script element.
const structuredJson = structured ? JSON.stringify(structured).replace(/</g, "\\u003c") : null;
// The name ends in its own punctuation, so the tagline follows it with a space.
const pageTitle =
  (tabTitle ?? title) ? `${tabTitle ?? title} | ${SITE.name}` : `${SITE.name} ${SITE.tagline}`;
// A page with no card of its own shares the site's: the mark, the name and the notice.
const imageUrl = new URL(image ?? "/brand-card.png", Astro.site).href;
// What the site's own card says, for a reader who cannot see it.
const imageText = image ? imageAlt : `${SITE.name} ${SITE.tagline}. ${CARD_NOTICE}.`;
// One topic is linked by name. With several, the item leads to the list of them all.
const topics = listedTopics;
const topicLink =
  topics.length === 1
    ? { href: `/topic/${topics[0].slug}`, label: topics[0].title, here: "page" as const }
    : topics.length > 1
      ? { href: "/topics", label: "Topics", here: "page" as const }
      : null;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Checking the source? Same. Every record on this page links to its own. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* For a browser or a search result that does not draw the vector icon. */}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href={faceUrl} crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={`${SITE.name} Anniversaries`}
      href="/anniversaries.xml"
    />
    {structuredJson && <script type="application/ld+json" is:inline set:html={structuredJson} />}
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={imageUrl} />
    {imageText && <meta property="og:image:alt" content={imageText} />}
    <meta name="twitter:card" content="summary_large_image" />
    {data.preview && <meta name="robots" content="noindex" />}
    {/* The name's animation plays on the first page of a visit only. */}
    <script is:inline>
      try {
        if (sessionStorage.getItem("seen")) document.documentElement.classList.add("seen");
        else sessionStorage.setItem("seen", "1");
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="masthead">
      <div class="wrap">
        <a class="name" href="/" aria-label={SITE.name}>
          <img class="mark" src="/favicon.svg" alt="" width="26" height="26" />
          <span class="lead" aria-hidden="true">{SITE.wordmark[0]}</span>
          <span class="tail" aria-hidden="true">{SITE.wordmark[1]}</span>
          <svg class="ask" viewBox="0 0 20 30" aria-hidden="true">
            <path
              class="hook"
              pathLength="1"
              d="M4.2 8.8a5.9 5.9 0 1 1 9 5c-2.1 1.3-3.2 2.4-3.2 4.7"></path>
            <circle class="dot" cx="10" cy="26" r="3.6"></circle>
          </svg>
        </a>
        <nav aria-label="Site">
          <ul>
            <li><a href="/" aria-current={current === "home" ? "page" : undefined}>Look up</a></li>
            {
              topicLink && (
                <li>
                  <a
                    href={topicLink.href}
                    aria-current={current === "topics" && Astro.url.pathname.replace(/\/$/, "") === topicLink.href ? topicLink.here : undefined}
                  >
                    {topicLink.label}
                  </a>
                </li>
              )
            }
            <li>
              <a href="/it-happened" aria-current={current === "approved" ? "page" : undefined}>
                It happened
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    {
      data.preview && (
        <div class="preview-note" role="note">
          <div class="wrap">{PREVIEW_NOTE}</div>
        </div>
      )
    }

    <main id="content">
      {/* A page's opening band runs the full width, straight under the masthead. */}
      <slot name="band" />
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="colophon">
      <div class="wrap">
        <div class="notices">
          {NOTICES.map((notice) => <p>{notice}</p>)}
        </div>
        <nav class="more" aria-label="About this site">
          <a href="/how-it-works">How it works</a>
          <a href="/anniversaries">Anniversaries</a>
          <a href="/data">Data</a>
          <a href="/privacy">Privacy</a>
        </nav>
        <div class="details">
          <p>
            Data sources:{" "}
            {
              data.sources.map((source, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={source.url}>{source.name}</a>
                </>
              ))
            }. Records are shown as the registries gave them; summaries are ours.
          </p>
          <p>
            {
              data.last_checked_at
                ? `Registries last checked ${formatDate(data.last_checked_at)}.`
                : "Registries not yet checked."
            }
            {` Pages built ${formatDate(data.generated_at)}. We will check again.`}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Panels open on a tap or a key press with no script. With a mouse they also open
  // on hover, and a click then keeps one open until it is dismissed.
  // A link inside a panel leads somewhere on the page, so the panel steps aside.
  for (const panel of document.querySelectorAll<HTMLElement>(".pop")) {
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a") && panel.matches(":popover-open")) {
        panel.hidePopover();
      }
    });
  }

  if (matchMedia("(hover: hover)").matches) {
    for (const trigger of document.querySelectorAll<HTMLButtonElement>("[popovertarget]")) {
      const panel = document.getElementById(trigger.getAttribute("popovertarget")!)!;
      let timer: number | undefined;
      let pinned = false;
      const isOpen = () => panel.matches(":popover-open");
      const open = () => {
        clearTimeout(timer);
        timer = setTimeout(() => !isOpen() && panel.showPopover(), 150);
      };
      const close = () => {
        clearTimeout(timer);
        timer = setTimeout(() => !pinned && isOpen() && panel.hidePopover(), 250);
      };
      trigger.addEventListener("mouseenter", open);
      trigger.addEventListener("mouseleave", close);
      panel.addEventListener("mouseenter", () => clearTimeout(timer));
      panel.addEventListener("mouseleave", close);
      trigger.addEventListener("click", (event) => {
        clearTimeout(timer);
        if (isOpen() && !pinned) event.preventDefault();
        pinned = true;
      });
      panel.addEventListener("toggle", () => {
        if (!isOpen()) pinned = false;
      });
    }
  }
</script>
