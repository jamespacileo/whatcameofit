---
import "../styles/global.css";
// Preloaded so the first paint is already in the site's face and headings do not reflow.
import faceUrl from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import { SITE } from "../../site.config.mjs";
import { data, listedTopics } from "../lib/export";
import { NOTICES } from "../lib/notices";
import { formatDate } from "../lib/timetable";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  current?: "home" | "topics" | "approved";
}

const { title, description = SITE.description, image, imageAlt, current } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const imageUrl = image ? new URL(image, Astro.site).href : null;
// One topic is linked by name. With several, the item leads to the list of them all.
const topics = listedTopics;
const topicLink =
  topics.length === 1
    ? { href: `/topic/${topics[0].slug}`, label: topics[0].title, here: "page" as const }
    : topics.length > 1
      ? { href: "/#topics", label: "Topics", here: "true" as const }
      : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={faceUrl} crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="article" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {imageUrl && <meta name="twitter:card" content="summary_large_image" />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="masthead">
      <div class="wrap">
        <a class="name" href="/">{SITE.name}</a>
        <nav aria-label="Site">
          <ul>
            <li><a href="/" aria-current={current === "home" ? "page" : undefined}>Search</a></li>
            {
              topicLink && (
                <li>
                  <a
                    href={topicLink.href}
                    aria-current={current === "topics" ? topicLink.here : undefined}
                  >
                    {topicLink.label}
                  </a>
                </li>
              )
            }
            <li>
              <a href="/it-happened" aria-current={current === "approved" ? "page" : undefined}>
                It happened
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="content">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="colophon">
      <div class="wrap">
        <div class="notices">
          {NOTICES.map((notice) => <p>{notice}</p>)}
        </div>
        <div class="details">
          <p>
            Data sources:{" "}
            {
              data.sources.map((source, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={source.url}>{source.name}</a>
                </>
              ))
            }. Records are shown as the registries gave them; summaries are ours.
          </p>
          <p>
            {
              data.last_checked_at
                ? `Registries last checked ${formatDate(data.last_checked_at)}.`
                : "Registries not yet checked."
            }
            {` Pages built ${formatDate(data.generated_at)}.`}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
