---
import Base from "../../layouts/Base.astro";
import ClaimTable from "../../components/ClaimTable.astro";
import { data } from "../../lib/export";

export function getStaticPaths() {
  const years = new Set<string>();
  for (const claim of data.claims) {
    const year = claim.first_reported_date?.slice(0, 4);
    if (year) years.add(year);
  }
  return [...years].sort().map((year) => ({ params: { year } }));
}

const { year } = Astro.params;
const claims = data.claims
  .filter((claim) => claim.first_reported_date?.slice(0, 4) === year)
  .sort((a, b) => (a.first_reported_date! < b.first_reported_date! ? 1 : -1));
const approved = claims.filter((claim) => claim.status.code === "approved").length;
---

<Base
  title={`First reported in ${year}`}
  description={`Reported breakthroughs first reported in ${year} and where each stands now.`}
>
  <h1 class="title">First reported in {year}</h1>
  <p class="lede">
    {claims.length}{" "}
    {claims.length === 1 ? "reported breakthrough" : "reported breakthroughs"} tracked. Approvals on record:{" "}
    {approved} of {claims.length}.
  </p>

  <ClaimTable claims={claims} caption={`Claims first reported in ${year}`} filter />
</Base>
