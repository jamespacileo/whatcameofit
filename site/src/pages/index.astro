---
import Rss from "@lucide/astro/icons/rss";
import SlidersHorizontal from "@lucide/astro/icons/sliders-horizontal";
import Base from "../layouts/Base.astro";
import ClaimName from "../components/ClaimName.astro";
import Lookup from "../components/Lookup.astro";
import Outlet from "../components/Outlet.astro";
import Pager from "../components/Pager.astro";
import PromiseText from "../components/PromiseText.astro";
import StageFilter from "../components/StageFilter.astro";
import StageTrack from "../components/StageTrack.astro";
import StatusCell from "../components/StatusCell.astro";
import TopicChip from "../components/TopicChip.astro";
import { EXTENSION_OFFERED, SITE } from "../../site.config.mjs";
import { SUGGEST_SUBJECT, contactLink } from "../lib/contact.mjs";
import { calendarByMonth } from "../lib/anniversaries";
import { data, listedTopics } from "../lib/export";
import {
  longestWithoutSignal,
  promisesByDate,
  statusCountsByTopic,
  statusMoves,
} from "../lib/feed";
import { followedNameFor, recentReports } from "../lib/reports";
import { siteData } from "../lib/structured";
import { STATUS_LABELS, latestPromise } from "../lib/status";
import { formatDate } from "../lib/timetable";

// Every row of every list is on the page, read ten at a time.
const PAGE_SIZE = 10;
const reports = recentReports(data.claims, Infinity);
// Drawn only when a suggestion address is configured. Nothing is carried from here;
// the lookup's own answers carry a pasted article address.
const suggest = contactLink(SITE.suggestUrl, "", SUGGEST_SUBJECT);

// The home page names the topics with the most claims; the rest are one link away.
const topTopics = listedTopics
  .map((topic) => ({
    ...topic,
    count: data.claims.filter((claim) => claim.vertical === topic.slug).length,
  }))
  .sort((a, b) => b.count - a.count || a.title.localeCompare(b.title))
  .slice(0, 12);

// Each year in which a published claim was first reported, newest first, with its count.
const perYear = new Map<string, number>();
for (const claim of data.claims) {
  if (!claim.first_reported_date) continue;
  const year = claim.first_reported_date.slice(0, 4);
  perYear.set(year, (perYear.get(year) ?? 0) + 1);
}
const years = Array.from(perYear).sort((a, b) => b[0].localeCompare(a[0]));

// The headlines table sets the promise beside the status, as a claim page does. With no
// dated promise among the reports there is no amber column.
const anyPromise = reports.some((report) => latestPromise(report.claim) !== null);
const approvals = data.claims.filter((claim) => claim.status.code === "approved").length;

// The front page is one set of lists over the same claims, each in an order a reader
// comes back for. A list with nothing in it is not offered.
const moves = statusMoves(data.claims);
const promised = promisesByDate(data.claims);
const quiet = longestWithoutSignal(data.claims);
const views = [
  { id: "headlines", tab: "Headlines", count: reports.length },
  { id: "moved", tab: "Status changes", count: moves.length },
  { id: "promised", tab: "Promises", count: promised.length },
  { id: "quiet", tab: "No signal", count: quiet.length },
].filter((view) => view.id === "headlines" || view.count > 0);
// The lists can be narrowed to one topic; the counts on the path follow the topic.
const topicChoices = listedTopics
  .map((topic) => ({
    ...topic,
    count: data.claims.filter((claim) => claim.vertical === topic.slug).length,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
const topicCounts = statusCountsByTopic(data.claims);
// Every day of the calendar that has a first report. The reader's own today picks
// which is shown, so the page is true whenever it is read.
const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const calendarDays = calendarByMonth(data.claims).flatMap((month) => month.days);
---

<Base current="home" structured={siteData()}>
  {/* The lookup is what the site is for: it gets a band of its own under the masthead. */}
  <section class="band" slot="band" aria-labelledby="lookup-title">
    <div class="wrap">
      <h1 class="title" id="lookup-title">What happened to that breakthrough?</h1>
      <p class="lede">{SITE.description}</p>

      <Lookup />
    </div>
  </section>

  <div class="front">
  {/* The tally opens the lists, under the band: the band holds only the lookup. */}
  {
    data.claims.length > 0 && (
      <p class="tally">
        {data.claims.length} {data.claims.length === 1 ? "claim" : "claims"} tracked in{" "}
        <a href="/topics">
          {listedTopics.length} {listedTopics.length === 1 ? "topic" : "topics"}
        </a>
        . <a href="/it-happened">Approvals on record</a>: {approvals} of {data.claims.length}.
        {data.last_checked_at && (
          <>
            {" "}Registries last checked <span class="unbroken">{formatDate(data.last_checked_at)}</span>.
          </>
        )}
      </p>
    )
  }

  {/* The claims this reader follows, read from this browser's own storage by the script. */}
  <section class="following" id="following" hidden data-following>
    <h2 class="bar">Following</h2>
    <ul class="plain" data-following-list></ul>
    <p class="entry-note">Kept in this browser only.</p>
    <p class="visually-hidden" role="status" data-following-said></p>
  </section>

  {/* Filled in by the script from the dates on the rows below: what is dated since this
      reader's last visit, or in the last thirty days on a first one. */}
  <p class="since" hidden data-since></p>

  <div class="feed" data-feed>
  {
    data.claims.length > 0 && (
      <div class="scoreboard" data-scoreboard>
        {/* On a phone the counts and the topic choice wait behind this, so a headline is
            on the first screen. Shown by the script; without it everything is in view. */}
        <button
          type="button"
          class="narrow-toggle"
          aria-expanded="false"
          aria-controls="narrow-body"
          hidden
          data-narrow
        >
          <SlidersHorizontal size={16} stroke-width={1.9} aria-hidden="true" />
          Narrow these lists
        </button>
        <div class="narrow-body" id="narrow-body">
        <StageFilter claims={data.claims} scope="[data-feed]" param="status" />
        {topicChoices.length > 1 && (
          <p class="topic-filter" hidden data-topic-filter>
            <label for="feed-topic">Topic</label>
            <select id="feed-topic" data-counts={JSON.stringify(topicCounts)}>
              <option value="">All topics ({data.claims.length})</option>
              {topicChoices.map((topic) => (
                <option value={topic.slug}>
                  {topic.title} ({topic.count})
                </option>
              ))}
            </select>
          </p>
        )}
        </div>
      </div>
    )
  }
    {/* Shown by the script: without it the lists follow one another, each under its heading. */}
    <div class="feed-tabs" role="tablist" aria-label="Lists of tracked claims" hidden>
      {views.map((view, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${view.id}`}
          aria-controls={`feed-${view.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-view={view.id}
        >
          {view.tab}
          <span class="count">{view.count}</span>
        </button>
      ))}
    </div>

  <section class="feed-panel" id="feed-headlines" data-view="headlines">
  <h2 class="bar">Headlines reported most recently</h2>
  {
    reports.length === 0 ? (
      <p>No news report is on record yet.</p>
    ) : (
      <div class="table-frame">
      <table role="table" class="index">
        <caption class="visually-hidden">
          News reports about tracked claims, newest first. Each headline is the outlet's own wording.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Headline</th>
            <th role="columnheader" scope="col">Reported</th>
            {anyPromise && <th role="columnheader" scope="col" class="promise">Promised</th>}
            <th role="columnheader" scope="col">Status now</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {reports.map((report, index) => (
            <tr role="row" data-status={report.claim.status.code} data-topic={report.claim.vertical} data-on={report.publishedDate} data-later={index >= PAGE_SIZE ? "" : undefined}>
              <td role="cell" class="claim">
                {/* Named as on the claim page, so the headline pressed here is
                    carried to its place there. */}
                <a
                  class="followed"
                  href={`/${report.claim.slug}`}
                  style={
                    followedNameFor(report.claim, report.url)
                      ? `view-transition-name: ${followedNameFor(report.claim, report.url)}`
                      : undefined
                  }
                >
                  “{report.title}”
                </a>
                <span class="entry-note">
                  <Outlet url={report.url} outlet={report.outlet} />
                </span>
              </td>
              <td role="cell" class="when" data-column="Reported">
                {formatDate(report.publishedDate)}
              </td>
              {anyPromise && (
                <td
                  role="cell"
                  class:list={["promise", { none: !latestPromise(report.claim) }]}
                  data-column="Promised"
                >
                  {latestPromise(report.claim) ? (
                    <>
                      <PromiseText promise={latestPromise(report.claim)} />
                    </>
                  ) : (
                    <span class="visually-hidden">None with a date</span>
                  )}
                </td>
              )}
              <td role="cell" class="status" data-column="Status now">
                <StatusCell claim={report.claim} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <Pager name="headlines" total={reports.length} size={PAGE_SIZE} one="headline" many="headlines" />
      <p class="none" data-none hidden>Nothing in this list for that choice.</p>
    )
  }
  </section>

  {
    moves.length > 0 && (
      <section class="feed-panel" id="feed-moved" data-view="moved">
      <h2 class="bar">Statuses changed most recently</h2>
      <div class="table-frame">
      <table role="table" class="index">
        <caption class="visually-hidden">
          Each change of a claim's status, newest first, with the status before it.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Claim</th>
            <th role="columnheader" scope="col">Changed</th>
            <th role="columnheader" scope="col">Status from then</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {moves.map((move, index) => (
            <tr role="row" data-status={move.claim.status.code} data-topic={move.claim.vertical} data-on={move.on} data-later={index >= PAGE_SIZE ? "" : undefined}>
              <td role="cell" class="claim">
                <ClaimName claim={move.claim} />
              </td>
              <td role="cell" class="when" data-column="Changed">
                {formatDate(move.on)}
              </td>
              <td role="cell" class="status" data-column="Status from then">
                <span class="status-line">
                  <StageTrack code={move.code} />
                  <strong class="status-name">{STATUS_LABELS[move.code]}</strong>
                </span>
                <span class="gloss">Was: {STATUS_LABELS[move.before!]}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <Pager name="moved" total={moves.length} size={PAGE_SIZE} one="change" many="changes" />
      <p class="none" data-none hidden>Nothing in this list for that choice.</p>
      </section>
    )
  }

  {
    promised.length > 0 && (
      <section class="feed-panel" id="feed-promised" data-view="promised">
      <h2 class="bar">Dated promises, earliest date first</h2>
      <div class="table-frame">
      <table role="table" class="index">
        <caption class="visually-hidden">
          Claims whose reports stated a date, in order of that date, each beside its status now.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Claim</th>
            <th role="columnheader" scope="col" class="promise">Promised</th>
            <th role="columnheader" scope="col">Status now</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {promised.map((claim, index) => (
            <tr role="row" data-status={claim.status.code} data-topic={claim.vertical} data-on={latestPromise(claim)?.parsed_date} data-later={index >= PAGE_SIZE ? "" : undefined}>
              <td role="cell" class="claim">
                <ClaimName claim={claim} />
              </td>
              <td role="cell" class="promise" data-column="Promised">
                <PromiseText promise={latestPromise(claim)} />
              </td>
              <td role="cell" class="status" data-column="Status now">
                <StatusCell claim={claim} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <Pager name="promised" total={promised.length} size={PAGE_SIZE} one="claim" many="claims" label="claims with a dated promise" />
      <p class="none" data-none hidden>Nothing in this list for that choice.</p>
      </section>
    )
  }

  {
    quiet.length > 0 && (
      <section class="feed-panel" id="feed-quiet" data-view="quiet">
      <h2 class="bar">Longest with no new record</h2>
      <div class="table-frame">
      <table role="table" class="index">
        <caption class="visually-hidden">
          Claims with no new dated record for a year or more, the longest first.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Claim</th>
            <th role="columnheader" scope="col">First reported</th>
            <th role="columnheader" scope="col">Status now</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {quiet.map((claim, index) => (
            <tr role="row" data-status={claim.status.code} data-topic={claim.vertical} data-later={index >= PAGE_SIZE ? "" : undefined}>
              <td role="cell" class="claim">
                <ClaimName claim={claim} />
              </td>
              <td role="cell" class="when" data-column="First reported">
                {claim.first_reported_date ? (
                  formatDate(claim.first_reported_date)
                ) : (
                  <span class="visually-hidden">Not recorded</span>
                )}
              </td>
              <td role="cell" class="status" data-column="Status now">
                <StatusCell claim={claim} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <Pager name="quiet" total={quiet.length} size={PAGE_SIZE} one="claim" many="claims" label="claims with no signal" />
      <p class="none" data-none hidden>Nothing in this list for that choice.</p>
      </section>
    )
  }
  </div>

  </div>

  {/* How to hear of a change without looking for one. The first line is for a reader who
      follows nothing yet, and is shown only where this browser can keep a list. */}
  <section class="keep-up">
    <h2 class="bar">Keep up</h2>
    <p class="keep-hint" hidden data-follow-hint>
      Follow a claim from its page and it is listed at the top of this page, with a note when
      its status changes. This page also notes the day you open it, so next time it can say
      what is dated since. Both are kept in this browser only: no account, nothing sent.
    </p>
    <div class="keep-feed">
      <a class="share" href="/changes.xml">
        <Rss size={16} stroke-width={1.9} aria-hidden="true" />
        Subscribe to status changes
      </a>
      <span class="entry-note">A feed of every status change, for a feed reader.</span>
    </div>
  </section>

  {/* Shown by the script, which knows the reader's date: today's anniversaries of first
      reports, or the next day that has one. */}
  {
    calendarDays.length > 0 && (
      <section class="on-this-day" hidden data-on-this-day>
        <div class="bar-row">
          <h2 class="bar" data-title>On this day</h2>
          <a href="/anniversaries">All anniversaries</a>
        </div>
        <ul class="calendar">
          {calendarDays.map((day) => (
            <li class="day" hidden data-day={day.id} data-label={`${day.day} ${MONTH_NAMES[day.month - 1]}`}>
              <strong class="when">
                {day.day} {MONTH_NAMES[day.month - 1].slice(0, 3)}
              </strong>
              <ul>
                {day.entries.map((entry) => (
                  <li data-year={entry.year}>
                    <span class="year"><span class="visually-hidden">First reported </span>{entry.year}</span>
                    <a href={`/${entry.claim.slug}`}>{entry.claim.headline}</a>
                    <span class="status">
                      <StatusCell claim={entry.claim} />
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <h2 class="bar" id="topics">Topics</h2>
  <ul class="chips">
    {
      topTopics.map((topic) => (
        <li>
          <TopicChip vertical={topic.slug} count={topic.count} />
        </li>
      ))
    }
  </ul>
  {
    listedTopics.length > topTopics.length && (
      <p class="more-topics">
        <a href="/topics">All {listedTopics.length} topics</a>
      </p>
    )
  }
  {
    years.length > 0 && (
      <>
        <h2 class="bar" id="years">By year first reported</h2>
        <ul class="chips">
          {years.map(([year, count]) => (
            <li>
              <a class="chip plain-chip" href={`/year/${year}`}>
                {year}
                <span class="count">
                  {count}
                  <span class="visually-hidden">{count === 1 ? " claim" : " claims"}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
  {/* Where the question arises is the article itself: the extension answers there. */}
  {
    EXTENSION_OFFERED && (
      <section class="closing">
        <h2 class="bar">Reading it somewhere else?</h2>
        <p class="suggest">
          The browser extension shows what came of a report from the article itself:{" "}
          <a href="/extension">Get the extension</a>
        </p>
      </section>
    )
  }
  {/* The page ends on something to do: the one way a reader adds to what is tracked. */}
  {
    suggest && (
      <section class="closing">
        <h2 class="bar">Not here yet?</h2>
        <p class="suggest">
          Seen a reported breakthrough we do not track? Send the address of the news article:{" "}
          <a href={suggest.href}>Suggest a headline (opens {suggest.opens})</a>
        </p>
      </section>
    )
  }
</Base>

<script>
  import { nextAnniversaryDay } from "../lib/anniversaries";

  // The lists under the lookup: one is shown at a time, picked by its tab. The pick is
  // kept in the page's address, so a list can be linked to and returned to.
  const feed = document.querySelector<HTMLElement>("[data-feed]");
  const tabs = [...(feed?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? [])];
  if (feed && tabs.length > 1) {
    const panels = [...feed.querySelectorAll<HTMLElement>(".feed-panel")];
    const list = feed.querySelector<HTMLElement>(".feed-tabs")!;
    const select = (view: string, focus = false) => {
      for (const tab of tabs) {
        const on = tab.dataset.view === view;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
        // On a phone the tabs run off the side: the picked one is brought into the row.
        if (on) list.scrollLeft = tab.offsetLeft - list.offsetLeft - 16;
      }
      for (const panel of panels) panel.hidden = panel.dataset.view !== view;
    };
    const remember = (view: string) => {
      const url = new URL(location.href);
      if (view === tabs[0].dataset.view) url.searchParams.delete("view");
      else url.searchParams.set("view", view);
      history.replaceState(history.state, "", url);
    };
    for (const panel of panels) {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `tab-${panel.dataset.view}`);
    }
    const last = tabs.length - 1;
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        select(tab.dataset.view!);
        remember(tab.dataset.view!);
      });
      tab.addEventListener("keydown", (event) => {
        const { key: pressed } = event;
        const to = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: last }[pressed];
        if (to === undefined) return;
        event.preventDefault();
        const next = tabs[(to + tabs.length) % tabs.length];
        select(next.dataset.view!, true);
        remember(next.dataset.view!);
      });
    });
    const asked = new URL(location.href).searchParams.get("view");
    const wanted = tabs.find((tab) => tab.dataset.view === asked) ?? tabs[0];
    feed.classList.add("tabbed");
    list.hidden = false;
    select(wanted.dataset.view!);
  }

  // Narrowing: each list keeps the rows no filter has left out. The tab says how many
  // are left, and a list with none says so in place of an empty table.
  if (feed) {
    const lists = [...feed.querySelectorAll<HTMLElement>(".feed-panel")].map((panel) => ({
      table: panel.querySelector("table"),
      frame: panel.querySelector<HTMLElement>(".table-frame"),
      none: panel.querySelector<HTMLElement>("[data-none]"),
      count: feed.querySelector<HTMLElement>(`#tab-${panel.dataset.view} .count`),
    }));
    const left = (row: HTMLTableRowElement) =>
      !row.getAttributeNames().some((name) => name.startsWith("data-out"));
    for (const list of lists) {
      if (!list.table) continue;
      const rows = [...list.table.tBodies[0].rows];
      const recount = () => {
        const total = rows.filter(left).length;
        if (list.count) list.count.textContent = String(total);
        if (list.frame) list.frame.hidden = total === 0;
        if (list.none) list.none.hidden = total > 0;
      };
      list.table.addEventListener("paged:refresh", recount);
      // A status named in the address may have narrowed the lists already.
      recount();
    }

    // Found by its field: this script is small enough to be written into the page, and a
    // page with one topic carries no topic choice, not even its marker in a selector.
    const choice = document.querySelector<HTMLSelectElement>("#feed-topic");
    const line = choice?.closest<HTMLElement>(".topic-filter");
    const strip = document.querySelector<HTMLElement>("[data-stage-filter]");
    if (line && choice) {
      const counts: Record<string, Record<string, number>> = JSON.parse(choice.dataset.counts!);
      const narrow = (topic: string) => {
        for (const list of lists) {
          if (!list.table) continue;
          for (const row of list.table.tBodies[0].rows) {
            row.toggleAttribute("data-out-topic", topic !== "" && row.dataset.topic !== topic);
          }
          list.table.dispatchEvent(new Event("paged:refresh"));
        }
        strip?.dispatchEvent(new CustomEvent("stage:counts", { detail: counts[topic] ?? {} }));
      };
      choice.addEventListener("change", () => {
        narrow(choice.value);
        const url = new URL(location.href);
        if (choice.value) url.searchParams.set("topic", choice.value);
        else url.searchParams.delete("topic");
        history.replaceState(history.state, "", url);
      });
      line.hidden = false;
      const asked = new URL(location.href).searchParams.get("topic") ?? "";
      if (asked && asked in counts) {
        choice.value = asked;
        narrow(asked);
      }
    }
  }

  // Anniversaries of first reports, counted from the reader's own today: the ones that
  // fall today, or else the next day that has one. A report from this year has none yet.
  const onThisDay = document.querySelector<HTMLElement>("[data-on-this-day]");
  if (onThisDay) {
    const now = new Date();
    const two = (value: number) => String(value).padStart(2, "0");
    const today = `${now.getFullYear()}-${two(now.getMonth() + 1)}-${two(now.getDate())}`;
    const days = [...onThisDay.querySelectorAll<HTMLElement>("[data-day]")];
    const reports = days.flatMap((day) =>
      [...day.querySelectorAll<HTMLElement>("[data-year]")].map((entry) => ({
        entry,
        id: day.dataset.day!,
        year: Number(entry.dataset.year),
      })),
    );
    const found = nextAnniversaryDay(reports, today);
    if (found) {
      const year = Number(found.date.slice(0, 4));
      for (const day of days) day.hidden = !found.ids.includes(day.dataset.day!);
      for (const report of reports) report.entry.hidden = report.year >= year;
      if (!found.today) {
        const label = days.find((day) => !day.hidden)!.dataset.label!;
        onThisDay.querySelector("[data-title]")!.textContent = `Next anniversary: ${label}`;
      }
      onThisDay.hidden = false;
    }
  }
</script>

<script>
  // For a reader who comes back. Two things are kept in this browser's own storage and
  // sent nowhere: the day of the last visit, and the claims the reader follows.
  import {
    FOLLOWING_ENTRY,
    VISIT_ENTRY,
    changedParts,
    followedRows,
    isSince,
    nextVisit,
    readFollowed,
    sinceOf,
  } from "../lib/returning";
  import { formatDate } from "../lib/timetable";

  // Storage can be refused (a private window, a setting): then nothing is remembered
  // and the page says what is dated in the last thirty days.
  const store = (() => {
    try {
      localStorage.setItem("probe", "1");
      localStorage.removeItem("probe");
      return localStorage;
    } catch {
      return null;
    }
  })();
  const now = new Date();
  const two = (value: number) => String(value).padStart(2, "0");
  const today = `${now.getFullYear()}-${two(now.getMonth() + 1)}-${two(now.getDate())}`;
  const feed = document.querySelector<HTMLElement>("[data-feed]");

  const line = document.querySelector<HTMLElement>("[data-since]");
  if (line && feed) {
    const visit = nextVisit(store?.getItem(VISIT_ENTRY) ?? null, today);
    try {
      store?.setItem(VISIT_ENTRY, JSON.stringify(visit));
    } catch {}
    const since = sinceOf(visit, today);
    const views = ["headlines", "moved", "promised"] as const;
    const rowsOf = (view: string) => [
      ...feed.querySelectorAll<HTMLTableRowElement>(`#feed-${view} tbody tr[data-on]`),
    ];
    const dated = (view: string) =>
      rowsOf(view).filter((row) => isSince(row.dataset.on!, since.from, today));
    const parts = changedParts(
      { reports: dated("headlines").length, moves: dated("moved").length, promises: dated("promised").length },
      { reports: rowsOf("headlines").length, moves: rowsOf("moved").length, promises: rowsOf("promised").length },
    );

    // Pressing a count narrows its list to the rows dated in the span; pressing it
    // again, or "Show all", brings the rest back. One list is narrowed at a time.
    const counts: HTMLButtonElement[] = [];
    const showAll = document.createElement("button");
    showAll.type = "button";
    showAll.className = "text-control";
    showAll.textContent = "Show all";
    showAll.hidden = true;
    const narrow = (picked: string | null) => {
      for (const view of views) {
        const keep = new Set(view === picked ? dated(view) : rowsOf(view));
        for (const row of rowsOf(view)) row.toggleAttribute("data-out-since", !keep.has(row));
        feed.querySelector(`#feed-${view} table`)?.dispatchEvent(new Event("paged:refresh"));
      }
      for (const count of counts) {
        count.setAttribute("aria-pressed", String(count.dataset.view === picked));
      }
      showAll.hidden = picked === null;
    };
    showAll.addEventListener("click", () => narrow(null));

    line.append(
      since.visited ? `Since your last visit on ${formatDate(since.from)}: ` : "In the last 30 days: ",
    );
    parts.forEach((part, index) => {
      if (index > 0) line.append(", ");
      // None of something is said in words; there is nothing to open.
      if (part.count === 0) {
        line.append(part.text);
        return;
      }
      const open = document.createElement("button");
      open.type = "button";
      open.className = "text-control";
      open.textContent = part.text;
      open.dataset.view = part.view;
      open.setAttribute("aria-pressed", "false");
      open.addEventListener("click", () => {
        const on = open.getAttribute("aria-pressed") !== "true";
        narrow(on ? part.view : null);
        if (on) {
          document.getElementById(`tab-${part.view}`)?.click();
          feed.scrollIntoView({ block: "nearest" });
        }
      });
      counts.push(open);
      line.append(open);
    });
    line.append(parts.length > 0 ? "." : "nothing new on record.", " ", showAll);
    // Filled in below, once the followed claims have been compared with their statuses now.
    const followedNote = document.createElement("span");
    followedNote.dataset.sinceFollowed = "";
    line.append(followedNote);
    line.hidden = false;

    // A row dated since the last visit says so in a word. Not on a first visit: with
    // nothing to compare against, everything would be new.
    if (since.visited) {
      for (const row of [...dated("headlines"), ...dated("moved")]) {
        const tag = document.createElement("span");
        tag.className = "new-tag";
        tag.textContent = "New";
        row.querySelector(".claim a")?.after(" ", tag);
      }
    }
  }

  // The claims this reader follows, with a note on any whose status has changed since
  // they last opened it. The statuses now come from the site's lookup file.
  const following = document.querySelector<HTMLElement>("[data-following]");
  if (following && store) {
    const list = following.querySelector<HTMLElement>("[data-following-list]")!;
    const said = following.querySelector<HTMLElement>("[data-following-said]")!;
    const followed = readFollowed(store.getItem(FOLLOWING_ENTRY));
    const hint = document.querySelector<HTMLElement>("[data-follow-hint]");
    if (hint) hint.hidden = Object.keys(followed).length > 0;
    const element = (tag: string, text?: string, className?: string) => {
      const node = document.createElement(tag);
      if (text) node.textContent = text;
      if (className) node.className = className;
      return node;
    };
    const draw = (listed: Parameters<typeof followedRows>[1]) => {
      const rows = followedRows(followed, listed);
      list.replaceChildren(
        ...rows.map((row) => {
          const item = element("li");
          if (row.page) {
            const link = element("a", row.headline) as HTMLAnchorElement;
            link.href = row.page;
            item.append(link);
          } else {
            item.append(element("span", row.headline));
          }
          const note = element("span", undefined, "entry-note");
          if (row.status === null) {
            note.append("No longer listed on this site.");
          } else if (row.was) {
            // The change is said in words; the tag alone never carries it.
            note.append(element("span", "Changed", "new-tag"), ` Was: ${row.was}. Now: ${row.status}.`);
          } else {
            note.append(element("strong", row.status));
          }
          const stop = element("button", "Stop following", "text-control") as HTMLButtonElement;
          stop.type = "button";
          stop.addEventListener("click", () => {
            delete followed[row.slug];
            try {
              store.setItem(FOLLOWING_ENTRY, JSON.stringify(followed));
            } catch {}
            said.textContent = `No longer following: ${row.headline}`;
            draw(listed);
          });
          note.append(" ", stop);
          item.append(note);
          return item;
        }),
      );
      following.hidden = rows.length === 0;
      if (hint) hint.hidden = rows.length > 0;
      // A changed followed claim is the news a reader came back for: the line above says so.
      const note = document.querySelector<HTMLElement>("[data-since-followed]");
      const changed = rows.filter((row) => row.was !== null).length;
      if (note) {
        note.replaceChildren();
        if (changed > 0) {
          const link = document.createElement("a");
          link.href = "#following";
          link.textContent = `${changed} followed ${changed === 1 ? "claim has" : "claims have"} changed`;
          note.append(" ", link, ".");
        }
      }
    };
    if (Object.keys(followed).length > 0) {
      fetch("/lookup.json")
        .then((response) => response.json())
        .then((index) => draw(index.claims ?? {}))
        // Without the lookup file the stored headlines and statuses are still true as kept.
        .catch(() => draw(Object.fromEntries(
          Object.entries(followed).map(([slug, entry]) => [
            slug,
            { headline: entry.headline, page: `/${slug}`, status: entry.status },
          ]),
        )));
    }
  }

  // On a phone the counts and the topic choice open on request. They start open when
  // the address already narrows the lists, so a narrowed list is never unexplained.
  const board = document.querySelector<HTMLElement>("[data-scoreboard]");
  const toggle = board?.querySelector<HTMLButtonElement>("[data-narrow]");
  if (board && toggle) {
    const set = (open: boolean) => {
      board.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    const asked = new URL(location.href).searchParams;
    set(asked.has("status") || asked.has("topic"));
    toggle.addEventListener("click", () => set(toggle.getAttribute("aria-expanded") !== "true"));
    toggle.hidden = false;
  }
</script>

<style is:global>
  /* Global, not scoped: scoping would mark every element of the page, and the
     lookup's answers are drawn by script. */
  .suggest {
    margin-top: 0.8rem;
    max-width: var(--measure);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .results .suggest {
    margin-top: 0.6rem;
  }

  /* The live answer uses the same record/confidence layout as a claim page.
     Keep the native disclosure marker when no static Astro icon is present. */
  .live-matches .match-why summary {
    display: list-item;
    list-style: disclosure-closed inside;
  }

  .live-matches .match-why[open] summary {
    list-style-type: disclosure-open;
  }

  .live-matches .match-why summary::-webkit-details-marker {
    display: inline;
  }
</style>
