---
import CalendarPlus from "@lucide/astro/icons/calendar-plus";
import Base from "../layouts/Base.astro";
import Outlet from "../components/Outlet.astro";
import PromiseText from "../components/PromiseText.astro";
import StatusCell from "../components/StatusCell.astro";
import TopicChip from "../components/TopicChip.astro";
import { SITE } from "../../site.config.mjs";
import { SUGGEST_SUBJECT, contactLink } from "../lib/contact.mjs";
import { data, listedTopics } from "../lib/export";
import { recentReports } from "../lib/reports";
import { siteData } from "../lib/structured";
import { latestPromise } from "../lib/status";
import { formatDate } from "../lib/timetable";

const reports = recentReports(data.claims, 10);
// Drawn only when a suggestion address is configured. Nothing is carried from here;
// the lookup's own answers carry a pasted article address.
const suggest = contactLink(SITE.suggestUrl, "", SUGGEST_SUBJECT);

// The home page names the topics with the most claims; the rest are one link away.
const topTopics = listedTopics
  .map((topic) => ({
    ...topic,
    count: data.claims.filter((claim) => claim.vertical === topic.slug).length,
  }))
  .sort((a, b) => b.count - a.count || a.title.localeCompare(b.title))
  .slice(0, 12);

// Each year in which a published claim was first reported, newest first, with its count.
const perYear = new Map<string, number>();
for (const claim of data.claims) {
  if (!claim.first_reported_date) continue;
  const year = claim.first_reported_date.slice(0, 4);
  perYear.set(year, (perYear.get(year) ?? 0) + 1);
}
const years = Array.from(perYear).sort((a, b) => b[0].localeCompare(a[0]));

// The headlines table sets the promise beside the status, as a claim page does. With no
// dated promise among the reports there is no amber column.
const anyPromise = reports.some((report) => latestPromise(report.claim) !== null);
const approvals = data.claims.filter((claim) => claim.status.code === "approved").length;

const recent = data.claims
  .filter((claim) => claim.status.updated_at !== null)
  .sort((a, b) => (a.status.updated_at! < b.status.updated_at! ? 1 : -1))
  .slice(0, 10);
// Statuses are often set in one batch. One shared date is said once, in the heading,
// in place of a column that repeats it on every row.
const setOn = new Set(recent.map((claim) => claim.status.updated_at!.slice(0, 10)));
const oneDay = setOn.size === 1 ? formatDate(recent[0].status.updated_at) : null;
---

<Base current="home" structured={siteData()}>
  <h1 class="title">What happened to that breakthrough?</h1>
  <p class="lede">{SITE.description}</p>

  <form class="search lookup" role="search" id="search">
    <label for="query">Paste a link to an article, or search by treatment or condition</label>
    <div class="row">
      <input
        id="query"
        name="q"
        type="search"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="https://… or tooth regrowth"
      />
      <button type="submit">Look up</button>
    </div>
  </form>
  <noscript>
    <p class="results">
      Looking up needs JavaScript. Without it, <a href="/topics">the list of topics</a> leads to
      every claim.
    </p>
  </noscript>
  {/* No space inside: an empty answer area is hidden by ":empty". */}
  <div class="results" id="results" aria-live="polite" data-suggest={SITE.suggestUrl ?? undefined} data-live={SITE.lookupUrl ?? undefined}></div>
  {
    suggest && (
      <p class="suggest">
        Seen a reported breakthrough we do not track? Send the address of the news article:{" "}
        <a href={suggest.href}>Suggest a headline (opens {suggest.opens})</a>
      </p>
    )
  }

  {
    data.claims.length > 0 && (
      <p class="tally">
        {data.claims.length} {data.claims.length === 1 ? "claim" : "claims"} tracked in{" "}
        <a href="/topics">
          {listedTopics.length} {listedTopics.length === 1 ? "topic" : "topics"}
        </a>
        . <a href="/it-happened">Approvals on record</a>: {approvals} of {data.claims.length}.
      </p>
    )
  }

  <h2 class="bar">Headlines reported most recently</h2>
  {
    reports.length === 0 ? (
      <p>No news report is on record yet.</p>
    ) : (
      <div class="table-frame">
      <table role="table" class="index">
        <caption class="visually-hidden">
          News reports about tracked claims, newest first. Each headline is the outlet's own wording.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Headline</th>
            <th role="columnheader" scope="col">Reported</th>
            {anyPromise && <th role="columnheader" scope="col" class="promise">Promised</th>}
            <th role="columnheader" scope="col">Status now</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {reports.map((report) => (
            <tr role="row">
              <td role="cell" class="claim">
                <a href={`/${report.claim.slug}`}>“{report.title}”</a>
                <span class="entry-note">
                  <Outlet url={report.url} outlet={report.outlet} />
                </span>
              </td>
              <td role="cell" class="when" data-column="Reported">
                {formatDate(report.publishedDate)}
              </td>
              {anyPromise && (
                <td
                  role="cell"
                  class:list={["promise", { none: !latestPromise(report.claim) }]}
                  data-column="Promised"
                >
                  {latestPromise(report.claim) ? (
                    <>
                      <PromiseText promise={latestPromise(report.claim)} />
                    </>
                  ) : (
                    <span class="visually-hidden">None with a date</span>
                  )}
                </td>
              )}
              <td role="cell" class="status" data-column="Status now">
                <StatusCell claim={report.claim} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    )
  }

  <h2 class="bar">{oneDay ? `Statuses set on ${oneDay}` : "Statuses set most recently"}</h2>
  {
    recent.length === 0 ? (
      <p>No status has changed yet.</p>
    ) : (
      <div class="table-frame">
      <table role="table" class="index">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Claim</th>
            <th role="columnheader" scope="col">Status</th>
            {!oneDay && <th role="columnheader" scope="col">Status set</th>}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {recent.map((claim) => (
            <tr role="row">
              <td role="cell" class="claim">
                <a href={`/${claim.slug}`}>{claim.headline}</a>
              </td>
              <td role="cell" class="status" data-column="Status">
                <StatusCell claim={claim} />
              </td>
              {!oneDay && (
                <td role="cell" class="when" data-column="Status set">
                  {formatDate(claim.status.updated_at)}
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    )
  }

  <h2 class="bar" id="topics">Topics</h2>
  <ul class="chips">
    {
      topTopics.map((topic) => (
        <li>
          <TopicChip vertical={topic.slug} count={topic.count} />
        </li>
      ))
    }
  </ul>
  {
    listedTopics.length > topTopics.length && (
      <p class="more-topics">
        <a href="/topics">All {listedTopics.length} topics</a>
      </p>
    )
  }
  {
    years.length > 0 && (
      <>
        <h2 class="bar" id="years">By year first reported</h2>
        <ul class="chips">
          {years.map(([year, count]) => (
            <li>
              <a class="chip plain-chip" href={`/year/${year}`}>
                {year}
                <span class="count">
                  {count}
                  <span class="visually-hidden">{count === 1 ? " claim" : " claims"}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
  {/* For a report with no record yet: a calendar file made in the reader's browser. */}
  <template id="remind-later">
    <section class="again" data-pagefind-ignore>
      <h2 class="bar">Check again later</h2>
      <p class="take-why">
        Nothing is on record for this report yet. Save a date to your calendar to look again.
        The file is made on this device; nothing is sent to us, not even the link.
      </p>
      <div class="take-actions">
        <button type="button" class="share" data-when="six-months">
          <CalendarPlus size={16} stroke-width={1.9} aria-hidden="true" />
          In six months
        </button>
        <button type="button" class="share" data-when="year">
          <CalendarPlus size={16} stroke-width={1.9} aria-hidden="true" />
          In a year
        </button>
      </div>
      <p class="visually-hidden" aria-live="polite" data-said></p>
    </section>
  </template>
</Base>

<script>
  // A pasted link is compared with the site's lookup file here in the browser. It is
  // sent to the site's server only if the reader then asks for a registry search, and
  // only where the site is built with one. Other text is searched in an index built
  // with the site. Without JavaScript the topic pages list every claim.
  import { SUGGEST_SUBJECT, contactLink } from "../lib/contact.mjs";
  import { LIVE, describeAnswer, refusalMessage, textWouldHelp } from "../lib/live-lookup.mjs";
  import { calendarFile, reminderDate, type ReminderChoice } from "../lib/calendar";
  import { SITE as BRAND } from "../../site.config.mjs";
  const SITE_NAME = BRAND.name;
  import { closestClaims, readAddress } from "../lib/lookup-match.mjs";

  const form = document.querySelector<HTMLFormElement>("#search")!;
  const input = document.querySelector<HTMLInputElement>("#query")!;
  const results = document.querySelector<HTMLDivElement>("#results")!;
  const suggestAddress = results.dataset.suggest ?? null;
  const liveAddress = results.dataset.live ?? null;

  interface Hit {
    url: string;
    meta: { title?: string; status?: string; summary?: string };
  }
  interface LookupClaim {
    headline: string;
    page: string;
    status: string;
    meaning: string;
    place: number | null;
    no_signal: string | null;
    first_reported: string | null;
    unchecked: string | null;
  }
  interface Lookup {
    articles: Record<string, string[]>;
    claims: Record<string, LookupClaim>;
    places: number;
  }

  function element(tag: string, text?: string, className?: string) {
    const node = document.createElement(tag);
    if (text) node.textContent = text;
    if (className) node.className = className;
    return node;
  }

  // Where to go when the box has no answer: never a full stop.
  function next() {
    const line = element("p", "Every tracked claim is listed by ", "entry-note");
    const topics = element("a", "topic") as HTMLAnchorElement;
    topics.href = "/topics";
    line.append(topics, ". A treatment's name can also be typed in the box above.");
    return line;
  }

  function show(...messages: string[]) {
    results.replaceChildren(...messages.map((message) => element("p", message)));
  }

  function claimList(claims: LookupClaim[]) {
    const list = element("ul", undefined, "plain");
    for (const claim of claims) {
      const item = element("li");
      const link = element("a", claim.headline) as HTMLAnchorElement;
      link.href = claim.page;
      const note = element("span", undefined, "entry-note");
      note.append(element("strong", claim.status));
      const rest = [
        claim.no_signal,
        claim.meaning,
        claim.first_reported && `First reported ${claim.first_reported}.`,
      ]
        .filter(Boolean)
        .join(" ");
      note.append(` ${rest}`);
      item.append(link, note);
      if (claim.unchecked) item.append(element("span", claim.unchecked, "entry-note"));
      list.append(item);
    }
    return list;
  }

  // An article we track is answered the way its claim page answers: the status in
  // words, its place on the path, the no-signal note, then what the status means.
  function standing(claim: LookupClaim, places: number) {
    const card = element("div", undefined, "digest found");
    const stands = element("div", undefined, "standing");
    stands.append(element("span", claim.status, "label"));
    if (claim.place) {
      const track = element("span", undefined, "track");
      const steps = element("span", undefined, "steps");
      steps.setAttribute("role", "img");
      steps.setAttribute(
        "aria-label",
        `Place ${claim.place} of ${places} on the path from preclinical to approved`,
      );
      for (let place = 1; place <= places; place += 1) {
        steps.append(element("span", undefined, place === claim.place ? "step here" : "step"));
      }
      track.append(steps);
      stands.append(track);
    }
    if (claim.no_signal) stands.append(element("span", claim.no_signal, "note"));

    const about = element("div", undefined, "about");
    about.append(element("h2", claim.headline));
    if (claim.unchecked) about.append(element("p", claim.unchecked, "unchecked"));
    about.append(element("p", claim.meaning));
    const more = element("p", undefined, "changed");
    if (claim.first_reported) more.append(`First reported ${claim.first_reported}. `);
    const link = element("a", "See the records") as HTMLAnchorElement;
    link.href = claim.page;
    more.append(link);
    about.append(more);

    card.append(stands, about);
    return card;
  }

  // An article we do not track can be suggested, when a suggestion address is set. The
  // pasted address goes only into this link; the reader's mail or form sends it, if
  // they choose to.
  function suggestion(address: string) {
    const link = contactLink(suggestAddress, address, SUGGEST_SUBJECT);
    if (!link) return [];
    const anchor = element("a", `Suggest this headline (opens ${link.opens})`) as HTMLAnchorElement;
    anchor.href = link.href;
    const paragraph = element("p", undefined, "suggest");
    paragraph.append(anchor);
    return [paragraph];
  }

  // --- a registry search for an article the site does not track ---------------------
  // Nothing is sent until the reader presses the button. The answer is an automatic
  // search and is marked as one before anything else is shown.

  function liveAnswer(found: Parameters<typeof describeAnswer>[0]) {
    const shown = describeAnswer(found);
    const block = element("div", undefined, "live");
    if (shown.marked) block.append(element("p", shown.marked, "unchecked"));
    block.append(element("p", shown.lead));
    if (shown.source) block.append(element("p", shown.source, "entry-note"));
    if (shown.searchedAlso) block.append(element("p", shown.searchedAlso, "entry-note"));
    if (shown.trialSaid) block.append(element("p", shown.trialSaid, "entry-note"));
    if (shown.tracked.length > 0) {
      const list = element("ul", undefined, "plain");
      for (const claim of shown.tracked) {
        const link = element("a", claim.headline) as HTMLAnchorElement;
        link.href = claim.page;
        const item = element("li");
        item.append(link);
        list.append(item);
      }
      // After a post that links to a tracked article, the lead above already says so.
      if (shown.marked) block.append(element("p", LIVE.trackedLead));
      block.append(list);
    }
    if (shown.likely.length > 0) {
      const list = element("ul", undefined, "plain");
      for (const record of shown.likely) {
        const link = element("a", record.title) as HTMLAnchorElement;
        link.href = record.url;
        link.rel = "noopener";
        const item = element("li");
        item.append(link, element("span", record.detail, "entry-note"));
        if (record.why) item.append(element("span", record.why, "entry-note"));
        list.append(item);
      }
      block.append(element("p", LIVE.likelyLead), list);
    }
    if (shown.none) block.append(element("p", shown.none));
    if (shown.rest) block.append(element("p", shown.rest, "entry-note"));
    for (const notice of shown.notices) block.append(element("p", notice, "entry-note"));
    return block;
  }

  // Openspec reader-follow-up, open question 3: a calendar file for a report with no
  // record yet. The event links to the report itself and says where to paste it.
  function remindLater(address: string) {
    const template = document.querySelector<HTMLTemplateElement>("#remind-later");
    if (!template || typeof Blob === "undefined" || typeof URL.createObjectURL !== "function") return null;
    const section = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const said = section.querySelector<HTMLElement>("[data-said]");
    const now = new Date();
    const pad = (value: number) => String(value).padStart(2, "0");
    const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    for (const choice of section.querySelectorAll<HTMLButtonElement>("[data-when]")) {
      const date = reminderDate(choice.dataset.when as ReminderChoice, { today, promiseDue: null, firstReported: null });
      if (!date) continue;
      choice.addEventListener("click", () => {
        const file = calendarFile({
          site: SITE_NAME,
          headline: "Check this report again",
          url: address,
          slug: `report-${today}`,
          date,
          madeAt: new Date().toISOString(),
          description: `Paste this link into ${SITE_NAME} at ${location.origin} to see what is on record now: ${address}`,
        });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob([file], { type: "text/calendar" }));
        link.download = `check-again-${date}.ics`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        choice.classList.add("done");
        if (said) said.textContent = "Calendar file saved";
        setTimeout(() => {
          choice.classList.remove("done");
          if (said) said.textContent = "";
        }, 2000);
      });
    }
    return section;
  }

  function textForm() {
    const form = element("form", undefined, "live-text") as HTMLFormElement;
    const label = element("label", LIVE.textLabel) as HTMLLabelElement;
    const area = element("textarea") as HTMLTextAreaElement;
    area.id = "live-text";
    area.rows = 5;
    area.maxLength = 20000;
    label.htmlFor = area.id;
    const button = element("button", LIVE.textOffer) as HTMLButtonElement;
    button.type = "submit";
    form.append(label, area, button);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const text = area.value.trim();
      if (text) void askLive({ text });
    });
    return form;
  }

  async function askLive(body: { url: string } | { text: string }) {
    latest += 1;
    const asked = latest;
    show(LIVE.working);
    let status = 0;
    let found: any = null;
    try {
      const response = await fetch(liveAddress!, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      status = response.status;
      found = await response.json();
    } catch {
      found = null;
    }
    if (asked !== latest) return;
    if (status === 200 && found) {
      results.replaceChildren(liveAnswer(found));
      // A linked report the site does not track yet: offer to come back to it.
      if ("url" in body && !found.article_tracked && !(found.tracked?.length > 0)) {
        const later = remindLater(body.url);
        if (later) results.append(later);
      }
      return;
    }
    const code = found?.error ?? "failed";
    results.replaceChildren(
      element("p", refusalMessage(code, { platform: found?.platform })),
      ...(textWouldHelp(code) ? [textForm()] : []),
    );
  }

  function liveOffer(address: string, post = false) {
    if (!liveAddress) return [];
    const button = element("button", post ? LIVE.postOffer : LIVE.offer, "live-offer") as HTMLButtonElement;
    button.type = "button";
    button.addEventListener("click", () => void askLive({ url: address }));
    return [button, element("p", post ? LIVE.postDisclosure : LIVE.disclosure, "entry-note")];
  }

  let lookup: Promise<Lookup> | undefined;
  const loadLookup = () => (lookup ??= fetch("/lookup.json").then((response) => response.json()));

  async function lookUp(address: string, read: ReturnType<typeof readAddress>) {
    if (read.kind === "short") {
      show(
        `That is a shortened link (${read.host}). Open it, then paste the address of the article it leads to.`,
      );
      return;
    }
    if (read.kind === "post") {
      // A post the service can read is offered a search of the post and its article.
      // Any other post is turned back here, before anything is sent.
      if (read.readable && liveAddress) {
        results.replaceChildren(
          element("p", `That is a post on ${read.platform}. This site can read it and the article it links to.`),
          ...liveOffer(address, true),
        );
        return;
      }
      results.replaceChildren(
        element(
          "p",
          liveAddress
            ? refusalMessage("post", { platform: read.platform })
            : `That is a post on ${read.platform}, not the article itself. Open the article it links to, then paste that address.`,
        ),
        ...(liveAddress ? [textForm()] : []),
      );
      return;
    }
    show("Looking up…");
    let index: Lookup;
    try {
      index = await loadLookup();
    } catch {
      lookup = undefined;
      results.replaceChildren(element("p", "The lookup is not available right now."), next());
      return;
    }
    const slugs = index.articles[read["key"]] ?? [];
    const tracked = slugs.map((slug) => index.claims[slug]).filter(Boolean);
    if (tracked.length > 0) {
      results.replaceChildren(
        element(
          "p",
          tracked.length === 1 ? "This article is one we track." : "This article reports claims we track.",
        ),
        ...tracked.map((claim) => standing(claim, index.places)),
      );
      // On a phone the answer can land below the keyboard or the fold.
      results.scrollIntoView({ block: "nearest" });
      return;
    }
    const close = closestClaims(index, address).map((match: { claim: LookupClaim }) => match.claim);
    if (close.length > 0) {
      results.replaceChildren(
        element(
          "p",
          "We do not track this exact article. These tracked claims share words with its address. That is a guess: check it is the same treatment for the same condition.",
        ),
        claimList(close),
        ...liveOffer(address),
        ...suggestion(address),
      );
      return;
    }
    results.replaceChildren(
      element(
        "p",
        "This article is not one we track, and no tracked claim looks close. That says nothing about the story itself.",
      ),
      ...liveOffer(address),
      ...suggestion(address),
      next(),
    );
  }

  // A slow answer to an earlier question must not replace the answer to a later one.
  let latest = 0;

  async function search(query: string) {
    const asked = latest;
    show("Searching…");
    let hits: Hit[];
    try {
      const indexUrl = "/pagefind/pagefind.js";
      const pagefind = await import(/* @vite-ignore */ indexUrl);
      const found = await pagefind.search(query);
      hits = await Promise.all(
        found.results.slice(0, 20).map((result: { data: () => Promise<Hit> }) => result.data()),
      );
    } catch {
      if (asked === latest) {
        results.replaceChildren(element("p", "Search is not available right now."), next());
      }
      return;
    }
    if (asked !== latest) return;
    if (hits.length === 0) {
      show(
        `No record found for “${query}”. We say that a lot.`,
        "This site only covers claims it has tracked so far.",
      );
      results.append(next());
      return;
    }
    // Each match: the headline, then its status in words ahead of the summary.
    const list = element("ul", undefined, "plain hits");
    for (const hit of hits) {
      const item = element("li");
      const link = element("a", hit.meta.title ?? hit.url) as HTMLAnchorElement;
      link.href = hit.url;
      const note = element("span", undefined, "entry-note");
      if (hit.meta.status) note.append(element("strong", hit.meta.status), " ");
      if (hit.meta.summary) note.append(hit.meta.summary);
      item.append(link, note);
      list.append(item);
    }
    const count = element(
      "p",
      `${hits.length} tracked ${hits.length === 1 ? "claim matches" : "claims match"} “${query}”.`,
      "entry-note",
    );
    results.replaceChildren(count, list);
  }

  function answer(text: string) {
    latest += 1;
    if (!text) {
      results.replaceChildren();
      return;
    }
    const read = readAddress(text);
    void (read.kind === "none" ? search(text) : lookUp(text, read));
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const text = input.value.trim();
    const url = new URL(location.href);
    // Only typed words go into the page's address. A pasted article address stays in
    // the field: in the address it would reach the server on a reload or when shared.
    if (text && readAddress(text).kind === "none") url.searchParams.set("q", text);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
    answer(text);
  });

  // A pasted link is answered at once; typed words wait for the button.
  input.addEventListener("paste", () => {
    setTimeout(() => {
      if (readAddress(input.value.trim()).kind !== "none") form.requestSubmit();
    });
  });

  const initial = new URL(location.href).searchParams.get("q");
  if (initial) {
    input.value = initial;
    answer(initial);
  }
</script>

<style is:global>
  /* Global, not scoped: scoping would mark every element of the page, and the
     lookup's answers are drawn by script. */
  .suggest {
    margin-top: 0.8rem;
    max-width: var(--measure);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .results .suggest {
    margin-top: 0.6rem;
  }
</style>
