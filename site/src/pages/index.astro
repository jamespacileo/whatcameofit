---
import Base from "../layouts/Base.astro";
import Outlet from "../components/Outlet.astro";
import StatusCell from "../components/StatusCell.astro";
import TopicChip from "../components/TopicChip.astro";
import { SITE } from "../../site.config.mjs";
import { data, listedTopics } from "../lib/export";
import { recentReports } from "../lib/reports";
import { formatDate } from "../lib/timetable";

const reports = recentReports(data.claims, 10);

const recent = data.claims
  .filter((claim) => claim.status.updated_at !== null)
  .sort((a, b) => (a.status.updated_at! < b.status.updated_at! ? 1 : -1))
  .slice(0, 10);
---

<Base current="home">
  <h1 class="title">What happened to that breakthrough?</h1>
  <p class="lede">{SITE.description}</p>

  <form class="search" role="search" id="search">
    <label for="query">Search by treatment, condition or name</label>
    <div class="row">
      <input id="query" name="q" type="search" autocomplete="off" placeholder="tooth regrowth" />
      <button type="submit">Search</button>
    </div>
  </form>
  <div class="results" id="results" aria-live="polite"></div>

  <h2 class="bar">Headlines reported most recently</h2>
  {
    reports.length === 0 ? (
      <p>No news report is on record yet.</p>
    ) : (
      <div class="table-frame">
      <table class="index">
        <caption class="visually-hidden">
          News reports about tracked claims, newest first. Each headline is the outlet's own wording.
        </caption>
        <thead>
          <tr>
            <th scope="col">Headline</th>
            <th scope="col">Reported</th>
            <th scope="col">Status now</th>
          </tr>
        </thead>
        <tbody>
          {reports.map((report) => (
            <tr>
              <td class="claim">
                <a href={`/${report.claim.slug}`}>“{report.title}”</a>
                <span class="entry-note">
                  <Outlet url={report.url} outlet={report.outlet} />
                </span>
              </td>
              <td class="when" data-column="Reported">
                {formatDate(report.publishedDate)}
              </td>
              <td data-column="Status now">
                <StatusCell claim={report.claim} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    )
  }

  <h2 class="bar">Statuses set most recently</h2>
  {
    recent.length === 0 ? (
      <p>No status has changed yet.</p>
    ) : (
      <div class="table-frame">
      <table class="index">
        <thead>
          <tr>
            <th scope="col">Claim</th>
            <th scope="col">Status</th>
            <th scope="col">Status set</th>
          </tr>
        </thead>
        <tbody>
          {recent.map((claim) => (
            <tr>
              <td class="claim">
                <a href={`/${claim.slug}`}>{claim.headline}</a>
              </td>
              <td data-column="Status">
                <StatusCell claim={claim} />
              </td>
              <td class="when" data-column="Status set">
                {formatDate(claim.status.updated_at)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    )
  }

  <h2 class="bar" id="topics">Topics</h2>
  <ul class="chips">
    {
      listedTopics.map((vertical) => (
        <li>
          <TopicChip
            vertical={vertical.slug}
            count={data.claims.filter((claim) => claim.vertical === vertical.slug).length}
          />
        </li>
      ))
    }
  </ul>
</Base>

<script>
  // Search runs in the browser against an index built with the site. Without
  // JavaScript the topic pages list every claim.
  const form = document.querySelector<HTMLFormElement>("#search")!;
  const input = document.querySelector<HTMLInputElement>("#query")!;
  const results = document.querySelector<HTMLDivElement>("#results")!;

  interface Hit {
    url: string;
    meta: { title?: string; status?: string; summary?: string };
  }

  function show(message: string) {
    const paragraph = document.createElement("p");
    paragraph.textContent = message;
    results.replaceChildren(paragraph);
  }

  async function search(query: string) {
    if (!query) {
      results.replaceChildren();
      return;
    }
    show("Searching…");
    let hits: Hit[];
    try {
      const indexUrl = "/pagefind/pagefind.js";
      const pagefind = await import(/* @vite-ignore */ indexUrl);
      const found = await pagefind.search(query);
      hits = await Promise.all(
        found.results.slice(0, 20).map((result: { data: () => Promise<Hit> }) => result.data()),
      );
    } catch {
      show("Search is not available right now. The topic pages list every claim.");
      return;
    }
    if (hits.length === 0) {
      show(`Nothing found for “${query}”. This site only covers claims it has tracked so far.`);
      return;
    }
    const list = document.createElement("ul");
    list.className = "plain";
    for (const hit of hits) {
      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = hit.url;
      link.textContent = hit.meta.title ?? hit.url;
      const note = document.createElement("span");
      note.className = "entry-note";
      note.textContent = [hit.meta.status, hit.meta.summary].filter(Boolean).join(". ");
      item.append(link, note);
      list.append(item);
    }
    results.replaceChildren(list);
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = input.value.trim();
    const url = new URL(location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
    void search(query);
  });

  const initial = new URL(location.href).searchParams.get("q");
  if (initial) {
    input.value = initial;
    void search(initial);
  }
</script>
