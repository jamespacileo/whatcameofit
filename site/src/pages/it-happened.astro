---
import Base from "../layouts/Base.astro";
import ClaimTable from "../components/ClaimTable.astro";
import { data } from "../lib/export";

const approved = data.claims.filter((claim) => claim.status.code === "approved");
---

<Base
  title="It happened"
  description="Reported breakthroughs for which a regulator has recorded an approval."
  current="approved"
>
  <h1 class="title">It happened</h1>
  <p class="lede">
    Reported breakthroughs for which a regulator has recorded an approval. An approval says what a
    regulator decided; it is not advice about any one person's care.
  </p>
  {
    data.claims.length > 0 && (
      <p class="tally">
        Approvals on record: {approved.length} of {data.claims.length} tracked{" "}
        {data.claims.length === 1 ? "claim" : "claims"}.
      </p>
    )
  }

  {
    approved.length === 0 ? (
      <p>No tracked claim has an approval on record.</p>
    ) : (
      <ClaimTable claims={approved} caption="Claims with a recorded approval" />
    )
  }
</Base>
