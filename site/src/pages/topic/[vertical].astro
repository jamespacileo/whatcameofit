---
import Base from "../../layouts/Base.astro";
import ClaimTable from "../../components/ClaimTable.astro";
import { data, type StatusCode } from "../../lib/export";
import { topicSummary } from "../../lib/status";

export function getStaticPaths() {
  return data.verticals.map((vertical) => ({
    params: { vertical: vertical.slug },
    props: { vertical },
  }));
}

const { vertical } = Astro.props;
const claims = data.claims
  .filter((claim) => claim.vertical === vertical.slug)
  .sort((a, b) => ((a.first_reported_date ?? "") < (b.first_reported_date ?? "") ? 1 : -1));
// Where the topic's claims stand, said once in plain words before the list.
const counts = new Map<StatusCode, number>();
for (const claim of claims) counts.set(claim.status.code, (counts.get(claim.status.code) ?? 0) + 1);
const summary = topicSummary(counts);
---

<Base
  title={vertical.title}
  description={`Reported breakthroughs in ${vertical.title.toLowerCase()} and where each stands now.`}
  current="topics"
  breadcrumbs={[
    { name: "Topics", path: "/topics" },
    { name: vertical.title, path: `/topic/${vertical.slug}` },
  ]}
>
  <h1 class="title">{vertical.title}</h1>
  <p class="lede">
    {summary ?? "0 reported breakthroughs tracked."}
    {claims.length > 1 && " Newest first."}
  </p>

  {
    claims.length === 0 ? (
      <p>No claims are tracked in this topic yet.</p>
    ) : (
      <ClaimTable claims={claims} caption={`Claims in ${vertical.title}`} filter />
    )
  }
</Base>
