---
import Base from "../../layouts/Base.astro";
import ClaimTable from "../../components/ClaimTable.astro";
import LookupAgain from "../../components/LookupAgain.astro";
import CopyButton from "../../components/CopyButton.astro";
import Rss from "@lucide/astro/icons/rss";
import SectionList from "../../components/SectionList.astro";
import SharePill from "../../components/SharePill.astro";
import { topicCardAlt } from "../../lib/card";
import { topicCardFor } from "../../lib/card-image";
import { data, listedTopics } from "../../lib/export";
import { reportedClaimCount } from "../../lib/reports";
import { topicSentence } from "../../lib/share";
import { topicClaimSummary } from "../../lib/status";
import { canonicalAddress } from "../../lib/structured";
import { pairBundleFolder } from "../../lib/pairs";

export function getStaticPaths() {
  // A build that reads a bundle lists pairs on this address (src/pair/TopicRoute.astro).
  if (pairBundleFolder()) return [];
  return data.verticals.map((vertical) => ({
    params: { vertical: vertical.slug },
    props: { vertical },
  }));
}

const { vertical } = Astro.props;
const claims = data.claims
  .filter((claim) => claim.vertical === vertical.slug)
  .sort((a, b) => ((a.first_reported_date ?? "") < (b.first_reported_date ?? "") ? 1 : -1));
// Where the topic's claims stand, said once in plain words before the list.
const summary = topicClaimSummary(claims);
const mixed = reportedClaimCount(claims) < claims.length;
// A topic with a claim has a link-preview card of its own, built from the same summary.
const card = claims.length > 0 ? `/og/topic/${vertical.slug}.png` : undefined;
// The other topics with published claims, each with its count; this one marked.
const topics = listedTopics.map((topic) => {
  const members = data.claims.filter((claim) => claim.vertical === topic.slug);
  return {
    href: `/topic/${topic.slug}`,
    name: topic.title,
    count: `${members.length} · ${reportedClaimCount(members)} reported`,
    current: topic.slug === vertical.slug,
  };
});
const sentence =
  summary && topicSentence(summary, data.last_checked_at, canonicalAddress(`/topic/${vertical.slug}`));
---

<Base
  title={vertical.title}
  description={`Tracked claims in ${vertical.title.toLowerCase()} and where each stands now.`}
  current="topics"
  image={card}
  imageAlt={card && topicCardAlt(topicCardFor(vertical, claims))}
  breadcrumbs={[
    { name: "Topics", path: "/topics" },
    { name: vertical.title, path: `/topic/${vertical.slug}` },
  ]}
  framed
>
  <section class="band record" slot="band" aria-label="This topic and where its claims stand">
    <div class="wrap band-grid">
      <div class="band-main">
        <nav class="crumbs" aria-label="Where this page sits">
          <a href="/topics">Topics</a>
        </nav>
        <h1 class="title">{vertical.title}</h1>
        {/* A reader arriving from a shared link has not seen the home page. */}
        <p class="what-this-is" data-pagefind-ignore>
          {mixed ? "Tracked claims" : "Reported breakthroughs"} in {vertical.title.toLowerCase()}, and where the public records show
          each stands now. <a href="/how-it-works">How a status is set</a>
        </p>
        <p class="lede">
          {summary ?? "0 reported breakthroughs tracked."}
          {claims.length > 1 && (mixed ? " Newest reports first." : " Newest first.")}
        </p>
        {
          /* Ways to pass the topic on and to hear when one of its claims moves: in the
             band, before the list, so a keyboard reaches them first. */
          claims.length > 0 && (
            <div class="page-actions band-actions" data-pagefind-ignore>
              <SharePill />
              <CopyButton source="topic-sentence" label="Copy sentence" />
              <a class="share" href={`/changes/topic/${vertical.slug}.xml`}>
                <Rss size={16} stroke-width={1.9} aria-hidden="true" />
                <span>Status changes feed</span>
              </a>
              {/* What "Copy sentence" copies: the summary above, dated, with this page's address. */}
              <span id="topic-sentence" hidden>{sentence}</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <div class="frame no-rail">
    <SectionList label="Topics" items={topics} />

    <div class="sheet">
      {
        claims.length === 0 ? (
          <p>No claims are tracked in this topic yet.</p>
        ) : (
          <>
            <h2 class="bar sheet-title" id="claims">Claims in {vertical.title.toLowerCase()}</h2>
            <ClaimTable claims={claims} caption={`Claims in ${vertical.title}`} filter words />
          </>
        )
      }
      <LookupAgain />
    </div>
  </div>
</Base>
