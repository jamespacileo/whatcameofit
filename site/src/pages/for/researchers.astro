---
// For people who study what follows a treatment: the data files themselves, with their
// licence, the day their records were gathered and what a record holds. Openspec
// landing-pages-and-guide.
import Download from "@lucide/astro/icons/download";
import { SITE } from "../../../site.config.mjs";
import Audience from "../../layouts/Audience.astro";
import { CORRECTION_SUBJECT, contactLink } from "../../lib/contact.mjs";
import { DATA_LICENCE, DATA_LICENCE_URL } from "../../lib/open-data";
import { bundleMadeAt, pairDataIndex, topicsIndex } from "../../lib/pairs";
import { formatDate } from "../../lib/timetable";

const count = pairDataIndex(SITE.name, SITE.url).entries.length;
const topics = topicsIndex().length;
const corrections = contactLink(SITE.correctionsUrl, "", CORRECTION_SUBJECT);
---

<Audience
  audience="researchers"
  title="Studying what becomes of a treatment?"
  lede="Every treatment and condition followed here, with its status and the trial records behind it, as JSON you can download, cite and build on."
  description="The open data files of treatments and conditions and what the public trial records show: their licence, the day the records were gathered and what a record holds."
>
  <div class="file" slot="tool">
    <a class="get" href="/data/pairs.json" download>
      <Download size={18} stroke-width={1.9} aria-hidden="true" />
      Download the index, pairs.json
    </a>
    <dl class="about-file">
      <div>
        <dt>Holds</dt>
        <dd>
          {count}{" "}
          {count === 1 ? "treatment and condition" : "treatments and conditions"} in {topics}{" "}
          {topics === 1 ? "topic" : "topics"}, as JSON.
        </dd>
      </div>
      <div>
        <dt>Records gathered</dt>
        <dd>{formatDate(bundleMadeAt())}</dd>
      </div>
      <div>
        <dt>Licence</dt>
        <dd>
          <a href={DATA_LICENCE_URL}>{DATA_LICENCE}</a>
        </dd>
      </div>
    </dl>
  </div>

  <h2 class="bar" id="fields">What each record holds</h2>
  <p>
    The index lists each treatment and condition with the address of its full record, one file
    each. <a href="/data">The data page</a> says how to fetch them all and gives the credit line
    to use. The files hold public trial records only, and no article text.
  </p>

  <h2 class="bar">How a status is set</h2>
  <p>
    By fixed rules, applied in order, from the dated registry events of the trials in a record.
    No model and no editor decides one, and a record names the events that produced its status.{" "}
    <a href="/how-it-works#how-a-status-is-set">The rules, in order</a>
  </p>

  <h2 class="bar">Feeds, and reporting a wrong match</h2>
  <p>
    For a feed reader: <a href="/changes.xml">every status change</a>.
  </p>
  {
    corrections && (
      <p>
        A trial filed under the wrong treatment or condition:{" "}
        <a href={corrections.href}>report it (opens {corrections.opens})</a>, with the record's
        identifier. A wrong match is removed and the rules then set the status again.
      </p>
    )
  }

  <Fragment slot="limits">
    <p>
      The treatments and conditions are not a sample of medicine. They are the ones this site
      follows so far, so counts across them describe this collection and nothing wider.
    </p>
    <p>
      Trials are matched to a treatment and condition by software and published by rule; a record
      says whether a person has reviewed it. A real trial can be missed, and a status can lag a
      registry.
    </p>
    <p>
      No outlet, researcher or company is ranked or scored, and the files hold no article text.
    </p>
  </Fragment>
</Audience>

<style>
  .file {
    margin-top: 1.5rem;
    max-width: 46rem;
  }

  .get {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3.2rem;
    padding: 0 1.4rem;
    border-radius: 0.65rem;
    background: var(--blue-fill);
    color: var(--on-blue);
    font-size: 1.08rem;
    font-weight: 700;
    text-decoration: none;
  }

  .get:hover {
    background: var(--blue-hover);
  }

  .about-file,
  .fields {
    margin: 1.1rem 0 0;
  }

  .about-file div,
  .fields div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.1rem 1.25rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--rule);
  }

  .about-file dt,
  .fields dt {
    font-weight: 600;
  }

  .about-file dt {
    color: var(--muted);
  }

  .about-file dd,
  .fields dd {
    margin: 0;
  }

  .fields {
    max-width: var(--measure);
  }

  .fields code {
    overflow-wrap: anywhere;
  }

  @media (max-width: 40rem) {
    .about-file div,
    .fields div {
      grid-template-columns: 1fr;
    }
  }
</style>
