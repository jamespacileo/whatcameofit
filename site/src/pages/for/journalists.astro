---
// For a journalist writing a follow-up: find a treatment, and its status box appears as it
// will on their own page, with the snippet that places it. The box is the site's own
// embed at its real size, so nothing here can differ from what a reader of theirs
// sees. Openspec landing-pages-and-guide.
import { SITE } from "../../../site.config.mjs";
import CopyButton from "../../components/CopyButton.astro";
import Audience from "../../layouts/Audience.astro";
import type { PickerPair } from "../../lib/audiences";
import { SUGGEST_SUBJECT, contactLink } from "../../lib/contact.mjs";
import { examplePair } from "../../lib/extension-page";
import { builtAheadPages, bundleMadeAt, pairView } from "../../lib/pairs";
import { DATA_LICENCE, DATA_LICENCE_URL } from "../../lib/open-data";
import { EMBED_SIZE, checkedMonth, embedSnippet } from "../../lib/share";
import { canonicalAddress } from "../../lib/structured";

// The pairs with a status box: those whose embed the build makes (`builtAhead`). What the
// search matches: a treatment's names and the condition.
const boxed = Object.values(builtAheadPages());
const pairs: PickerPair[] = boxed.map(pairView).map((pair) => ({
  slug: pair.address,
  name: pair.intervention,
  headline: pair.title,
  words: [pair.intervention, ...pair.otherNames, pair.condition].join(" ").toLowerCase(),
}));
// The box is drawn on arrival for the example pair, so the tool is seen working.
const firstPage = examplePair(boxed);
const first = firstPage && pairView(firstPage);
const suggest = contactLink(SITE.suggestUrl, "", SUGGEST_SUBJECT);
const checked = checkedMonth(bundleMadeAt());
// "<" is escaped so that no text in the data can close the script element.
const pairsJson = JSON.stringify(pairs).replace(/</g, "\\u003c");
---

<Audience
  audience="journalists"
  title="Writing a follow-up?"
  lede="Find the treatment your story is about. Its status box appears here as it will on your page, with the code that places it. The box follows the public records, so it stays current after you publish."
  description="A status box for your own follow-up story: find a treatment followed here, see its embed at full size and copy the code that places it."
>
  <div class="picker" slot="tool" data-picker data-site={SITE.url}>
    <form class="search" role="search" data-picker-form>
      <label for="pick">Find by treatment or condition</label>
      <div class="row">
        <input
          id="pick"
          type="search"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <button type="submit">Find</button>
      </div>
    </form>
    <noscript>
      <p class="entry-note">
        Finding a treatment here needs JavaScript.
      </p>
    </noscript>
    <div class="found" aria-live="polite" data-picker-found></div>
    <p class="none" data-picker-none hidden>
      <span data-picker-none-text></span>
      {
        suggest && (
          <>
            {" "}
            <a href={suggest.href}>Suggest a treatment (opens {suggest.opens})</a>
          </>
        )
      }
    </p>

    {
      first && (
        <div class="shown" data-picker-shown>
          <p class="showing">
            Showing: <a href={`/${first.address}`} data-picker-link>{first.intervention}</a>
          </p>
          <div class="frame">
            <iframe
              src={`/embed/${first.address}`}
              title={first.title}
              width={EMBED_SIZE.width}
              height={EMBED_SIZE.height}
              data-picker-frame></iframe>
          </div>
          <div class="code">
            <p class="entry-note">
              Paste this where the box should appear. It shows the current status and links to its
              page here; it loads nothing else and stores nothing.
            </p>
            <pre id="picker-snippet" data-picker-snippet><code>{embedSnippet(SITE.url, first.address, first.title)}</code></pre>
            <CopyButton source="picker-snippet" label="Copy code" />
          </div>
        </div>
      )
    }
    <script type="application/json" id="picker-pairs" is:inline set:html={pairsJson} />
  </div>

  <h2 class="bar">How to cite a page</h2>
  <p>
    Give the page's address and the month its records were gathered, since a status can
    change.
    {
      first && checked && (
        <>
          {" "}
          For example: “{SITE.name}, {canonicalAddress(`/${first.address}`)}, checked {checked}.”
        </>
      )
    }
  </p>

  <h2 class="bar">Where corrections go</h2>
  <p>
    A status is never edited by hand: the missing or wrong record is fixed,
    and the rules set the status again. The box on your page follows at the next rebuild.
  </p>

  <h2 class="bar">The open data</h2>
  <p>
    Every treatment and condition followed, with its records and sources, is open data under{" "}
    <a href={DATA_LICENCE_URL}>{DATA_LICENCE}</a>. <a href="/data">Download and credit line</a>
  </p>

  <Fragment slot="limits">
    <p>Outlets are never ranked or compared.</p>
    <p>
      It gives no verdict on a treatment, a researcher or a company. A status describes which records
      exist; <a href="/guide">the guide</a> says what each one does not tell you.
    </p>
    <p>
      A page that no person has checked says so, and so does its box. The box is shown here
      as it is.
    </p>
  </Fragment>
</Audience>

<script>
  // The search runs in the page, over the pairs written into it at build. Nothing
  // typed here is sent anywhere. Picking one swaps the box and the code under it.
  import { pickPairs, type PickerPair } from "../../lib/audiences";
  import { embedSnippet } from "../../lib/share";

  const picker = document.querySelector<HTMLElement>("[data-picker]");
  const carried = document.querySelector("#picker-pairs");
  if (picker && carried) {
    const pairs: PickerPair[] = JSON.parse(carried.textContent!);
    const site = picker.dataset.site!;
    const form = picker.querySelector<HTMLFormElement>("[data-picker-form]")!;
    const input = picker.querySelector<HTMLInputElement>("#pick")!;
    const found = picker.querySelector<HTMLElement>("[data-picker-found]")!;
    const none = picker.querySelector<HTMLElement>("[data-picker-none]")!;
    const noneText = picker.querySelector<HTMLElement>("[data-picker-none-text]")!;
    const frame = picker.querySelector<HTMLIFrameElement>("[data-picker-frame]");
    const link = picker.querySelector<HTMLAnchorElement>("[data-picker-link]");
    const snippet = picker.querySelector<HTMLElement>("[data-picker-snippet] code");

    const show = (pair: PickerPair) => {
      if (!frame || !link || !snippet) return;
      frame.src = `/embed/${pair.slug}`;
      frame.title = pair.headline;
      link.href = `/${pair.slug}`;
      link.textContent = pair.name;
      snippet.textContent = embedSnippet(site, pair.slug, pair.headline);
      found.replaceChildren();
      link.closest<HTMLElement>("[data-picker-shown]")!.scrollIntoView({ block: "nearest" });
    };

    const search = () => {
      const typed = input.value.trim();
      const matches = pickPairs(pairs, typed);
      none.hidden = typed === "" || matches.length > 0;
      noneText.textContent = `Nothing followed here matches “${typed}”. A status box is offered for the treatments this site builds a page for ahead.`;
      const list = document.createElement("ul");
      list.className = "plain picks";
      for (const pair of matches) {
        const item = document.createElement("li");
        const pick = document.createElement("button");
        pick.type = "button";
        pick.className = "pick";
        const name = document.createElement("strong");
        name.textContent = pair.name;
        const headline = document.createElement("span");
        headline.className = "entry-note";
        headline.textContent = pair.headline;
        pick.append(name, headline);
        pick.addEventListener("click", () => show(pair));
        item.append(pick);
        list.append(item);
      }
      found.replaceChildren(...(matches.length > 0 ? [list] : []));
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      search();
    });
    input.addEventListener("input", search);
  }
</script>

<style>
  .picker {
    max-width: 46rem;
  }

  .found :global(.picks) {
    margin-top: 0.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .found :global(.picks li) {
    padding: 0;
  }

  .found :global(.picks li:first-child) {
    border-top: 0;
  }

  .found :global(.picks li:last-child) {
    border-bottom: 0;
  }

  .found :global(.pick) {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6rem 0.9rem;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .found :global(.pick:hover) {
    background: var(--panel);
  }

  .found :global(.pick strong) {
    color: var(--blue);
  }

  .none {
    margin-top: 0.75rem;
  }

  .shown {
    margin-top: 1.25rem;
  }

  .showing {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* The embed at the size its snippet gives, on the paper a reader's page would be. */
  .frame {
    width: fit-content;
    max-width: 100%;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .frame iframe {
    display: block;
    max-width: 100%;
    border: 0;
  }

  .code {
    margin-top: 0.9rem;
  }

  .code pre {
    margin: 0.5rem 0 0.6rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 0.65rem;
    font-size: 0.85rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
