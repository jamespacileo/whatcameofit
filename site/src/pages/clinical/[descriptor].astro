---
// One MeSH category: where it sits, what is narrower, and the published claims at or
// below it. Addressed by the descriptor's identifier, which NLM keeps when it rewords a
// name or moves a term. Openspec site-publishing: "Clinical category page".
import Base from "../../layouts/Base.astro";
import ClaimTable from "../../components/ClaimTable.astro";
import { hasLinkedReport, reportedClaimCount } from "../../lib/reports";
import MeshCredit from "../../components/MeshCredit.astro";
import { data } from "../../lib/export";
import {
  buildTree,
  categoryPath,
  claimCount,
  listedCategories,
  narrowerWithClaims,
} from "../../lib/clinical";
import { pairBundleFolder } from "../../lib/pairs";

export function getStaticPaths() {
  // A build that reads a bundle lists pairs on this address (src/pair/CategoryRoute.astro).
  if (pairBundleFolder()) return [];
  const tree = buildTree(data.clinical, data.claims);
  return listedCategories(tree).map((node) => ({
    params: { descriptor: node.identifier },
    props: { node },
  }));
}

const { node } = Astro.props;
const tree = buildTree(data.clinical, data.claims);
const broader = node.broader
  .filter((parent) => tree.narrower.get(parent)?.includes(node.identifier))
  .map((identifier) => tree.nodes.get(identifier))
  .filter((one) => one !== undefined)
  .sort((a, b) => a.label.localeCompare(b.label));
const narrower = narrowerWithClaims(tree, node.identifier);
const reportedSlugs = new Set(data.claims.filter(hasLinkedReport).map((claim) => claim.slug));
const slugs = tree.claims.get(node.identifier) ?? new Set<string>();
const claims = data.claims
  .filter((claim) => slugs.has(claim.slug))
  .sort((a, b) => ((a.first_reported_date ?? "") < (b.first_reported_date ?? "") ? 1 : -1));
---

<Base
  title={`${node.label} (MeSH)`}
  description={`Tracked claims filed under the MeSH category ${node.label}, and where each stands now.`}
  current="topics"
  breadcrumbs={[
    { name: "Clinical categories", path: "/clinical" },
    { name: node.label, path: categoryPath(node.identifier) },
  ]}
>
  <nav class="crumbs" aria-label="Where this page sits">
    <a href="/clinical">Clinical categories</a>
  </nav>
  <h1 class="title">{node.label}</h1>
  <p class="lede">
    {`${claims.length} ${claims.length === 1 ? "claim" : "claims"} in this MeSH category or one narrower.`}
    {" "}{reportedClaimCount(claims)} with a linked report.
    {claims.length > 1 && " Newest first."}
  </p>
  {
    broader.length > 0 && (
      <p class="what-this-is clinical-broader">
        {broader.length === 1 ? "Broader category: " : `Sits under ${broader.length} broader categories: `}
        {broader.map((one, index) => (
          <>
            {index > 0 && ", "}
            <a href={categoryPath(one.identifier)} data-broader>{one.label}</a>
          </>
        ))}
      </p>
    )
  }
  <p class="what-this-is">
    {`MeSH category ${node.identifier}${node.tree_numbers.length > 0 ? `, tree ${node.tree_numbers.join(", ")}` : ""}.`}
    {broader.length === 0 && " It is at the top of its tree."}
    {" A condition can be listed in a trial record, indexed as a major subject on a paper, or identified by an approved model reading of the claim’s stated condition. Each claim page names its sources. A category is not a diagnosis and not advice."}
  </p>

  {
    narrower.length > 0 && (
      <div class="directory grouped clinical-directory">
        <section class="letter" aria-labelledby="clinical-narrower">
          <h2 id="clinical-narrower">Narrower categories</h2>
          <ul>
            {narrower.map((one) => (
              <li>
                <a href={categoryPath(one.identifier)}>{one.label}</a>
                <span class="count">
                  {claimCount(tree, one.identifier)}
                  <span class="visually-hidden">
                    {claimCount(tree, one.identifier) === 1 ? " claim" : " claims"}
                  </span>
                  {" · "}{[...(tree.claims.get(one.identifier) ?? [])].filter((slug) => reportedSlugs.has(slug)).length} reported
                </span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    )
  }

  <h2 class="bar sheet-title clinical-claims" id="claims">Claims in {node.label}</h2>
  <ClaimTable claims={claims} caption={`Claims in the MeSH category ${node.label}`} filter words />

  <MeshCredit />
</Base>
