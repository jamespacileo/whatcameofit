---
// The clinical index: the tops of MeSH's trees that a published claim falls under, each
// with how many. For a reader who thinks in the standard hierarchy; the topics page is
// the same claims in everyday names. Openspec site-publishing: "Clinical index".
import Base from "../../layouts/Base.astro";
import MeshCredit from "../../components/MeshCredit.astro";
import { data } from "../../lib/export";
import { buildTree, categoryPath, claimCount, topCategories } from "../../lib/clinical";
import { hasLinkedReport } from "../../lib/reports";
import ClinicalIndex from "../../pair/ClinicalIndex.astro";
import { pairBundleFolder } from "../../lib/pairs";
// A build that reads a bundle lists pairs here (openspec pairs-site).
const pairIndex = pairBundleFolder() !== null;

const tree = buildTree(data.clinical, data.claims);
const reportedTree = buildTree(data.clinical, data.claims.filter(hasLinkedReport));
const tops = topCategories(tree);
const filed = new Set([...tree.claims.values()].flatMap((slugs) => [...slugs])).size;
const reported = new Set([...reportedTree.claims.values()].flatMap((slugs) => [...slugs])).size;
---

{
  pairIndex ? (
    <ClinicalIndex />
  ) : (
<Base
  title="Clinical categories"
  description="Tracked claims by MeSH category, the U.S. National Library of Medicine's hierarchy of conditions."
  current="topics"
  breadcrumbs={[{ name: "Clinical categories", path: "/clinical" }]}
>
  <h1 class="title">Clinical categories</h1>
  <p class="lede">
    {`${filed} ${filed === 1 ? "claim" : "claims"}`} filed by condition using MeSH, the National Library of Medicine’s
    vocabulary. {reported} with a linked report. A claim can sit under more than one category.
  </p>
  <p class="what-this-is">
    Categories come from conditions listed in trial records, major subject headings on papers,
    or an approved model reading of the claim’s stated condition. Each claim page shows which
    source supports each category. A category is not a diagnosis and not advice. The same claims in everyday names are on the{" "}
    <a href="/topics">topics page</a>.
  </p>

  {
    tops.length === 0 ? (
      <p>No tracked claim has a clinical category yet.</p>
    ) : (
      <div class="directory grouped clinical-directory">
        <section class="letter" aria-labelledby="clinical-top">
          <h2 id="clinical-top">Top categories</h2>
          <ul>
            {tops.map((node) => (
              <li>
                <a href={categoryPath(node.identifier)}>{node.label}</a>
                <span class="count">
                  {claimCount(tree, node.identifier)}
                  <span class="visually-hidden">
                    {claimCount(tree, node.identifier) === 1 ? " claim" : " claims"}
                  </span>
                  {" · "}{claimCount(reportedTree, node.identifier)} reported
                </span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    )
  }

  <MeshCredit />
</Base>
  )
}
