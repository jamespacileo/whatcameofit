---
import Base from "../layouts/Base.astro";
import { SITE } from "../../site.config.mjs";
import { data } from "../lib/export";
import { DATA_LICENCE, DATA_LICENCE_URL, dataCredit, recordPath } from "../lib/open-data";
import { datasetData } from "../lib/structured";

const credit = dataCredit(SITE.name, SITE.url);
const example = data.claims[0]?.slug;
const description =
  "Every published claim, with its status, records and sources, as JSON you can download and reuse: an index of every claim, and one file per claim.";
---

<Base
  title="Data"
  description={description}
  structured={datasetData({
    description,
    licence: DATA_LICENCE_URL,
    claimCount: data.claims.length,
    dateModified: data.generated_at,
  })}
  breadcrumbs={[{ name: "Data", path: "/data" }]}
>
  <h1 class="title">Data</h1>
  <p class="lede">
    Every published claim, with its status, the records that produced it, its source reports and
    its promises, as JSON you can download, cite and build on.
  </p>

  {
    data.preview && (
      <p class="entry-note">
        This is a preview. The files hold claims that no person has yet checked, and each is marked.
      </p>
    )
  }

  <h2 class="bar">The files</h2>
  <ul class="plain">
    <li>
      <a href="/data/claims.json" download>Download the index, claims.json</a>
      <span class="entry-note">
        {data.claims.length}
        {data.claims.length === 1 ? " claim" : " claims"}, as JSON
      </span>
    </li>
  </ul>
  <p>
    The index lists every claim with its headline, treatment, condition, status code, the date it
    was first reported and the day the registries were last checked. Each entry's
    <code>record</code> is the address of that claim's full record, such as{" "}
    {example ? <a href={recordPath(example)}><code>{recordPath(example)}</code></a> : <code>/data/claims/&lt;slug&gt;.json</code>}.
    Each record file carries the licence and credit line too, so it can be used on its own.
  </p>
  <p>
    To get everything, download the index, then each address in its <code>record</code> fields.
  </p>
  <p>
    The files leave out article text, claims not approved in review, and outlet icons.
  </p>

  <h2 class="bar">Licence and credit</h2>
  <p>
    The data is offered under <a href={DATA_LICENCE_URL}>{DATA_LICENCE}</a>.
  </p>
  <p>Credit: {credit}</p>
</Base>
