---
import Base from "../layouts/Base.astro";
import Unfound from "../components/Unfound.astro";
import { topicsIndex } from "../lib/pairs";

const topics = topicsIndex();
---

<Base title="No page at this address">
  {/* The site's own way of reporting, turned on a missing page. */}
  <h1 class="title">No page record found</h1>
  <Unfound />
  <p class="lede">
    No treatment and condition followed here has this address. It may never have been followed,
    or the address may be mistyped. Last checked: just now.
  </p>
  <ul class="plain">
    <li><a href="/">Search the treatments and conditions followed</a></li>
    {
      // A handful of topics are named here; more than that are a list of their own.
      topics.length > 6 ? (
        <li>
          <a href="/topics">All {topics.length} topics</a>
        </li>
      ) : (
        topics.map((topic) => (
          <li>
            <a href={`/topic/${topic.slug}`}>Everything in {topic.title.toLowerCase()}</a>
          </li>
        ))
      )
    }
  </ul>
</Base>
