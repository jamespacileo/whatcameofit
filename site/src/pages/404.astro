---
import Base from "../layouts/Base.astro";
import Unfound from "../components/Unfound.astro";
import { listedTopics } from "../lib/export";
---

<Base title="No page at this address">
  {/* The site's own way of reporting, turned on a missing page. */}
  <h1 class="title">No page record found</h1>
  <Unfound />
  <p class="lede">
    No tracked claim has this address. It may never have been tracked, or the address may be
    mistyped. Last checked: just now.
  </p>
  <ul class="plain">
    <li><a href="/">Search the tracked claims</a></li>
    {
      // A handful of topics are named here; more than that are a list of their own.
      listedTopics.length > 6 ? (
        <li>
          <a href="/topics">All {listedTopics.length} topics</a>
        </li>
      ) : (
        listedTopics.map((vertical) => (
          <li>
            <a href={`/topic/${vertical.slug}`}>All claims in {vertical.title.toLowerCase()}</a>
          </li>
        ))
      )
    }
  </ul>
</Base>
