---
import Base from "../layouts/Base.astro";
import Calendar from "@lucide/astro/icons/calendar";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Clock from "@lucide/astro/icons/clock";
import Copy from "@lucide/astro/icons/copy";
import ExternalLink from "@lucide/astro/icons/external-link";
import FileText from "@lucide/astro/icons/file-text";
import ImageDown from "@lucide/astro/icons/image-down";
import Info from "@lucide/astro/icons/info";
import Bookmark from "@lucide/astro/icons/bookmark";
import ClockMark from "../components/ClockMark.astro";
import BasisMark from "../components/BasisMark.astro";
import FoldHead from "../components/FoldHead.astro";
import FollowOffer from "../components/FollowOffer.astro";
import LookupAgain from "../components/LookupAgain.astro";
import Outlet from "../components/Outlet.astro";
import KindIcon from "../components/KindIcon.astro";
import Pop from "../components/Pop.astro";
import Score from "../components/Score.astro";
import RecordBrief from "../components/RecordBrief.astro";
import RecordStrip from "../components/RecordStrip.astro";
import StripKey from "../components/StripKey.astro";
import { claimAxis, stripFor } from "../lib/record-strip";
import SectionList from "../components/SectionList.astro";
import SharePill from "../components/SharePill.astro";
import Statements from "../components/Statements.astro";
import StageTrack from "../components/StageTrack.astro";
import TopicDrawing from "../components/TopicDrawing.astro";
import TrialDetailsLink from "../components/TrialDetailsLink.astro";
import { APPROACH_LABELS, approachBasisSentence } from "../lib/approach";
import { categoryPath, termSourceSentence } from "../lib/clinical";
import MeshCredit from "../components/MeshCredit.astro";
import { claimPaths, data, verticalTitle, type ExportedClaim } from "../lib/export";
import { statusSlug } from "../lib/guide";
import { BRIEF_TITLE, digestApproval, digestBridge, phase4Note, recordBrief } from "../lib/record-brief";
import { UNCHECKED_BYLINE } from "../lib/notices";
import { statementsHeading } from "../lib/statements";
import {
  EVIDENCE_STAGES,
  KIND_NAMES,
  KIND_PLURALS,
  STAGE_PATH,
  STATUS_LABELS,
  STATUS_GLOSSES,
  STATUS_MEANINGS,
  eventKind,
  eventLabel,
  latestPromise,
  overlayText,
  sourceName,
  type RecordKind,
} from "../lib/status";
import { cardAlt, clip, shareSentence } from "../lib/card";
import { embedSnippet, shareLinks } from "../lib/share";
import { LOW_READING_MEANING, MATCH_MEANING, matchWords, stageReading } from "../lib/confidence";
import MatchList from "../components/MatchList.astro";
import RegistryRecords from "../components/RegistryRecords.astro";
import Fact from "../components/Fact.astro";
import FactSheet from "../components/FactSheet.astro";
import Glance from "../components/Glance.astro";
import { NOT_COUNTED_LINK, notCounted } from "../lib/registry-records";
import GlanceBand from "../components/GlanceBand.astro";
import { GLANCE_ID, GLANCE_TITLE, bandFacts, glanceCards } from "../lib/glance";
import Organisations from "../components/Organisations.astro";
import { publisherOf, publisherText } from "../lib/organisations";
import Paper from "../components/Paper.astro";
import Trial from "../components/Trial.astro";
import {
  PAPERS_NOTE,
  PAPERS_SHOWN,
  TIE_KEY,
  trialRoles,
  countRecords,
  groupPapers,
  recordCountText,
} from "../lib/paper-facts";
import {
  TRIALS_NOTE,
  TRIALS_PER_PHASE,
  trialDates,
  isPaperMatch,
  orderTrials,
  measureGlosses,
  phaseGroups,
  withResults,
  PLAIN_STATE,
  RESULTS_POSTED,
  phaseText,
} from "../lib/trial-facts";
import { FOLLOWED_SHOWN, followedName, followedReports } from "../lib/reports";
import { claimPageData } from "../lib/structured";
import ReportError from "../components/ReportError.astro";
import { SITE } from "../../site.config.mjs";
import { cardFor } from "../lib/card-image";
import { buildTimetable, dayAndMonth, formatDate, recordedLines } from "../lib/timetable";

export const getStaticPaths = claimPaths;

interface Props {
  claim: ExportedClaim;
}

const { claim } = Astro.props;
// A lower-band reading of the evidence stage, in the parts its chip shows.
const stageRead = claim.evidence_stage_reading
  ? stageReading(claim.evidence_stage_reading, (code) => EVIDENCE_STAGES[code] ?? code)
  : null;
const timetable = buildTimetable(claim, data.generated_at);
const overlay = overlayText(claim.status.overlay_years);
const thisYear = Number(data.generated_at.slice(0, 4));
// The timetable already orders both reports and events newest first.
const latestYear = timetable.rows.find((row) => row.kind === "year" && row.recorded.length > 0);
const latestRecord = latestYear?.kind === "year" ? latestYear.recorded[0] : null;
const latestAnchor = latestRecord?.kind === "event" ? `record-${latestRecord.mark}` : "latest-report";
const onPath = STAGE_PATH.includes(claim.status.code);
const phase4 = phase4Note(claim);
const hasDatedPromise = claim.promises.some((promise) => promise.parsed_date !== null);
const hasPromise = claim.promises.length > 0;
// The claim's records by date on its own axis, and a key naming only the marks drawn;
// the end of the axis is named in words under it.
const lastCheckedDay = data.last_checked_at?.slice(0, 10) ?? null;
const ownAxis = lastCheckedDay ? claimAxis(claim, lastCheckedDay) : null;
const ownKinds = ownAxis
  ? [...new Set(stripFor(claim, ownAxis.startYear, ownAxis.lastChecked).marks.map((mark) => mark.kind))]
  : [];
// The year the latest dated promise names, shown beside the status as it is on the card.
const promised = latestPromise(claim)?.parsed_date?.slice(0, 4) ?? null;
// The legend names only the kinds of record this page shows.
const kinds: RecordKind[] = [
  ...(claim.articles.length > 0 ? (["report"] as const) : []),
  ...new Set(claim.events.map(eventKind)),
];
const explaining = timetable.sources.filter(({ event }) =>
  claim.status.explained_by.includes(event.id),
);
const latestExplaining = [...explaining]
  .sort((a, b) => (b.event.event_date ?? "").localeCompare(a.event.event_date ?? ""))
  .slice(0, 3);
const description = `${STATUS_LABELS[claim.status.code]}. ${claim.summary}`;
const imageAlt = cardAlt(cardFor(claim));
// In a browser tab and a search result there is room for what and for what, not for
// a whole headline: about sixty characters with the site's name.
const tabTitle = clip(`${claim.intervention.name} for ${claim.indication}`, 41);
// Where to go next: the claims filed with this one, newest report first.
const topic = verticalTitle(claim.vertical);
const inTopic = data.claims
  .filter((other) => other.vertical === claim.vertical && other.slug !== claim.slug)
  .sort((a, b) => ((a.first_reported_date ?? "") < (b.first_reported_date ?? "") ? 1 : -1));
const others = inTopic.slice(0, 3);
// The claim's clinical categories under NLM's names, each with the trials and papers
// that gave it, linked where the claim lists them. None while they are not yet read.
const meshNodes = new Map((data.clinical?.nodes ?? []).map((node) => [node.identifier, node]));
const categories = (claim.clinical_categories ?? [])
  .filter((category) => meshNodes.has(category.identifier))
  .map((category) => ({
    identifier: category.identifier,
    label: meshNodes.get(category.identifier)!.label,
    sources: category.sources.map((source) => ({
      kind: source.kind,
      name: source.identifier,
      score: source.score,
      href:
        source.kind === "trial"
          ? (claim.trials ?? []).find((trial) => trial.trial_id === source.identifier)?.url
          : source.kind === "paper"
            ? (claim.papers ?? []).find((paper) => paper.identifier === source.identifier)?.url
            : undefined,
    })),
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
// A group's papers stand newest first, under the year each appeared.
type PaperOnPage = NonNullable<typeof claim.papers>[number];
const newestFirst = (papers: PaperOnPage[]) =>
  [...papers].sort((a, b) => (b.facts?.year ?? 0) - (a.facts?.year ?? 0));
const byYear = (papers: PaperOnPage[]) => {
  const years = new Map<string, PaperOnPage[]>();
  for (const paper of papers) {
    const year = paper.facts?.year ? String(paper.facts.year) : "No year";
    years.set(year, [...(years.get(year) ?? []), paper]);
  }
  return [...years];
};
// Matched records, approved first, each with how sure the match is. A paper is not a
// registry record, so papers are listed and counted apart.
const matched = claim.matches ?? [];
// An export made before openspec paper-facts lists its papers among the matches.
const papers = claim.papers ? [] : matched.filter(isPaperMatch);
const paperGroups = groupPapers(claim.papers ?? []);
const recordCount = claim.papers ? recordCountText(countRecords(claim)) : null;
const registryMatches = matched.filter((match) => !isPaperMatch(match));
const counted = registryMatches.filter((match) => match.state === "approved").length;
const candidates = registryMatches.filter((match) => match.state === "candidate");
const possible = candidates.length;
// Each trial once, furthest phase first, with the match that brought it to the claim.
const trials = orderTrials(claim.trials ?? []);
const trialIds = new Set(trials.map((trial) => trial.trial_id));
// The trials by furthest phase, furthest first; each phase shows its first ten.
const trialGroups = phaseGroups(trials);
// The trials spread by phase: a mark for each under its phase, drawn over the table
// once there are enough to make a pattern. The phases in order, no phase last.
const NO_PHASE = "No phase given";
const trialSpread = (() => {
  const columns = new Map<string, typeof trials>();
  for (const trial of trials) {
    const name = phaseText(trial.phases.filter((code) => code !== "not_applicable")) ?? NO_PHASE;
    columns.set(name, [...(columns.get(name) ?? []), trial]);
  }
  return [...columns].sort(([a], [b]) =>
    a === NO_PHASE ? 1 : b === NO_PHASE ? -1 : a.localeCompare(b, "en", { numeric: true }),
  );
})();
// The largest size a trial states, against which each trial's size is drawn.
const largestSize = Math.max(0, ...trials.map((trial) => trial.facts?.participants?.count ?? 0));
// Each abbreviation in a main measure is said plainly once, on the first row that uses it.
const glossSeen = new Set<string>();
const trialGlosses = new Map<string, string[]>();
for (const group of trialGroups) {
  for (const trial of group.trials) {
    const measure = trial.facts?.primary_outcomes[0]?.measure;
    const fresh = (measure ? measureGlosses(measure) : []).filter((gloss) => {
      const plain = gloss.slice(gloss.indexOf(": ") + 2);
      if (glossSeen.has(plain)) return false;
      glossSeen.add(plain);
      return true;
    });
    trialGlosses.set(trial.trial_id, fresh);
  }
}
const matchOf = (trialId: string) =>
  registryMatches.find((match) => match.state === "approved" && match.external_id === trialId);
const bridge = digestBridge(claim);
const approvalNote = digestApproval(claim);
// The popover names the latest records the status rests on; the timetable marks all.
const WHY_SHOWN = latestExplaining.length;
// Who a report or a trial record says is behind the claim (openspec organisations), and
// the organisation, if any, on whose website a report is.
const organisations = claim.organisations ?? [];
const publisherNote = (url: string) => {
  const publisher = publisherOf(
    organisations,
    claim.articles.find((article) => article.url === url)?.published_by,
  );
  return publisher ? publisherText(publisher.name) : null;
};
// An approved record with no dated event yet has no trial entry, so it stays listed here.
const untried = registryMatches.filter(
  (match) => match.state === "approved" && !trialIds.has(match.external_id),
);
// The registry records section's name, the same in its heading and the section list.
const matchedHeading =
  untried.length > 0 || candidates.length === 0 ? "Matched registry records" : "Possible registry records";
// The trials section above already says what a score is about; said once on the page.
const scoreNote = trials.length > 0 ? "" : " A score is about the match, not about the treatment.";
// What the registry records section holds, said beside its heading while it is folded.
const matchedNote =
  [
    ...(untried.length > 0 ? [`${untried.length} matched`] : []),
    ...(candidates.length > 0 ? [`${candidates.length} possible, not counted`] : []),
  ].join(" · ") || null;
// A reader arrives from a headline, so the page names the reports it is about, newest first.
const reports = followedReports(claim);
const shownReports = reports.slice(0, FOLLOWED_SHOWN);
const address = `${SITE.url}/${claim.slug}`;
const sentence = shareSentence(claim, STATUS_LABELS[claim.status.code], data.last_checked_at, address);
// Reminders: the dates a reader can save, which the browser turns into a calendar file.
const promiseDue = latestPromise(claim)?.parsed_date ?? null;
// The whole of what another site needs to show this claim's status.
const snippet = embedSnippet(SITE.url, claim.slug, claim.headline);
// Prefilled posts carry the sentence and the address, and nothing of our own.
const postText = shareSentence(claim, STATUS_LABELS[claim.status.code], data.last_checked_at, "").trim();
const posts = shareLinks(postText, address, claim.headline);
// Promises and records are counted apart and never added together: every label that
// states them reads this one pair (openspec: "Promises and records are counted apart").
const counts = timetable.counts;
// The kinds of entry the timetable can be narrowed to, each with how many it holds.
const kindCounts = [
  ...(hasPromise ? [{ kind: "promise", name: "Promises", n: counts.promises }] : []),
  ...kinds.map((kind) => ({
    kind,
    name: KIND_PLURALS[kind],
    n: kind === "report" ? claim.articles.length : claim.events.filter((event) => eventKind(event) === kind).length,
  })),
];
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
// The record's moments: the first of each kind of record, the report, the latest record
// and a promised date, in order of date. They say when, never how it turned out.
const firstOn = (type: string, state?: string) =>
  claim.events
    .filter((event) => event.type === type && (!state || event.trial_state === state))
    .map((event) => event.event_date)
    .sort()[0] ?? null;
const latestOn = latestRecord?.date;
const moments = [
  { date: firstOn("trial_registered"), label: "First trial registered", mark: "not_started" },
  { date: firstOn("trial_status_change", "started"), label: "First trial started", mark: "under_way" },
  { date: claim.first_reported_date, label: claim.articles.length > 1 ? "First report" : "This report", mark: "report" },
  { date: firstOn("trial_results_posted"), label: "First results posted", mark: "results" },
  { date: firstOn("regulatory_decision"), label: "A regulator’s decision", mark: "completed" },
  { date: promiseDue, label: "Promised", mark: "promise" },
].filter((moment): moment is { date: string; label: string; mark: string } => moment.date !== null);
const milestones = [
  ...moments,
  // The latest record is a moment of its own unless one of the others is it.
  ...(latestOn && !moments.some((moment) => moment.date === latestOn)
    ? [{ date: latestOn, label: "Latest record", mark: "latest" }]
    : []),
].sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
const timetableNote = [
  ...(counts.promises > 0 ? [plural(counts.promises, "promise")] : []),
  plural(counts.records, "record"),
].join(" · ");
// A long record folds by year (openspec sheet-cohesion). This year and last stay open,
// with any year a promise names; an older year is one line that says how many records
// it holds and of what kinds, marks a record the status rests on, and opens to them.
// A link to a record inside a folded year opens the year (scripts/folds.ts).
const FOLD_OVER = 20;
const yearFolds = (row: Extract<(typeof timetable.rows)[number], { kind: "year" }>) =>
  counts.records > FOLD_OVER &&
  row.year < thisYear - 1 &&
  row.promised.length === 0;
const yearSaid = (row: Extract<(typeof timetable.rows)[number], { kind: "year" }>) => {
  const tally = new Map<string, number>();
  for (const entry of row.recorded) {
    const label = entry.kind === "report" ? "News report" : eventLabel(entry.event);
    tally.set(label, (tally.get(label) ?? 0) + 1);
  }
  const kindsSaid = [...tally].sort((a, b) => b[1] - a[1]);
  return {
    basis: row.recorded.some((entry) => entry.kind === "event" && entry.explains),
    total: plural(row.recorded.length, "record"),
    kinds: kindsSaid.map(([label, n]) => `${label.toLowerCase()} ${n}`),
  };
};
// The shape of each of a year's records, oldest first: a trial's states as in the trials
// table, results posted as a ringed mark, a report as the report's diamond.
const EVENT_STATES: Record<string, string> = { started: "under_way" };
const yearMarks = (row: Extract<(typeof timetable.rows)[number], { kind: "year" }>) =>
  [...row.recorded].reverse().map((entry) =>
    entry.kind === "report"
      ? "report"
      : entry.event.type === "trial_registered"
        ? "not_started"
        : entry.event.type === "trial_results_posted"
          ? "results"
          : entry.event.type === "trial_status_change"
            ? (EVENT_STATES[entry.event.trial_state ?? ""] ?? entry.event.trial_state ?? "unknown")
            : eventKind(entry.event),
  );
const anyYearFolds = timetable.rows.some((row) => row.kind === "year" && row.recorded.length > 0 && yearFolds(row));
// A key names only the marks its list draws (critique of 2026-11-17: a key listed states
// the claim did not have, and one state went by two names).
const yearKeyMarks = new Set(
  timetable.rows.flatMap((row) => (row.kind === "year" && row.recorded.length > 0 && yearFolds(row) ? yearMarks(row) : [])),
);
const otherYearKinds = kinds.filter((kind) => kind !== "report" && yearKeyMarks.has(kind));
const YEAR_KEY: [string, string, string][] = [
  ["not_started", "state-mark", "Registered"],
  ["under_way", "state-mark", "Started"],
  ["completed", "state-mark", "Finished"],
  ["terminated", "state-mark", PLAIN_STATE.terminated],
];
const TRIAL_KEY_ORDER = ["not_started", "under_way", "completed", "terminated", "suspended", "withdrawn", "unknown"];
const stateOf = (trial: (typeof trials)[number]) => (TRIAL_KEY_ORDER.includes(trial.state) ? trial.state : "unknown");
const trialKeyStates = TRIAL_KEY_ORDER.filter((state) => trials.some((trial) => stateOf(trial) === state));
// The trials table's columns, named over every group's table.
const TRIAL_COLUMNS = ["People", "Phase", "State", "Results posted", "Trial"];
const posted = withResults(trials);
const trialsNote = [
  plural(trials.length, "trial"),
  ...(posted > 0 ? [`${posted} with posted results`] : []),
].join(" · ");
const paperCount = claim.papers ? claim.papers.length : papers.length;
const papersNote = plural(paperCount, "paper");
const brief = recordBrief(claim, data.last_checked_at);
const statements = claim.reported_statements ?? [];
const background = claim.background ?? [];
// The sections this page has, in the page's order. One it does not have is not listed.
const sections = [
  { id: GLANCE_ID, name: GLANCE_TITLE },
  ...(brief.length > 0 ? [{ id: "brief", name: BRIEF_TITLE }] : []),
  ...(statements.length > 0
    ? [
        {
          id: "reported-statements",
          name: statementsHeading(new Set(statements.map((statement) => statement.article_url)).size),
        },
      ]
    : []),
  {
    id: "timetable",
    name: hasDatedPromise ? "Promised and recorded" : "Recorded",
    count: counts.promises > 0 ? `${counts.promises} and ${counts.records}` : counts.records,
  },
  ...(trials.length > 0 ? [{ id: "trials", name: "Trials on record", count: trials.length }] : []),
  ...(claim.matches && (untried.length > 0 || candidates.length > 0 || trials.length === 0)
    ? [
        {
          id: "matched",
          name: matchedHeading,
          ...(untried.length + candidates.length > 0 ? { count: untried.length + candidates.length } : {}),
        },
      ]
    : []),
  ...(paperCount > 0 ? [{ id: "papers", name: "Papers on record", count: paperCount }] : []),
  ...(organisations.length > 0
    ? [{ id: "organisations", name: "Organisations named", count: organisations.length }]
    : []),
  ...(others.length > 0 ? [{ id: "others", name: "Other claims" }] : []),
  ...(categories.length > 0
    ? [{ id: "clinical", name: "Clinical categories", count: categories.length }]
    : []),
  { id: "pass-on", name: "Keep or pass on" },
];
---

<Base
  title={claim.headline}
  tabTitle={tabTitle}
  structured={claimPageData(claim, data.last_checked_at, description)}
  breadcrumbs={[
    { name: topic, path: `/topic/${claim.vertical}` },
    { name: claim.headline, path: `/${claim.slug}` },
  ]}
  article={{ published: claim.first_reported_date, modified: data.last_checked_at }}
  oembed={`/oembed/${claim.slug}.json`}
  description={description}
  image={`/og/${claim.slug}.png`}
  imageAlt={imageAlt}
  framed
>
  {/* The band: what was reported and, level with it, where it stands. */}
  {/* The topic is kept in the search index, so a search counts its claims by topic
      without reading each one (openspec search-answer-in-step). */}
  <section class="band record" slot="band" data-pagefind-body data-pagefind-filter={`topic:${claim.vertical}`} aria-label="The claim and where it stands">
    <div class="wrap band-grid">
      {/* The side column on a wide screen: the topic's drawing, large. Decoration only:
          the chip beside it names the topic. */}
      <div class="band-side" aria-hidden="true">
        <TopicDrawing vertical={claim.vertical} />
      </div>
      <div class="band-main">
        <div class="above-title">
          <div class="filed">
            {/* Where the page sits: the topics, then this claim's topic. The drawing in the
                side column shows the topic; these words name it. */}
            <nav class="crumbs" aria-label="Where this page sits">
              <a href="/topics">Topics</a>
              <ChevronRight size={14} stroke-width={2} aria-hidden="true" />
              <a href={`/topic/${claim.vertical}`}>{verticalTitle(claim.vertical)}</a>
            </nav>
            {
              claim.approach && (
                <span class="approach">
                  <span class="visually-hidden">Approach: </span>
                  {APPROACH_LABELS[claim.approach]}
                </span>
              )
            }
            {
              claim.approach && claim.approach_basis && (
                <span class="approach-basis">{approachBasisSentence(claim.approach_basis)}</span>
              )
            }
          </div>
        </div>
        {/* The title is the claim: the treatment, then what it is for. Each is drawn as
            the record gives it. A report's own headline is quoted with its outlet, under
            the title on a wide screen and at the head of the sheet on a phone, never set
            as the page's own words (openspec claim-title). */}
        <h1
          class:list={[
            "title",
            "claim-title",
            { long: claim.intervention.name.length > 40, longer: claim.intervention.name.length > 80 },
          ]}
        >
          <span class="title-what">
            {
              /* A name such as "USAG-1" must not break at its hyphen. */
              claim.intervention.name.split(" ").map((word, index) => (
                <>
                  {index > 0 && " "}
                  {word.includes("-") && word.length <= 16 ? <span class="unbroken">{word}</span> : word}
                </>
              ))
            }
          </span>
          <span class="visually-hidden"> for </span>
          <span class="title-for">{claim.indication}</span>
        </h1>

        {/* The summary, straight under the title where the band has room for it. On a
            phone the band keeps to the title and the status, and the sheet opens with the
            same words instead: one of the two is drawn, never both. */}
        <p class="band-lede" data-clamp="5" data-pagefind-ignore>{claim.summary}</p>

        {
          /* What kind of thing the treatment is and a gene, straight under the headline:
             only what the headline does not say, and only when a card gives it. */
          bandFacts(glanceCards(background)).length > 0 && (
            <GlanceBand facts={bandFacts(glanceCards(background))} />
          )
        }

        {/* A reader arriving from a shared link has not seen the home page. */}
        <p class="what-this-is" data-pagefind-ignore>
          A record of what followed{" "}
          {reports.length === 0
            ? "this reported breakthrough"
            : reports.length === 1
              ? "this news report"
              : "these news reports"}. <a href="/how-it-works">How a status is set</a>
        </p>

        {/* Who and when, where a reader looks for a byline: the day the registries were
            last read and, for a claim no person checked, that software put the page
            together. Said once, here (openspec mobile-claim-page). */}
        <p class="byline" data-pagefind-ignore>
          {
            !claim.checked_by_person && (
              <>
                {UNCHECKED_BYLINE[0]}{" "}
                <a href="/guide/checked-by-a-person">{UNCHECKED_BYLINE[1]}</a>.{" "}
              </>
            )
          }
          {data.last_checked_at && <>Registries last checked {formatDate(data.last_checked_at)}.</>}
        </p>

        {
          shownReports.length > 0 && (
            <section class="reported band-reported" data-pagefind-ignore>
              <h2 class="visually-hidden">
                {reports.length === 1 ? "The news report this page follows" : "The news reports this page follows"}
              </h2>
              <ul class="plain">
                {shownReports.map((report, index) => (
                  <li>
                    {/* The same name as the headline on the home page, so a reader who
                        pressed it there sees it carried to this place. */}
                    <a
                      class="reported-title followed"
                      href={report.url}
                      style={`view-transition-name: ${followedName(claim.slug, index)}`}
                    >
                      “{report.title}”
                      <ExternalLink class="out" size={14} stroke-width={1.9} aria-hidden="true" />
                      <span class="visually-hidden">(at {report.outlet || "the outlet"})</span>
                    </a>
                    <span class="entry-note">
                      <Outlet url={report.url} outlet={report.outlet} link={false} />{" "}
                      <span class="unbroken">{formatDate(report.published_date)}</span>
                    </span>
                    {publisherNote(report.url) && (
                      <span class="entry-note publisher">{publisherNote(report.url)}</span>
                    )}
                  </li>
                ))}
              </ul>
              {reports.length > shownReports.length && (
                <p class="entry-note">
                  <a href="#timetable">All {reports.length} reports, by date</a>
                </p>
              )}
            </section>
          )
        }

      </div>
      <div class="digest">
        {/* The card's heading, in sight as a tab on the card's top edge. */}
        <h2 class="card-tab">Where it stands</h2>
        <div class="standing">
          <div class="label-row">
            <span class="label" data-pagefind-meta="status">{STATUS_LABELS[claim.status.code]}</span>
            <Pop id="why" label="Why this status" class="info" close>
              <Info slot="trigger" size={20} stroke-width={1.9} aria-hidden="true" />
              {
                explaining.length > 0 ? (
                  <>
                    <p class="pop-head">
                      <BasisMark label={false} /> The status rests on these records
                    </p>
                    <ul class="pop-list">
                      {latestExplaining.map(({ mark, event }) => (
                        <li>
                          <a href={`#record-${mark}`}>{eventLabel(event)}</a>,{" "}
                          {formatDate(event.event_date)}
                        </li>
                      ))}
                    </ul>
                    {explaining.length > WHY_SHOWN && (
                      <p class="pop-note">
                        The {WHY_SHOWN} latest of {explaining.length}.{" "}
                        <a href="#timetable">All are marked on the timetable</a>
                      </p>
                    )}
                  </>
                ) : (
                  <p>No trial, approval or retraction record is attached to this claim.</p>
                )
              }
              {
                /* The dots on the path are named here, so a reader need not guess them. */
                onPath && (
                  <>
                    <p class="pop-head">The six places on the path</p>
                    <ol class="pop-path">
                      {STAGE_PATH.map((code) => (
                        <li aria-current={code === claim.status.code ? "true" : undefined}>
                          {STATUS_LABELS[code]}
                        </li>
                      ))}
                    </ol>
                  </>
                )
              }
              {phase4 && <p class="pop-note">{phase4}</p>}
              <p class="pop-note">
                <a href={`/guide/${statusSlug(claim.status.code)}`}>
                  What “{STATUS_LABELS[claim.status.code]}” does and does not tell you
                </a>
              </p>
              <p class="pop-note">
                <a href="/how-it-works#what-each-status-means">What each status means</a>
              </p>
              {
                claim.status.updated_at && (
                  <p class="pop-note" data-pagefind-ignore>
                    Status set {formatDate(claim.status.updated_at)}.
                  </p>
                )
              }
            </Pop>
          </div>
          <p class="gloss">{STATUS_GLOSSES[claim.status.code]}</p>
          <StageTrack code={claim.status.code} ends />
          {
            overlay && (
              <div>
                <Pop id="quiet" class="overlay" close>
                  <Fragment slot="trigger">
                    <Clock size={15} stroke-width={1.9} aria-hidden="true" />
                    {overlay}
                  </Fragment>
                  <p>
                    No record on this page is more recent than that. It says nothing about work that
                    has not been published or registered.
                  </p>
                  <p class="pop-note">
                    <a href="/how-it-works#no-signal">How "no signal" is counted</a>
                  </p>
                  <p class="pop-note">
                    <a href="/guide/no-signal">What “no signal” does not tell you</a>
                  </p>
                </Pop>
              </div>
            )
          }
          {
            promised && (
              <p class="promised-by" data-pagefind-ignore>
                Promised by <a href={`#year-${promised}`}>{promised}</a>
              </p>
            )
          }
          <p class="changed" data-pagefind-ignore>
            <Calendar size={15} stroke-width={1.9} aria-hidden="true" />
            <span>
              {latestRecord ? (
                <>
                  Latest record <a href={`#${latestAnchor}`}>{formatDate(latestRecord.date)}</a>
                </>
              ) : (
                "No record yet"
              )}
            </span>
          </p>
          {
            claim.matches && (
              <p class="changed" data-pagefind-ignore>
                <FileText size={15} stroke-width={1.9} aria-hidden="true" />
                <span>
                  <a href={trials.length > 0 ? "#trials" : "#matched"}>
                    {registryMatches.length === 0
                      ? "No registry record matched"
                      : `${counted} registry ${counted === 1 ? "record" : "records"} matched`}
                  </a>
                  {possible > 0 && (
                    <>
                      , <a href="#matched">{possible} possible</a>
                    </>
                  )}
                </span>
              </p>
            )
          }
          <p class="changed" data-pagefind-ignore hidden data-remind-link>
            <Clock size={15} stroke-width={1.9} aria-hidden="true" />
            <span>
              <a href="#check-again">Check again later</a>
            </span>
          </p>
        </div>
        <div class="says">
          {/* What the status means, in a sentence, beside the label it explains. */}
          <p class="means">{STATUS_MEANINGS[claim.status.code]}</p>
          {
            /* Under a Phase 3 status with no approval listed: the site reads no
               regulator's records, said beside the status and not only in the brief. */
            approvalNote && <p class="bridge">{approvalNote}</p>
          }
          {
            /* Trials on record with no phase: said here, so the status is not read as
               contradicting the trials the page lists. No link in it: on a phone it is drawn
               ahead of the path, and nothing drawn out of order may be pressed. */
            bridge && <p class:list={["bridge", { counts: claim.status.code !== "trial_registered" }]}>{bridge}</p>
          }
        </div>
      </div>
        {/* In the band, before the content in the page's order, so a keyboard reaches them
            first. On a phone they close the band, under the status. */}
      <div class="page-actions band-actions" data-pagefind-ignore>
          {/* Following lists the claim on the home page, in this browser only. Shown by
              the script, where the browser lets it keep the list. */}
          <button
            type="button"
            class="share"
            data-follow
            data-slug={claim.slug}
            data-headline={claim.headline}
            data-status={STATUS_LABELS[claim.status.code]}
            aria-pressed="false"
            hidden
          >
            <Bookmark size={16} stroke-width={1.9} aria-hidden="true" />
            <span data-follow-text>Follow</span>
          </button>
          <SharePill />
        <a class="share" href="#check-again" hidden data-remind-link>
          <Clock size={16} stroke-width={1.9} aria-hidden="true" />
          <span>Check again later</span>
        </a>
        <ReportError page={`/${claim.slug}`} short />
      </div>
    </div>
  </section>

  <div class="frame no-rail">
    <SectionList label="On this page" items={sections} />


  <article class="sheet" data-pagefind-body>
    {
      /* On a phone the band keeps to the title and the status, so the report this
         page follows opens the content: the newest, and a way to the rest. */
      reports.length > 0 && (
        <div class="reported phone-reported" data-pagefind-ignore>
          <a class="reported-title" href={reports[0].url}>
            “{reports[0].title}”
            <ExternalLink class="out" size={14} stroke-width={1.9} aria-hidden="true" />
            <span class="visually-hidden">(at {reports[0].outlet || "the outlet"})</span>
          </a>
          <span class="entry-note">
            <Outlet url={reports[0].url} outlet={reports[0].outlet} link={false} />{" "}
            <span class="unbroken">{formatDate(reports[0].published_date)}</span>
          </span>
          {reports.length > 1 && (
            <p class="entry-note">
              <a href="#timetable">
                {reports.length - 1} more {reports.length === 2 ? "report" : "reports"}, on the timetable
              </a>
            </p>
          )}
        </div>
      )
    }

    <p class="lede" data-clamp="3" data-pagefind-meta="summary">{claim.summary}</p>

    {/* For a reader who follows this claim and last saw it at another status: filled in
        by the script, so a change noted on the home page is confirmed where they land. */}
    <p class="was-note" hidden data-follow-was data-pagefind-ignore></p>
    {/* Follow is offered once in the band, as one word, and once with its words, beside
        the reminders. When a reader follows, this line says so under the band: where the
        list is, and that it stays in this browser. Shown by the script, on the press. */}
    <p class="entry-note follow-confirm" hidden data-follow-confirm data-pagefind-ignore>
      You follow this claim. It is listed on <a href="/#following">the home page</a>, with a
      note when its status changes. Kept in this browser only.
    </p>

    {/* What the treatment and the condition are, then the claim's own facts: before
        the record in brief, so a reader knows what the records are about. */}
    <Glance
      intervention={claim.intervention}
      indication={claim.indication}
      cards={background}
      sources={data.card_sources ?? []}
    >
      {
        claim.first_reported_date && (
          <Fact label="First reported">
            <a href={`/year/${claim.first_reported_date.slice(0, 4)}`}>
              {formatDate(claim.first_reported_date)}
            </a>
          </Fact>
        )
      }
      {
        claim.evidence_stage && (
          <Fact
            label="Evidence when first reported"
            value={EVIDENCE_STAGES[claim.evidence_stage] ?? claim.evidence_stage}
          />
        )
      }
      {
        /* A reading that was not sure enough to confirm the stage: shown with its score,
           never used for the status (openspec review, "Lower-band stage reading"). */
        !claim.evidence_stage && claim.evidence_stage_reading && (
          <Fact label="Evidence when first reported">
            {EVIDENCE_STAGES[claim.evidence_stage_reading.stage] ?? claim.evidence_stage_reading.stage}{" "}
            <Score words={stageRead!.chip} low>
              {stageRead!.also && <span>{stageRead!.also}</span>}
              <span>{LOW_READING_MEANING}</span>
            </Score>
            <span slot="under" class="aka">{stageRead!.note}</span>
          </Fact>
        )
      }
      {
        /* A paper and its trial record remain distinct records. */
        recordCount && (
          <Fact label="Records listed" value={recordCount} />
        )
      }
    </Glance>

    {/* How the claim was tested and where its records stand, before the facts and the
        records themselves. The count of trials and the largest size are said here, once. */}
    <RecordBrief claim={claim} lastChecked={data.last_checked_at} />

    {
      /* What the reports said, in the site's words: after the summary and before the
         records, which never refer to it, so nothing holds the one against the other. */
      (claim.reported_statements ?? []).length > 0 && (
        <Statements statements={claim.reported_statements ?? []} articles={claim.articles} />
      )
    }

    <section class="recorded">
      <FoldHead id="timetable" note={timetableNote}>
        {hasDatedPromise ? "Promised and recorded" : "Recorded"}
      </FoldHead>
      {/* The record's moments, in order, on one line: what a reader wants first. Each
          leads to its year in the full record under it. */}
      <ol class="milestones">
        {milestones.map((moment) => (
          <li class:list={[{ promised: moment.mark === "promise" }]}>
            {moment.mark === "report" ? (
              <span class="ev-report" aria-hidden="true" />
            ) : moment.mark === "promise" ? (
              <span class="ev-promise" aria-hidden="true" />
            ) : (
              <span class:list={["state-mark", { posted: moment.mark === "results" }]} data-state={moment.mark === "results" ? "completed" : moment.mark} aria-hidden="true" />
            )}
            <a href={`#year-${moment.date.slice(0, 4)}`}>{moment.label}</a>
            <span>{formatDate(moment.date)}</span>
          </li>
        ))}
      </ol>
      {/* Every record, by year: one press under the moments. A link to a record opens it
          (scripts/folds.ts); on paper it is printed open. */}
      <details class="papers-rest record-all">
        <summary>
          All {plural(counts.records, "record")}{counts.promises > 0 ? ` and ${plural(counts.promises, "promise")}` : ""}, by year
          <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
        </summary>
      {
        ownAxis && (
          <div class="claim-strip">
            <RecordStrip claim={claim} counts={false} axis={ownAxis} years />
            <StripKey kinds={ownKinds} title={false} />
          </div>
        )
      }
    {!hasDatedPromise && <p class="absent">No dated promise on record.</p>}
    {/* Over the timetable: its filter at the left, its key at the right. */}
    <div class="table-tools">
    {
      /* Shown by the script: with none, every entry is there. */
      kindCounts.length > 1 && (
        <div class="kind-tabs" role="group" aria-label="Show entries of one kind" hidden data-kinds>
          <button type="button" class="kind-tab" data-kind="all" aria-pressed="true">All</button>
          {kindCounts.map(({ kind, name, n }) => (
            <button type="button" class="kind-tab" data-kind={kind} aria-pressed="false">
              {name} <span class="n">{n}</span>
            </button>
          ))}
        </div>
      )
    }
      <ul class="legend" aria-label="Key">
        {
          hasPromise && (
            <li>
              <span class="swatch" /> Promised
            </li>
          )
        }
        {
          kinds.map((kind) => (
            <li>
              <KindIcon kind={kind} /> {KIND_NAMES[kind]}
            </li>
          ))
        }
        {
          explaining.length > 0 && (
            <li>
              <BasisMark label={false} /> Basis of status
            </li>
          )
        }
      </ul>
    </div>
    {
      anyYearFolds && (
        // What the shapes in a folded year's row stand for, once.
        <p class="said-key year-key" aria-hidden="true">
          {YEAR_KEY.filter(([mark]) => yearKeyMarks.has(mark)).map(([mark, , words]) => (
            <span><span class="state-mark" data-state={mark} />{words}</span>
          ))}
          {yearKeyMarks.has("results") && (
            <span><span class="state-mark posted" data-state="completed" />{RESULTS_POSTED}</span>
          )}
          {otherYearKinds.map((kind) => <span><KindIcon kind={kind} />{KIND_NAMES[kind]}</span>)}
          {yearKeyMarks.has("report") && (
            <span><span class="ev-report" />News report</span>
          )}
        </p>
      )
    }
    <p class="visually-hidden" role="status" data-kinds-said></p>
    <div class="table-frame">
    <table role="table" class="timetable" aria-labelledby="timetable">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">Year</th>
          {hasDatedPromise && <th role="columnheader" scope="col" class="promised">Promised</th>}
          <th role="columnheader" scope="col">Recorded</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          timetable.rows.map((row) =>
            row.kind === "quiet" ? (
              <tr role="row" class="quiet">
                <th role="rowheader" scope="row" class="year">
                  {row.from === row.to ? row.from : `${row.from} to ${row.to}`}
                </th>
                {hasDatedPromise && <td role="cell" class="promised empty" />}
                <td role="cell">{hasDatedPromise ? "No promise, no record" : "No record"}</td>
              </tr>
            ) : (
              <tr role="row" id={`year-${row.year}`} data-year-row>
                <th role="rowheader" scope="row" class="year">
                  {row.year}
                  {row.current && <small>this year</small>}
                </th>
                {
                  hasDatedPromise && (
                    <td role="cell"
                      class:list={["promised", { none: row.promised.length === 0 }]}
                      data-column="Promised"
                    >
                      {row.promised.length === 0 ? (
                        <span class="visually-hidden">Nothing promised for this year.</span>
                      ) : (
                        <ul class="entries" data-promises>
                          {row.promised.map((promise) => (
                            <li>
                              <span class="entry-kind">{promise.description}</span>
                              <span class="entry-note">
                                <Outlet url={promise.articleUrl} outlet={promise.outlet} />{" "}
                                {formatDate(promise.madeOn)}
                              </span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </td>
                  )
                }
                <td role="cell" data-column={hasDatedPromise ? "Recorded" : undefined}>
                  {
                    row.recorded.length === 0 ? (
                      <span
                        class:list={[
                          "entry-note",
                          // The same words, in ink, where a promise names this year.
                          { beside: row.promised.length > 0 && row.year < thisYear },
                        ]}
                      >
                        {row.year < thisYear
                          ? "No record"
                          : row.current
                            ? "No record yet"
                            : "Not yet reached"}
                      </span>
                    ) : (
                      ((entries) =>
                        yearFolds(row) ? (
                          <details class="year-rest">
                            <summary>
                              {/* A shape for every record of the year, oldest first: what
                                  kinds they are is seen at a glance and said in words to a
                                  screen reader. */}
                              <span class="year-marks" aria-hidden="true">
                                {yearMarks(row).map((mark) =>
                                  mark === "report" ? (
                                    <span class="ev-report" />
                                  ) : mark in KIND_NAMES ? (
                                    <KindIcon kind={mark as RecordKind} />
                                  ) : (
                                    <span class:list={["state-mark", { posted: mark === "results" }]} data-state={mark === "results" ? "completed" : mark} />
                                  ),
                                )}
                              </span>
                              <span class="visually-hidden">{yearSaid(row).kinds.join(", ")}.</span>
                              <span class="year-total">{yearSaid(row).total}</span>
                              {yearSaid(row).basis && (
                                <span class="year-basis">
                                  <BasisMark label={false} />
                                  <span class="visually-hidden">Holds a record the status rests on.</span>
                                </span>
                              )}
                              <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                            </summary>
                            {entries}
                          </details>
                        ) : (
                          entries
                        ))(
                      <ul class="entries">
                        {recordedLines(row.recorded).map((line) =>
                          line.kind === "report" ? (
                            <li class="record" data-kind="report" id={line === latestRecord ? latestAnchor : undefined}>
                              <KindIcon kind="report" />
                              <span class="visually-hidden">News report.</span>
                              <span class="entry-date">{dayAndMonth(line.date)}</span>
                              <span>
                                <a href={line.url}>
                                  “{line.title}”
                                  <ExternalLink class="out" size={13} stroke-width={1.9} aria-hidden="true" />
                                  <span class="visually-hidden">(at {line.outlet ?? "the outlet"})</span>
                                </a>
                              </span>
                              <span class="origin">
                                <Outlet url={line.url} outlet={line.outlet} link={false} />
                                {line.archiveUrl && (
                                  <>
                                    {" "}
                                    <span class="unbroken">(<a href={line.archiveUrl}>archived copy</a>)</span>
                                  </>
                                )}
                                {publisherNote(line.url) && (
                                  <span class="entry-note publisher">{publisherNote(line.url)}</span>
                                )}
                              </span>
                            </li>
                          ) : (
                            <li
                              class="record"
                              data-kind={eventKind(line.steps[0].event)}
                              data-n={line.steps.length}
                            >
                              <KindIcon kind={eventKind(line.steps[0].event)} />
                              <span class="visually-hidden">
                                {KIND_NAMES[eventKind(line.steps[0].event)]}.
                              </span>
                              {line.steps.map((entry) => (
                                <>
                                  <span class="entry-date">{dayAndMonth(entry.date)}</span>
                                  <span class="what" id={`record-${entry.mark}`}>
                                    <Pop id={`about-${entry.mark}`} class="more">
                                      <Fragment slot="trigger">
                                        {eventLabel(entry.event)}
                                        {entry.explains && <BasisMark />}
                                        {/* Says this opens something, where a link's arrow says it leaves. */}
                                        <ChevronDown class="opens" size={14} stroke-width={2.2} aria-hidden="true" />
                                      </Fragment>
                                      <p>{entry.event.summary}</p>
                                      {entry.explains && (
                                        <p class="pop-note">
                                          <BasisMark label={false} /> The status rests on this record.
                                        </p>
                                      )}
                                      {entry.event.date_basis && (
                                        <p class="pop-note">
                                          Date taken from: {entry.event.date_basis}.
                                        </p>
                                      )}
                                      {entry.event.trial_id && trialIds.has(entry.event.trial_id) && (
                                        <p class="pop-note">
                                          <a href={`#trial-${entry.event.trial_id}`}>
                                            This trial's size, design and posted results
                                          </a>
                                        </p>
                                      )}
                                    </Pop>
                                  </span>
                                </>
                              ))}
                              <span class="origin">
                                <a href={line.sourceUrl}>
                                  {sourceName(line.steps[0].event.source_name)}
                                  {line.steps[0].event.trial_id
                                    ? `, ${line.steps[0].event.trial_id}`
                                    : ""}
                                </a>
                                {
                                  /* A record read from a registry is certain. One found by
                                     rule, such as a follow-up paper, says how sure it is. */
                                  typeof line.steps[0].event.confidence === "number" &&
                                    line.steps[0].event.confidence < 1 && (
                                      <Score about="Match to this claim" words={matchWords(line.steps[0].event.confidence)}>
                                        <span>{MATCH_MEANING}</span>
                                      </Score>
                                    )
                                }
                              </span>
                            </li>
                          ),
                        )}
                      </ul>,
                      )
                    )
                  }
                </td>
              </tr>
            ),
          )
        }
      </tbody>
    </table>
    </div>
      </details>

    {
      timetable.undated.length > 0 && (
        <>
          <div data-undated>
            <h3 class="bar sub" id="no-date">Promised with no date</h3>
            <ul class="plain undated">
              {timetable.undated.map((promise) => (
                <li>
                  <strong>{promise.description}</strong>
                  <span class="entry-note">
                    <Outlet url={promise.articleUrl} outlet={promise.outlet} />{" "}
                    {formatDate(promise.madeOn)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </>
      )
    }

    </section>

    {
      trials.length > 0 && (
        <section class="trials" data-pagefind-ignore>
          <FoldHead id="trials" phone="folded" note={trialsNote}>
            <p slot="about">{TRIALS_NOTE}</p>
            Trials on record
          </FoldHead>
          {/* How the trials are spread: a mark a trial, under its phase, in the shape of
              its state. For the eye; the table under it says the same in words, and a
              mark leads to its trial. */}
          {
            trials.length >= 4 && (
              <>
                <div class="trial-matrix" aria-hidden="true">
                  {trialSpread.map(([name, list]) => (
                    <div class="trial-matrix-col">
                      <p>
                        <b>{name}</b> <span class="entry-note">{list.length}</span>
                      </p>
                      <div class="trial-dots">
                        {list.map((trial) => (
                          <a
                            href={`#trial-${trial.trial_id}`}
                            tabindex="-1"
                            title={`${trial.trial_id}: ${PLAIN_STATE[trial.state] ?? "State not given"}${trial.facts?.results ? ", results posted" : ""}`}
                          >
                            <span class:list={["state-mark", { posted: Boolean(trial.facts?.results) }]} data-state={trial.state} />
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
                <p class="said-key trial-key" aria-hidden="true">
                  {/* The states these trials have, in the rows' own words. */}
                  {trialKeyStates.map((state) => (
                    <span><span class="state-mark" data-state={state} />{PLAIN_STATE[state]}</span>
                  ))}
                  {posted > 0 && (
                    <span><span class="state-mark posted" data-state="completed" />{RESULTS_POSTED}</span>
                  )}
                </p>
              </>
            )
          }
          {/* The columns, named once over every group and kept in sight while the groups
              scroll. For the eye only: each group's table keeps its own column names for a
              screen reader. */}
          <div class="trial-row trial-columns trial-columns-top" aria-hidden="true">
            {TRIAL_COLUMNS.map((name) => (
              <span>{name}</span>
            ))}
          </div>
          {trialGroups.map((group) => {
            const shown = group.trials.slice(0, TRIALS_PER_PHASE);
            const rest = group.trials.slice(TRIALS_PER_PHASE);
            const table = (list: typeof trials, label: string) => (
              <div class="trial-table" role="table" aria-label={label}>
                <div class="trial-row trial-columns" role="row">
                  {TRIAL_COLUMNS.map((name) => (
                    <span role="columnheader">{name}</span>
                  ))}
                </div>
                {list.map((trial) => (
                  <Trial
                    trial={trial}
                    match={matchOf(trial.trial_id)}
                    approach={claim.approach}
                    dates={trialDates(claim.events, trial.trial_id)}
                    glosses={trialGlosses.get(trial.trial_id) ?? []}
                    treatment={claim.intervention.name}
                    largest={largestSize}
                  />
                ))}
              </div>
            );
            return (
              <div class="trial-phase-group">
                <h3 class="trial-phase-head">
                  {group.name}
                  <span class="entry-note">
                    <span class="visually-hidden">, </span>
                    {plural(group.trials.length, "trial")}
                  </span>
                </h3>
                {table(shown, `${group.name}: trials on record`)}
                {rest.length > 0 && (
                  <details class="trials-rest">
                    <summary>
                      The other {rest.length} of {group.trials.length} trials
                      <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                    </summary>
                    {table(rest, `The other ${group.name} trials`)}
                  </details>
                )}
              </div>
            );
          })}
        </section>
      )
    }

    {
      /* Registry records that are not trials on this page yet: approved ones with no
         dated event, and candidates, which never count toward the status. When there
         is no trial at all, the section says the registries were searched. */
      claim.matches && (untried.length > 0 || candidates.length > 0 || trials.length === 0) && (
        <section class="matched" data-pagefind-ignore>
          <FoldHead id="matched" start={untried.length > 0 ? "open" : "folded"} phone="folded" note={matchedNote}>
            <p slot="about">
              {untried.length > 0
                ? `Trial registry records found for this treatment and condition, with how sure each match is.${scoreNote}`
                : candidates.length > 0
                  ? `Trial registry records that may be about this treatment and condition, with how sure each match is.${scoreNote}`
                  : "The trial registries were searched for this treatment and condition. No record matched."}
            </p>
            {candidates.length > 0 && (
              // That a possible record counts for nothing, and the rule that would count it.
              <p slot="about">
                {notCounted(data.match_accept_above ?? null)} <a href={NOT_COUNTED_LINK.href}>{NOT_COUNTED_LINK.text}</a>
              </p>
            )}
            {matchedHeading}
          </FoldHead>
          {untried.length > 0 && <RegistryRecords matches={untried} />}
          {untried.length > 0 && candidates.length > 0 && (
            <h3 class="matched-group">Possible records</h3>
          )}
          {candidates.length > 0 && (
            <RegistryRecords
              matches={candidates}
              level={untried.length > 0 ? 4 : 3}
              possible
            />
          )}
        </section>
      )
    }

    {
      paperGroups.length > 0 && (
        <section class="papers" data-pagefind-ignore>
          <FoldHead id="papers" start="folded" note={papersNote}>
            <p slot="about">{PAPERS_NOTE}</p>
            Papers on record
          </FoldHead>
          {paperGroups.map((group) => (
            <>
              <h3 class="matched-group">{group.heading}</h3>
              {group.papers.some((paper) => trialRoles(paper).length > 0) ? (
                // What the two marks beside a trial's number say, once, over the list.
                <p class="entry-note tie-key">
                  <span class="tie">
                    <span class="tie-mark listed" aria-hidden="true" />
                    {TIE_KEY.listed_by_sponsor}
                  </span>
                  <span class="tie">
                    <span class="tie-mark" aria-hidden="true" />
                    {TIE_KEY.linked_by_registry}
                  </span>
                </p>
              ) : (
                <p class="entry-note paper-group-note">{group.note}</p>
              )}
              <div class="year-groups">
                {byYear(newestFirst(group.papers).slice(0, PAPERS_SHOWN)).map(([year, papers]) => (
                  <div class="label-group">
                    <h4 class="label-group-name">{year}</h4>
                    <ul class="plain entry-rows paper-rows">
                      {papers.map((paper) => (
                        <Paper paper={paper} trialIds={trialIds} />
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              {group.papers.length > PAPERS_SHOWN && (
                <details class="papers-rest">
                  <summary>
                    The other {group.papers.length - PAPERS_SHOWN} of {group.papers.length} papers
                    <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                  </summary>
                  <div class="year-groups">
                    {byYear(newestFirst(group.papers).slice(PAPERS_SHOWN)).map(([year, papers]) => (
                      <div class="label-group">
                        <h4 class="label-group-name">{year}</h4>
                        <ul class="plain entry-rows paper-rows">
                          {papers.map((paper) => (
                            <Paper paper={paper} trialIds={trialIds} />
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              )}
            </>
          ))}
        </section>
      )
    }

    {
      papers.length > 0 && (
        <section class="matched" data-pagefind-ignore>
          <FoldHead id="papers" start="folded" note={papersNote}>Matched papers</FoldHead>
          <p class="take-why">
            Papers matched to this claim, with how sure each match is. A paper is not a trial
            record, and a score is about the match, not about the treatment.
          </p>
          <MatchList matches={papers} />
        </section>
      )
    }

    {
      /* Who the reports and trial records name, each once, by role and then by name.
         After the records and away from the status: an organisation is never evidence. */
      organisations.length > 0 && (
        <Organisations organisations={organisations} articles={claim.articles} trialIds={trialIds} />
      )
    }

    <ReportError page={`/${claim.slug}`} />

    {
      others.length > 0 && (
        <section class="others" data-pagefind-ignore>
          <FoldHead id="others" phone="folded">
            Other claims in {topic.toLowerCase()}
            {/* Beside the heading and outside its button, so it is a link of its own. */}
            <Fragment slot="beside">
              {inTopic.length > others.length && (
                <a href={`/topic/${claim.vertical}`}>
                  All {inTopic.length + 1} claims in {topic.toLowerCase()}
                </a>
              )}
            </Fragment>
          </FoldHead>
          {/* A row a claim: its treatment and condition, where it stands as a place on the
              path, and when it was first reported. The rest is on the claim's own page. */}
          <ul class="plain entry-rows other-claims">
            {others.map((other) => (
              <li>
                <div class="entry-lead">
                  <a class="entry-name" href={`/${other.slug}`}>{other.intervention.name}</a>
                  <span class="entry-note">{other.indication}</span>
                </div>
                <div class="entry-ties">
                  <span class="status-line">
                    <StageTrack code={other.status.code} />
                    <strong class="status-name">{STATUS_LABELS[other.status.code]}</strong>
                  </span>
                  {overlayText(other.status.overlay_years) && (
                    <span class="entry-note">{overlayText(other.status.overlay_years)}</span>
                  )}
                </div>
                <span class="entry-note other-first">{formatDate(other.first_reported_date)}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      categories.length > 0 && (
        <section class="clinical" data-pagefind-ignore>
          <FoldHead id="clinical" start="folded" phone="folded">
            Clinical categories
            <Fragment slot="beside">
              <a href="/clinical">All categories</a>
            </Fragment>
          </FoldHead>
          {/* NLM's own names for what the claim's trials and papers are indexed under,
              each with the records that gave it. Not a diagnosis, and not advice. */}
          <p class="entry-note">
            What this claim's registered trials and published papers are indexed under, and what
            its reported condition was read as, in MeSH's own names. A category describes the
            records. It is not a diagnosis and not advice.
          </p>
          <ul class="plain entry-rows clinical-categories">
            {categories.map((category) => (
              <li>
                <div class="entry-lead">
                  <a class="entry-name" href={categoryPath(category.identifier)}>{category.label}</a>
                </div>
                <span class="entry-note">
                  From {category.sources.map((source, index) => (
                    <>
                      {index > 0 && ", "}
                      {source.kind === "term" ? (
                        termSourceSentence(source.score)
                      ) : (
                        <>
                          {source.kind === "trial" ? "trial" : "paper"}{" "}
                          {source.href ? <a href={source.href}>{source.name}</a> : source.name}
                        </>
                      )}
                    </>
                  ))}
                </span>
              </li>
            ))}
          </ul>
          <MeshCredit />
        </section>
      )
    }

    {/* Keep or pass on: what a reader can do with the record, a label and its buttons
        on each row (chosen by the operator from the section mocks, 2026-11-17). The
        reminders' row is shown only where the browser can make and save the file. */}
    <section class="take keep" data-pagefind-ignore>
      <FoldHead id="pass-on" start="folded">Keep or pass on</FoldHead>
      {/* Says "Copied" to a screen reader; the button's own label changes for the eye. */}
      <p class="visually-hidden" role="status" data-said></p>
      <FactSheet>
        <Fact label="Share">
          <div class="take-actions">
            <button type="button" class="share" data-copy="sentence" hidden>
              <Copy size={16} stroke-width={1.9} aria-hidden="true" />
              <span data-copy-text>Copy sentence</span>
            </button>
            <a class="share" href={`/og/square/${claim.slug}.png`} download>
              <ImageDown size={16} stroke-width={1.9} aria-hidden="true" />
              Square image
            </a>
            <a class="share" href={`/og/tall/${claim.slug}.png`} download>
              <ImageDown size={16} stroke-width={1.9} aria-hidden="true" />
              Tall image
            </a>
            <button type="button" class="share" data-copy="page-address" hidden>
              <Copy size={16} stroke-width={1.9} aria-hidden="true" />
              <span data-copy-text>Copy link</span>
            </button>
            <span id="page-address" hidden>{address}</span>
          </div>
          <Fragment slot="under">
            <span class="aka sentence" id="sentence">{sentence}</span>
            <details class="post-to">
              <summary id="post-to">
                Post it to a network
                <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
              </summary>
              <ul class="post-links" aria-labelledby="post-to">
                {
                  posts.map((post) => (
                    <li>
                      <a
                        class="share"
                        href={post.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-network={post.network}
                      >
                        {post.label}
                      </a>
                    </li>
                  ))
                }
                <li>
                  {/* Mastodon has no one address: the reader names their server. */}
                  <button
                    type="button"
                    class="share"
                    data-mastodon
                    data-text={postText}
                    data-url={address}
                    hidden
                  >
                    Mastodon
                  </button>
                </li>
              </ul>
            </details>
          </Fragment>
        </Fact>
        <div
          id="check-again"
          tabindex="-1"
          data-remind
          data-site={SITE.name}
          data-headline={claim.headline}
          data-slug={claim.slug}
          data-url={address}
          data-promise={promiseDue}
          data-first={claim.first_reported_date}
          hidden
        >
          <dt>Remind me</dt>
          <dd>
            <span class="fact-head">
              <span class="fact-value">
                <div class="take-actions">
                  {
                    promiseDue && (
                      <button type="button" class="share" data-when="promise">
                        <ClockMark />
                        <span data-when-text>On the promised date, {formatDate(promiseDue)}</span>
                      </button>
                    )
                  }
                  <button type="button" class="share" data-when="six-months">
                    <ClockMark />
                    <span data-when-text>In six months</span>
                  </button>
                  <button type="button" class="share" data-when="year">
                    <ClockMark />
                    <span data-when-text>In a year</span>
                  </button>
                  {
                    claim.first_reported_date && (
                      <button type="button" class="share" data-when="anniversary">
                        <ClockMark />
                        <span data-when-text>On the anniversary, {dayAndMonth(claim.first_reported_date)}</span>
                      </button>
                    )
                  }
                </div>
              </span>
            </span>
            <span class="aka">The date is saved to your calendar as a file made on this device; nothing is sent to us.</span>
          </dd>
        </div>
        <Fact label="Follow">
          <FollowOffer claim={claim} />
        </Fact>
        {
          (claim.status.history?.length ?? 0) > 0 && (
            <Fact label="Feed">
              <span class="keep-feed-links">
                <a href={`/changes/${claim.slug}.xml`}>This claim's status changes</a>
                <a href="/changes.xml">Every claim's</a>
              </span>
            </Fact>
          )
        }
        <Fact label="Embed">
          <details class="embed-how">
            <summary>
              Writing about this? Show the status on your own page
              <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
            </summary>
            <p class="entry-note">
              Paste this where the status should appear. It shows the current status and links back
              here; it loads nothing else and stores nothing.
            </p>
            <pre id="snippet"><code>{snippet}</code></pre>
            <button type="button" class="share" data-copy="snippet" hidden>
              <Copy size={16} stroke-width={1.9} aria-hidden="true" />
              <span data-copy-text>Copy code</span>
            </button>
          </details>
        </Fact>
      </FactSheet>
      <dialog class="mastodon" data-mastodon-dialog aria-labelledby="mastodon-title">
        <form method="dialog">
          <h3 id="mastodon-title">Post to Mastodon</h3>
          <label for="mastodon-server">Your server</label>
          <input
            id="mastodon-server"
            name="server"
            type="text"
            inputmode="url"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="mastodon.social"
            aria-describedby="mastodon-note"
            required
          />
          <p class="entry-note" id="mastodon-note" data-mastodon-note aria-live="polite">
            Kept in this browser only, so you are not asked again.
          </p>
          <div class="mastodon-actions">
            <button type="submit" class="share" value="post">Open Mastodon</button>
            <button type="submit" class="share quiet" value="cancel" formnovalidate>Cancel</button>
          </div>
        </form>
      </dialog>
    </section>

    <LookupAgain />
  </article>
  </div>
</Base>

<script>
  import "../scripts/timetable-kinds";
  import { calendarFile, reminderDate, type ReminderChoice } from "../lib/calendar";
  import { mastodonShare } from "../lib/share";
  import { FOLLOWING_ENTRY, readFollowed } from "../lib/returning";

  // A timetable entry leads to its trial, a trial to its papers and a paper back to its
  // trial. An entry past the first five sits in a closed fold, which not every browser
  // opens for a link, so it is opened here.
  function showLinkedTrial() {
    if (!/^#(trial|paper)-/.test(location.hash)) return;
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const fold = target?.closest<HTMLDetailsElement>("details.trials-rest, details.papers-rest");
    if (!target || !fold || fold.open) return;
    fold.open = true;
    target.scrollIntoView();
  }
  showLinkedTrial();
  addEventListener("hashchange", showLinkedTrial);

  // Mastodon: the reader names their server once; it is kept in this browser only.
  const mastodon = document.querySelector<HTMLButtonElement>("[data-mastodon]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-mastodon-dialog]");
  if (mastodon && dialog && typeof dialog.showModal === "function") {
    const KEY = "mastodon-server";
    const input = dialog.querySelector<HTMLInputElement>("input")!;
    const note = dialog.querySelector<HTMLElement>("[data-mastodon-note]")!;
    const idleNote = note.textContent;
    const { text, url } = mastodon.dataset as { text: string; url: string };
    const open = (server: string) => {
      const href = mastodonShare(server, text, url);
      if (href) window.open(href, "_blank", "noopener,noreferrer");
      return href;
    };
    mastodon.hidden = false;
    // A remembered server is filled in, so posting is one more press and changing it is easy.
    mastodon.addEventListener("click", () => {
      let saved: string | null = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {}
      input.value = saved ?? "";
      note.textContent = idleNote;
      dialog.showModal();
    });
    dialog.querySelector("form")!.addEventListener("submit", (event) => {
      if (event.submitter?.getAttribute("value") !== "post") return;
      if (!open(input.value)) {
        event.preventDefault();
        note.textContent = "That is not a server's name. Try one like mastodon.social.";
        input.focus();
        return;
      }
      try {
        localStorage.setItem(KEY, input.value.trim());
      } catch {}
    });
  }

  // Copying: the button appears only where the clipboard can be written, says so when
  // it has copied, and otherwise leaves the text selected for the reader to copy.
  // A copy is confirmed three ways: the label changes, the site's blue dot lands in
  // place of the icon, and a screen reader is told.
  const said = document.querySelector<HTMLElement>("[data-said]");
  function confirm(control: HTMLElement, words: string) {
    control.classList.add("done");
    if (said) said.textContent = words;
    setTimeout(() => {
      control.classList.remove("done");
      if (said) said.textContent = "";
    }, 2000);
  }

  // A saved date is confirmed in its own pill: the clock's hand turns once, the words
  // say it is saved, and a screen reader is told. Then the pill offers its date again.
  function saved(choice: HTMLElement) {
    const words = choice.querySelector<HTMLElement>("[data-when-text]")!;
    if (choice.classList.contains("saved")) return;
    const offer = words.textContent;
    choice.classList.add("saved");
    words.textContent = "Saved to your calendar";
    if (said) said.textContent = "Calendar file saved";
    setTimeout(() => {
      choice.classList.remove("saved");
      words.textContent = offer;
      if (said) said.textContent = "";
    }, 2000);
  }

  if (navigator.clipboard) {
    for (const copier of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      const source = document.getElementById(copier.dataset.copy!)!;
      const label = copier.querySelector<HTMLElement>("[data-copy-text]")!;
      const idle = label.textContent;
      copier.hidden = false;
      copier.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(source.textContent!.trim());
          label.textContent = "Copied";
          confirm(copier, "Copied");
          setTimeout(() => (label.textContent = idle), 2000);
        } catch {
          getSelection()?.selectAllChildren(source);
        }
      });
    }
  }

  // A reminder is a calendar file made here, in the browser, from a date the reader
  // picks. A choice that cannot be offered (a promised date already past) is removed.
  const remind = document.querySelector<HTMLElement>("[data-remind]");
  if (remind && typeof Blob !== "undefined" && typeof URL.createObjectURL === "function") {
    const now = new Date();
    const pad = (value: number) => String(value).padStart(2, "0");
    const dates = {
      today: `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`,
      promiseDue: remind.dataset.promise || null,
      firstReported: remind.dataset.first || null,
    };
    for (const choice of remind.querySelectorAll<HTMLButtonElement>("[data-when]")) {
      const date = reminderDate(choice.dataset.when as ReminderChoice, dates);
      if (!date) {
        choice.remove();
        continue;
      }
      choice.addEventListener("click", () => {
        const file = calendarFile({
          site: remind.dataset.site!,
          headline: remind.dataset.headline!,
          url: remind.dataset.url!,
          slug: remind.dataset.slug!,
          date,
          madeAt: new Date().toISOString(),
        });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob([file], { type: "text/calendar" }));
        link.download = `${remind.dataset.slug}-${date}.ics`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        saved(choice);
      });
    }
    remind.hidden = false;
    for (const link of document.querySelectorAll<HTMLElement>("[data-remind-link]")) {
      link.hidden = false;
    }
  }

  // Following: the claim, its headline and its status in words are kept in this
  // browser's storage and sent nowhere. The home page lists followed claims and notes
  // a status that has changed. Opening this page is seeing the status, so a change is
  // said here once and the kept status is brought up to date.
  const follows = [...document.querySelectorAll<HTMLButtonElement>("[data-follow]")];
  if (follows.length > 0) {
    let store: Storage | null = null;
    try {
      localStorage.setItem("probe", "1");
      localStorage.removeItem("probe");
      store = localStorage;
    } catch {}
    if (store) {
      const kept = store;
      const { slug, headline, status } = follows[0].dataset as Record<string, string>;
      const write = (followed: ReturnType<typeof readFollowed>) => {
        try {
          kept.setItem(FOLLOWING_ENTRY, JSON.stringify(followed));
        } catch {}
      };
      // Every Follow control on the page says the same thing, and the words beside
      // one change with it: what following does, then where the list is.
      const show = (on: boolean) => {
        for (const button of follows) {
          button.setAttribute("aria-pressed", String(on));
          button.querySelector<HTMLElement>("[data-follow-text]")!.textContent = on
            ? "Following"
            : "Follow";
        }
        for (const words of document.querySelectorAll<HTMLElement>("[data-follow-when]")) {
          words.hidden = (words.dataset.followWhen === "on") !== on;
        }
      };
      const confirmed = document.querySelector<HTMLElement>("[data-follow-confirm]");
      const followed = readFollowed(kept.getItem(FOLLOWING_ENTRY));
      const before = followed[slug];
      if (before) {
        const was = document.querySelector<HTMLElement>("[data-follow-was]");
        if (was && before.status !== status) {
          const tag = document.createElement("span");
          tag.className = "new-tag";
          tag.textContent = "Changed";
          was.append(tag, ` When you last looked: ${before.status}. Now: ${status}.`);
          was.hidden = false;
        }
        followed[slug] = { ...before, headline, status };
        write(followed);
      }
      show(Boolean(before));
      for (const button of follows) {
        button.addEventListener("click", () => {
          const now = readFollowed(kept.getItem(FOLLOWING_ENTRY));
          const on = !now[slug];
          if (on) {
            const today = new Date();
            const two = (value: number) => String(value).padStart(2, "0");
            now[slug] = {
              headline,
              status,
              since: `${today.getFullYear()}-${two(today.getMonth() + 1)}-${two(today.getDate())}`,
            };
          } else {
            delete now[slug];
          }
          write(now);
          show(on);
          if (confirmed) confirmed.hidden = !on;
          // The bookmark lands in the pill that was pressed, not when a followed page is opened.
          for (const other of follows) other.classList.toggle("landed", on && other === button);
          if (said) {
            said.textContent = on
              ? "Following. Listed on the home page, in this browser only."
              : "No longer following.";
            setTimeout(() => (said.textContent = ""), 3000);
          }
        });
        button.hidden = false;
      }
      for (const offer of document.querySelectorAll<HTMLElement>("[data-follow-offer]")) {
        offer.hidden = false;
      }
    }
  }
</script>
