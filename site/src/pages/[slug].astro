---
import Base from "../layouts/Base.astro";
import Clock from "@lucide/astro/icons/clock";
import Info from "@lucide/astro/icons/info";
import Share2 from "@lucide/astro/icons/share-2";
import BasisMark from "../components/BasisMark.astro";
import Outlet from "../components/Outlet.astro";
import KindIcon from "../components/KindIcon.astro";
import Pop from "../components/Pop.astro";
import StageTrack from "../components/StageTrack.astro";
import TopicChip from "../components/TopicChip.astro";
import { data, type ExportedClaim } from "../lib/export";
import {
  EVIDENCE_STAGES,
  KIND_NAMES,
  STATUS_LABELS,
  STATUS_MEANINGS,
  eventKind,
  eventLabel,
  latestPromise,
  overlayText,
  sourceName,
  type RecordKind,
} from "../lib/status";
import { cardAlt, cardFacts } from "../lib/card";
import { buildTimetable, dayAndMonth, formatDate } from "../lib/timetable";

export function getStaticPaths() {
  return data.claims.map((claim) => ({ params: { slug: claim.slug }, props: { claim } }));
}

interface Props {
  claim: ExportedClaim;
}

const { claim } = Astro.props;
const timetable = buildTimetable(claim, data.generated_at);
const overlay = overlayText(claim.status.overlay_years);
const thisYear = Number(data.generated_at.slice(0, 4));
const latestRecord = claim.events.map((event) => event.event_date).sort().at(-1) ?? null;
const hasDatedPromise = claim.promises.some((promise) => promise.parsed_date !== null);
const hasPromise = claim.promises.length > 0;
// The legend names only the kinds of record this page shows.
const kinds: RecordKind[] = [
  ...(claim.articles.length > 0 ? (["report"] as const) : []),
  ...new Set(claim.events.map(eventKind)),
];
const explaining = timetable.sources.filter(({ event }) =>
  claim.status.explained_by.includes(event.id),
);
const description = `${STATUS_LABELS[claim.status.code]}. ${claim.summary}`;
const imageAlt = cardAlt(
  claim,
  cardFacts(claim, STATUS_LABELS[claim.status.code], latestPromise(claim)?.parsed_date ?? null),
);
---

<Base
  title={claim.headline}
  description={description}
  image={`/og/${claim.slug}.png`}
  imageAlt={imageAlt}
>
  <article data-pagefind-body>
    <div class="above-title">
      <TopicChip vertical={claim.vertical} />
      <button type="button" class="share" data-share hidden data-pagefind-ignore>
        <Share2 size={16} stroke-width={1.9} aria-hidden="true" />
        <span data-share-text>Share</span>
      </button>
    </div>
    <h1 class="title">
      {
        /* A name such as "USAG-1" must not break at its hyphen. */
        claim.headline.split(" ").map((word, index) => (
          <>
            {index > 0 && " "}
            {word.includes("-") ? <span class="unbroken">{word}</span> : word}
          </>
        ))
      }
    </h1>

    <div class="digest">
      <div class="standing">
        <h2 class="visually-hidden">Where it stands</h2>
        <div class="label-row">
          <span class="label" data-pagefind-meta="status">{STATUS_LABELS[claim.status.code]}</span>
          <Pop id="why" label="Why this status" class="info">
            <Info slot="trigger" size={20} stroke-width={1.9} aria-hidden="true" />
            <p>{STATUS_MEANINGS[claim.status.code]}</p>
            {
              explaining.length > 0 ? (
                <>
                  <p class="pop-head">
                    <BasisMark label={false} /> The status rests on these records
                  </p>
                  <ul class="pop-list">
                    {explaining.map(({ mark, event }) => (
                      <li>
                        <a href={`#record-${mark}`}>{eventLabel(event)}</a>,{" "}
                        {formatDate(event.event_date)}
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <p>No trial, approval or retraction record is attached to this claim.</p>
              )
            }
            {
              claim.status.updated_at && (
                <p class="pop-note" data-pagefind-ignore>
                  Status set {formatDate(claim.status.updated_at)}.
                </p>
              )
            }
          </Pop>
        </div>
        <StageTrack code={claim.status.code} ends />
        {
          overlay && (
            <div>
              <Pop id="quiet" class="overlay">
                <Fragment slot="trigger">
                  <Clock size={15} stroke-width={1.9} aria-hidden="true" />
                  {overlay}
                </Fragment>
                <p>
                  The most recent record on this page is that old. It says nothing about work that
                  has not been published or registered.
                </p>
              </Pop>
            </div>
          )
        }
        <p class="changed" data-pagefind-ignore>
          {latestRecord ? `Latest record ${formatDate(latestRecord)}` : "No record yet"}
        </p>
      </div>
      <p class="lede" data-pagefind-meta="summary">{claim.summary}</p>
    </div>

    <dl class="facts">
      <div>
        <dt>Intervention</dt>
        <dd>
          {claim.intervention.name}
          {
            claim.intervention.synonyms.length > 0 &&
              ` (also known as ${claim.intervention.synonyms.join(", ")})`
          }
        </dd>
      </div>
      <div>
        <dt>Claimed for</dt>
        <dd>{claim.indication}</dd>
      </div>
      {
        claim.first_reported_date && (
          <div>
            <dt>First reported</dt>
            <dd>{formatDate(claim.first_reported_date)}</dd>
          </div>
        )
      }
      {
        claim.evidence_stage && (
          <div>
            <dt>Evidence then</dt>
            <dd>{EVIDENCE_STAGES[claim.evidence_stage] ?? claim.evidence_stage}</dd>
          </div>
        )
      }
    </dl>

    <div class="bar-row">
      <h2 class="bar" id="timetable">{hasDatedPromise ? "Promised and recorded" : "Recorded"}</h2>
      <ul class="legend" aria-label="Key">
        {
          hasPromise && (
            <li>
              <span class="swatch" /> Promised
            </li>
          )
        }
        {
          kinds.map((kind) => (
            <li>
              <KindIcon kind={kind} /> {KIND_NAMES[kind]}
            </li>
          ))
        }
        {
          explaining.length > 0 && (
            <li>
              <BasisMark label={false} /> Basis of status
            </li>
          )
        }
      </ul>
    </div>
    {!hasDatedPromise && <p class="absent">No dated promise on record.</p>}
    <div class="table-frame">
    <table class="timetable" aria-labelledby="timetable">
      <thead>
        <tr>
          <th scope="col">Year</th>
          {hasDatedPromise && <th scope="col" class="promised">Promised</th>}
          <th scope="col">Recorded</th>
        </tr>
      </thead>
      <tbody>
        {
          timetable.rows.map((row) =>
            row.kind === "quiet" ? (
              <tr class="quiet">
                <th scope="row" class="year">
                  {row.from === row.to ? row.from : `${row.from} to ${row.to}`}
                </th>
                {hasDatedPromise && <td class="promised empty" />}
                <td>{hasDatedPromise ? "No promise, no record" : "No record"}</td>
              </tr>
            ) : (
              <tr>
                <th scope="row" class="year">
                  {row.year}
                  {row.current && <small>this year</small>}
                </th>
                {
                  hasDatedPromise && (
                    <td
                      class:list={["promised", { none: row.promised.length === 0 }]}
                      data-column="Promised"
                    >
                      {row.promised.length === 0 ? (
                        <span class="visually-hidden">Nothing promised for this year.</span>
                      ) : (
                        <ul class="entries">
                          {row.promised.map((promise) => (
                            <li>
                              <span class="entry-kind">{promise.description}</span>
                              <span class="entry-note">
                                <Outlet url={promise.articleUrl} outlet={promise.outlet} />{" "}
                                {formatDate(promise.madeOn)}
                              </span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </td>
                  )
                }
                <td data-column="Recorded">
                  {
                    row.recorded.length === 0 ? (
                      <span class="entry-note">
                        {row.year < thisYear
                          ? "No record"
                          : row.current
                            ? "No record yet"
                            : "Not yet reached"}
                      </span>
                    ) : (
                      <ul class="entries">
                        {row.recorded.map((entry) =>
                          entry.kind === "report" ? (
                            <li class="record">
                              <KindIcon kind="report" />
                              <span class="visually-hidden">News report.</span>
                              <span class="entry-date">{dayAndMonth(entry.date)}</span>
                              <span>
                                <a href={entry.url}>“{entry.title}”</a>
                              </span>
                              <span class="origin">
                                <Outlet url={entry.url} outlet={entry.outlet} link={false} />
                                {entry.archiveUrl && (
                                  <>
                                    {" "}
                                    (<a href={entry.archiveUrl}>archived copy</a>)
                                  </>
                                )}
                              </span>
                            </li>
                          ) : (
                            <li class="record" id={`record-${entry.mark}`}>
                              <KindIcon kind={eventKind(entry.event)} />
                              <span class="entry-date">{dayAndMonth(entry.date)}</span>
                              <span class="what">
                                <Pop id={`about-${entry.mark}`} class="more">
                                  <Fragment slot="trigger">{eventLabel(entry.event)}</Fragment>
                                  <p>{entry.event.summary}</p>
                                  {entry.explains && (
                                    <p class="pop-note">
                                      <BasisMark label={false} /> The status rests on this record.
                                    </p>
                                  )}
                                  {entry.event.date_basis && (
                                    <p class="pop-note">Date taken from: {entry.event.date_basis}.</p>
                                  )}
                                </Pop>
                                {entry.explains && <BasisMark />}
                              </span>
                              <span class="origin">
                                <a href={entry.event.source_url}>
                                  {sourceName(entry.event.source_name)}
                                  {entry.event.trial_id ? `, ${entry.event.trial_id}` : ""}
                                </a>
                              </span>
                            </li>
                          ),
                        )}
                      </ul>
                    )
                  }
                </td>
              </tr>
            ),
          )
        }
      </tbody>
    </table>
    </div>

    {
      timetable.undated.length > 0 && (
        <>
          <h2 class="bar">Promised with no date</h2>
          <ul class="plain undated">
            {timetable.undated.map((promise) => (
              <li>
                <strong>{promise.description}</strong>
                <span class="entry-note">
                  <Outlet url={promise.articleUrl} outlet={promise.outlet} />{" "}
                  {formatDate(promise.madeOn)}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </article>
</Base>

<script>
  // Sharing uses the device's own share sheet where there is one, and copies the
  // page address where there is not. The button only appears when it can work.
  const button = document.querySelector<HTMLButtonElement>("[data-share]");
  if (button && (navigator.share || navigator.clipboard)) {
    const text = button.querySelector<HTMLElement>("[data-share-text]")!;
    button.hidden = false;
    button.addEventListener("click", async () => {
      const url = location.origin + location.pathname;
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url });
        } else {
          await navigator.clipboard.writeText(url);
          text.textContent = "Link copied";
          setTimeout(() => (text.textContent = "Share"), 2000);
        }
      } catch {
        // The reader closed the share sheet, or copying was refused: nothing to do.
      }
    });
  }
</script>
