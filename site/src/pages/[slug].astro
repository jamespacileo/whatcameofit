---
import Base from "../layouts/Base.astro";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Clock from "@lucide/astro/icons/clock";
import Copy from "@lucide/astro/icons/copy";
import ExternalLink from "@lucide/astro/icons/external-link";
import ImageDown from "@lucide/astro/icons/image-down";
import Info from "@lucide/astro/icons/info";
import Bookmark from "@lucide/astro/icons/bookmark";
import ClockMark from "../components/ClockMark.astro";
import BasisMark from "../components/BasisMark.astro";
import ClaimTable from "../components/ClaimTable.astro";
import FollowOffer from "../components/FollowOffer.astro";
import LookupAgain from "../components/LookupAgain.astro";
import Outlet from "../components/Outlet.astro";
import KindIcon from "../components/KindIcon.astro";
import Pop from "../components/Pop.astro";
import SharePill from "../components/SharePill.astro";
import StageTrack from "../components/StageTrack.astro";
import TopicChip from "../components/TopicChip.astro";
import { APPROACH_LABELS } from "../lib/approach";
import { data, verticalTitle, type ExportedClaim } from "../lib/export";
import { UNCHECKED_NOTE } from "../lib/notices";
import {
  EVIDENCE_STAGES,
  KIND_NAMES,
  STAGE_PATH,
  STATUS_LABELS,
  STATUS_GLOSSES,
  STATUS_MEANINGS,
  eventKind,
  eventLabel,
  latestPromise,
  overlayText,
  sourceName,
  type RecordKind,
} from "../lib/status";
import { cardAlt, clip, shareSentence } from "../lib/card";
import { embedSnippet, shareLinks } from "../lib/share";
import { confidenceLabel, readingOf } from "../lib/confidence";
import { FOLLOWED_SHOWN, followedName, followedReports } from "../lib/reports";
import { claimPageData } from "../lib/structured";
import ReportError from "../components/ReportError.astro";
import { SITE } from "../../site.config.mjs";
import { cardFor } from "../lib/card-image";
import { buildTimetable, dayAndMonth, formatDate, recordedLines } from "../lib/timetable";

export function getStaticPaths() {
  return data.claims.map((claim) => ({ params: { slug: claim.slug }, props: { claim } }));
}

interface Props {
  claim: ExportedClaim;
}

const { claim } = Astro.props;
const timetable = buildTimetable(claim, data.generated_at);
const overlay = overlayText(claim.status.overlay_years);
const thisYear = Number(data.generated_at.slice(0, 4));
const latestRecord = claim.events.map((event) => event.event_date).sort().at(-1) ?? null;
// The latest record is at the foot of a long timetable, so the date leads to it.
const latestMark =
  timetable.sources.find(({ event }) => event.event_date === latestRecord)?.mark ?? null;
const onPath = STAGE_PATH.includes(claim.status.code);
const hasDatedPromise = claim.promises.some((promise) => promise.parsed_date !== null);
const hasPromise = claim.promises.length > 0;
// The year the latest dated promise names, shown beside the status as it is on the card.
const promised = latestPromise(claim)?.parsed_date?.slice(0, 4) ?? null;
// The legend names only the kinds of record this page shows.
const kinds: RecordKind[] = [
  ...(claim.articles.length > 0 ? (["report"] as const) : []),
  ...new Set(claim.events.map(eventKind)),
];
const explaining = timetable.sources.filter(({ event }) =>
  claim.status.explained_by.includes(event.id),
);
const description = `${STATUS_LABELS[claim.status.code]}. ${claim.summary}`;
const imageAlt = cardAlt(cardFor(claim));
// In a browser tab and a search result there is room for what and for what, not for
// a whole headline: about sixty characters with the site's name.
const tabTitle = clip(`${claim.intervention.name} for ${claim.indication}`, 41);
// Where to go next: the claims filed with this one, newest report first.
const topic = verticalTitle(claim.vertical);
const inTopic = data.claims
  .filter((other) => other.vertical === claim.vertical && other.slug !== claim.slug)
  .sort((a, b) => ((a.first_reported_date ?? "") < (b.first_reported_date ?? "") ? 1 : -1));
const others = inTopic.slice(0, 3);
// Matched registry records, approved first, each with how sure the match is.
const matched = claim.matches ?? [];
const counted = matched.filter((match) => match.state === "approved").length;
const possible = matched.length - counted;
// A reader arrives from a headline, so the page names the reports it is about, newest first.
const reports = followedReports(claim);
const shownReports = reports.slice(0, FOLLOWED_SHOWN);
const address = `${SITE.url}/${claim.slug}`;
const sentence = shareSentence(claim, STATUS_LABELS[claim.status.code], data.last_checked_at, address);
// Reminders: the dates a reader can save, which the browser turns into a calendar file.
const promiseDue = latestPromise(claim)?.parsed_date ?? null;
// The whole of what another site needs to show this claim's status.
const snippet = embedSnippet(SITE.url, claim.slug, claim.headline);
// Prefilled posts carry the sentence and the address, and nothing of our own.
const postText = shareSentence(claim, STATUS_LABELS[claim.status.code], data.last_checked_at, "").trim();
const posts = shareLinks(postText, address, claim.headline);
---

<Base
  title={claim.headline}
  tabTitle={tabTitle}
  structured={claimPageData(claim, data.last_checked_at, description)}
  breadcrumbs={[
    { name: topic, path: `/topic/${claim.vertical}` },
    { name: claim.headline, path: `/${claim.slug}` },
  ]}
  article={{ published: claim.first_reported_date, modified: data.last_checked_at }}
  oembed={`/oembed/${claim.slug}.json`}
  description={description}
  image={`/og/${claim.slug}.png`}
  imageAlt={imageAlt}
>
  <article data-pagefind-body>
    <div class="above-title">
      <div class="filed">
        <TopicChip vertical={claim.vertical} />
        {
          claim.approach && (
            <span class="approach">
              <span class="visually-hidden">Approach: </span>
              {APPROACH_LABELS[claim.approach]}
            </span>
          )
        }
      </div>
      <div class="page-actions" data-pagefind-ignore>
        {/* Following lists the claim on the home page, in this browser only. Shown by
            the script, where the browser lets it keep the list. */}
        <button
          type="button"
          class="share"
          data-follow
          data-slug={claim.slug}
          data-headline={claim.headline}
          data-status={STATUS_LABELS[claim.status.code]}
          aria-pressed="false"
          hidden
        >
          <Bookmark size={16} stroke-width={1.9} aria-hidden="true" />
          <span data-follow-text>Follow</span>
        </button>
        <SharePill />
      </div>
    </div>
    <h1 class:list={["title", { long: claim.headline.length > 70 }]}>
      {
        /* A name such as "USAG-1" must not break at its hyphen. */
        claim.headline.split(" ").map((word, index) => (
          <>
            {index > 0 && " "}
            {word.includes("-") && word.length <= 16 ? <span class="unbroken">{word}</span> : word}
          </>
        ))
      }
    </h1>

    {/* A reader arriving from a shared link has not seen the home page. */}
    <p class="what-this-is" data-pagefind-ignore>
      A record of what followed{" "}
      {reports.length === 0
        ? "this reported breakthrough"
        : reports.length === 1
          ? "this news report"
          : "these news reports"}. <a href="/how-it-works">How a status is set</a>
    </p>

    {
      shownReports.length > 0 && (
        <section class="reported" data-pagefind-ignore>
          <h2 class="visually-hidden">
            {reports.length === 1 ? "The news report this page follows" : "The news reports this page follows"}
          </h2>
          <ul class="plain">
            {shownReports.map((report, index) => (
              <li>
                {/* The same name as the headline on the home page, so a reader who
                    pressed it there sees it carried to this place. */}
                <a
                  class="reported-title followed"
                  href={report.url}
                  style={`view-transition-name: ${followedName(claim.slug, index)}`}
                >
                  “{report.title}”
                  <ExternalLink class="out" size={14} stroke-width={1.9} aria-hidden="true" />
                  <span class="visually-hidden">(at {report.outlet || "the outlet"})</span>
                </a>
                <span class="entry-note">
                  <Outlet url={report.url} outlet={report.outlet} link={false} />{" "}
                  <span class="unbroken">{formatDate(report.published_date)}</span>
                </span>
              </li>
            ))}
          </ul>
          {reports.length > shownReports.length && (
            <p class="entry-note">
              <a href="#timetable">All {reports.length} reports, by date</a>
            </p>
          )}
        </section>
      )
    }

    <div class="digest">
      <div class="standing">
        <h2 class="visually-hidden">Where it stands</h2>
        <div class="label-row">
          <span class="label" data-pagefind-meta="status">{STATUS_LABELS[claim.status.code]}</span>
          <Pop id="why" label="Why this status" class="info">
            <Info slot="trigger" size={20} stroke-width={1.9} aria-hidden="true" />
            {
              explaining.length > 0 ? (
                <>
                  <p class="pop-head">
                    <BasisMark label={false} /> The status rests on these records
                  </p>
                  <ul class="pop-list">
                    {explaining.map(({ mark, event }) => (
                      <li>
                        <a href={`#record-${mark}`}>{eventLabel(event)}</a>,{" "}
                        {formatDate(event.event_date)}
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <p>No trial, approval or retraction record is attached to this claim.</p>
              )
            }
            {
              /* The dots on the path are named here, so a reader need not guess them. */
              onPath && (
                <>
                  <p class="pop-head">The six places on the path</p>
                  <ol class="pop-path">
                    {STAGE_PATH.map((code) => (
                      <li aria-current={code === claim.status.code ? "true" : undefined}>
                        {STATUS_LABELS[code]}
                      </li>
                    ))}
                  </ol>
                </>
              )
            }
            <p class="pop-note">
              <a href="/how-it-works#what-each-status-means">What each status means</a>
            </p>
            {
              claim.status.updated_at && (
                <p class="pop-note" data-pagefind-ignore>
                  Status set {formatDate(claim.status.updated_at)}.
                </p>
              )
            }
          </Pop>
        </div>
        <p class="gloss">{STATUS_GLOSSES[claim.status.code]}</p>
        <StageTrack code={claim.status.code} ends />
        {
          overlay && (
            <div>
              <Pop id="quiet" class="overlay">
                <Fragment slot="trigger">
                  <Clock size={15} stroke-width={1.9} aria-hidden="true" />
                  {overlay}
                </Fragment>
                <p>
                  No record on this page is more recent than that. It says nothing about work that
                  has not been published or registered.
                </p>
                <p class="pop-note">
                  <a href="/how-it-works#no-signal">How "no signal" is counted</a>
                </p>
              </Pop>
            </div>
          )
        }
        {
          promised && (
            <p class="promised-by" data-pagefind-ignore>
              Promised by <a href={`#year-${promised}`}>{promised}</a>
            </p>
          )
        }
        <p class="changed" data-pagefind-ignore>
          {latestMark ? (
            <>
              Latest record <a href={`#record-${latestMark}`}>{formatDate(latestRecord)}</a>
            </>
          ) : (
            "No record yet"
          )}
        </p>
        {
          claim.matches && (
            <p class="changed" data-pagefind-ignore>
              <a href="#matched">
                {matched.length === 0
                  ? "No registry record matched"
                  : `${counted} registry ${counted === 1 ? "record" : "records"} matched`}
              </a>
              {possible > 0 && `, ${possible} possible`}
            </p>
          )
        }
        <p class="changed" data-pagefind-ignore hidden data-remind-link>
          <a href="#check-again">Check again later</a>
        </p>
      </div>
      <div class="says">
        {/* What the status means, in a sentence, beside the label it explains. */}
        <p class="means">{STATUS_MEANINGS[claim.status.code]}</p>
        <p class="lede" data-pagefind-meta="summary">{claim.summary}</p>
      </div>
    </div>

    {/* For a reader who follows this claim and last saw it at another status: filled in
        by the script, so a change noted on the home page is confirmed where they land. */}
    <p class="was-note" hidden data-follow-was data-pagefind-ignore></p>
    <FollowOffer claim={claim} />

    {!claim.checked_by_person && <p class="unchecked">{UNCHECKED_NOTE}</p>}

    <dl class="facts">
      <div>
        <dt>Intervention</dt>
        <dd>
          {claim.intervention.name}
          {claim.intervention.synonyms.length > 0 && (
            <span class="aka">
              also known as{" "}
              {
                /* A name such as "TRG-035" must not break at its hyphen. */
                claim.intervention.synonyms.map((name, index) => (
                  <>
                    {index > 0 && ", "}
                    {name.includes("-") && name.length <= 16 ? <span class="unbroken">{name}</span> : name}
                  </>
                ))
              }
            </span>
          )}
        </dd>
      </div>
      <div>
        <dt>Claimed for</dt>
        <dd>{claim.indication}</dd>
      </div>
      {
        claim.first_reported_date && (
          <div>
            <dt>First reported</dt>
            <dd>
              <a href={`/year/${claim.first_reported_date.slice(0, 4)}`}>
                {formatDate(claim.first_reported_date)}
              </a>
            </dd>
          </div>
        )
      }
      {
        claim.evidence_stage && (
          <div>
            <dt>Evidence when first reported</dt>
            <dd>{EVIDENCE_STAGES[claim.evidence_stage] ?? claim.evidence_stage}</dd>
          </div>
        )
      }
    </dl>

    <div class="bar-row">
      <h2 class="bar" id="timetable">{hasDatedPromise ? "Promised and recorded" : "Recorded"}</h2>
      <ul class="legend" aria-label="Key">
        {
          hasPromise && (
            <li>
              <span class="swatch" /> Promised
            </li>
          )
        }
        {
          kinds.map((kind) => (
            <li>
              <KindIcon kind={kind} /> {KIND_NAMES[kind]}
            </li>
          ))
        }
        {
          explaining.length > 0 && (
            <li>
              <BasisMark label={false} /> Basis of status
            </li>
          )
        }
      </ul>
    </div>
    {!hasDatedPromise && <p class="absent">No dated promise on record.</p>}
    <div class="table-frame">
    <table role="table" class="timetable" aria-labelledby="timetable">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">Year</th>
          {hasDatedPromise && <th role="columnheader" scope="col" class="promised">Promised</th>}
          <th role="columnheader" scope="col">Recorded</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          timetable.rows.map((row) =>
            row.kind === "quiet" ? (
              <tr role="row" class="quiet">
                <th role="rowheader" scope="row" class="year">
                  {row.from === row.to ? row.from : `${row.from} to ${row.to}`}
                </th>
                {hasDatedPromise && <td role="cell" class="promised empty" />}
                <td role="cell">{hasDatedPromise ? "No promise, no record" : "No record"}</td>
              </tr>
            ) : (
              <tr role="row" id={`year-${row.year}`}>
                <th role="rowheader" scope="row" class="year">
                  {row.year}
                  {row.current && <small>this year</small>}
                </th>
                {
                  hasDatedPromise && (
                    <td role="cell"
                      class:list={["promised", { none: row.promised.length === 0 }]}
                      data-column="Promised"
                    >
                      {row.promised.length === 0 ? (
                        <span class="visually-hidden">Nothing promised for this year.</span>
                      ) : (
                        <ul class="entries">
                          {row.promised.map((promise) => (
                            <li>
                              <span class="entry-kind">{promise.description}</span>
                              <span class="entry-note">
                                <Outlet url={promise.articleUrl} outlet={promise.outlet} />{" "}
                                {formatDate(promise.madeOn)}
                              </span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </td>
                  )
                }
                <td role="cell" data-column={hasDatedPromise ? "Recorded" : undefined}>
                  {
                    row.recorded.length === 0 ? (
                      <span
                        class:list={[
                          "entry-note",
                          // The same words, in ink, where a promise names this year.
                          { beside: row.promised.length > 0 && row.year < thisYear },
                        ]}
                      >
                        {row.year < thisYear
                          ? "No record"
                          : row.current
                            ? "No record yet"
                            : "Not yet reached"}
                      </span>
                    ) : (
                      <ul class="entries">
                        {recordedLines(row.recorded).map((line) =>
                          line.kind === "report" ? (
                            <li class="record">
                              <KindIcon kind="report" />
                              <span class="visually-hidden">News report.</span>
                              <span class="entry-date">{dayAndMonth(line.date)}</span>
                              <span>
                                <a href={line.url}>
                                  “{line.title}”
                                  <ExternalLink class="out" size={13} stroke-width={1.9} aria-hidden="true" />
                                  <span class="visually-hidden">(at {line.outlet ?? "the outlet"})</span>
                                </a>
                              </span>
                              <span class="origin">
                                <Outlet url={line.url} outlet={line.outlet} link={false} />
                                {line.archiveUrl && (
                                  <>
                                    {" "}
                                    <span class="unbroken">(<a href={line.archiveUrl}>archived copy</a>)</span>
                                  </>
                                )}
                              </span>
                            </li>
                          ) : (
                            <li class="record">
                              <KindIcon kind={eventKind(line.steps[0].event)} />
                              <span class="visually-hidden">
                                {KIND_NAMES[eventKind(line.steps[0].event)]}.
                              </span>
                              {line.steps.map((entry) => (
                                <>
                                  <span class="entry-date">{dayAndMonth(entry.date)}</span>
                                  <span class="what" id={`record-${entry.mark}`}>
                                    <Pop id={`about-${entry.mark}`} class="more">
                                      <Fragment slot="trigger">
                                        {eventLabel(entry.event)}
                                        {entry.explains && <BasisMark />}
                                        {/* Says this opens something, where a link's arrow says it leaves. */}
                                        <ChevronDown class="opens" size={14} stroke-width={2.2} aria-hidden="true" />
                                      </Fragment>
                                      <p>{entry.event.summary}</p>
                                      {entry.explains && (
                                        <p class="pop-note">
                                          <BasisMark label={false} /> The status rests on this record.
                                        </p>
                                      )}
                                      {entry.event.date_basis && (
                                        <p class="pop-note">
                                          Date taken from: {entry.event.date_basis}.
                                        </p>
                                      )}
                                    </Pop>
                                  </span>
                                </>
                              ))}
                              <span class="origin">
                                <a href={line.sourceUrl}>
                                  {sourceName(line.steps[0].event.source_name)}
                                  {line.steps[0].event.trial_id
                                    ? `, ${line.steps[0].event.trial_id}`
                                    : ""}
                                </a>
                              </span>
                            </li>
                          ),
                        )}
                      </ul>
                    )
                  }
                </td>
              </tr>
            ),
          )
        }
      </tbody>
    </table>
    </div>

    {
      timetable.undated.length > 0 && (
        <>
          <h2 class="bar">Promised with no date</h2>
          <ul class="plain undated">
            {timetable.undated.map((promise) => (
              <li>
                <strong>{promise.description}</strong>
                <span class="entry-note">
                  <Outlet url={promise.articleUrl} outlet={promise.outlet} />{" "}
                  {formatDate(promise.madeOn)}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      claim.matches && (
        <section class="matched" data-pagefind-ignore>
          <h2 class="bar" id="matched">Matched registry records</h2>
          <p class="take-why">
            {matched.length > 0
              ? "Each trial registry record found for this treatment and condition, with how sure the match is. A score is about the match, not about the treatment."
              : "The trial registries were searched for this treatment and condition. No record matched."}
          </p>
          {[
            { title: null, list: matched.filter((match) => match.state === "approved") },
            {
              title: "Possible records, not counted in the status",
              list: matched.filter((match) => match.state === "candidate"),
            },
          ].map(
            (group) =>
              group.list.length > 0 && (
                <>
                  {group.title && <h3 class="matched-group">{group.title}</h3>}
                  <ul class="plain match-list">
                    {group.list.map((match) => (
                      <li>
                        <span class="match-record">
                          {match.url ? (
                            <a href={match.url} rel="noopener">
                              {match.external_id}
                            </a>
                          ) : (
                            match.external_id
                          )}
                          {match.summary && (
                            <span class="entry-note">{match.summary.replace(`${match.external_id}: `, "")}</span>
                          )}
                        </span>
                        <details class="match-why">
                          <summary>
                            <strong>{confidenceLabel(match.score)}</strong>
                            <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
                          </summary>
                          <p>{readingOf(match.reading)}</p>
                        </details>
                      </li>
                    ))}
                  </ul>
                </>
              ),
          )}
        </section>
      )
    }

    <ReportError page={`/${claim.slug}`} />

    {
      others.length > 0 && (
        <section class="others" data-pagefind-ignore>
          <h2 class="bar" id="others">Other claims in {topic.toLowerCase()}</h2>
          <ClaimTable claims={others} caption="Each claim, when it was first reported and its status" />
          {inTopic.length > others.length && (
            <p class="about-page">
              <a href={`/topic/${claim.vertical}`}>
                All {inTopic.length + 1} claims in {topic.toLowerCase()}
              </a>
            </p>
          )}
        </section>
      )
    }

    <section class="take" data-pagefind-ignore>
      <h2 class="bar" id="pass-on">Pass it on</h2>
      {/* Says "Copied" to a screen reader; the button's own label changes for the eye. */}
      <p class="visually-hidden" role="status" data-said></p>
      <p class="take-why">Seen this headline shared again? Reply with the record.</p>
      <div class="take-body">
        {/* The card the pills download, so a reader sees what they would be passing on. */}
        <img
          class="take-card"
          src={`/og/square/${claim.slug}.png`}
          width="1080"
          height="1080"
          alt={imageAlt}
          loading="lazy"
          decoding="async"
        />
        <div>
      <p class="sentence" id="sentence">{sentence}</p>
      <div class="take-actions">
        <button type="button" class="share" data-copy="sentence" hidden>
          <Copy size={16} stroke-width={1.9} aria-hidden="true" />
          <span data-copy-text>Copy sentence</span>
        </button>
        <a class="share" href={`/og/square/${claim.slug}.png`} download>
          <ImageDown size={16} stroke-width={1.9} aria-hidden="true" />
          Square image
        </a>
        <a class="share" href={`/og/tall/${claim.slug}.png`} download>
          <ImageDown size={16} stroke-width={1.9} aria-hidden="true" />
          Tall image
        </a>
        <button type="button" class="share" data-copy="page-address" hidden>
          <Copy size={16} stroke-width={1.9} aria-hidden="true" />
          <span data-copy-text>Copy link</span>
        </button>
        <span id="page-address" hidden>{address}</span>
      </div>
      <details class="post-to">
        <summary id="post-to">Post it to a network</summary>
        <ul class="post-links" aria-labelledby="post-to">
          {
            posts.map((post) => (
              <li>
                <a
                  class="share"
                  href={post.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-network={post.network}
                >
                  {post.label}
                </a>
              </li>
            ))
          }
          <li>
            {/* Mastodon has no one address: the reader names their server. */}
            <button
              type="button"
              class="share"
              data-mastodon
              data-text={postText}
              data-url={address}
              hidden
            >
              Mastodon
            </button>
          </li>
        </ul>
      </details>
      <dialog class="mastodon" data-mastodon-dialog aria-labelledby="mastodon-title">
        <form method="dialog">
          <h3 id="mastodon-title">Post to Mastodon</h3>
          <label for="mastodon-server">Your server</label>
          <input
            id="mastodon-server"
            name="server"
            type="text"
            inputmode="url"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="mastodon.social"
            aria-describedby="mastodon-note"
            required
          />
          <p class="entry-note" id="mastodon-note" data-mastodon-note aria-live="polite">
            Kept in this browser only, so you are not asked again.
          </p>
          <div class="mastodon-actions">
            <button type="submit" class="share" value="post">Open Mastodon</button>
            <button type="submit" class="share quiet" value="cancel" formnovalidate>Cancel</button>
          </div>
        </form>
      </dialog>
        </div>
      </div>
      <details class="embed-how">
        <summary>Writing about this? Show the status on your own page</summary>
        <p class="entry-note">
          Paste this where the status should appear. It shows the current status and links back
          here; it loads nothing else and stores nothing.
        </p>
        <pre id="snippet"><code>{snippet}</code></pre>
        <button type="button" class="share" data-copy="snippet" hidden>
          <Copy size={16} stroke-width={1.9} aria-hidden="true" />
          <span data-copy-text>Copy code</span>
        </button>
      </details>
    </section>

    {/* Shown only where the browser can make and save the file. */}
    <section
      class="again"
      data-pagefind-ignore
      data-remind
      data-site={SITE.name}
      data-headline={claim.headline}
      data-slug={claim.slug}
      data-url={address}
      data-promise={promiseDue}
      data-first={claim.first_reported_date}
      hidden
    >
      <h2 class="bar" id="check-again">Check again later</h2>
      <p class="take-why">
        Save a date to your calendar to look at this record again. The file is made on this
        device; nothing is sent to us.
      </p>
      <div class="take-actions">
        {
          promiseDue && (
            <button type="button" class="share" data-when="promise">
              <ClockMark />
              <span data-when-text>On the promised date, {formatDate(promiseDue)}</span>
            </button>
          )
        }
        <button type="button" class="share" data-when="six-months">
          <ClockMark />
          <span data-when-text>In six months</span>
        </button>
        <button type="button" class="share" data-when="year">
          <ClockMark />
          <span data-when-text>In a year</span>
        </button>
        {
          claim.first_reported_date && (
            <button type="button" class="share" data-when="anniversary">
              <ClockMark />
              <span data-when-text>On the anniversary, {dayAndMonth(claim.first_reported_date)}</span>
            </button>
          )
        }
      </div>
      <FollowOffer claim={claim} />
      {
        (claim.status.history?.length ?? 0) > 0 && (
          <p class="entry-note">
            For a feed reader: <a href={`/changes/${claim.slug}.xml`}>this claim's status changes</a>,
            or <a href="/changes.xml">every claim's</a>.
          </p>
        )
      }
    </section>

    <LookupAgain />
  </article>
</Base>

<script>
  import { calendarFile, reminderDate, type ReminderChoice } from "../lib/calendar";
  import { mastodonShare } from "../lib/share";
  import { FOLLOWING_ENTRY, readFollowed } from "../lib/returning";

  // Mastodon: the reader names their server once; it is kept in this browser only.
  const mastodon = document.querySelector<HTMLButtonElement>("[data-mastodon]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-mastodon-dialog]");
  if (mastodon && dialog && typeof dialog.showModal === "function") {
    const KEY = "mastodon-server";
    const input = dialog.querySelector<HTMLInputElement>("input")!;
    const note = dialog.querySelector<HTMLElement>("[data-mastodon-note]")!;
    const idleNote = note.textContent;
    const { text, url } = mastodon.dataset as { text: string; url: string };
    const open = (server: string) => {
      const href = mastodonShare(server, text, url);
      if (href) window.open(href, "_blank", "noopener,noreferrer");
      return href;
    };
    mastodon.hidden = false;
    // A remembered server is filled in, so posting is one more press and changing it is easy.
    mastodon.addEventListener("click", () => {
      let saved: string | null = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {}
      input.value = saved ?? "";
      note.textContent = idleNote;
      dialog.showModal();
    });
    dialog.querySelector("form")!.addEventListener("submit", (event) => {
      if (event.submitter?.getAttribute("value") !== "post") return;
      if (!open(input.value)) {
        event.preventDefault();
        note.textContent = "That is not a server's name. Try one like mastodon.social.";
        input.focus();
        return;
      }
      try {
        localStorage.setItem(KEY, input.value.trim());
      } catch {}
    });
  }

  // Sharing uses the device's own share sheet where there is one, and copies the
  // page address where there is not. The button only appears when it can work.
  // Copying: the button appears only where the clipboard can be written, says so when
  // it has copied, and otherwise leaves the text selected for the reader to copy.
  // A copy is confirmed three ways: the label changes, the site's blue dot lands in
  // place of the icon, and a screen reader is told.
  const said = document.querySelector<HTMLElement>("[data-said]");
  function confirm(control: HTMLElement, words: string) {
    control.classList.add("done");
    if (said) said.textContent = words;
    setTimeout(() => {
      control.classList.remove("done");
      if (said) said.textContent = "";
    }, 2000);
  }

  // A saved date is confirmed in its own pill: the clock's hand turns once, the words
  // say it is saved, and a screen reader is told. Then the pill offers its date again.
  function saved(choice: HTMLElement) {
    const words = choice.querySelector<HTMLElement>("[data-when-text]")!;
    if (choice.classList.contains("saved")) return;
    const offer = words.textContent;
    choice.classList.add("saved");
    words.textContent = "Saved to your calendar";
    if (said) said.textContent = "Calendar file saved";
    setTimeout(() => {
      choice.classList.remove("saved");
      words.textContent = offer;
      if (said) said.textContent = "";
    }, 2000);
  }

  if (navigator.clipboard) {
    for (const copier of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      const source = document.getElementById(copier.dataset.copy!)!;
      const label = copier.querySelector<HTMLElement>("[data-copy-text]")!;
      const idle = label.textContent;
      copier.hidden = false;
      copier.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(source.textContent!.trim());
          label.textContent = "Copied";
          confirm(copier, "Copied");
          setTimeout(() => (label.textContent = idle), 2000);
        } catch {
          getSelection()?.selectAllChildren(source);
        }
      });
    }
  }

  // A reminder is a calendar file made here, in the browser, from a date the reader
  // picks. A choice that cannot be offered (a promised date already past) is removed.
  const remind = document.querySelector<HTMLElement>("[data-remind]");
  if (remind && typeof Blob !== "undefined" && typeof URL.createObjectURL === "function") {
    const now = new Date();
    const pad = (value: number) => String(value).padStart(2, "0");
    const dates = {
      today: `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`,
      promiseDue: remind.dataset.promise || null,
      firstReported: remind.dataset.first || null,
    };
    for (const choice of remind.querySelectorAll<HTMLButtonElement>("[data-when]")) {
      const date = reminderDate(choice.dataset.when as ReminderChoice, dates);
      if (!date) {
        choice.remove();
        continue;
      }
      choice.addEventListener("click", () => {
        const file = calendarFile({
          site: remind.dataset.site!,
          headline: remind.dataset.headline!,
          url: remind.dataset.url!,
          slug: remind.dataset.slug!,
          date,
          madeAt: new Date().toISOString(),
        });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob([file], { type: "text/calendar" }));
        link.download = `${remind.dataset.slug}-${date}.ics`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        saved(choice);
      });
    }
    remind.hidden = false;
    const link = document.querySelector<HTMLElement>("[data-remind-link]");
    if (link) link.hidden = false;
  }

  // Following: the claim, its headline and its status in words are kept in this
  // browser's storage and sent nowhere. The home page lists followed claims and notes
  // a status that has changed. Opening this page is seeing the status, so a change is
  // said here once and the kept status is brought up to date.
  const follows = [...document.querySelectorAll<HTMLButtonElement>("[data-follow]")];
  if (follows.length > 0) {
    let store: Storage | null = null;
    try {
      localStorage.setItem("probe", "1");
      localStorage.removeItem("probe");
      store = localStorage;
    } catch {}
    if (store) {
      const kept = store;
      const { slug, headline, status } = follows[0].dataset as Record<string, string>;
      const write = (followed: ReturnType<typeof readFollowed>) => {
        try {
          kept.setItem(FOLLOWING_ENTRY, JSON.stringify(followed));
        } catch {}
      };
      // Every Follow control on the page says the same thing, and the words beside
      // one change with it: what following does, then where the list is.
      const show = (on: boolean) => {
        for (const button of follows) {
          button.setAttribute("aria-pressed", String(on));
          button.querySelector<HTMLElement>("[data-follow-text]")!.textContent = on
            ? "Following"
            : "Follow";
        }
        for (const words of document.querySelectorAll<HTMLElement>("[data-follow-when]")) {
          words.hidden = (words.dataset.followWhen === "on") !== on;
        }
      };
      const followed = readFollowed(kept.getItem(FOLLOWING_ENTRY));
      const before = followed[slug];
      if (before) {
        const was = document.querySelector<HTMLElement>("[data-follow-was]");
        if (was && before.status !== status) {
          const tag = document.createElement("span");
          tag.className = "new-tag";
          tag.textContent = "Changed";
          was.append(tag, ` When you last looked: ${before.status}. Now: ${status}.`);
          was.hidden = false;
        }
        followed[slug] = { ...before, headline, status };
        write(followed);
      }
      show(Boolean(before));
      for (const button of follows) {
        button.addEventListener("click", () => {
          const now = readFollowed(kept.getItem(FOLLOWING_ENTRY));
          const on = !now[slug];
          if (on) {
            const today = new Date();
            const two = (value: number) => String(value).padStart(2, "0");
            now[slug] = {
              headline,
              status,
              since: `${today.getFullYear()}-${two(today.getMonth() + 1)}-${two(today.getDate())}`,
            };
          } else {
            delete now[slug];
          }
          write(now);
          show(on);
          // The bookmark lands in the pill that was pressed, not when a followed page is opened.
          for (const other of follows) other.classList.toggle("landed", on && other === button);
          if (said) {
            said.textContent = on
              ? "Following. Listed on the home page, in this browser only."
              : "No longer following.";
            setTimeout(() => (said.textContent = ""), 3000);
          }
        });
        button.hidden = false;
      }
      for (const offer of document.querySelectorAll<HTMLElement>("[data-follow-offer]")) {
        offer.hidden = false;
      }
    }
  }
</script>
