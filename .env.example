# Copy to .env and fill in. Never commit .env.

# --- Local stack ---------------------------------------------------------
# Password for the local Compose database. The database listens on
# 127.0.0.1 only. If you change the password or port, set TEST_DATABASE_URL
# to match when running `make check`.
POSTGRES_PASSWORD=thenwhat
DB_PORT=5433
# Port for the local site preview (bound to 127.0.0.1 only).
SITE_PORT=4321

# --- Registry access -----------------------------------------------------
# Contact address sent in the User-Agent of every registry request.
# No request is sent while this is empty.
CONTACT_EMAIL=

# --- Language model ------------------------------------------------------
# Provider and model as "provider:model", where provider is "anthropic" or
# "openai". There is no default: extraction and decisions refuse to run while
# this is empty.
LLM_MODEL=
# The key of the provider named in LLM_MODEL. The other one stays empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Private pipeline monthly spend ceiling in US dollars (13 is about GBP 10).
# The public Worker uses a separate OpenAI project hard limit; see docs/deploy.md.
# Pipeline calls are refused once the month's recorded cost reaches this ceiling.
LLM_MONTHLY_BUDGET_USD=13
# Prices of the configured model, in US dollars per million tokens.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=

# Which backend answers bounded decisions (match scoring, evidence stage, lookups).
#   llm               the model above, answering in text: any provider, slower
#   openai-decisions  OpenAI's Decisions API: every record of a step in one fast call
DECISION_BACKEND=llm
# For openai-decisions. The model by OpenAI's own name; leave empty to use the model
# of LLM_MODEL when that is an OpenAI one. The price is per million input tokens (the
# Decisions API charges no output). It needs OPENAI_API_KEY above.
DECISIONS_MODEL=
DECISIONS_INPUT_USD_PER_MTOK=

# --- Local preview -------------------------------------------------------
# Set to 1 to include claims an AI assistant decided in the export, marked as
# not checked by a person. For looking at work in progress on this machine
# only. Leave unset for anything public.
# EXPORT_PREVIEW=1

# --- Rules ---------------------------------------------------------------
# New evidence events below this confidence wait for human review.
# A value above 1 sends every event to review.
REVIEW_CONFIDENCE_THRESHOLD=0.95
# A new candidate match scored under this is rejected by rule, so only plausible
# candidates wait for review. Rejected candidates are kept: list them with
# `review list --by-rule` and approve any of them. 0 turns the rule off.
MATCH_REJECT_BELOW=0.05
# A new trial candidate scored for the claim's indication at or above this is
# approved by rule and published without review. Empty or 0 turns the rule off.
# Choose it from the lookup's measured agreement with past human approvals.
MATCH_ACCEPT_ABOVE=
# Decide new drafts by rule: approved and published when the intervention is a name,
# rejected and kept otherwise. Empty or false keeps every draft pending.
APPROVE_DRAFTS_BY_RULE=
# Years without an evidence event before the no-signal overlay appears.
NO_SIGNAL_YEARS=3
