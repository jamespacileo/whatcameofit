# Copy to .env and fill in. Never commit .env.

# --- Local stack ---------------------------------------------------------
# Password for the local Compose database. The database listens on
# 127.0.0.1 only.
POSTGRES_PASSWORD=thenwhat
DB_PORT=5433
# The tests' own Postgres (Compose service `test-db`), which `make check` starts. Tests
# refuse to run on the port above. Its user and password are fixed: it holds no data.
# TEST_DB_PORT=5434
# Port for the local site preview (bound to 127.0.0.1 only).
SITE_PORT=4321

# --- Page reader ---------------------------------------------------------
# The operator's self-hosted Firecrawl service, which fetches every news page and holds
# the rules about each site (docs/adr/0005, docs/adr/0006, docs/sources.md). Its address
# on the private network and its key. No page is read while either is empty, and no
# page is fetched any other way.
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
# How many requests the pipeline has with the reader at once. Default 2, at most 4.
# READER_READS_AT_ONCE=2
# How many seconds one request to the reader may take. Default 120.
# READER_TIMEOUT_SECONDS=120

# --- Registry access -----------------------------------------------------
# Contact address sent in the User-Agent of every registry request.
# No request is sent while this is empty.
CONTACT_EMAIL=
# OpenAlex free API key: server only. Unset disables paper search, not trial lookup.
# No key is needed for ROR. No prepaid OpenAlex balance/top-ups are used.
OPENALEX_API_KEY=

# --- Language model ------------------------------------------------------
# Provider and model as "provider:model", where provider is "anthropic" or
# "openai". There is no default: extraction and decisions refuse to run while
# this is empty.
LLM_MODEL=
# The key of the provider named in LLM_MODEL. The other one stays empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: another address for the provider's API, used by the site's lookup
# service (docs/deploy.md).
# LLM_BASE_URL=
# Private pipeline monthly spend ceiling in US dollars (13 is about GBP 10).
# The public Worker uses a separate OpenAI project hard limit; see docs/deploy.md.
# Pipeline calls are refused once the month's recorded cost reaches this ceiling.
LLM_MONTHLY_BUDGET_USD=13
# Prices of the configured model, in US dollars per million tokens.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=

# Which backend answers bounded decisions (match scoring, evidence stage, lookups).
#   llm               the model above, answering in text: any provider, slower
#   openai-decisions  OpenAI's Decisions API: every record of a step in one fast call
DECISION_BACKEND=llm
# For openai-decisions. The model by OpenAI's own name; leave empty to use the model
# of LLM_MODEL when that is an OpenAI one. The price is per million input tokens (the
# Decisions API charges no output). It needs OPENAI_API_KEY above.
DECISIONS_MODEL=
DECISIONS_INPUT_USD_PER_MTOK=

# --- Rules ---------------------------------------------------------------
# New evidence events below this confidence wait for human review.
# A value above 1 sends every event to review.
REVIEW_CONFIDENCE_THRESHOLD=0.95
# An evidence-stage reading that did not reach the threshold above is still shown on the
# claim page, marked low confidence, when the stage it chose has at least this
# probability. It never sets the stage or the status. A value above 1 shows none.
STAGE_SHOW_ABOVE=0.5
# A new candidate match scored under this is rejected by rule, so only plausible
# candidates wait for review. Rejected candidates are kept: list them with
# `review list --by-rule` and approve any of them. 0 turns the rule off.
MATCH_REJECT_BELOW=0.05
# A new trial candidate scored for the claim's indication at or above this is
# approved by rule and published without review. Leave it out for the default, 0.8,
# where the site's "High match" band starts. 0 turns the rule off.
# A related paper scored at or above it is approved by rule too, and one scored
# under MATCH_REJECT_BELOW is rejected by rule.
# MATCH_ACCEPT_ABOVE=0.8
# How many candidate subject terms are kept for a claim. They are approved and rejected
# on the two match settings above.
# TERM_CANDIDATES_MAX=10
# How many genes named in a claim's intervention are kept as candidate targets, a word
# equal to a gene's symbol before a word equal to a synonym of it. Leave it out for the
# default, 3.
# TARGET_CANDIDATES_MAX=3
# Reported statements: what an article says about the intervention, in the site's own
# words. A statement the check scores at or above this (the probability that its article
# says it) is approved by rule and published; one below it waits, unpublished. Leave it
# out for the default, 0.8. 0 turns the rule off.
# STATEMENT_ACCEPT_ABOVE=0.8
# The most reported statements kept for one article. Leave it out for the default, 6.
# STATEMENTS_PER_ARTICLE=6
# A proposed statement that shares this many consecutive words with its article is
# refused as copied. Leave it out for the default, 8.
# STATEMENT_COPIED_RUN=8
# Record readings (ADR 0003): a reading the model gives less confidence than this is not
# published; the page and data file give the registry's own words instead. Leave it out for
# the default, 0.8.
# READING_ACCEPT_ABOVE=0.8
# How many trials the readings step asks the model about at a time, 1 to 16. The monthly
# ceiling is looked at before each group. Leave it out for the default, 6.
# READINGS_AT_ONCE=6
# Decide new drafts by rule: approved and published when the intervention is a name,
# rejected and kept otherwise. On by default; false keeps every draft pending.
# APPROVE_DRAFTS_BY_RULE=true
# Years without an evidence event before the no-signal overlay appears.
NO_SIGNAL_YEARS=3
# Days a stored paper record (the index record a paper's facts are read from) is kept
# before a fetch asks the index for it again. Leave it out for the default, 30.
# PAPER_RECORD_MAX_AGE_DAYS=30

# --- Backfill ------------------------------------------------------------
# How many requests each source may receive in a period, and how far apart, whichever
# command asks it. Every process shares the count, which is kept in the database. A
# source with no entry is not counted, only spaced at its client's own rate.
# JSON by source name; an entry here replaces the default for that source. Defaults:
#   clinicaltrials.gov  5,000 requests in 24 hours, 0.5 seconds apart
#   mediacloud          4,000 requests in 168 hours, 30 seconds apart
#   reader              3,000 requests in 24 hours, 1 second apart (the page reader)
#   pubmed              5,000 requests in 24 hours, 0.5 seconds apart
# Never set an allowance above what the source publishes (docs/sources.md).
# SOURCE_ALLOWANCES={"mediacloud": {"requests": 4000, "period_hours": 168, "interval_seconds": 30}}
# The longest one wait inside a call to a source or a model may be, in seconds: a delay
# before a retry, or a wait the source stated. One that asks for longer is paused until
# then for every process, and the call ends at once saying so.
# CALL_WAIT_CEILING_SECONDS=60
# A record that fails this many times is skipped and listed by `backfill plan`.
# BACKFILL_ATTEMPT_LIMIT=3
# A record put off for one reason for longer than this many days is listed as needing
# a fix and is no longer asked for by itself.
# WORK_PUT_OFF_DAYS=30
# Media Cloud key for the news search step. Create the account and accept its terms
# yourself (docs/sources.md). The step refuses to run while this is empty.
MEDIACLOUD_API_KEY=
# What the news search searches, as comma-separated ids from Media Cloud's directory:
# collections of outlets, and single outlets. Media Cloud refuses a search that names
# neither, so the step refuses to run while both are empty.
MEDIACLOUD_COLLECTION_IDS=
MEDIACLOUD_SOURCE_IDS=
# At most this many article leads are kept for one trial.
# LEADS_PER_TRIAL=20
# PubMed, through NCBI's E-utilities (docs/sources.md): the papers that carry a trial's
# registry number. Every request gives PUBMED_TOOL and CONTACT_EMAIL, as NCBI's usage
# policy asks; the step `pubmed_papers` refuses to run while either is empty. Register
# both with NCBI by email (the address is in docs/sources.md). The key is free, made in
# the Settings page of an NCBI account, and optional: without it NCBI allows three
# requests a second, and this client sends two.
# PUBMED_TOOL=thenwhat
PUBMED_API_KEY=
# How many trials' numbers one PubMed search carries.
# PUBMED_TRIALS_PER_REQUEST=50

# --- Link leads ----------------------------------------------------------
# `thenwhat backfill load-links` reads article addresses people shared from a bulk file
# on your disk (docs/sources.md, "Link datasets for the social-link backfill"). It sends
# no request. Never the author, the post or its comments.
# The Reddit communities whose submissions are loaded, separated by commas, without
# "r/". A Reddit load refuses to run while this is empty.
LINK_LEAD_SUBREDDITS=
# Screening links a link lead to the claims and registry trials the database already
# holds for it. At most this many are kept for one lead. Leave it out for the default, 10.
# LEAD_LINKS_MAX=10
# Triage scores each link lead from its title: the probability that the article reports
# a specific treatment for a specific condition. A lead scored at or above the first
# setting is passed and may be read; one scored below the second is rejected and kept;
# between them it is held. There is no default: set both after reading
# `thenwhat backfill evaluate-leads`. Until then no lead is passed.
LEAD_PASS_ABOVE=
LEAD_REJECT_BELOW=
# No link lead's article is read until this many leads carry a label, yours or an
# assistant's that you spot-check, and a score from the current version of triage. Leave
# it out for the default, 200.
# LEAD_EVALUATION_MIN_LABELS=200
# Reading a passed lead's article. A new claim's vertical is chosen by a decision and
# accepted only at or above this probability; below it no claim is made and the lead is
# listed for you. Leave it out for the default, 0.8.
# VERTICAL_ACCEPT_ABOVE=0.8
# Several outlets report one story in different words. When an article's treatment shares
# a name with claims that exist, a decision says whether it reports one of them. The
# article joins the likeliest claim when the decision gives at least this probability to
# "one of these claims" (one minus what it gives "none of these") and gives that claim
# more than half; otherwise a new claim is drafted. Leave it out for the default, 0.6.
# SAME_CLAIM_ACCEPT_ABOVE=0.6
# After a lead's article is read, a decision on the read's own headline and summary says
# whether it is about one treatment for one condition, new or already in established use.
# Both become claims. Below this probability of "one treatment" no claim is made or
# joined. Leave it out for the default, 0.5.
# TREATMENT_ACCEPT_ABOVE=0.5
# A lead for a claim that already has this many source articles is held and not read,
# unless it was shared before the claim's first reported date. Default 3.
# LEAD_READS_PER_CLAIM=3

# --- Measurements --------------------------------------------------------
# Each step of processing an address records how long it ran, what it waited on and
# what it cost (openspec processing-metrics). The folder those single-step
# measurements are written to. Empty turns measuring off. No default: they are large
# and belong on a disk you choose, outside the repository. An absolute path on this
# machine: under Docker Compose it is mounted at /measure in the pipeline container.
MEASURE_DIR=
# Who is writing them: this device's name in `thenwhat measure`. Default "pipeline".
# MEASURE_WRITER=pipeline
# How many days single-step measurements are kept before only the daily totals
# remain, and how many for those of readers' lookups. No defaults: while MEASURE_DIR is
# set and either is empty, nothing is measured and each command says so.
# The operator's figures of 2026-11-16 are 30 and 7.
MEASURE_KEEP_DAYS=
MEASURE_LOOKUP_KEEP_DAYS=
# The least time, in seconds, between two pages asked of one outlet within a run of
# reads. A lead whose outlet was asked more recently is left for a later run. Default
# 30; 0 turns it off.
# READER_OUTLET_GAP_SECONDS=30
# Narrow a backfill to a period: score, and read, only link leads first shared on or
# after these days (YYYY-MM-DD). Unset, leads of any date are scored and read. A lead
# outside the period keeps its place and is due again once the day is moved back.
# LEAD_TRIAGE_SINCE=
# LEAD_READ_SINCE=
# The named set of stored trials being worked (`thenwhat backfill trial-sets` lists
# them). While it is set, `backfill run link_read` reads first the leads with an exact
# or strong link to a trial of the set, phase 3 first, and reads a held lead so linked.
# Unset, no set orders the reading. `thenwhat backfill read-set` reads for a set alone.
# LEAD_READ_TRIAL_SET=
# The share of the month's model ceiling that `thenwhat backfill read-set` may use, in
# US dollars. It reads nothing once the reads for the set this month have reached it.
# TRIAL_ROUTE_MONTHLY_USD=15

# --- Daily run -----------------------------------------------------------
# scripts/daily-run.sh, the once-a-day job (docs/daily-run.md). It reads these from this
# file as text, and holds itself to LLM_MONTHLY_BUDGET_USD above, which must be set for
# it to start. The operator's figure for the Mac mini on 2026-11-16 is 30.
# Write a JSON value anywhere in this file in single quotes, for example
# SOURCE_ALLOWANCES='{"reader": {...}}': `uv run --env-file` loses every line after an
# unquoted one, and the job refuses to start on such a file.
# The database as this machine reaches it, at the port Compose publishes on 127.0.0.1.
# The job runs on the host, where no DATABASE_URL is set; `sh scripts/daily-run.sh plist`
# puts this into the property list. With no database address anywhere the run stops.
# DAILY_RUN_DATABASE_URL=postgresql+psycopg://thenwhat:thenwhat@127.0.0.1:5433/thenwhat
# The job's `trials` step asks ClinicalTrials.gov within its SOURCE_ALLOWANCES entry. A
# load that stops starts again from page 1, so until one full load of every
# interventional trial has completed (about 470 requests) the clinicaltrials.gov
# allowance must be at least 500 requests a period. The default, 5,000 a day, is.
# At most this many passed leads are read in one run. Default 40.
# DAILY_RUN_READ_LIMIT=40
# At most this many leads are scored in one run. Default 2000.
# DAILY_RUN_TRIAGE_LIMIT=2000
# The registries are read again for this many published claims a run, in turn, so each
# claim is asked about every few days. 0 asks about every claim each run. Default 150.
# DAILY_RUN_REFRESH_LIMIT=150
# The link fetch goes on from its last fetch (data/link-files/hackernews/last-fetch.json),
# at most 20 days a run; with no record it asks for this many days back, 1 to 28.
# Default 3.
# DAILY_RUN_FETCH_DAYS=3
# How many leads the read works on at once, 1 to 4. Default 2.
# DAILY_RUN_READ_WORKERS=2
# The run stops before a step that spends when the month's recorded cost is within this
# many dollars of the ceiling. Default 1.
# DAILY_RUN_SPEND_MARGIN_USD=1
# The run stops before a step that spends once today's recorded cost (UTC) has reached
# this many dollars. Unset, there is no ceiling for a day.
# DAILY_RUN_DAY_BUDGET_USD=
# The hour and minute the job starts, in this machine's time. Read when the property
# list is written (`sh scripts/daily-run.sh plist`). Default 04:30.
# DAILY_RUN_HOUR=4
# DAILY_RUN_MINUTE=30
# Days the job's logs and summaries are kept. Default 30.
# DAILY_RUN_KEEP_DAYS=30
