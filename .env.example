# Copy to .env and fill in. Never commit .env.
#
# Read only by `make lookup-dev` (site/scripts/dev-vars.mjs), which copies these settings
# into site/.dev.vars for the lookup service on this machine. The published service takes
# them as Worker secrets and variables (docs/deploy.md).

# --- Registry access -----------------------------------------------------
# Contact address sent in the User-Agent of every registry request.
# No request is sent while this is empty.
CONTACT_EMAIL=
# OpenAlex free API key: server only. Unset disables paper search, not trial lookup.
OPENALEX_API_KEY=

# --- Language model ------------------------------------------------------
# The model the lookup service asks, by OpenAI's own name. There is no default: the
# registry search refuses to run while this is empty.
LLM_MODEL=
OPENAI_API_KEY=
# Optional: another address for the provider's API.
# LLM_BASE_URL=
# Which backend answers bounded decisions:
#   llm               the model above, answering in text
#   openai-decisions  OpenAI's Decisions API
DECISION_BACKEND=llm
# For openai-decisions. Leave empty to use LLM_MODEL.
DECISIONS_MODEL=
