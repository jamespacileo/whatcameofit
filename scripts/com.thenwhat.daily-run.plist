<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily run as a launchd agent of the logged-in user (docs/daily-run.md).
  A template: the words between @ signs are filled in by `sh scripts/daily-run.sh plist`,
  which takes every path from the top of scripts/daily-run.sh. Do not copy this file
  into ~/Library/LaunchAgents as it is.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.thenwhat.daily-run</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@ROOT@/scripts/daily-run.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>THENWHAT_ENV_FILE</key><string>@ENV_FILE@</string>
  </dict>
  <key>WorkingDirectory</key><string>@ROOT@</string>
  <!-- Once a day. A run missed while the machine slept starts when it wakes; one missed
       while it was off or nobody was logged in is not made up. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>@HOUR@</integer>
    <key>Minute</key><integer>@MINUTE@</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@LOGS@/launchd.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/launchd.log</string>
</dict>
</plist>
