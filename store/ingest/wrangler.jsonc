// The store's D1 database, as the scripts here reach it with Wrangler. No Worker is
// deployed from this folder: the ingest service that once stood in front of the store was
// removed with claims on 2026-11-20. The pairs the site reads are loaded with
// scripts/load-pairs.mjs and read back with scripts/export-pairs.mjs.
//
// The database is named here by binding only, and its id is never committed: locally
// Wrangler stands it up on this machine, and scripts/preview-config.mjs writes the
// preview's id into the git-ignored wrangler.preview.jsonc.
{
  "name": "thenwhat-store",
  // Not newer than the installed Wrangler supports.
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    { "binding": "STORE", "database_name": "thenwhat-store-preview", "migrations_dir": "migrations" }
  ]
}
